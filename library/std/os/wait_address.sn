// Waiting on an address (docs/en/reference/concurrency.md, "Waiting and waking"): the one
// blocking primitive std.sync's Mutex, Condvar, Once, RwLock and channels are
// built on, after Rust's sys/sync/futex and Go's runtime/sema. A thread
// sleeps while a 32-bit atomic cell holds an expected value, and another
// thread wakes one or every sleeper on that cell. The check and the sleep are
// one step in the kernel, so a wake that happens between a caller's load and
// its wait is never lost.
//
// - Linux, Android: futex FUTEX_WAIT_PRIVATE / FUTEX_WAKE_PRIVATE.
// - FreeBSD: _umtx_op UMTX_OP_WAIT_UINT_PRIVATE / UMTX_OP_WAKE_PRIVATE.
// - macOS: __ulock_wait2 / __ulock_wake (UL_COMPARE_AND_WAIT).
// - Windows: WaitOnAddress / WakeByAddressSingle / WakeByAddressAll.
// - WASI and every other target run one thread: nothing can change the cell
//   while the caller sleeps, so a wait returns at once (a timed wait reports
//   the timeout) and a wake has no one to wake.
//
// A wait may return without a wake (a signal, a spurious wake-up); callers
// re-check their condition in a loop, as with every futex. It answers خطأ
// only when the timeout passed. The timeout is relative, in nanoseconds;
// none waits without a deadline.
استورد sync.atomic;

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.wait_address;

    عام عرف انتظر_عند_العنوان(الخلية: &ذرة_ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_لينكس(&(*الخلية).القيمة, المتوقعة, المهلة_بالنانو);
    }
    عام عرف أيقظ_واحدا_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_لينكس(&(*الخلية).القيمة, 1 مثل ط64); }
    عام عرف أيقظ_الكل_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_لينكس(&(*الخلية).القيمة, 2147483647 مثل ط64); }
    عام عرف هل_الانتظار_عند_العنوان_مدعوم(): منطقي { أرجع صواب; }
    عرف انتظر_عند_خلية_المنصة(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_لينكس(الخلية, المتوقعة, المهلة_بالنانو);
    }
    عرف أيقظ_عند_خلية_المنصة(الخلية: &ط32, الكل: منطقي): فراغ {
        إذا (الكل) { أيقظ_عند_عنوان_لينكس(الخلية, 2147483647 مثل ط64); } وإلا { أيقظ_عند_عنوان_لينكس(الخلية, 1 مثل ط64); };
    }
}

إذا (الهدف.المنصة == «freebsd») {
    استورد os.platform.unix.freebsd.wait_address;

    عام عرف انتظر_عند_العنوان(الخلية: &ذرة_ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_فري_بي_إس_دي(&(*الخلية).القيمة, المتوقعة, المهلة_بالنانو);
    }
    عام عرف أيقظ_واحدا_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_فري_بي_إس_دي(&(*الخلية).القيمة, 1 مثل ط64); }
    عام عرف أيقظ_الكل_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_فري_بي_إس_دي(&(*الخلية).القيمة, 2147483647 مثل ط64); }
    عام عرف هل_الانتظار_عند_العنوان_مدعوم(): منطقي { أرجع صواب; }
    عرف انتظر_عند_خلية_المنصة(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_فري_بي_إس_دي(الخلية, المتوقعة, المهلة_بالنانو);
    }
    عرف أيقظ_عند_خلية_المنصة(الخلية: &ط32, الكل: منطقي): فراغ {
        إذا (الكل) { أيقظ_عند_عنوان_فري_بي_إس_دي(الخلية, 2147483647 مثل ط64); } وإلا { أيقظ_عند_عنوان_فري_بي_إس_دي(الخلية, 1 مثل ط64); };
    }
}

إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.wait_address;

    عام عرف انتظر_عند_العنوان(الخلية: &ذرة_ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_داروين(&(*الخلية).القيمة, المتوقعة, المهلة_بالنانو);
    }
    عام عرف أيقظ_واحدا_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_داروين(&(*الخلية).القيمة, خطأ); }
    عام عرف أيقظ_الكل_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_داروين(&(*الخلية).القيمة, صواب); }
    عام عرف هل_الانتظار_عند_العنوان_مدعوم(): منطقي { أرجع صواب; }
    عرف انتظر_عند_خلية_المنصة(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_داروين(الخلية, المتوقعة, المهلة_بالنانو);
    }
    عرف أيقظ_عند_خلية_المنصة(الخلية: &ط32, الكل: منطقي): فراغ { أيقظ_عند_عنوان_داروين(الخلية, الكل); }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.wait_address;

    عام عرف انتظر_عند_العنوان(الخلية: &ذرة_ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_ويندوز(&(*الخلية).القيمة, المتوقعة, المهلة_بالنانو);
    }
    عام عرف أيقظ_واحدا_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_ويندوز(&(*الخلية).القيمة, خطأ); }
    عام عرف أيقظ_الكل_عند_العنوان(الخلية: &ذرة_ط32): فراغ { أيقظ_عند_عنوان_ويندوز(&(*الخلية).القيمة, صواب); }
    عام عرف هل_الانتظار_عند_العنوان_مدعوم(): منطقي { أرجع صواب; }
    عرف انتظر_عند_خلية_المنصة(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        أرجع انتظر_عند_عنوان_ويندوز(الخلية, المتوقعة, المهلة_بالنانو);
    }
    عرف أيقظ_عند_خلية_المنصة(الخلية: &ط32, الكل: منطقي): فراغ { أيقظ_عند_عنوان_ويندوز(الخلية, الكل); }
}

إذا (!(((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») || الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    // One thread: a cell that holds the expected value can never change
    // while the caller waits, so waiting forever would be a deadlock. The
    // wait returns at once and reports a passed timeout when one was given.
    عام عرف انتظر_عند_العنوان(الخلية: &ذرة_ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        طابق المهلة_بالنانو مع
        | اختياري.موجود(_) -> { أرجع احمل_ط32(الخلية, ترتيب_ذاكرة.تسلسلي()) != المتوقعة; }
        | اختياري.لا_شيء -> { أرجع صواب; };
    }
    عام عرف أيقظ_واحدا_عند_العنوان(الخلية: &ذرة_ط32): فراغ { }
    عام عرف أيقظ_الكل_عند_العنوان(الخلية: &ذرة_ط32): فراغ { }
    عام عرف هل_الانتظار_عند_العنوان_مدعوم(): منطقي { أرجع خطأ; }
    عرف انتظر_عند_خلية_المنصة(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
        طابق المهلة_بالنانو مع
        | اختياري.موجود(_) -> { أرجع *الخلية != المتوقعة; }
        | اختياري.لا_شيء -> { أرجع صواب; };
    }
    عرف أيقظ_عند_خلية_المنصة(الخلية: &ط32, الكل: منطقي): فراغ { }
}

// The same on a bare 32-bit cell (a scalar module variable used as a lock
// word, which cannot be an atomic record): the caller changes the cell only
// through the atomic intrinsics.
عام عرف انتظر_عند_الخلية(الخلية: &ط32, المتوقعة: ط32, المهلة_بالنانو: اختياري عدد): منطقي {
    أرجع انتظر_عند_خلية_المنصة(الخلية, المتوقعة, المهلة_بالنانو);
}
عام عرف أيقظ_واحدا_عند_الخلية(الخلية: &ط32): فراغ { أيقظ_عند_خلية_المنصة(الخلية, خطأ); }

عام مرادف wait_on_address = انتظر_عند_العنوان;
عام مرادف wake_by_address_single = أيقظ_واحدا_عند_العنوان;
عام مرادف wake_by_address_all = أيقظ_الكل_عند_العنوان;
عام مرادف wait_on_address_supported = هل_الانتظار_عند_العنوان_مدعوم;
عام مرادف wait_on_cell = انتظر_عند_الخلية;
عام مرادف wake_one_on_cell = أيقظ_واحدا_عند_الخلية;
