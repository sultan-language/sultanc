استورد os.error;

// The path of the running executable at the OS boundary (Rust's
// std::env::current_exe; Go's os.Executable): /proc/self/exe on Linux and
// Android, kern.proc.pathname on FreeBSD, dyld's _NSGetExecutablePath on
// macOS, GetModuleFileNameW on Windows. An interpreted program runs in the
// interpreter's process, so this is the interpreter's path there, as
// sys.executable is Python's.

لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد os.file_attributes;

    عام عرف مسار_البرنامج_الحالي_نظام(): نتيجة نص, خطأ_حد_نظام {
        دع الرابط: نص = «/proc/self/exe»;
        أرجع اقرأ_وصلة_رمزية_نظام(&الرابط);
    }
}

لو (الهدف.المنصة == «freebsd» && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.freebsd.system_parameters;

    عام عرف مسار_البرنامج_الحالي_نظام(): نتيجة نص, خطأ_حد_نظام {
        طابق اقرأ_مسار_البرنامج_فري_بي_إس_دي() مع
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
        | نتيجة.نجح(البايتات) -> {
            لو ((الطول(البايتات) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود()); };
            أرجع نتيجة.نجح(البايتات مثل نص);
        };
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.executable_path;

    عام عرف مسار_البرنامج_الحالي_نظام(): نتيجة نص, خطأ_حد_نظام {
        طابق اقرأ_مسار_البرنامج_داروين() مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود()); }
        | اختياري.موجود(البايتات) -> { أرجع نتيجة.نجح(البايتات مثل نص); };
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_control;
    استورد encoding.utf16;

    عام عرف مسار_البرنامج_الحالي_نظام(): نتيجة نص, خطأ_حد_نظام {
        طابق اقرأ_مسار_البرنامج_ويندوز() مع
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
        | نتيجة.نجح(الوحدات) -> {
            طابق يوتيف16_إلى_نص(&الوحدات) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
        };
    }
}

لو (!(((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve»)
    || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    // WASI has no executable path (a module is not a file the host names).
    عام عرف مسار_البرنامج_الحالي_نظام(): نتيجة نص, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود());
    }
}

عام مرادف current_executable_os = مسار_البرنامج_الحالي_نظام;
