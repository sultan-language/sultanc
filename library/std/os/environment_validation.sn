// Environment-name and value validation shared by the selected OS providers.
عام عرف اسم_متغير_بيئة_نظام_صالح(الاسم: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        دع البايت: ط8 = (*الاسم)[الموضع];
        إذا (البايت == 0 || البايت == 0x3D) { أرجع خطأ; };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

عام عرف قيمة_متغير_بيئة_نظام_صالحة(القيمة: &نص): منطقي {
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*القيمة) مثل طبيعي)) {
        إذا ((*القيمة)[الموضع] == 0) { أرجع خطأ; };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

عام مرادف os_environment_name_valid = اسم_متغير_بيئة_نظام_صالح;
عام مرادف os_environment_value_valid = قيمة_متغير_بيئة_نظام_صالحة;
