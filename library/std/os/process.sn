استورد os.error;
استورد os.path;

// On Linux the identifier is a child PID; on Windows it is an owned
// process HANDLE. The issuer selects and owns the corresponding OS API.
عام نوع عملية_نظام = { المعرف: عدد, قيد_الانتظار: منطقي };

عام عرف تحقق_وسائط_تشغيل_النظام(البرنامج: &نص, الوسائط: &متجه نص): منطقي {
    إذا (الطول(*البرنامج) == 0 || !مسار_نظام_بلا_صفر_مدمج(البرنامج)) {
        أرجع خطأ;
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الوسائط) مثل طبيعي)) {
        إذا (!مسار_نظام_بلا_صفر_مدمج(&(*الوسائط)[الفهرس])) {
            أرجع خطأ;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_control;
    استورد os.platform.windows.win32.error;
    استورد os.platform.windows.win32.file_handles;
    عرف خطأ_عملية_ويندوز_للنظام(الخطأ: خطأ_عملية_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_عملية_ويندوز.وسيط_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_عملية_ويندوز.ترميز_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_عملية_ويندوز.مغلقة -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_عملية_ويندوز.حالة_انتظار_غير_متوقعة(_) -> {
            أرجع خطأ_حد_نظام.قيمة_خارج_النطاق();
        }
        | خطأ_عملية_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عام عرف شغل_عملية_نظام(
        البرنامج: &نص, الوسائط: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق شغل_عملية_ويندوز(البرنامج, الوسائط) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(المصدر) -> {
            دع العملية: متغير عملية_ويندوز = المصدر;
            // The child owns its PROCESS handle; thread HANDLE is not
            // needed to wait for process termination and must be closed.
            إذا (CloseHandle(العملية.مقبض_الخيط) == 0) {
                دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
                // Spawn has not returned ownership to the caller. Do not
                // abandon a running child after a thread-HANDLE failure.
                دع الإنهاء: نتيجة عدد, خطأ_عملية_ويندوز = أنه_عملية_ويندوز(&العملية, 127);
                // A process may already have exited; never turn cleanup
                // after a failed spawn handoff into an infinite wait.
                طابق الإنهاء مع
                | نتيجة.نجح(_) -> {
                    دع الانتظار: نتيجة اختياري ط32, خطأ_عملية_ويندوز =
                        انتظر_عملية_ويندوز_بمهلة(&العملية, 5000 مثل ط32);
                }
                | نتيجة.خطأ(_) -> {};
                // Attempt both HANDLE closes even if the first one fails;
                // the original close error remains the reported failure.
                دع التنظيف: نتيجة عدد, خطأ_عملية_ويندوز = أغلق_عملية_ويندوز(&متغير العملية);
                أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
            };
            العملية.خيط_مفتوح := خطأ;
            دع العملية_الناتجة: عملية_نظام = { المعرف: العملية.مقبض_العملية مثل عدد, قيد_الانتظار: صواب };
            أرجع نتيجة.نجح(العملية_الناتجة);
        };
    }
    عام عرف انتظر_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        دع المصدر: متغير عملية_ويندوز = {
            مقبض_العملية: (*العملية).المعرف مثل ط64,
            مقبض_الخيط: 0 مثل ط64,
            مفتوحة: صواب, خيط_مفتوح: خطأ
        };
        طابق انتظر_عملية_ويندوز(&المصدر) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(الحالة) -> {
            // Waiting does not close a Windows HANDLE. Retain ownership if
            // CloseHandle fails so the caller may retry resource cleanup.
            طابق أغلق_عملية_ويندوز(&متغير المصدر) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ));
            }
            | نتيجة.نجح(_) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(الحالة مثل عدد);
            };
        };
    }

    // WaitForSingleObject(h, 0): None while the child runs; Some closes the
    // HANDLE, as a blocking wait does (Rust's Process::try_wait).
    عام عرف تفقد_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        دع المصدر: متغير عملية_ويندوز = {
            مقبض_العملية: (*العملية).المعرف مثل ط64,
            مقبض_الخيط: 0 مثل ط64,
            مفتوحة: صواب, خيط_مفتوح: خطأ
        };
        طابق انتظر_عملية_ويندوز_بمهلة(&المصدر, 0 مثل ط32) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | نتيجة.نجح(اختياري.موجود(الرمز)) -> {
            طابق أغلق_عملية_ويندوز(&متغير المصدر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ)); }
            | نتيجة.نجح(_) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(اختياري.موجود(الرمز مثل عدد));
            };
        };
    }

    // TerminateProcess(h, 1), as Rust's Process::kill: Some when the child
    // had already exited (it is reaped), None when it was terminated and the
    // caller still waits for it. A child that exits between the check and
    // TerminateProcess makes the call fail with ERROR_ACCESS_DENIED (5);
    // that is not an error, as in Rust.
    عام عرف اقتل_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        طابق تفقد_عملية_نظام(العملية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(اختياري.موجود(الرمز)) -> { أرجع نتيجة.نجح(اختياري.موجود(الرمز)); }
        | نتيجة.نجح(اختياري.لا_شيء) -> {};
        دع المصدر: عملية_ويندوز = {
            مقبض_العملية: (*العملية).المعرف مثل ط64,
            مقبض_الخيط: 0 مثل ط64,
            مفتوحة: صواب, خيط_مفتوح: خطأ
        };
        طابق أنه_عملية_ويندوز(&المصدر, 1 مثل ط32) مع
        | نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(الأصلي)) -> {
            إذا (الأصلي.الرمز != 5) { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(_) -> {};
        أرجع نتيجة.نجح(اختياري.لا_شيء());
    }

    // Windows has no polite termination signal: terminating is killing.
    عام عرف انه_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        أرجع اقتل_عملية_نظام(العملية);
    }

    // The process ID behind the child's HANDLE (GetProcessId).
    عام عرف معرف_عملية_نظام(العملية: &عملية_نظام): عدد {
        إذا (!(*العملية).قيد_الانتظار) { أرجع 0; };
        أرجع GetProcessId((*العملية).المعرف مثل ط64) مثل عدد;
    }
}

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.process_control;
    // waitid is independently usable for a child PID acquired from a
    // supported spawn provider. It cannot create a child by itself.
    عام عرف انتظر_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        طابق انتظر_طفلا_لينكس((*العملية).المعرف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(الحالة) -> {
            (*العملية).قيد_الانتظار := خطأ;
            أرجع نتيجة.نجح(رمز_حالة_طفل_لينكس(الحالة));
        };
    }

    عرف خطأ_انتظار_لينكس_للنظام(الخطأ: خطأ_انتظار_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_انتظار_لينكس.معرف_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_انتظار_لينكس.استجابة_غير_صالحة -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_انتظار_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    // Signal terminations are 256 + signal, as on Darwin.
    عرف رمز_حالة_طفل_لينكس(الحالة: حالة_طفل_لينكس): عدد {
        طابق الحالة مع
        | حالة_طفل_لينكس.خرج(الرمز) -> { أرجع الرمز; }
        | حالة_طفل_لينكس.إشارة(الرمز) -> { أرجع 256 + الرمز; };
    }

    // A child is reaped only when a concrete exit status is returned.
    // None retains ownership and permits another poll or blocking wait.
    عام عرف تفقد_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        طابق تفقد_طفلا_لينكس((*العملية).المعرف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(النتيجة) -> {
            طابق النتيجة مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
            | اختياري.موجود(الحالة) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(اختياري.موجود(رمز_حالة_طفل_لينكس(الحالة)));
            };
        };
    }

    // None: signal sent, caller must reap. Some: already exited and reaped.
    عرف أرسل_إشارة_عملية_نظام(
        العملية: &متغير عملية_نظام, إيقاف_قسري: منطقي
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        دع الإشارة: متغير عدد = 15;
        إذا (إيقاف_قسري) { الإشارة := 9; };
        طابق أرسل_إشارة_طفل_لينكس((*العملية).المعرف, الإشارة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(النتيجة) -> {
            طابق النتيجة مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
            | اختياري.موجود(الحالة) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(اختياري.موجود(رمز_حالة_طفل_لينكس(الحالة)));
            };
        };
    }

    عام عرف انه_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        أرجع أرسل_إشارة_عملية_نظام(العملية, خطأ);
    }

    عام عرف اقتل_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        أرجع أرسل_إشارة_عملية_نظام(العملية, صواب);
    }

    // The child's process ID (Rust Child::id).
    عام عرف معرف_عملية_نظام(العملية: &عملية_نظام): عدد { أرجع (*العملية).المعرف; }
}

// This operation does not return and must not silently claim that cleanup or
// process exit is supported by environments without a process host contract.
// The frontend chooses the native provider at compile time. Foreign targets
// deliberately have no implementation instead of an invalid runtime fallback.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.process_control;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;
    عام عرف اخرج_من_عملية_النظام(الرمز: عدد): فراغ {
        اخرج_من_مجموعة_عملية_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.خروج_جماعي()),
            (الرمز مثل ط32) مثل ط64
        );
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_control;
    عام عرف اخرج_من_عملية_النظام(الرمز: عدد): فراغ {
        اخرج_من_عملية_ويندوز(الرمز مثل ط32);
    }
}

// WASI command modules exit through the host's proc_exit. WASI preview 1
// has no process creation: spawning reports WASI ENOSYS (52, "function not
// supported") as a native WASI error, so callers fail with the real reason
// instead of a fabricated child.
إذا (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.process_control;
    عام عرف اخرج_من_عملية_النظام(الرمز: عدد): فراغ {
        اخرج_من_عملية_واسي(الرمز مثل ط32);
    }

    عرف لا_إنشاء_عمليات_واسي(): خطأ_حد_نظام {
        أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 52));
    }

    عام عرف شغل_عملية_نظام(
        البرنامج: &نص, الوسائط: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        أرجع نتيجة.خطأ(لا_إنشاء_عمليات_واسي());
    }

    عام عرف شغل_عملية_نظام_ببيئة(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        أرجع نتيجة.خطأ(لا_إنشاء_عمليات_واسي());
    }

    عام عرف انتظر_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
    }
    عام عرف تفقد_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(لا_إنشاء_عمليات_واسي()); }
    عام عرف انه_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(لا_إنشاء_عمليات_واسي()); }
    عام عرف اقتل_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(لا_إنشاء_عمليات_واسي()); }
    عام عرف معرف_عملية_نظام(العملية: &عملية_نظام): عدد { أرجع 0; }
}

// Linux process creation. Both public spawn APIs share one path into
// os.platform.unix.linux.process_control (clone + execve with the O_CLOEXEC
// error channel); they differ only in where the child's environment comes
// from:
// - شغل_عملية_نظام_ببيئة: the caller's explicit NAME=VALUE entries.
// - شغل_عملية_نظام: the current process's real startup environment, copied
//   from the process-lifetime envp by its canonical owner
//   (os.platform.unix.process_startup, اجمع_بيئة_إقلاع_يونكس).
// Previously the two-argument API was absent on Linux because typed startup
// data was not yet available; it is never satisfied with an empty
// environment. An unavailable or invalid startup environment is an error.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.process_control;
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.process_startup;

    عرف خطأ_تشغيل_لينكس_للنظام(الخطأ: خطأ_تشغيل_طفل_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل -> {
            أرجع خطأ_حد_نظام.قيمة_خارج_النطاق();
        }
        | خطأ_تشغيل_طفل_لينكس.نظام(الأصلي) -> {
            أرجع خطأ_حد_نظام.نظام(الأصلي);
        }
        | خطأ_تشغيل_طفل_لينكس.واصف(الواصف) -> {
            طابق الواصف مع
            | خطأ_واصف_لينكس.نظام(الأصلي) -> {
                أرجع خطأ_حد_نظام.نظام(الأصلي);
            }
            | خطأ_واصف_لينكس.واصف_مغلق -> {
                أرجع خطأ_حد_نظام.مورد_مغلق();
            }
            | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
        };
    }

    // Shared tail of both spawn APIs. The caller has validated البرنامج and
    // الوسائط; بايتات_البيئة holds owned byte strings. Explicit environment
    // entries are validated as NAME=VALUE; inherited entries are preserved.
    عرف شغل_عملية_لينكس_ببايتات_بيئة(
        البرنامج: &نص, الوسائط: &متجه نص, بايتات_البيئة: &متجه متجه ط8,
        بيئة_موروثة: منطقي
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        دع بايتات_البرنامج: متجه ط8 = بايتات_مسار_نص_نظام(البرنامج);
        دع بايتات_الوسائط: متغير متجه متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(*الوسائط) مثل طبيعي)) {
            ألحق(بايتات_الوسائط, بايتات_مسار_نص_نظام(&(*الوسائط)[الفهرس]));
            الفهرس := الفهرس + 1;
        }
        طابق شغل_طفلا_لينكس_ببيئة(
            &بايتات_البرنامج, &بايتات_الوسائط, بايتات_البيئة, بيئة_موروثة
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تشغيل_لينكس_للنظام(الخطأ));
        }
        | نتيجة.نجح(المعرف) -> {
            دع العملية_الناتجة: عملية_نظام = { المعرف: المعرف, قيد_الانتظار: صواب };
            أرجع نتيجة.نجح(العملية_الناتجة);
        };
    }

    // Inherited envp entries retain their original bytes, even entries
    // lacking '='. An invalid pointer, unterminated entry or unsafe bound
    // remains an error rather than silently dropping an entry.
    عام عرف شغل_عملية_نظام(
        البرنامج: &نص, الوسائط: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق اجمع_بيئة_إقلاع_يونكس() مع
        | اختياري.لا_شيء -> {
            // Missing envp or an unterminated/overlong entry: the same
            // classification std.os.environment uses for invalid startup data.
            أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
        }
        | اختياري.موجود(البيئة_الموروثة) -> {
            أرجع شغل_عملية_لينكس_ببايتات_بيئة(
                البرنامج, الوسائط, &البيئة_الموروثة, صواب
            );
        };
    }

    // Entries in البيئة are explicit NAME=VALUE strings supplied by the
    // caller; the startup environment is not consulted.
    عام عرف شغل_عملية_نظام_ببيئة(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع بايتات_البيئة: متغير متجه متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(*البيئة) مثل طبيعي)) {
            ألحق(بايتات_البيئة, بايتات_مسار_نص_نظام(&(*البيئة)[الفهرس]));
            الفهرس := الفهرس + 1;
        }
        أرجع شغل_عملية_لينكس_ببايتات_بيئة(
            البرنامج, الوسائط, &بايتات_البيئة, خطأ
        );
    }
}

// Darwin: posix_spawn with the current startup environment (shared Unix
// startup envp contract) or explicit NAME=VALUE entries, waitpid, and _exit.
إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.process_control;
    استورد os.platform.unix.process_startup;

    عرف خطأ_تشغيل_داروين_للنظام(الخطأ: خطأ_تشغيل_طفل_داروين): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_تشغيل_طفل_داروين.مدخل_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_تشغيل_طفل_داروين.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عرف شغل_عملية_داروين_ببايتات_بيئة(
        البرنامج: &نص, الوسائط: &متجه نص, بايتات_البيئة: &متجه متجه ط8
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        دع بايتات_البرنامج: متجه ط8 = بايتات_مسار_نص_نظام(البرنامج);
        دع بايتات_الوسائط: متغير متجه متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(*الوسائط) مثل طبيعي)) {
            ألحق(بايتات_الوسائط, بايتات_مسار_نص_نظام(&(*الوسائط)[الفهرس]));
            الفهرس := الفهرس + 1;
        }
        طابق شغل_طفلا_داروين_ببيئة(&بايتات_البرنامج, &بايتات_الوسائط, بايتات_البيئة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تشغيل_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(المعرف) -> {
            دع العملية_الناتجة: عملية_نظام = { المعرف: المعرف, قيد_الانتظار: صواب };
            أرجع نتيجة.نجح(العملية_الناتجة);
        };
    }

    عام عرف شغل_عملية_نظام(
        البرنامج: &نص, الوسائط: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق اجمع_بيئة_إقلاع_يونكس() مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
        | اختياري.موجود(البيئة_الموروثة) -> {
            أرجع شغل_عملية_داروين_ببايتات_بيئة(البرنامج, الوسائط, &البيئة_الموروثة);
        };
    }

    عام عرف شغل_عملية_نظام_ببيئة(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        إذا (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع بايتات_البيئة: متغير متجه متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(*البيئة) مثل طبيعي)) {
            ألحق(بايتات_البيئة, بايتات_مسار_نص_نظام(&(*البيئة)[الفهرس]));
            الفهرس := الفهرس + 1;
        }
        أرجع شغل_عملية_داروين_ببايتات_بيئة(البرنامج, الوسائط, &بايتات_البيئة);
    }

    عرف خطأ_انتظار_داروين_للنظام(الخطأ: خطأ_انتظار_داروين): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_انتظار_داروين.معرف_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_انتظار_داروين.استجابة_غير_صالحة -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_انتظار_داروين.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عرف رمز_حالة_طفل_داروين(الحالة: حالة_طفل_داروين): عدد {
        طابق الحالة مع
        | حالة_طفل_داروين.خرج(الرمز) -> { أرجع الرمز; }
        | حالة_طفل_داروين.إشارة(الرمز) -> { أرجع 256 + الرمز; };
    }

    // The same exit-code encoding as Linux: signal terminations are 256 + signal.
    عام عرف انتظر_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        طابق انتظر_طفلا_داروين((*العملية).المعرف) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_انتظار_داروين_للنظام(الخطأ));
        }
        | نتيجة.نجح(الحالة) -> {
            (*العملية).قيد_الانتظار := خطأ;
            أرجع نتيجة.نجح(رمز_حالة_طفل_داروين(الحالة));
        };
    }

    // A child is reaped only when a concrete exit status is returned.
    // None retains ownership and permits another poll or blocking wait.
    عام عرف تفقد_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        طابق تفقد_طفلا_داروين((*العملية).المعرف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(النتيجة) -> {
            طابق النتيجة مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
            | اختياري.موجود(الحالة) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(اختياري.موجود(رمز_حالة_طفل_داروين(الحالة)));
            };
        };
    }

    // None: signal sent, caller must reap. Some: already exited and reaped.
    عرف أرسل_إشارة_عملية_نظام(
        العملية: &متغير عملية_نظام, إيقاف_قسري: منطقي
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        إذا (!(*العملية).قيد_الانتظار) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
        };
        دع الإشارة: متغير ص32 = 15;
        إذا (إيقاف_قسري) { الإشارة := 9; };
        طابق أرسل_إشارة_طفل_داروين((*العملية).المعرف, الإشارة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(النتيجة) -> {
            طابق النتيجة مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
            | اختياري.موجود(الحالة) -> {
                (*العملية).قيد_الانتظار := خطأ;
                أرجع نتيجة.نجح(اختياري.موجود(رمز_حالة_طفل_داروين(الحالة)));
            };
        };
    }

    عام عرف انه_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        أرجع أرسل_إشارة_عملية_نظام(العملية, خطأ);
    }

    عام عرف اقتل_عملية_نظام(
        العملية: &متغير عملية_نظام
    ): نتيجة اختياري عدد, خطأ_حد_نظام {
        أرجع أرسل_إشارة_عملية_نظام(العملية, صواب);
    }

    // The child's process ID (Rust Child::id).
    عام عرف معرف_عملية_نظام(العملية: &عملية_نظام): عدد { أرجع (*العملية).المعرف; }

    عام عرف اخرج_من_عملية_النظام(الرمز: عدد): فراغ {
        اخرج_من_عملية_داروين(الرمز مثل ص32);
    }
}
