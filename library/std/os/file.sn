            إذا (المعلومات.التعديل_بالنانو < 0 || المعلومات.التعديل_بالنانو > 999999999) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            دع الكلي: ط64 = (المعلومات.التعديل_بالثواني مثل ط64) * 1000000000;
            إذا ((المعلومات.التعديل_بالنانو مثل ط64) > 9223372036854775807 - الكلي) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح((الكلي + (المعلومات.التعديل_بالنانو مثل ط64)) مثل عدد);
        };
    }

