استورد os.buffer;
استورد os.error;
استورد os.path;

// Owned kernel file descriptors (Linux) and native HANDLEs (Windows) are
// stored as machine words, not signed runtime statuses. A close consumes the
// owner according to the selected platform's semantics.
عام نوع ملف_نظام = {
    القيمة: ط64,
    مفتوح: منطقي
};

عام نوع أصل_تحريك_ملف_نظام =
    | البداية
    | الحالي
    | النهاية
;

عرف أصل_تحريك_ملف_نظام_خام(الأصل: أصل_تحريك_ملف_نظام): عدد {
    طابق الأصل مع
    | أصل_تحريك_ملف_نظام.البداية -> { أرجع 0; }
    | أصل_تحريك_ملف_نظام.الحالي -> { أرجع 1; }
    | أصل_تحريك_ملف_نظام.النهاية -> { أرجع 2; };
}

// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف حول_خطأ_واصف_للنظام(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عرف افتح_ملف_لينكس_للنظام(المسار: &نص, للكتابة: منطقي): نتيجة ملف_نظام, خطأ_حد_نظام {
        دع البايتات: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        // Owned file descriptors must not leak into a child on execve.
        // Process descriptor inheritance remains owned by std.os.process.
        دع الأعلام: متغير ط64 = علم_فتح_إغلاق_عند_التنفيذ_لينكس();
        إذا (للكتابة) { الأعلام := (علم_فتح_إغلاق_عند_التنفيذ_لينكس() | علم_فتح_إنشاء_لينكس() | علم_فتح_اقتطاع_لينكس() | علم_فتح_للكتابة_لينكس()); };
        طابق افتح_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()),
            &البايتات, الأعلام, 438 مثل ط64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_واصف_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف) -> {
            دع الملف: ملف_نظام = { القيمة: الواصف.القيمة مثل ط64, مفتوح: صواب };
            أرجع نتيجة.نجح(الملف);
        };
    }

    عام عرف افتح_ملف_نظام_للقراءة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        أرجع افتح_ملف_لينكس_للنظام(المسار, خطأ);
    }
    عام عرف أنشئ_ملف_نظام_للكتابة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        أرجع افتح_ملف_لينكس_للنظام(المسار, صواب);
    }
    عام عرف اقرأ_ملف_نظام(
        الملف: &ملف_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = { القيمة: واصف_لينكس_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        طابق اقرأ_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()),
            &الواصف, المخزن, الإزاحة, المطلوب
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_واصف_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف اكتب_ملف_نظام(
        الملف: &ملف_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = { القيمة: واصف_لينكس_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        طابق اكتب_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة()),
            &الواصف, المحتوى, الإزاحة, المطلوب
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_واصف_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أغلق_ملف_نظام(الملف: &متغير ملف_نظام): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: متغير واصف_ملف_لينكس = { القيمة: واصف_لينكس_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
        );
        (*الملف).مفتوح := الواصف.مفتوح;
        طابق الإغلاق مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_واصف_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.file_handles;

    عرف حول_خطأ_مقبض_للنظام(الخطأ: خطأ_مقبض_ملف_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبض_ملف_ويندوز.مقبض_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبض_ملف_ويندوز.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبض_ملف_ويندوز.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_مقبض_ملف_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عرف حول_مقبض_ويندوز_إلى_ملف(المقبض: مقبض_ملف_ويندوز): ملف_نظام {
        دع الملف: ملف_نظام = { القيمة: المقبض.القيمة, مفتوح: المقبض.مفتوح };
        أرجع الملف;
    }
    عام عرف افتح_ملف_نظام_للقراءة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        طابق افتح_ملف_ويندوز_للقراءة(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_مقبض_للنظام(الخطأ)); }
        | نتيجة.نجح(المقبض) -> { أرجع نتيجة.نجح(حول_مقبض_ويندوز_إلى_ملف(المقبض)); };
    }
    عام عرف أنشئ_ملف_نظام_للكتابة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        طابق أنشئ_ملف_ويندوز_للكتابة(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_مقبض_للنظام(الخطأ)); }
        | نتيجة.نجح(المقبض) -> { أرجع نتيجة.نجح(حول_مقبض_ويندوز_إلى_ملف(المقبض)); };
    }
    عام عرف اقرأ_ملف_نظام(
        الملف: &ملف_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع المقبض: مقبض_ملف_ويندوز = { القيمة: (*الملف).القيمة, مفتوح: (*الملف).مفتوح };
        طابق اقرأ_مقطع_ملف_ويندوز(&المقبض, المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_مقبض_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف اكتب_ملف_نظام(
        الملف: &ملف_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع المقبض: مقبض_ملف_ويندوز = { القيمة: (*الملف).القيمة, مفتوح: (*الملف).مفتوح };
        طابق اكتب_مقطع_ملف_ويندوز(&المقبض, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_مقبض_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف أغلق_ملف_نظام(الملف: &متغير ملف_نظام): نتيجة عدد, خطأ_حد_نظام {
        دع المقبض: متغير مقبض_ملف_ويندوز = { القيمة: (*الملف).القيمة, مفتوح: (*الملف).مفتوح };
        دع الإغلاق: نتيجة عدد, خطأ_مقبض_ملف_ويندوز = أغلق_ملف_ويندوز(&متغير المقبض);
        (*الملف).مفتوح := المقبض.مفتوح;
        طابق الإغلاق مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حول_خطأ_مقبض_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
}

إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_descriptors;


    عرف افتح_ملف_داروين_للنظام(المسار: &نص, للكتابة: منطقي): نتيجة ملف_نظام, خطأ_حد_نظام {
        دع البايتات: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق افتح_واصف_داروين(&البايتات, للكتابة, 438) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف) -> {
            دع الملف: ملف_نظام = { القيمة: الواصف.القيمة مثل ط64, مفتوح: صواب };
            أرجع نتيجة.نجح(الملف);
        };
    }

    عام عرف افتح_ملف_نظام_للقراءة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        أرجع افتح_ملف_داروين_للنظام(المسار, خطأ);
    }
    عام عرف أنشئ_ملف_نظام_للكتابة(المسار: &نص): نتيجة ملف_نظام, خطأ_حد_نظام {
        أرجع افتح_ملف_داروين_للنظام(المسار, صواب);
    }
    عام عرف اقرأ_ملف_نظام(
        الملف: &ملف_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_داروين = { القيمة: واصف_داروين_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        طابق اقرأ_واصف_داروين(&الواصف, المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف اكتب_ملف_نظام(
        الملف: &ملف_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_داروين = { القيمة: واصف_داروين_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        طابق اكتب_واصف_داروين(&الواصف, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أغلق_ملف_نظام(الملف: &متغير ملف_نظام): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: متغير واصف_ملف_داروين = { القيمة: واصف_داروين_من_ط64((*الملف).القيمة), مفتوح: (*الملف).مفتوح };
        دع الإغلاق: نتيجة ط64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الواصف);
        (*الملف).مفتوح := الواصف.مفتوح;
        طابق الإغلاق مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }

    عام عرف أعد_تسمية_مسار_نظام(الأصلي: &نص, الجديد: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع بايتات_الأصلي: متجه ط8 = بايتات_مسار_نص_نظام(الأصلي);
        دع بايتات_الجديد: متجه ط8 = بايتات_مسار_نص_نظام(الجديد);
        طابق أعد_تسمية_داروين(&بايتات_الأصلي, &بايتات_الجديد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أزل_ملف_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق احذف_ملف_داروين(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عرف معلومات_داروين_للنظام(المسار: &نص): نتيجة معلومات_مسار_داروين, خطأ_حد_نظام {
        دع البايتات: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_معلومات_مسار_داروين(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(المعلومات) -> { أرجع نتيجة.نجح(المعلومات); };
    }
    // S_IFMT=0xF000: regular 0x8000, directory 0x4000, symlink 0xA000.
    عام عرف نوع_مسار_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق معلومات_داروين_للنظام(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المعلومات) -> {
            دع النوع: ط16 = المعلومات.الوضع & 0xF000;
            إذا (النوع == 0x8000) { أرجع نتيجة.نجح(1); };
            إذا (النوع == 0x4000) { أرجع نتيجة.نجح(2); };
            إذا (النوع == 0xA000) { أرجع نتيجة.نجح(3); };
            أرجع نتيجة.نجح(4);
        };
    }
    عام عرف حجم_مسار_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق معلومات_داروين_للنظام(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المعلومات) -> {
            إذا (المعلومات.الحجم > 9223372036854775807) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح(المعلومات.الحجم مثل عدد);
        };
    }
    عام عرف تعديل_مسار_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق معلومات_داروين_للنظام(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المعلومات) -> {
            إذا (المعلومات.التعديل_بالثواني < 0 || المعلومات.التعديل_بالثواني > 9223372035) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
