// statx and GetFileAttributesExW return native metadata, not runtime status
// codes. The portable type classification is regular=1, directory=2,
// symbolic/reparse=3, other=4.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.metadata;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف حول_خطأ_معلومات_لينكس(الخطأ: خطأ_معلومات_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_معلومات_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_معلومات_لينكس.معلومات_غير_متاحة -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
