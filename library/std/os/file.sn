// Filesystem mutation operations use the selected native path ABI; these
// signatures preserve the existing portable typed-error contract.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.path_operations;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_مسار_لينكس_للنظام(الخطأ: خطأ_مسارات_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مسارات_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مسارات_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عام عرف أعد_تسمية_مسار_نظام(الأصلي: &نص, الجديد: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع بايتات_الأصلي: متجه ط8 = بايتات_مسار_نص_نظام(الأصلي);
        دع بايتات_الجديد: متجه ط8 = بايتات_مسار_نص_نظام(الجديد);
        طابق أعد_تسمية_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إعادة_تسمية_عند()), &بايتات_الأصلي, &بايتات_الجديد
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أزل_ملف_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق احذف_مسار_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حذف_عند()), &البايتات, خطأ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
}
