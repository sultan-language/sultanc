// A one-byte read consumes the same owned file resource as bounded reads.
// Keep EOF distinct from a native failure and never reuse a closed handle.
عام عرف اقرأ_بايت_ملف_نظام(
    الملف: &ملف_نظام
): نتيجة اختياري ط8, خطأ_حد_نظام {
    دع المخزن: متغير متجه ط8 = [0];
    طابق اقرأ_ملف_نظام(الملف, &متغير المخزن, 0, 1) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العدد) -> {
        إذا (العدد == 0) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
        أرجع نتيجة.نجح(اختياري.موجود(المخزن[0]));
    };
}
