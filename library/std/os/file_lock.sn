استورد os.error;

// Advisory whole-file locks on an open file (Rust 1.89 File::lock,
// lock_shared, try_lock, try_lock_shared, unlock), one guarded branch per
// OS. The handle is the OS's own: a Unix descriptor or a Windows HANDLE.
//
// - Linux, Android, FreeBSD: flock(2), as Rust's std does on these
//   systems. The lock belongs to the open file description: it is shared by
//   duplicated descriptors and released when the last one closes.
// - macOS: flock from libSystem.
// - Windows: LockFileEx / UnlockFileEx over the whole range (offset 0,
//   length 2^64 - 1), as Rust does. A shared and an exclusive lock taken
//   by the same handle are two locks there; unlock releases one.
// - WASI preview 1 has no file locks (ENOTSUP 58).
//
// اقفل_ملف_نظام waits for the lock unless بلا_انتظار is set; then it answers
// خطأ (not acquired) when another holder would make it wait, and صواب when
// it took the lock.

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;
    استورد os.platform.unix.linux.syscalls.kernel_result;

    // flock, retried on EINTR (a blocking lock is interruptible).
    عرف نفذ_قفل_ملف_لينكس(المقبض: ط64, العملية: ط64): نتيجة عدد, خطأ_نظام_أصلي {
        طالما (صواب) {
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قفل_ملف()), المقبض, العملية,
                0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
            | نتيجة.خطأ(الأصلي) -> {
                إذا (الأصلي.الرمز != 4) { أرجع نتيجة.خطأ(الأصلي); };
            };
        }
        أرجع نتيجة.نجح(0);
    }

    عام عرف اقفل_ملف_نظام(المقبض: ط64, حصري: منطقي, بلا_انتظار: منطقي): نتيجة منطقي, خطأ_حد_نظام {
        دع العملية: متغير ط64 = قفل_ملف_مشترك_لينكس();
        إذا (حصري) { العملية := قفل_ملف_حصري_لينكس(); };
        إذا (بلا_انتظار) { العملية := العملية | قفل_ملف_بلا_انتظار_لينكس(); };
        طابق نفذ_قفل_ملف_لينكس(المقبض, العملية) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صواب); }
        | نتيجة.خطأ(الأصلي) -> {
            إذا (بلا_انتظار && الأصلي.الرمز == رمز_خطأ_سيحظر_لينكس()) { أرجع نتيجة.نجح(خطأ); };
            أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
        };
    }

    عام عرف افتح_قفل_ملف_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        طابق نفذ_قفل_ملف_لينكس(المقبض, فك_قفل_ملف_لينكس()) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
    }
}

إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_locks;

    // EWOULDBLOCK is 35.
    عام عرف اقفل_ملف_نظام(المقبض: ط64, حصري: منطقي, بلا_انتظار: منطقي): نتيجة منطقي, خطأ_حد_نظام {
        دع العملية: متغير ص32 = 1;
        إذا (حصري) { العملية := 2; };
        إذا (بلا_انتظار) { العملية := العملية | 4; };
        طابق نفذ_قفل_ملف_داروين(المقبض, العملية) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صواب); }
        | نتيجة.خطأ(الأصلي) -> {
            إذا (بلا_انتظار && الأصلي.الرمز == 35) { أرجع نتيجة.نجح(خطأ); };
            أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
        };
    }

    عام عرف افتح_قفل_ملف_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        طابق نفذ_قفل_ملف_داروين(المقبض, 8) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.file_locks;

    // A lock held elsewhere makes a LOCKFILE_FAIL_IMMEDIATELY request fail
    // with ERROR_LOCK_VIOLATION (33), or ERROR_IO_PENDING (997) on a handle
    // opened for overlapped I/O; both are "would block", as in Rust.
    عام عرف اقفل_ملف_نظام(المقبض: ط64, حصري: منطقي, بلا_انتظار: منطقي): نتيجة منطقي, خطأ_حد_نظام {
        طابق اقفل_ملف_ويندوز(المقبض, حصري, بلا_انتظار) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صواب); }
        | نتيجة.خطأ(الأصلي) -> {
            إذا (بلا_انتظار && (الأصلي.الرمز == 33 || الأصلي.الرمز == 997)) { أرجع نتيجة.نجح(خطأ); };
            أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
        };
    }

    عام عرف افتح_قفل_ملف_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        طابق افتح_قفل_ملف_ويندوز(المقبض) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
    }
}

إذا (الهدف.المنصة == «wasi») {
    عرف غير_مدعوم_قفل_واسي(): خطأ_حد_نظام {
        أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 58));
    }
    عام عرف اقفل_ملف_نظام(المقبض: ط64, حصري: منطقي, بلا_انتظار: منطقي): نتيجة منطقي, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(غير_مدعوم_قفل_واسي());
    }
    عام عرف افتح_قفل_ملف_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(غير_مدعوم_قفل_واسي());
    }
}
