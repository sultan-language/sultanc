// The OS layer under std.process.id, std.os.terminal and std.os.signal
// (Nahr items 16 and 17): one implementation per platform family.
//   pid            Linux/FreeBSD getpid, macOS getpid, Windows GetCurrentProcessId;
//                  0 where the platform has no process id (WASI).
//   terminal       Linux TCGETS / FreeBSD TIOCGETA ioctl, macOS isatty,
//                  Windows GetConsoleMode; false where there is no terminal.
//   stop signals   Linux/FreeBSD rt_sigprocmask + rt_sigtimedwait, macOS
//                  pthread_sigmask + sigwait; unsupported on Windows (a
//                  console control handler needs a C callback with its own
//                  argument, which closures cannot be yet) and WASI.
استورد os.error;

إذا (((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») || الهدف.المنصة == «freebsd») {
    استورد os.platform.unix.linux.process_info;
    استورد os.platform.unix.linux.signals;

    عام عرف معرف_العملية_نظام(): ط64 { أرجع معرف_العملية_لينكس(); }
    عام عرف هل_طرفية_نظام(التيار: ط64): منطقي { أرجع هل_طرفية_لينكس(التيار); }
    عام عرف تدعم_إشارات_الإيقاف_نظام(): منطقي { أرجع صواب; }
    عام عرف احجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع احجب_إشارات_الإيقاف_لينكس(); }
    عام عرف ارفع_حجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع ارفع_حجب_إشارات_الإيقاف_لينكس(); }
    عام عرف خذ_إشارة_إيقاف_نظام(فوري: منطقي): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع خذ_إشارة_إيقاف_لينكس(فوري); }
}

إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.process_info;

    عام عرف معرف_العملية_نظام(): ط64 { أرجع معرف_العملية_داروين(); }
    عام عرف هل_طرفية_نظام(التيار: ط64): منطقي { أرجع هل_طرفية_داروين(التيار); }
    عام عرف تدعم_إشارات_الإيقاف_نظام(): منطقي { أرجع صواب; }
    عام عرف احجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع احجب_إشارات_الإيقاف_داروين(); }
    عام عرف ارفع_حجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع ارفع_حجب_إشارات_الإيقاف_داروين(); }
    عام عرف خذ_إشارة_إيقاف_نظام(فوري: منطقي): نتيجة طبيعي, خطأ_نظام_أصلي { أرجع خذ_إشارة_إيقاف_داروين(فوري); }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_info;

    عام عرف معرف_العملية_نظام(): ط64 { أرجع معرف_العملية_ويندوز(); }
    عام عرف هل_طرفية_نظام(التيار: ط64): منطقي { أرجع هل_طرفية_ويندوز(التيار); }
}

إذا (!((((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») || الهدف.المنصة == «freebsd») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    عام عرف معرف_العملية_نظام(): ط64 { أرجع 0; }
    عام عرف هل_طرفية_نظام(التيار: ط64): منطقي { أرجع خطأ; }
}

إذا (!((((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») || الهدف.المنصة == «freebsd») || الهدف.المنصة == «macos»)) {
    عام عرف تدعم_إشارات_الإيقاف_نظام(): منطقي { أرجع خطأ; }
    عام عرف احجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واجهة_مضيف(), 0));
    }
    عام عرف ارفع_حجب_إشارات_الإيقاف_نظام(): نتيجة طبيعي, خطأ_نظام_أصلي {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واجهة_مضيف(), 0));
    }
    عام عرف خذ_إشارة_إيقاف_نظام(فوري: منطقي): نتيجة طبيعي, خطأ_نظام_أصلي {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واجهة_مضيف(), 0));
    }
}
