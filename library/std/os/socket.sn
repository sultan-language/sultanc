        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف استمع_مقبس_نظام(المقبس: &مقبس_نظام, التراكم: عدد): نتيجة عدد, خطأ_حد_نظام {
        لو (التراكم < 0 || التراكم > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق استمع_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.استماع()), &الواصف, التراكم مثل ص32
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف اقبل_مقبس_نظام(المستمع: &مقبس_نظام): نتيجة مقبس_نظام, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المستمع);
        طابق اقبل_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.قبول_بأعلام()),
            &الواصف, علم_مقبس_إغلاق_عند_التنفيذ_لينكس()
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(الطفل) -> {
            دع المقبس_الناتج: مقبس_نظام = { القيمة: الطفل.القيمة مثل عدد, مفتوح: صواب };
            أرجع نتيجة.نجح(المقبس_الناتج);
        };
    }
    عام عرف أرسل_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
