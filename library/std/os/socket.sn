لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.winsock.sockets;
    استورد os.platform.windows.winsock.name_resolution;

    عرف خطأ_مقبس_وينسوك_للنظام(الخطأ: خطأ_مقبس_وينسوك): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_وينسوك.غير_مهيأ -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_وينسوك.إصدار_غير_مدعوم -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_وينسوك.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_وينسوك.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_وينسوك.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف مقبس_وينسوك_من_النظام(المقبس: &مقبس_نظام): مقبس_وينسوك {
        دع الناتج: مقبس_وينسوك = { القيمة: (*المقبس).القيمة مثل غ64, مفتوح: (*المقبس).مفتوح };
        أرجع الناتج;
    }
    // Every socket owns exactly one Winsock startup reference. A listener
    // and its accepted child each have independent WSACleanup obligations.
    عام عرف أنشئ_مقبس_نظام(
        العائلة: عدد, النوع: عدد, البروتوكول: عدد
    ): نتيجة مقبس_نظام, خطأ_حد_نظام {
        دع العائلة_الأصلية: متغير ص32 = 0;
        لو (العائلة == 4) { العائلة_الأصلية := 2; }
        وإلا لو (العائلة == 6) { العائلة_الأصلية := 23; }
        وإلا { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        لو (النوع != 1 && النوع != 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق ابدأ_جلسة_وينسوك() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(الجلسة) -> {
            دع الجلسة_المملوكة: متغير جلسة_وينسوك = الجلسة;
            طابق أنشئ_مقبس_وينسوك(
                &الجلسة_المملوكة, العائلة_الأصلية, النوع مثل ص32, البروتوكول مثل ص32
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة عدد, خطأ_مقبس_وينسوك = أنه_جلسة_وينسوك(&متغير الجلسة_المملوكة);
                أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ));
            }
            | نتيجة.نجح(المقبس) -> {
                دع المقبس_الناتج: مقبس_نظام = { القيمة: المقبس.القيمة مثل عدد, مفتوح: صواب };
                أرجع نتيجة.نجح(المقبس_الناتج);
            };
        };
    }
    عرف عنوان_وينسوك_محدد(العنوان: &متجه غ8, العدد: عدد): نتيجة متجه غ8, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*العنوان), 0, العدد) || العدد < 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الخارج: متغير متجه غ8 = [];
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < (العدد مثل غير_موقع)) {
            ألحق(الخارج, (*العنوان)[الفهرس]); الفهرس := الفهرس + 1;
        }
        أرجع نتيجة.نجح(الخارج);
    }
    عام عرف اتصل_مقبس_نظام(
        المقبس: &مقبس_نظام, العنوان: &متجه غ8, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق عنوان_وينسوك_محدد(العنوان, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(البايتات) -> {
            دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
            طابق اتصل_بمقبس_وينسوك(&الأصلي, &البايتات) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
            | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
        };
    }
    عام عرف اربط_مقبس_نظام(
        المقبس: &مقبس_نظام, العنوان: &متجه غ8, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق عنوان_وينسوك_محدد(العنوان, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(البايتات) -> {
            دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
            طابق اربط_مقبس_وينسوك(&الأصلي, &البايتات) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
            | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
        };
    }
    عام عرف استمع_مقبس_نظام(المقبس: &مقبس_نظام, التراكم: عدد): نتيجة عدد, خطأ_حد_نظام {
        لو (التراكم < 0 || التراكم > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق استمع_مقبس_وينسوك(&الأصلي, التراكم مثل ص32) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف اقبل_مقبس_نظام(المستمع: &مقبس_نظام): نتيجة مقبس_نظام, خطأ_حد_نظام {
        لو (!(*المستمع).مفتوح) { أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق()); };
        طابق ابدأ_جلسة_وينسوك() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(الجلسة) -> {
            دع الجلسة_المملوكة: متغير جلسة_وينسوك = الجلسة;
            دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المستمع);
            طابق اقبل_مقبس_وينسوك(&الأصلي) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة عدد, خطأ_مقبس_وينسوك = أنه_جلسة_وينسوك(&متغير الجلسة_المملوكة);
                أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ));
            }
            | نتيجة.نجح(المقبس) -> {
                دع المقبس_الناتج: مقبس_نظام = { القيمة: المقبس.القيمة مثل عدد, مفتوح: صواب };
                أرجع نتيجة.نجح(المقبس_الناتج);
            };
        };
    }
    عام عرف أرسل_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه غ8, الإزاحة: عدد, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق أرسل_بمقبس_وينسوك(&الأصلي, المحتوى, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف استقبل_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه غ8, الإزاحة: عدد, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق استقبل_بمقبس_وينسوك(&الأصلي, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف أوقف_مقبس_نظام(المقبس: &مقبس_نظام, الاتجاه: عدد): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق أوقف_اتجاه_مقبس_وينسوك(&الأصلي, الاتجاه مثل ص32) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف اضبط_مقبس_نظام_غير_حاصر(المقبس: &مقبس_نظام, مفعل: منطقي): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق اضبط_مقبس_وينسوك_غير_حاصر(&الأصلي, مفعل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف اضبط_خيار_مقبس_نظام(
        المقبس: &مقبس_نظام, الخيار: عدد, القيمة: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (القيمة < 0 || القيمة > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع المستوى: متغير ص32 = 0xffff;
        دع المعرف: متغير ص32 = 0;
        لو (الخيار == 1) { المستوى := 6; المعرف := 1; }
        وإلا لو (الخيار == 2) { المعرف := 4; }
        وإلا لو (الخيار == 3) { المعرف := 8; }
        وإلا لو (الخيار == 4) { المستوى := 0; المعرف := 4; }
        وإلا لو (الخيار == 5) { المستوى := 41; المعرف := 4; }
        وإلا لو (الخيار == 6) { المعرف := 0x1002; }
        وإلا لو (الخيار == 7) { المعرف := 0x1001; }
        وإلا { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق اضبط_خيار_عدد_مقبس_وينسوك(&الأصلي, المستوى, المعرف, القيمة مثل ص32) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف أغلق_مقبس_نظام(المقبس: &متغير مقبس_نظام): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: متغير مقبس_وينسوك = مقبس_وينسوك_من_النظام(المقبس);
        طابق أغلق_مقبس_وينسوك(&متغير الأصلي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(_) -> {
            (*المقبس).مفتوح := خطأ;
            دع الجلسة: متغير جلسة_وينسوك = { نشطة: صواب };
            طابق أنه_جلسة_وينسوك(&متغير الجلسة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
            | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
        };
    }
}

// Native sockaddr is a target-specific byte layout, not the retired
// compact runtime record. Only the selected provider is included.
عرف انسخ_عنوان_النظام(
    المصدر: &متجه غ8, الخارج: &متغير متجه غ8
): نتيجة عدد, خطأ_حد_نظام {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو ((الطول(*الخارج) مثل غير_موقع) < العدد) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        (*الخارج)[الفهرس] := (*المصدر)[الفهرس];
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة.نجح(العدد مثل عدد);
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.socket_address;
    عام عرف رمز_عنوان_مقبس_النظام(
        العائلة: عدد, المنفذ: عدد, العنوان: &متجه غ8,
        الخارج: &متغير متجه غ8
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (المنفذ < 0 || المنفذ > 65535) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        لو (العائلة == 4) {
            طابق عنوان_مقبس_آيبي4_لينكس(العنوان, المنفذ مثل غ16, صواب) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | نتيجة.نجح(البايتات) -> { أرجع انسخ_عنوان_النظام(&البايتات, الخارج); };
        };
        لو (العائلة == 6) {
            طابق عنوان_مقبس_آيبي6_لينكس(
                العنوان, المنفذ مثل غ16, 0 مثل غ32, 0 مثل غ32, صواب
            ) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | نتيجة.نجح(البايتات) -> { أرجع انسخ_عنوان_النظام(&البايتات, الخارج); };
        };
        أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.winsock.socket_address;
    استورد os.platform.windows.winsock.sockets;
    استورد os.platform.windows.winsock.name_resolution;
    عام عرف رمز_عنوان_مقبس_النظام(
        العائلة: عدد, المنفذ: عدد, العنوان: &متجه غ8,
        الخارج: &متغير متجه غ8
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (المنفذ < 0 || المنفذ > 65535) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        لو (العائلة == 4) {
            طابق عنوان_مقبس_آيبي4_وينسوك(العنوان, المنفذ مثل غ16) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | نتيجة.نجح(البايتات) -> { أرجع انسخ_عنوان_النظام(&البايتات, الخارج); };
        };
        لو (العائلة == 6) {
            طابق عنوان_مقبس_آيبي6_وينسوك(
                العنوان, المنفذ مثل غ16, 0 مثل غ32, 0 مثل غ32
            ) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | نتيجة.نجح(البايتات) -> { أرجع انسخ_عنوان_النظام(&البايتات, الخارج); };
        };
        أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
    }


    // The native Winsock resolver owns its linked native results. Copy an
    // IPv4/IPv6 address before its allocation and startup reference expire.
    عام عرف حل_اسم_مضيف_النظام(
        المضيف: &نص, العائلة: عدد
    ): نتيجة متجه غ8, خطأ_حد_نظام {
        لو (العائلة != 4 && العائلة != 6) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق ابدأ_جلسة_وينسوك() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(الجلسة) -> {
            دع الجلسة_المملوكة: متغير جلسة_وينسوك = الجلسة;
            دع الخدمة: نص = «»;
            دع النتائج: نتيجة متجه عنوان_محلول_وينسوك, خطأ_حل_عنوان_وينسوك =
                حل_اسم_مضيف_وينسوك(&الجلسة_المملوكة, المضيف, &الخدمة);
            // The resolver result is an owned copy, so release the Winsock
            // reference on both success and failure before returning.
            طابق النتائج مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الإغلاق: نتيجة عدد, خطأ_مقبس_وينسوك =
                    أنه_جلسة_وينسوك(&متغير الجلسة_المملوكة);
                طابق الخطأ مع
                | خطأ_حل_عنوان_وينسوك.جلسة_غير_نشطة -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق()); }
                | خطأ_حل_عنوان_وينسوك.اسم_غير_صالح -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
                | خطأ_حل_عنوان_وينسوك.عنوان_غير_صالح -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
                | خطأ_حل_عنوان_وينسوك.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
            }
            | نتيجة.نجح(العناوين) -> {
                دع الخارج: متغير متجه غ8 = [];
                دع وجد: متغير منطقي = خطأ;
                دع الفهرس: متغير غير_موقع = 0;
                بينما (الفهرس < (الطول(العناوين) مثل غير_موقع) && !وجد) {
                    دع العنوان: عنوان_محلول_وينسوك = العناوين[الفهرس];
                    دع النوع: عدد = العنوان.العائلة مثل عدد;
                    دع الطول_الأصلي: غير_موقع = الطول(العنوان.البايتات) مثل غير_موقع;
                    لو ((العائلة == 4 && النوع == 2 && الطول_الأصلي >= 16)
                        || (العائلة == 6 && النوع == 23 && الطول_الأصلي >= 28)) {
                        دع طول_الآيبي: متغير غير_موقع = 4;
                        دع بداية_الآيبي: متغير غير_موقع = 4;
                        لو (العائلة == 6) { طول_الآيبي := 16; بداية_الآيبي := 8; };
                        ألحق(الخارج, العائلة مثل غ8);
                        ألحق(الخارج, طول_الآيبي مثل غ8);
                        ألحق(الخارج, 0 مثل غ8);
                        ألحق(الخارج, 0 مثل غ8);
                        دع الموضع: متغير غير_موقع = 0;
                        بينما (الموضع < طول_الآيبي) {
                            ألحق(الخارج, العنوان.البايتات[بداية_الآيبي + الموضع]);
                            الموضع := الموضع + 1;
                        }
                        وجد := صواب;
                    };
                    الفهرس := الفهرس + 1;
                }
                دع الإغلاق: نتيجة عدد, خطأ_مقبس_وينسوك =
                    أنه_جلسة_وينسوك(&متغير الجلسة_المملوكة);
                لو (!وجد) { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); };
                أرجع نتيجة.نجح(الخارج);
            };
        };
    }
}
