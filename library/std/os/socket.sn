    عرف خطأ_مقبس_لينكس_للنظام(الخطأ: خطأ_مقبس_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_لينكس.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف خطأ_واصف_مقبس_للنظام(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_واصف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_واصف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف واصف_من_مقبس_النظام(المقبس: &مقبس_نظام): واصف_ملف_لينكس {
