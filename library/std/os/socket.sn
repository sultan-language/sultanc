        طابق أرسل_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.إرسال_إلى()),
            &الواصف, المحتوى, الإزاحة, العدد, 0 مثل ط64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف استقبل_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق استقبل_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.استقبال_من()),
            &الواصف, المخزن, الإزاحة, العدد, 0 مثل ط64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف أوقف_مقبس_نظام(المقبس: &مقبس_نظام, الاتجاه: عدد): نتيجة عدد, خطأ_حد_نظام {
        لو (الاتجاه < 0 || الاتجاه > 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق أوقف_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.إيقاف_مقبس()),
            &الواصف, الاتجاه مثل ط64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف اضبط_مقبس_نظام_غير_حاصر(المقبس: &مقبس_نظام, مفعل: منطقي): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق اضبط_واصف_لينكس_غير_حاصر(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.تحكم_واصف()), &الواصف, مفعل
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف اضبط_خيار_مقبس_نظام(
        المقبس: &مقبس_نظام, الخيار: عدد, القيمة: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (القيمة < 0 || القيمة > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        // Socket-level and IP option numbers differ per kernel and
        // architecture (uapi.sn); the IP (0), IPv6 (41) and TCP (6) levels
        // and TCP_NODELAY (1) are the same on Linux and FreeBSD.
        لو (الخيار == 8 || الخيار == 9) {
            دع واصف_المهلة: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
            طابق اضبط_مهلة_مقبس_لينكس(
                رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.ضبط_خيار_مقبس()),
                &واصف_المهلة, الخيار == 8,
                (القيمة / 1000) مثل ط64, ((القيمة % 1000) * 1000) مثل ط64
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
            | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
        };
        دع المستوى: متغير ط64 = مستوى_مقبس_لينكس();
        دع المعرف: متغير ط64 = 0;
        لو (الخيار == 1) { المستوى := 6; المعرف := 1; }
        وإلا لو (الخيار == 2) { المعرف := خيار_إعادة_استخدام_العنوان_لينكس(); }
        وإلا لو (الخيار == 3) { المعرف := خيار_إبقاء_الاتصال_لينكس(); }
        وإلا لو (الخيار == 4) { المستوى := 0; المعرف := خيار_عمر_آيبي4_لينكس(); }
        وإلا لو (الخيار == 5) { المستوى := 41; المعرف := خيار_قفزات_آيبي6_لينكس(); }
        وإلا لو (الخيار == 6) { المعرف := خيار_مخزن_الاستقبال_لينكس(); }
        وإلا لو (الخيار == 7) { المعرف := خيار_مخزن_الإرسال_لينكس(); }
        وإلا { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق اضبط_خيار_عدد_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.ضبط_خيار_مقبس()),
            &الواصف, المستوى, المعرف, القيمة مثل ص32
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أغلق_مقبس_نظام(المقبس: &متغير مقبس_نظام): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: متغير واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        دع الحالة: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
        );
        (*المقبس).مفتوح := الواصف.مفتوح;
        طابق الحالة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.sockets;

    عرف خطأ_مقبس_داروين_للنظام(الخطأ: خطأ_مقبس_داروين): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_داروين.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_داروين.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_داروين.حل_اسم_فشل -> { أرجع خطأ_حد_نظام.رد_شبكة_غير_صالح(); }
