استورد os.buffer;
استورد os.error;

// Socket identities are target-specific. Linux descriptors and Windows
// SOCKETs never pass through the same platform implementation.
عام نوع مقبس_نظام = { القيمة: عدد, مفتوح: منطقي };

// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.sockets;
    استورد os.platform.unix.linux.name_resolution;
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_مقبس_لينكس_للنظام(الخطأ: خطأ_مقبس_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_لينكس.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف خطأ_واصف_مقبس_للنظام(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_واصف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_واصف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف واصف_من_مقبس_النظام(المقبس: &مقبس_نظام): واصف_ملف_لينكس {
        دع الناتج: واصف_ملف_لينكس = { القيمة: (*المقبس).القيمة مثل ط64, مفتوح: (*المقبس).مفتوح };
        أرجع الناتج;
    }
    عرف رقم_عملية_مقبس_لينكس(العملية: عملية_نداء_نواة_لينكس): ط64 {
        أرجع رقم_نداء_نواة_لينكس(العملية);
    }

    // Linux DNS uses the configured nameserver and owned UDP socket via
    // the existing Linux syscall providers, not a libc resolver.
    عام عرف حل_اسم_مضيف_النظام(
        المضيف: &نص, العائلة: عدد
    ): نتيجة متجه ط8, خطأ_حد_نظام {
        طابق حل_اسم_مضيف_لينكس(المضيف, العائلة) مع
        | نتيجة.نجح(البيانات) -> { أرجع نتيجة.نجح(البيانات); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_حل_اسم_لينكس.اسم_غير_صالح -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            }
            | خطأ_حل_اسم_لينكس.تكوين_غير_صالح -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            }
            | خطأ_حل_اسم_لينكس.رد_غير_صالح -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح());
            }
            | خطأ_حل_اسم_لينكس.رد_مبتور -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح());
            }
            | خطأ_حل_اسم_لينكس.اسم_مستعار(_) -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح());
            }
            | خطأ_حل_اسم_لينكس.لا_عنوان -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.اسم_شبكة_غير_موجود());
            }
            | خطأ_حل_اسم_لينكس.نظام(الأصلي) -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
            };
        };
    }
    عام عرف أنشئ_مقبس_نظام(
        العائلة: عدد, النوع: عدد, البروتوكول: عدد
    ): نتيجة مقبس_نظام, خطأ_حد_نظام {
        دع العائلة_الأصلية: متغير ط64 = 0;
        // Family 1 is a Unix domain socket (std.net.unix): AF_UNIX.
        لو (العائلة == 4) { العائلة_الأصلية := 2; }
        وإلا لو (العائلة == 6) { العائلة_الأصلية := عائلة_آيبي6_لينكس(); }
        وإلا لو (العائلة == 1) { العائلة_الأصلية := عائلة_يونكس_لينكس(); }
        وإلا { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        لو (النوع != 1 && النوع != 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع النوع_الأصلي: متغير ط64 = نوع_مقبس_تدفق_لينكس();
        لو (النوع == 2) { النوع_الأصلي := نوع_مقبس_رسائل_لينكس(); };
        طابق أنشئ_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.مقبس()),
            العائلة_الأصلية, النوع_الأصلي, البروتوكول مثل ط64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف) -> {
            دع المقبس_الناتج: مقبس_نظام = { القيمة: الواصف.القيمة مثل عدد, مفتوح: صواب };
            أرجع نتيجة.نجح(المقبس_الناتج);
        };
    }
    عام عرف اتصل_مقبس_نظام(
        المقبس: &مقبس_نظام, العنوان: &متجه ط8, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*العنوان), 0, العدد) || العدد < 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع البايتات: متغير متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (العدد مثل طبيعي)) {
            ألحق(البايتات, (*العنوان)[الفهرس]); الفهرس := الفهرس + 1;
        }
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق ضع_عنوان_مقبس_لينكس(
            رقم_عملية_مقبس_لينكس(عملية_نداء_نواة_لينكس.اتصال()), &الواصف, &البايتات
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
    عام عرف اربط_مقبس_نظام(
        المقبس: &مقبس_نظام, العنوان: &متجه ط8, العدد: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*العنوان), 0, العدد) || العدد < 2) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع البايتات: متغير متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (العدد مثل طبيعي)) {
            ألحق(البايتات, (*العنوان)[الفهرس]); الفهرس := الفهرس + 1;
        }
        دع الواصف: واصف_ملف_لينكس = واصف_من_مقبس_النظام(المقبس);
        طابق ضع_عنوان_مقبس_لينكس(
