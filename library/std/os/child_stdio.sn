استورد os.error;
استورد os.path;
استورد os.process;

// What std.process.command needs beyond std.os.process, one guarded branch
// per OS: pipes, the null device, reading and writing a pipe, waiting until one of
// several pipes can be read, and spawning with chosen standard streams, a
// working directory and an environment. Handles are machine words: Unix
// descriptors or Windows HANDLEs. القياسية passes three handles for the
// child's standard input, output and error; ~0 keeps the parent's own.

عام نوع قناة_نظام = { القارئ: ط64, الكاتب: ط64 };

عرف مقبض_موروث_نظام(): ط64 { أرجع ~(0 مثل ط64); }

لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.process_control;
    استورد os.platform.unix.linux.child_stdio;
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;
    استورد os.platform.unix.process_startup;

    عرف خطأ_واصف_للنظام_قياسي(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }
    عرف رقم_إغلاق_قياسي(): ط64 { أرجع رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()); }
    عرف رقم_تحكم_قياسي(): ط64 { أرجع رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تحكم_واصف()); }

    // pipe2(O_CLOEXEC), both ends moved above the standard range.
    عام عرف أنشئ_قناة_نظام(): نتيجة قناة_نظام, خطأ_حد_نظام {
        طابق أنشئ_قناة_فشل_طفل_لينكس() مع
        | نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الأصلي)) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
        | نتيجة.نجح(الجديدة) -> {
            دع القناة: متغير قناة_فشل_طفل_لينكس = الجديدة;
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(رقم_تحكم_قياسي(), رقم_إغلاق_قياسي(), &متغير القناة.القارئ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة ط64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(رقم_تحكم_قياسي(), رقم_إغلاق_قياسي(), &متغير القناة.الكاتب) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة ط64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            دع الناتج: قناة_نظام = { القارئ: القناة.القارئ.القيمة, الكاتب: القناة.الكاتب.القيمة };
            أرجع نتيجة.نجح(الناتج);
        };
    }

    عام عرف افتح_الجهاز_الفارغ_نظام(): نتيجة ط64, خطأ_حد_نظام {
        طابق افتح_الجهاز_الفارغ_لينكس() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
        | نتيجة.نجح(الواصف_الجديد) -> {
            دع الواصف: متغير واصف_ملف_لينكس = الواصف_الجديد;
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(رقم_تحكم_قياسي(), رقم_إغلاق_قياسي(), &متغير الواصف) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
            | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
        };
    }

    عام عرف اقرأ_قناة_نظام(
        المقبض: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = { القيمة: المقبض, مفتوح: صواب };
        طابق اقرأ_واصف_لينكس(رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()), &الواصف, المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    // write(2) with SIGPIPE blocked: a child that closed its input gives
    // EPIPE instead of ending this process.
    عام عرف اكتب_قناة_نظام(
        المقبض: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_قناة_بلا_إشارة_لينكس(المقبض, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عام عرف أغلق_مقبض_قناة_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: متغير واصف_ملف_لينكس = { القيمة: المقبض, مفتوح: صواب };
        طابق أغلق_واصف_لينكس(رقم_إغلاق_قياسي(), &متغير الواصف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }

    عام عرف انتظر_قنوات_نظام(المقابض: &متجه ط64): نتيجة متجه منطقي, خطأ_حد_نظام {
        طابق انتظر_واصفات_للقراءة_لينكس(المقابض) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_للنظام_قياسي(الخطأ)); }
        | نتيجة.نجح(الجاهزة) -> { أرجع نتيجة.نجح(الجاهزة); };
    }

    عرف خطأ_تشغيل_قياسي_للنظام(الخطأ: خطأ_تشغيل_طفل_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_تشغيل_طفل_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_تشغيل_طفل_لينكس.واصف(الواصف) -> { أرجع خطأ_واصف_للنظام_قياسي(الواصف); }
        | خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }

    // A source below 3 is first duplicated above the standard range, so
    // the child's dup3 calls never overwrite one another's source.
    عام عرف شغل_عملية_نظام_بإعداد(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, بيئة_مخصصة: منطقي,
        القياسية: &متجه ط64, الدليل: &نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        لو (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط) || (الطول(*القياسية) مثل طبيعي) != 3) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع بايتات_البيئة: متغير متجه متجه ط8 = [];
        لو (بيئة_مخصصة) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*البيئة) مثل طبيعي)) {
                ألحق(بايتات_البيئة, بايتات_مسار_نص_نظام(&(*البيئة)[ف]));
                ف := ف + 1;
            }
        } وإلا {
            طابق اجمع_بيئة_إقلاع_يونكس() مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
            | اختياري.موجود(الموروثة) -> { بايتات_البيئة := الموروثة; };
        };
        دع بايتات_البرنامج: متجه ط8 = بايتات_مسار_نص_نظام(البرنامج);
        دع بايتات_الوسائط: متغير متجه متجه ط8 = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(*الوسائط) مثل طبيعي)) {
            ألحق(بايتات_الوسائط, بايتات_مسار_نص_نظام(&(*الوسائط)[ح]));
            ح := ح + 1;
        }
        دع المصادر: متغير متجه ص64 = [];
        دع المؤقتة: متغير متجه ط64 = [];
        دع فشل: متغير اختياري خطأ_حد_نظام = اختياري.لا_شيء();
        ح := 0;
        طالما (ح < 3) {
            دع المقبض: ط64 = (*القياسية)[ح];
            لو (المقبض == مقبض_موروث_نظام()) {
                ألحق(المصادر, -1);
            } وإلا لو (المقبض < 3) {
                طابق كرر_واصفا_فوق_القياسية_لينكس(المقبض) مع
                | نتيجة.خطأ(الخطأ) -> { فشل := اختياري.موجود(خطأ_واصف_للنظام_قياسي(الخطأ)); ألحق(المصادر, -1); }
                | نتيجة.نجح(المكرر) -> { ألحق(المؤقتة, المكرر.القيمة); ألحق(المصادر, المكرر.القيمة مثل ص64); };
            } وإلا {
                ألحق(المصادر, المقبض مثل ص64);
            };
            ح := ح + 1;
        }
        دع الدليل_بايتات: متجه ط8 = بايتات_مسار_نص_نظام(الدليل);
        دع الناتج: متغير نتيجة عملية_نظام, خطأ_حد_نظام = نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        طابق فشل مع
        | اختياري.موجود(الخطأ) -> { الناتج := نتيجة.خطأ(الخطأ); }
        | اختياري.لا_شيء -> {
            طابق شغل_طفلا_لينكس_بإعداد(
                &بايتات_البرنامج, &بايتات_الوسائط, &بايتات_البيئة, !بيئة_مخصصة,
                &المصادر, &الدليل_بايتات
            ) مع
            | نتيجة.خطأ(الخطأ) -> { الناتج := نتيجة.خطأ(خطأ_تشغيل_قياسي_للنظام(الخطأ)); }
            | نتيجة.نجح(المعرف) -> {
                دع العملية: عملية_نظام = { المعرف: المعرف, قيد_الانتظار: صواب };
                الناتج := نتيجة.نجح(العملية);
            };
        };
        ح := 0;
        طالما (ح < (الطول(المؤقتة) مثل طبيعي)) {
            دع الإغلاق: نتيجة عدد, خطأ_حد_نظام = أغلق_مقبض_قناة_نظام(المؤقتة[ح]);
            ح := ح + 1;
        }
        أرجع الناتج;
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.process_control;
    استورد os.platform.unix.apple.darwin.child_stdio;
    استورد os.platform.unix.apple.darwin.file_descriptors;
    استورد os.platform.unix.process_startup;

    عرف حالة_واصف_داروين_قياسية(الخطأ: خطأ_واصف_داروين): خطأ_حد_نظام {
        أرجع خطأ_واصف_داروين_للنظام(الخطأ);
    }

    عام عرف أنشئ_قناة_نظام(): نتيجة قناة_نظام, خطأ_حد_نظام {
        طابق أنشئ_قناة_داروين() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(الواصفات) -> {
            دع الناتج: قناة_نظام = { القارئ: الواصفات[0] مثل ط64, الكاتب: الواصفات[1] مثل ط64 };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    عام عرف افتح_الجهاز_الفارغ_نظام(): نتيجة ط64, خطأ_حد_نظام {
        طابق افتح_الجهاز_الفارغ_داروين() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(الواصف) -> { أرجع نتيجة.نجح(الواصف.القيمة); };
    }
    عام عرف اقرأ_قناة_نظام(
        المقبض: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_داروين = { القيمة: المقبض, مفتوح: صواب };
        طابق اقرأ_واصف_داروين(&الواصف, المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف اكتب_قناة_نظام(
        المقبض: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_قناة_بلا_إشارة_داروين(المقبض, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أغلق_مقبض_قناة_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: متغير واصف_ملف_داروين = { القيمة: المقبض, مفتوح: صواب };
        طابق أغلق_واصف_داروين(&متغير الواصف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }
    عام عرف انتظر_قنوات_نظام(المقابض: &متجه ط64): نتيجة متجه منطقي, خطأ_حد_نظام {
        طابق انتظر_واصفات_للقراءة_داروين(المقابض) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(حالة_واصف_داروين_قياسية(الخطأ)); }
        | نتيجة.نجح(الجاهزة) -> { أرجع نتيجة.نجح(الجاهزة); };
    }
    عام عرف شغل_عملية_نظام_بإعداد(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, بيئة_مخصصة: منطقي,
        القياسية: &متجه ط64, الدليل: &نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        لو (!تحقق_وسائط_تشغيل_النظام(البرنامج, الوسائط) || (الطول(*القياسية) مثل طبيعي) != 3) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع بايتات_البيئة: متغير متجه متجه ط8 = [];
        لو (بيئة_مخصصة) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*البيئة) مثل طبيعي)) {
                ألحق(بايتات_البيئة, بايتات_مسار_نص_نظام(&(*البيئة)[ف]));
                ف := ف + 1;
            }
        } وإلا {
            طابق اجمع_بيئة_إقلاع_يونكس() مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
            | اختياري.موجود(الموروثة) -> { بايتات_البيئة := الموروثة; };
        };
        دع بايتات_البرنامج: متجه ط8 = بايتات_مسار_نص_نظام(البرنامج);
        دع بايتات_الوسائط: متغير متجه متجه ط8 = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(*الوسائط) مثل طبيعي)) {
            ألحق(بايتات_الوسائط, بايتات_مسار_نص_نظام(&(*الوسائط)[ح]));
            ح := ح + 1;
        }
        دع المصادر: متغير متجه ص64 = [];
        ح := 0;
        طالما (ح < 3) {
            لو ((*القياسية)[ح] == مقبض_موروث_نظام()) { ألحق(المصادر, -1); }
            وإلا { ألحق(المصادر, (*القياسية)[ح] مثل ص64); };
            ح := ح + 1;
        }
        دع الدليل_بايتات: متجه ط8 = بايتات_مسار_نص_نظام(الدليل);
        طابق شغل_طفلا_داروين_بإعداد(&بايتات_البرنامج, &بايتات_الوسائط, &بايتات_البيئة, &المصادر, &الدليل_بايتات) مع
        | نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.نظام(الأصلي)) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
        | نتيجة.نجح(المعرف) -> {
            دع العملية: عملية_نظام = { المعرف: المعرف, قيد_الانتظار: صواب };
            أرجع نتيجة.نجح(العملية);
        };
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_control;
    استورد os.platform.windows.win32.child_stdio;
    استورد os.platform.windows.win32.file_handles;
    استورد os.platform.windows.win32.error;

    عرف خطأ_ويندوز_قياسي(الخطأ: خطأ_عملية_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_عملية_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_عملية_ويندوز.مغلقة -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }

    عام عرف أنشئ_قناة_نظام(): نتيجة قناة_نظام, خطأ_حد_نظام {
        طابق أنشئ_قناة_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(المقابض) -> {
            دع الناتج: قناة_نظام = { القارئ: المقابض[0], الكاتب: المقابض[1] };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    عام عرف افتح_الجهاز_الفارغ_نظام(): نتيجة ط64, خطأ_حد_نظام {
        طابق افتح_الجهاز_الفارغ_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(المقبض) -> { أرجع نتيجة.نجح(المقبض); };
    }
    عام عرف اقرأ_قناة_نظام(
        المقبض: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_قناة_ويندوز(المقبض, المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف اكتب_قناة_نظام(
        المقبض: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_قناة_ويندوز(المقبض, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف أغلق_مقبض_قناة_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام {
        لو (CloseHandle(المقبض) == 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(التقط_خطأ_وين32())); };
        أرجع نتيجة.نجح(0);
    }
    عام عرف انتظر_قنوات_نظام(المقابض: &متجه ط64): نتيجة متجه منطقي, خطأ_حد_نظام {
        طابق انتظر_قنوات_ويندوز(المقابض) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(الجاهزة) -> { أرجع نتيجة.نجح(الجاهزة); };
    }
    عام عرف شغل_عملية_نظام_بإعداد(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, بيئة_مخصصة: منطقي,
        القياسية: &متجه ط64, الدليل: &نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام {
        طابق شغل_عملية_ويندوز_بإعداد(البرنامج, الوسائط, البيئة, بيئة_مخصصة, القياسية, الدليل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ويندوز_قياسي(الخطأ)); }
        | نتيجة.نجح(المصدر) -> {
            دع العملية_الويندوز: متغير عملية_ويندوز = المصدر;
            لو (CloseHandle(العملية_الويندوز.مقبض_الخيط) == 0) {
                دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
                دع الإنهاء: نتيجة عدد, خطأ_عملية_ويندوز = أنه_عملية_ويندوز(&العملية_الويندوز, 127);
                دع التنظيف: نتيجة عدد, خطأ_عملية_ويندوز = أغلق_عملية_ويندوز(&متغير العملية_الويندوز);
                أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
            };
            دع العملية: عملية_نظام = { المعرف: العملية_الويندوز.مقبض_العملية مثل عدد, قيد_الانتظار: صواب };
            أرجع نتيجة.نجح(العملية);
        };
    }
}

لو (الهدف.المنصة == «wasi») {
    // WASI preview 1 has no processes and no pipes (ENOTSUP 58).
    عرف غير_مدعوم_واسي(): خطأ_حد_نظام {
        أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 58));
    }
    عام عرف أنشئ_قناة_نظام(): نتيجة قناة_نظام, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف افتح_الجهاز_الفارغ_نظام(): نتيجة ط64, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف اقرأ_قناة_نظام(
        المقبض: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف اكتب_قناة_نظام(
        المقبض: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف أغلق_مقبض_قناة_نظام(المقبض: ط64): نتيجة عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف انتظر_قنوات_نظام(المقابض: &متجه ط64): نتيجة متجه منطقي, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
    عام عرف شغل_عملية_نظام_بإعداد(
        البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, بيئة_مخصصة: منطقي,
        القياسية: &متجه ط64, الدليل: &نص
    ): نتيجة عملية_نظام, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_واسي()); }
}
