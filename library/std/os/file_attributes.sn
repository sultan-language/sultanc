        أرجع نتيجة.خطأ(غير_مدعوم_نظام(مصدر_خطأ_نظام.واسي(), 58));
    }
    عام عرف اقرأ_أذونات_مسار_نظام(المسار: &نص): نتيجة طبيعي, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(غير_مدعوم_نظام(مصدر_خطأ_نظام.واسي(), 58));
    }
    عام عرف اقتطع_مقبض_ملف_نظام(المقبض: &مقبض_ملف_نظام, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_واسي = { القيمة: (*المقبض).القيمة, مفتوح: (*المقبض).مفتوح };
        أرجع حالة_سمات_واسي_للنظام(اقتطع_واصف_واسي(&الواصف, الطول مثل ط64));
