استورد os.error;
استورد os.path;
استورد os.file;

// Links, permission bits, file sizes, file times, exclusive creation and the
// working directory, one guarded branch per OS. Times are nanoseconds since
// the Unix epoch; permission bits are the low twelve bits of a Unix mode.

// An operation the platform does not have, as that platform's own error
// (WASI ENOTSUP 58, Windows ERROR_NOT_SUPPORTED 50).
عرف غير_مدعوم_نظام(المصدر: مصدر_خطأ_نظام, الرمز: عدد): خطأ_حد_نظام {
    أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(المصدر, الرمز));
}

عرف ثواني_من_نانو(النانو: عدد): ص64 {
    دع الثواني: متغير عدد = النانو / 1000000000;
    لو (النانو % 1000000000 < 0) { الثواني := الثواني - 1; };
    أرجع الثواني مثل ص64;
}
عرف باقي_نانو(النانو: عدد): ط64 {
    دع الباقي: متغير عدد = النانو % 1000000000;
    لو (الباقي < 0) { الباقي := الباقي + 1000000000; };
    أرجع الباقي مثل ط64;
}

لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.file_attributes;
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_سمات_لينكس_للنظام(الخطأ: خطأ_سمات_ملف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_سمات_ملف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_سمات_ملف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_سمات_ملف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف خطأ_واصف_سمات_للنظام(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }
    عرف حالة_سمات_للنظام(النتيجة: نتيجة ط64, خطأ_سمات_ملف_لينكس): نتيجة عدد, خطأ_حد_نظام {
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }

    عام عرف أنشئ_وصلة_رمزية_نظام(الهدف_المرجعي: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(الهدف_المرجعي);
        دع ب: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_للنظام(أنشئ_وصلة_رمزية_لينكس(&أ, &ب));
    }
    عام عرف اقرأ_وصلة_رمزية_نظام(المسار: &نص): نتيجة نص, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_وصلة_رمزية_لينكس(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات مثل نص); };
    }
    عام عرف أنشئ_وصلة_صلبة_نظام(الأصل: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(الأصل);
        دع ب: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_للنظام(أنشئ_وصلة_صلبة_لينكس(&أ, &ب));
    }
    عام عرف اضبط_أذونات_مسار_نظام(المسار: &نص, الوضع: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_للنظام(اضبط_أذونات_مسار_لينكس(&أ, الوضع مثل ط64));
    }
    عام عرف اقرأ_أذونات_مسار_نظام(المسار: &نص): نتيجة طبيعي, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_نمط_مسار_لينكس(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(النمط) -> { أرجع نتيجة.نجح((النمط & 0xfff) مثل طبيعي); };
    }
    عام عرف اقتطع_مقبض_ملف_نظام(المقبض: &مقبض_ملف_نظام, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = { القيمة: (*المقبض).القيمة, مفتوح: (*المقبض).مفتوح };
        أرجع حالة_سمات_للنظام(اقتطع_واصف_لينكس(&الواصف, الطول مثل ط64));
    }
    عام عرف اقتطع_مسار_نظام(المسار: &نص, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق افتح_ملفا_للتعديل_لينكس(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_سمات_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف_الجديد) -> {
            دع الواصف: متغير واصف_ملف_لينكس = الواصف_الجديد;
            دع النتيجة: نتيجة عدد, خطأ_حد_نظام = حالة_سمات_للنظام(اقتطع_واصف_لينكس(&الواصف, الطول مثل ط64));
            دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
            );
            أرجع النتيجة;
        };
    }
    عام عرف اضبط_أوقات_مسار_نظام(المسار: &نص, الوصول_نانو: عدد, التعديل_نانو: عدد): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_للنظام(اضبط_أوقات_مسار_لينكس(
            &أ, ثواني_من_نانو(الوصول_نانو), باقي_نانو(الوصول_نانو),
            ثواني_من_نانو(التعديل_نانو), باقي_نانو(التعديل_نانو)
        ));
    }
    عام عرف غير_دليل_العمل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_للنظام(غير_دليل_العمل_لينكس(&أ));
    }
    عام عرف أنشئ_ملفا_جديدا_نظام(المسار: &نص, الوضع: طبيعي): نتيجة مقبض_ملف_نظام, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق أنشئ_ملفا_جديدا_لينكس(&أ, الوضع مثل ط64) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_سمات_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف) -> {
            دع المقبض: مقبض_ملف_نظام = { القيمة: الواصف.القيمة, مفتوح: صواب };
            أرجع نتيجة.نجح(المقبض);
        };
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_attributes;
    استورد os.platform.unix.apple.darwin.file_descriptors;

    عرف حالة_سمات_داروين_للنظام(النتيجة: نتيجة ط64, خطأ_واصف_داروين): نتيجة عدد, خطأ_حد_نظام {
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }

    عام عرف أنشئ_وصلة_رمزية_نظام(الهدف_المرجعي: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(الهدف_المرجعي);
        دع ب: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_داروين_للنظام(أنشئ_وصلة_رمزية_داروين(&أ, &ب));
    }
    عام عرف اقرأ_وصلة_رمزية_نظام(المسار: &نص): نتيجة نص, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_وصلة_رمزية_داروين(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات مثل نص); };
    }
    عام عرف أنشئ_وصلة_صلبة_نظام(الأصل: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(الأصل);
        دع ب: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_داروين_للنظام(أنشئ_وصلة_صلبة_داروين(&أ, &ب));
    }
    عام عرف اضبط_أذونات_مسار_نظام(المسار: &نص, الوضع: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_داروين_للنظام(اضبط_أذونات_مسار_داروين(&أ, الوضع مثل ط64));
    }
    عام عرف اقرأ_أذونات_مسار_نظام(المسار: &نص): نتيجة طبيعي, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_معلومات_مسار_داروين(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(المعلومات) -> { أرجع نتيجة.نجح((المعلومات.الوضع & 0xfff) مثل طبيعي); };
    }
    عام عرف اقتطع_مقبض_ملف_نظام(المقبض: &مقبض_ملف_نظام, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_داروين = { القيمة: (*المقبض).القيمة, مفتوح: (*المقبض).مفتوح };
        أرجع حالة_سمات_داروين_للنظام(اقتطع_واصف_داروين(&الواصف, الطول مثل ط64));
    }
    عام عرف اقتطع_مسار_نظام(المسار: &نص, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق افتح_ملفا_للتعديل_داروين(&أ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف_الجديد) -> {
            دع الواصف: متغير واصف_ملف_داروين = الواصف_الجديد;
            دع النتيجة: نتيجة عدد, خطأ_حد_نظام = حالة_سمات_داروين_للنظام(اقتطع_واصف_داروين(&الواصف, الطول مثل ط64));
            دع الإغلاق: نتيجة ط64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الواصف);
            أرجع النتيجة;
        };
    }
    عام عرف اضبط_أوقات_مسار_نظام(المسار: &نص, الوصول_نانو: عدد, التعديل_نانو: عدد): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_داروين_للنظام(اضبط_أوقات_مسار_داروين(
            &أ, ثواني_من_نانو(الوصول_نانو), باقي_نانو(الوصول_نانو),
            ثواني_من_نانو(التعديل_نانو), باقي_نانو(التعديل_نانو)
        ));
    }
    عام عرف غير_دليل_العمل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        أرجع حالة_سمات_داروين_للنظام(غير_دليل_العمل_داروين(&أ));
    }
    عام عرف أنشئ_ملفا_جديدا_نظام(المسار: &نص, الوضع: طبيعي): نتيجة مقبض_ملف_نظام, خطأ_حد_نظام {
        دع أ: متجه ط8 = بايتات_مسار_نص_نظام(المسار);
        طابق أنشئ_ملفا_جديدا_داروين(&أ, الوضع مثل ط64) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(الواصف) -> {
            دع المقبض: مقبض_ملف_نظام = { القيمة: الواصف.القيمة, مفتوح: صواب };
            أرجع نتيجة.نجح(المقبض);
        };
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.file_attributes;
    استورد os.platform.windows.win32.file_handles;
    استورد os.platform.windows.win32.environment;

    عرف خطأ_سمات_ويندوز_للنظام(الخطأ: خطأ_سمات_ملف_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_سمات_ملف_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        // ERROR_NOT_A_REPARSE_POINT (4390): the path is not a link.
        | خطأ_سمات_ملف_ويندوز.غير_وصلة -> { أرجع غير_مدعوم_نظام(مصدر_خطأ_نظام.وين32(), 4390); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }
    عرف حالة_سمات_ويندوز_للنظام(النتيجة: نتيجة عدد, خطأ_سمات_ملف_ويندوز): نتيجة عدد, خطأ_حد_نظام {
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }

    عام عرف أنشئ_وصلة_رمزية_نظام(الهدف_المرجعي: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        أرجع حالة_سمات_ويندوز_للنظام(أنشئ_وصلة_رمزية_ويندوز(الهدف_المرجعي, المسار));
    }
    عام عرف اقرأ_وصلة_رمزية_نظام(المسار: &نص): نتيجة نص, خطأ_حد_نظام {
        طابق اقرأ_وصلة_رمزية_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
    }
    عام عرف أنشئ_وصلة_صلبة_نظام(الأصل: &نص, المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        أرجع حالة_سمات_ويندوز_للنظام(أنشئ_وصلة_صلبة_ويندوز(الأصل, المسار));
    }
    عام عرف اضبط_أذونات_مسار_نظام(المسار: &نص, الوضع: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        أرجع حالة_سمات_ويندوز_للنظام(اضبط_أذونات_مسار_ويندوز(المسار, الوضع مثل ط64));
    }
    عام عرف اقرأ_أذونات_مسار_نظام(المسار: &نص): نتيجة طبيعي, خطأ_حد_نظام {
        طابق اقرأ_أذونات_مسار_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(الوضع) -> { أرجع نتيجة.نجح(الوضع مثل طبيعي); };
    }
    عام عرف اقتطع_مقبض_ملف_نظام(المقبض: &مقبض_ملف_نظام, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        لو (!(*المقبض).مفتوح) { أرجع نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق()); };
        أرجع حالة_سمات_ويندوز_للنظام(اقتطع_مقبض_ويندوز((*المقبض).القيمة, الطول مثل ط64));
    }
    عام عرف اقتطع_مسار_نظام(المسار: &نص, الطول: طبيعي): نتيجة عدد, خطأ_حد_نظام {
        أرجع حالة_سمات_ويندوز_للنظام(اقتطع_مسار_ويندوز(المسار, الطول مثل ط64));
    }
    عام عرف اضبط_أوقات_مسار_نظام(المسار: &نص, الوصول_نانو: عدد, التعديل_نانو: عدد): نتيجة عدد, خطأ_حد_نظام {
        أرجع حالة_سمات_ويندوز_للنظام(اضبط_أوقات_مسار_ويندوز(
            المسار, ثواني_من_نانو(الوصول_نانو), باقي_نانو(الوصول_نانو),
            ثواني_من_نانو(التعديل_نانو), باقي_نانو(التعديل_نانو)
        ));
    }
    عام عرف غير_دليل_العمل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق غيّر_دليل_عمل_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_بيئة_ويندوز.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
            | _ -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
    }
    عام عرف أنشئ_ملفا_جديدا_نظام(المسار: &نص, الوضع: طبيعي): نتيجة مقبض_ملف_نظام, خطأ_حد_نظام {
        طابق أنشئ_ملفا_جديدا_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> {
            دع المقبض: مقبض_ملف_نظام = { القيمة: القيمة, مفتوح: صواب };
            أرجع نتيجة.نجح(المقبض);
        };
    }
    // The final path of an existing file or directory, links resolved.
    عام عرف المسار_النهائي_نظام(المسار: &نص): نتيجة نص, خطأ_حد_نظام {
        طابق المسار_النهائي_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
    }
}

