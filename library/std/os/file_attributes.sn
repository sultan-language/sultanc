            دع النتيجة: نتيجة عدد, خطأ_حد_نظام = حالة_سمات_واسي_للنظام(اقتطع_واصف_واسي(&الواصف, الطول مثل ط64));
            دع الإغلاق: نتيجة ط64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير الواصف);
