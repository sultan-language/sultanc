استورد os.error;

// Operating-system cryptographic randomness. This module is the single std
// owner of entropy for key generation, nonces and protocol randoms. Each
// supported platform calls its kernel or host CSPRNG; a target without a
// provider declares no function, so a consumer fails to compile instead of
// receiving predictable bytes. There is no userspace fallback generator.

عرف تحقق_طول_عشوائية_النظام(الحجم: غير_موقع): منطقي {
    أرجع الحجم <= 1048576;
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.entropy;

    عام عرف املأ_بايتات_عشوائية_النظام(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_حد_نظام {
        لو (!تحقق_طول_عشوائية_النظام(الطول(*المخزن) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق املأ_عشوائية_نواة_لينكس(المخزن) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الخطأ)); }
        | نتيجة.نجح(الحجم) -> { أرجع نتيجة.نجح(الحجم); };
    }
    عام مرادف os_fill_random_bytes = املأ_بايتات_عشوائية_النظام;
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.entropy;

    عام عرف املأ_بايتات_عشوائية_النظام(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_حد_نظام {
        لو (!تحقق_طول_عشوائية_النظام(الطول(*المخزن) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق املأ_عشوائية_نواة_داروين(المخزن) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الخطأ)); }
        | نتيجة.نجح(الحجم) -> { أرجع نتيجة.نجح(الحجم); };
    }
    عام مرادف os_fill_random_bytes = املأ_بايتات_عشوائية_النظام;
}

لو (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;
    استورد os.platform.wasi.preview1.random;

    عام عرف املأ_بايتات_عشوائية_النظام(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_حد_نظام {
        لو (!تحقق_طول_عشوائية_النظام(الطول(*المخزن) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق املأ_عشوائية_واسي(المخزن) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(الحجم) -> { أرجع نتيجة.نجح(الحجم); };
    }
    عام مرادف os_fill_random_bytes = املأ_بايتات_عشوائية_النظام;
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.random;

    عام عرف املأ_بايتات_عشوائية_النظام(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_حد_نظام {
        لو (!تحقق_طول_عشوائية_النظام(الطول(*المخزن) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق املأ_عشوائية_ويندوز(المخزن) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الخطأ)); }
        | نتيجة.نجح(الحجم) -> { أرجع نتيجة.نجح(الحجم); };
    }
    عام مرادف os_fill_random_bytes = املأ_بايتات_عشوائية_النظام;
}
