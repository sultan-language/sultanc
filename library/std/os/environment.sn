استورد os.buffer;
استورد os.error;

// Process environment and process paths have target-specific storage.
// A Linux kernel syscall cannot supply the current mutable environment;
// the Unix startup/runtime owner must make environ available to std.os.
استورد os.environment_validation;

// Copy an owned text's bytes into a caller-owned slice. The caller chooses
// the capacity; this routine does not truncate or discard an overflow.
عرف انسخ_نص_بيئة_لنطاق(
    القيمة: &نص, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_حد_نظام {
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
    };
    دع الحجم: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    لو (الحجم > (المطلوب مثل غير_موقع)) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحجم) {
        (*المخزن)[(الإزاحة مثل غير_موقع) + الفهرس] := (*القيمة)[الفهرس];
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة.نجح(الحجم مثل عدد);
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.environment;

    عرف خطأ_بيئة_ويندوز_للنظام(الخطأ: خطأ_بيئة_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_بيئة_ويندوز.اسم_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_بيئة_ويندوز.ترميز_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_بيئة_ويندوز.تغير_متكرر -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
        | خطأ_بيئة_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عام عرف طول_متغير_بيئة_نظام(الاسم: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_متغير_بيئة_ويندوز(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(الطول(القيمة) مثل عدد); };
    }
    عام عرف اقرأ_متغير_بيئة_نظام(
        الاسم: &نص, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_متغير_بيئة_ويندوز(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> {
            أرجع انسخ_نص_بيئة_لنطاق(&القيمة, المخزن, الإزاحة, المطلوب);
        };
    }
    عام عرف اقرأ_دليل_عمل_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دليل_عمل_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> {
            أرجع انسخ_نص_بيئة_لنطاق(&القيمة, المخزن, الإزاحة, المطلوب);
        };
    }
    عام عرف اقرأ_دليل_مؤقت_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دليل_مؤقت_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> {
            أرجع انسخ_نص_بيئة_لنطاق(&القيمة, المخزن, الإزاحة, المطلوب);
        };
    }
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.path_operations;
    استورد os.platform.unix.linux.temporary_directory;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    // The compiler startup ABI must supply TMPDIR; do not guess an envp
    // pointer or fabricate a platform-wide fallback directory here.
    عام عرف اختر_دليل_مؤقت_نظام_من_البيئة(
        قيمة_البيئة: اختيار نص
    ): نتيجة نص, خطأ_حد_نظام {
        طابق اختر_دليل_مؤقت_لينكس(قيمة_البيئة) مع
        | نتيجة.نجح(المسار) -> { أرجع نتيجة.نجح(المسار); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
    }
    عام عرف اقرأ_دليل_عمل_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
            || المطلوب == 0) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق اقرأ_دليل_عمل_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_دليل_العمل()),
            المطلوب مثل غير_موقع
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_مسارات_لينكس.مسار(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | خطأ_مسارات_لينكس.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.نجح(البايتات) -> {
            دع الحجم: غير_موقع = الطول(البايتات) مثل غير_موقع;
            لو (الحجم > (المطلوب مثل غير_موقع)) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            دع الفهرس: متغير غير_موقع = 0;
            بينما (الفهرس < الحجم) {
                (*المخزن)[(الإزاحة مثل غير_موقع) + الفهرس] := البايتات[الفهرس];
                الفهرس := الفهرس + 1;
            }
            أرجع نتيجة.نجح(الحجم مثل عدد);
        };
    }
}


// Darwin: the working directory comes from libSystem getcwd; TMPDIR is set
// per user by launchd and must be an absolute path without embedded NUL.
لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_descriptors;
    استورد os.path;

    عام عرف اختر_دليل_مؤقت_نظام_من_البيئة(
        قيمة_البيئة: اختيار نص
    ): نتيجة نص, خطأ_حد_نظام {
        طابق قيمة_البيئة مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود()); }
        | اختيار.بعض(المسار) -> {
            لو (الطول(المسار) == 0 || المسار[0] != 47
                || !مسار_نظام_بلا_صفر_مدمج(&المسار)) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            };
            أرجع نتيجة.نجح(المسار);
        };
    }
    عام عرف اقرأ_دليل_عمل_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
            || المطلوب == 0) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق اقرأ_دليل_عمل_داروين(المطلوب مثل غير_موقع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> {
            دع الحجم: غير_موقع = الطول(البايتات) مثل غير_موقع;
            دع الفهرس: متغير غير_موقع = 0;
            بينما (الفهرس < الحجم) {
                (*المخزن)[(الإزاحة مثل غير_موقع) + الفهرس] := البايتات[الفهرس];
                الفهرس := الفهرس + 1;
            }
            أرجع نتيجة.نجح(الحجم مثل عدد);
        };
    }
}

// Linux and Darwin share the Unix process-startup envp contract.
لو ((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) || الهدف.المنصة == «macos») {
    استورد os.platform.unix.process_startup;
    استورد text.from_bytes;

    // Match NAME=VALUE exactly. The startup provider returns owned bytes;
    // no mutable environment pointer escapes into safe STD interfaces.
    عرف ابحث_قيمة_بيئة_إقلاع_النظام(
        الاسم: &نص
    ): نتيجة متجه غ8, خطأ_حد_نظام {
        لو (!اسم_متغير_بيئة_نظام_صالح(الاسم)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق ابحث_قيمة_بيئة_إقلاع_يونكس(الاسم) مع
        | نتيجة_بحث_بيئة_إقلاع_يونكس.موجود(القيمة) -> {
            أرجع نتيجة.نجح(القيمة);
        }
        | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_موجود -> {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود());
        }
        | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح -> {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
        };
    }

    عام عرف طول_متغير_بيئة_نظام(الاسم: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق ابحث_قيمة_بيئة_إقلاع_النظام(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(الطول(القيمة) مثل عدد); };
    }

    عام عرف اقرأ_متغير_بيئة_نظام(
        الاسم: &نص, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق ابحث_قيمة_بيئة_إقلاع_النظام(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع النص: نص = من_بايتات(&القيمة);
            أرجع انسخ_نص_بيئة_لنطاق(&النص, المخزن, الإزاحة, المطلوب);
        };
    }

    عام عرف اقرأ_دليل_مؤقت_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع اسم_المؤقت: نص = «TMPDIR»;
        دع القيمة: متغير اختيار نص = اختيار.لا_شيء();
        طابق ابحث_قيمة_بيئة_إقلاع_النظام(&اسم_المؤقت) مع
        | نتيجة.نجح(البايتات) -> { القيمة := اختيار.بعض(من_بايتات(&البايتات)); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_حد_نظام.غير_موجود -> { }
            | _ -> { أرجع نتيجة.خطأ(الخطأ); };
        };
        طابق اختر_دليل_مؤقت_نظام_من_البيئة(القيمة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النص) -> {
            أرجع انسخ_نص_بيئة_لنطاق(&النص, المخزن, الإزاحة, المطلوب);
        };
    }
}

// WASI hosts supply the environment through environ_sizes_get/environ_get.
// WASI preview 1 has no working-directory call: paths are resolved against
// preopened directories, and "/" names the root they are mounted under (the
// convention wasi-libc uses for its initial working directory).
لو (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;
    استورد os.platform.wasi.preview1.process_startup;
    استورد text.from_bytes;

    عرف ابحث_قيمة_بيئة_واسي_للنظام(الاسم: &نص): نتيجة متجه غ8, خطأ_حد_نظام {
        لو (!اسم_متغير_بيئة_نظام_صالح(الاسم)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق ابحث_قيمة_بيئة_واسي(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(الموجود) -> {
            طابق الموجود مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود()); }
            | اختيار.بعض(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
        };
    }

    عام عرف طول_متغير_بيئة_نظام(الاسم: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق ابحث_قيمة_بيئة_واسي_للنظام(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(الطول(القيمة) مثل عدد); };
    }

    عام عرف اقرأ_متغير_بيئة_نظام(
        الاسم: &نص, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق ابحث_قيمة_بيئة_واسي_للنظام(الاسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع النص: نص = من_بايتات(&القيمة);
            أرجع انسخ_نص_بيئة_لنطاق(&النص, المخزن, الإزاحة, المطلوب);
        };
    }

    عام عرف اقرأ_دليل_عمل_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الجذر: نص = «/»;
        أرجع انسخ_نص_بيئة_لنطاق(&الجذر, المخزن, الإزاحة, المطلوب);
    }

    // TMPDIR when the host provides one (an absolute path); no invented default.
    عام عرف اختر_دليل_مؤقت_نظام_من_البيئة(
        قيمة_البيئة: اختيار نص
    ): نتيجة نص, خطأ_حد_نظام {
        طابق قيمة_البيئة مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.غير_موجود()); }
        | اختيار.بعض(المسار) -> {
            لو (الطول(المسار) == 0 || المسار[0] != 47) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            };
            أرجع نتيجة.نجح(المسار);
        };
    }

    عام عرف اقرأ_دليل_مؤقت_النظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        دع اسم_المؤقت: نص = «TMPDIR»;
        دع القيمة: متغير اختيار نص = اختيار.لا_شيء();
        طابق ابحث_قيمة_بيئة_واسي_للنظام(&اسم_المؤقت) مع
        | نتيجة.نجح(البايتات) -> { القيمة := اختيار.بعض(من_بايتات(&البايتات)); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_حد_نظام.غير_موجود -> { }
            | _ -> { أرجع نتيجة.خطأ(الخطأ); };
        };
        طابق اختر_دليل_مؤقت_نظام_من_البيئة(القيمة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النص) -> {
            أرجع انسخ_نص_بيئة_لنطاق(&النص, المخزن, الإزاحة, المطلوب);
        };
    }
}
