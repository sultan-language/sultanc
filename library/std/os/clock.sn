استورد math.integer;
استورد os.error;

// Wall-clock timestamps and monotonic instants are distinct types: a system
// time may jump after clock correction; an elapsed interval needs a monotonic
// source. Neither constructor fetches time from the host.
عام نوع طابع_وقت_نظام = { النانوثواني: عدد };
عام نوع لحظة_رتيبة_نظام = { النانوثواني: عدد };

عام عرف أنشئ_طابع_وقت_نظام(النانوثواني: عدد): طابع_وقت_نظام {
    دع الطابع: طابع_وقت_نظام = { النانوثواني: النانوثواني };
    أرجع الطابع;
}

عام عرف أنشئ_لحظة_رتيبة_نظام(النانوثواني: عدد): لحظة_رتيبة_نظام {
    دع اللحظة: لحظة_رتيبة_نظام = { النانوثواني: النانوثواني };
    أرجع اللحظة;
}

// Returns none for reversed samples or signed overflow. Both readings must
// come from the same monotonic clock and boot/session epoch.
عام عرف مدة_بين_لحظتين_رتيبتين(
    السابقة: &لحظة_رتيبة_نظام,
    اللاحقة: &لحظة_رتيبة_نظام
): اختياري عدد {
    إذا ((*اللاحقة).النانوثواني < (*السابقة).النانوثواني) {
        أرجع اختياري.لا_شيء();
    };
    أرجع طرح_عدد_متحقق((*اللاحقة).النانوثواني, (*السابقة).النانوثواني);
}

عام مرادف os_wall_clock_timestamp = طابع_وقت_نظام;
عام مرادف os_monotonic_instant = لحظة_رتيبة_نظام;
عام مرادف os_monotonic_elapsed_checked = مدة_بين_لحظتين_رتيبتين;


// Convert timespec64 only after checking signed nanosecond range.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.clocks;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف وقت_نانو_لينكس(رتيب: منطقي): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_ساعة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ساعة_نظام()), رتيب
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_ساعة_لينكس.مدة_غير_صالحة -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
            | خطأ_ساعة_لينكس.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.نجح(القيمة) -> {
            إذا (القيمة.الثواني < 0 || القيمة.الثواني > 9223372035) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            دع الكلي: ط64 = (القيمة.الثواني مثل ط64) * 1000000000;
            إذا ((القيمة.النانو مثل ط64) > 9223372036854775807 - الكلي) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح((الكلي + (القيمة.النانو مثل ط64)) مثل عدد);
        };
    }

    عام عرف اقرأ_وقت_نظام_النظام(): نتيجة طابع_وقت_نظام, خطأ_حد_نظام {
        طابق وقت_نانو_لينكس(خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> { أرجع نتيجة.نجح(أنشئ_طابع_وقت_نظام(النانو)); };
    }

    عام عرف اقرأ_وقت_رتيب_النظام(): نتيجة لحظة_رتيبة_نظام, خطأ_حد_نظام {
        طابق وقت_نانو_لينكس(صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> { أرجع نتيجة.نجح(أنشئ_لحظة_رتيبة_نظام(النانو)); };
    }

    عام عرف نم_نانو_للنظام(المدة: عدد): نتيجة عدد, خطأ_حد_نظام {
        إذا (المدة < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق نم_نانو_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نوم_نانو()),
            (المدة / 1000000000) مثل ص64, (المدة % 1000000000) مثل ص64
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_ساعة_لينكس.مدة_غير_صالحة -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | خطأ_ساعة_لينكس.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.clocks;

    عام عرف اقرأ_وقت_نظام_النظام(): نتيجة طابع_وقت_نظام, خطأ_حد_نظام {
        طابق اقرأ_وقت_يونكس_نانو_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_تحويل_وقت_ويندوز.خارج_النطاق -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
            | خطأ_تحويل_وقت_ويندوز.تردد_غير_صالح -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | خطأ_تحويل_وقت_ويندوز.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.نجح(القيمة) -> {
            إذا (القيمة > 9223372036854775807) { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); };
            أرجع نتيجة.نجح(أنشئ_طابع_وقت_نظام(القيمة مثل عدد));
        };
    }

    عام عرف اقرأ_وقت_رتيب_النظام(): نتيجة لحظة_رتيبة_نظام, خطأ_حد_نظام {
        طابق اقرأ_وقت_رتيب_نانو_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_تحويل_وقت_ويندوز.خارج_النطاق -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
            | خطأ_تحويل_وقت_ويندوز.تردد_غير_صالح -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
            | خطأ_تحويل_وقت_ويندوز.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); };
        }
        | نتيجة.نجح(القيمة) -> {
            إذا (القيمة > 9223372036854775807) { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); };
            أرجع نتيجة.نجح(أنشئ_لحظة_رتيبة_نظام(القيمة مثل عدد));
        };
    }

    عام عرف نم_نانو_للنظام(المدة: عدد): نتيجة عدد, خطأ_حد_نظام {
        إذا (المدة < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق نم_نانو_ويندوز(المدة مثل ط64) مع
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_نوم_ويندوز.نظام(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
            | خطأ_نوم_ويندوز.حالة_انتظار_غير_متوقعة(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); };
        };
    }
}

// Darwin uses libSystem/Mach for elapsed time and sleep, and the POSIX
// CLOCK_REALTIME API for Unix wall time. Keep platform ABI details in std.os.
إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.clocks;

    عرف خطأ_ساعة_ماخ_للنظام(الخطأ: خطأ_ساعة_ماخ): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_ساعة_ماخ.فشل_نواة(الرمز) -> {
            أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(
                مصدر_خطأ_نظام.واجهة_مضيف(), الرمز مثل عدد
            ));
        }
        | خطأ_ساعة_ماخ.تردد_غير_صالح -> {
            أرجع خطأ_حد_نظام.قيمة_خارج_النطاق();
        }
        | خطأ_ساعة_ماخ.خارج_النطاق -> {
            أرجع خطأ_حد_نظام.قيمة_خارج_النطاق();
        };
    }

    عام عرف اقرأ_وقت_نظام_النظام(): نتيجة طابع_وقت_نظام, خطأ_حد_نظام {
        طابق اقرأ_وقت_داروين_جداري_نانو() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> {
            أرجع نتيجة.نجح(أنشئ_طابع_وقت_نظام(النانو));
        };
    }

    عام عرف اقرأ_وقت_رتيب_النظام(): نتيجة لحظة_رتيبة_نظام, خطأ_حد_نظام {
        طابق اقرأ_وقت_ماخ_رتيب_نانو() مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_ساعة_ماخ_للنظام(الخطأ));
        }
        | نتيجة.نجح(النانو) -> {
            إذا (النانو > 9223372036854775807) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح(أنشئ_لحظة_رتيبة_نظام(النانو مثل عدد));
        };
    }

    عام عرف نم_نانو_للنظام(المدة: عدد): نتيجة عدد, خطأ_حد_نظام {
        إذا (المدة < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق نم_نانو_ماخ(المدة مثل ط64) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_ساعة_ماخ_للنظام(الخطأ));
        }
        | نتيجة.نجح(الرمز) -> { أرجع نتيجة.نجح(الرمز); };
    }
}

إذا (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;
    استورد os.platform.wasi.preview1.clocks;

    عرف وقت_نانو_واسي(رتيب: منطقي): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_ساعة_واسي(رتيب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> {
            إذا (القيمة > 9223372036854775807) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح(القيمة مثل عدد);
        };
    }

    عام عرف اقرأ_وقت_نظام_النظام(): نتيجة طابع_وقت_نظام, خطأ_حد_نظام {
        طابق وقت_نانو_واسي(خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> { أرجع نتيجة.نجح(أنشئ_طابع_وقت_نظام(النانو)); };
    }

    عام عرف اقرأ_وقت_رتيب_النظام(): نتيجة لحظة_رتيبة_نظام, خطأ_حد_نظام {
        طابق وقت_نانو_واسي(صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> { أرجع نتيجة.نجح(أنشئ_لحظة_رتيبة_نظام(النانو)); };
    }

    عام عرف نم_نانو_للنظام(المدة: عدد): نتيجة عدد, خطأ_حد_نظام {
        إذا (المدة < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق نم_واسي(المدة مثل ط64) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }
}
