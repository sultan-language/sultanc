// The run-time half of derived JSON (Nahr item 23): `@@json` on a record or
// enum type (frontend/annotations/json_derive.sn) generates, from the
// declaration, an encoder, a decoder and a field schema, as serde's derive
// and pydantic's models. The generated code calls these helpers. Records are
// objects with one member per field in declaration order; options are null
// when absent and may be missing on input; vectors are arrays; enum
// constructors without payloads are strings, others {"tag": name, "values":
// [payloads]}. Decoding names the failing field path in its error.
استورد text.from_bytes;
استورد text.number;
استورد text.float;
استورد json.value;
استورد json.escape;
استورد json.parse;

// ---- Encoding ----

عرف ألحق_نص_مشتق(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عام عرف ألحق_جسون_عدد(الناتج: &متغير متجه ط8, القيمة: عدد): فراغ {
    دع النص: نص = عدد_إلى_نص(القيمة);
    ألحق_نص_مشتق(الناتج, &النص);
}
عام عرف ألحق_جسون_طبيعي(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع النص: نص = طبيعي_إلى_نص(القيمة);
    ألحق_نص_مشتق(الناتج, &النص);
}
عام عرف ألحق_جسون_عشري(الناتج: &متغير متجه ط8, القيمة: ع64): فراغ {
    // JSON has no NaN or infinities: null, as JavaScript's JSON.stringify.
    إذا (القيمة != القيمة || القيمة - القيمة != 0.0) { ألحق_نص_مشتق(الناتج, &«null»); أرجع; };
    دع النص: نص = ع64_إلى_نص(القيمة);
    ألحق_نص_مشتق(الناتج, &النص);
}
عام عرف ألحق_جسون_منطقي(الناتج: &متغير متجه ط8, القيمة: منطقي): فراغ {
    إذا (القيمة) { ألحق_نص_مشتق(الناتج, &«true»); } وإلا { ألحق_نص_مشتق(الناتج, &«false»); };
}
عام عرف ألحق_جسون_نص(الناتج: &متغير متجه ط8, القيمة: &نص): فراغ {
    دع تجاهل: منطقي = ألحق_سلسلة_جسون(الناتج, القيمة);
}
عام عرف ألحق_جسون_عدم(الناتج: &متغير متجه ط8): فراغ { ألحق_نص_مشتق(الناتج, &«null»); }
عام عرف ألحق_بايت_جسون(الناتج: &متغير متجه ط8, البايت: ط8): فراغ { ألحق(*الناتج, البايت); }

// `"key":`, after a comma unless it is the first member.
عام عرف ألحق_مفتاح_جسون(الناتج: &متغير متجه ط8, المفتاح: &نص, الأول: منطقي): فراغ {
    إذا (!الأول) { ألحق(*الناتج, 0x2C مثل ط8); };
    دع تجاهل: منطقي = ألحق_سلسلة_جسون(الناتج, المفتاح);
    ألحق(*الناتج, 0x3A مثل ط8);
}

// ---- Decoding ----

عرف خطأ_حقل_جسون(المسار: &نص, السبب: نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_مشتق(&متغير الناتج, المسار);
    ألحق_نص_مشتق(&متغير الناتج, &«: »);
    ألحق_نص_مشتق(&متغير الناتج, &السبب);
    أرجع الناتج مثل نص;
}

// المسار.الاسم, for nested error paths.
عام عرف مسار_حقل_جسون(المسار: &نص, الاسم: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_مشتق(&متغير الناتج, المسار);
    إذا ((الطول(*المسار) مثل طبيعي) > 0) { ألحق(الناتج, 0x2E مثل ط8); };
    ألحق_نص_مشتق(&متغير الناتج, الاسم);
    أرجع الناتج مثل نص;
}

عام عرف مسار_عنصر_جسون(المسار: &نص, الموضع: طبيعي): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_مشتق(&متغير الناتج, المسار);
    ألحق(الناتج, 0x5B مثل ط8);
    دع الرقم: نص = طبيعي_إلى_نص(الموضع);
    ألحق_نص_مشتق(&متغير الناتج, &الرقم);
    ألحق(الناتج, 0x5D مثل ط8);
    أرجع الناتج مثل نص;
}

عام عرف حلل_وثيقة_جسون_مشتقة(النص: &نص): نتيجة وثيقة_جسون, نص {
    طابق حلل_جسون(النص) مع
    | نتيجة.نجح(الوثيقة) -> { أرجع نتيجة.نجح(الوثيقة); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(«invalid JSON»); };
}

عام عرف عدد_من_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة عدد, نص {
    طابق *القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an integer»)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an integer»)); };
}
عام عرف طبيعي_من_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة طبيعي, نص {
    طابق *القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_طبيعي(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected a non-negative integer»)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected a non-negative integer»)); };
}
عام عرف عشري_من_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة ع64, نص {
    طابق *القيمة مع
    | قيمة_جسون.رقم(النص) -> {
        طابق حلل_ع64(&النص) مع
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected a number»)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected a number»)); };
}
عام عرف منطقي_من_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة منطقي, نص {
    طابق *القيمة مع
    | قيمة_جسون.منطق(ب) -> { أرجع نتيجة.نجح(ب); }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected true or false»)); };
}
عام عرف نص_من_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة نص, نص {
    طابق *القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع نتيجة.نجح(انسخ_نص(&النص)); }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected a string»)); };
}

// A required member: missing is an error.
عام عرف عضو_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المفتاح: &نص, المسار: &نص): نتيجة قيمة_جسون, نص {
    طابق *القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> {
        طابق قيمة_مفتاح_جسون(الوثيقة, الفهرس, المفتاح) مع
        | اختياري.موجود(العضو) -> { أرجع نتيجة.نجح(العضو); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(&مسار_حقل_جسون(المسار, المفتاح), «missing»)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an object»)); };
}

// An optional member: missing and null are none.
عام عرف عضو_اختياري_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المفتاح: &نص, المسار: &نص): نتيجة اختياري قيمة_جسون, نص {
    طابق *القيمة مع
    | قيمة_جسون.كائن(الفهرس) -> {
        طابق قيمة_مفتاح_جسون(الوثيقة, الفهرس, المفتاح) مع
        | اختياري.موجود(قيمة_جسون.عدم) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | اختياري.موجود(العضو) -> { أرجع نتيجة.نجح(اختياري.موجود(العضو)); }
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an object»)); };
}

عام عرف هل_عدم_جسون(القيمة: &قيمة_جسون): منطقي {
    طابق *القيمة مع
    | قيمة_جسون.عدم -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف عناصر_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة متجه قيمة_جسون, نص {
    طابق *القيمة مع
    | قيمة_جسون.مصفوفة(الفهرس) -> {
        دع الناتج: متغير متجه قيمة_جسون = [];
        دع العدد: طبيعي;
        طابق طول_مصفوفة_جسون(الوثيقة, الفهرس) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an array»)); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق عنصر_مصفوفة_جسون(الوثيقة, الفهرس, ف) مع
            | اختياري.موجود(العنصر) -> { ألحق(الناتج, العنصر); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_حقل_جسون(المسار, «expected an array»)); };
}

// The tag of an enum value: a string, or {"tag": ...}.
عام عرف وسم_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة نص, نص {
    طابق *القيمة مع
    | قيمة_جسون.سلسلة(النص) -> { أرجع نتيجة.نجح(انسخ_نص(&النص)); }
    | _ -> {
        طابق عضو_جسون(الوثيقة, القيمة, &«tag», المسار) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الوسم) -> { أرجع نص_من_جسون(الوثيقة, &الوسم, &مسار_حقل_جسون(المسار, &«tag»)); };
    };
}

عام عرف خطأ_وسم_جسون(المسار: &نص, الوسم: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_مشتق(&متغير الناتج, &«unknown tag »);
    ألحق_نص_مشتق(&متغير الناتج, الوسم);
    أرجع خطأ_حقل_جسون(المسار, الناتج مثل نص);
}

// ---- Schema ----

// One field of a derived type, for OpenAPI and validation: its name, its
// JSON Schema type ("integer", "number", "boolean", "string", "array",
// "object") with the element or named type in التفاصيل, and whether input
// may leave it out (an option).
عام نوع حقل_مخطط_جسون = { الاسم: نص, النوع: نص, التفاصيل: نص, مطلوب: منطقي };
عام مرادف json_schema_field = حقل_مخطط_جسون;

عام عرف حقل_مخطط(الاسم: نص, النوع: نص, التفاصيل: نص, مطلوب: منطقي): حقل_مخطط_جسون {
    دع الناتج: حقل_مخطط_جسون = { الاسم: الاسم, النوع: النوع, التفاصيل: التفاصيل, مطلوب: مطلوب };
    أرجع الناتج;
}
