استورد json.value;
استورد collections.text_index_map;
استورد text.substring;
استورد text.range;
استورد text.compare;
استورد text.from_bytes;
استورد encoding.utf8;

نوع محلل_جسون = {
    النص: نص,
    الموضع: طبيعي,
    المصفوفات: متجه مصفوفة_جسون,
    الكائنات: متجه كائن_جسون,
    العمق: طبيعي
};

// The deepest array/object nesting the parser accepts.
عام عرف حد_تعشيش_جسون(): طبيعي { أرجع 512; }
عام مرادف json_max_nesting = حد_تعشيش_جسون;

عرف خطأ_عند(الصنف: صنف_خطأ_جسون, الموضع: طبيعي): خطأ_جسون {
    دع الخطأ: خطأ_جسون = { الصنف: الصنف, الإزاحة: الموضع };
    أرجع الخطأ;
}

عرف تجاوز_فراغ_جسون(المحلل: &متغير محلل_جسون): فراغ {
    دع العدد: طبيعي = الطول((*المحلل).النص) مثل طبيعي;
    دع مستمر: متغير منطقي = صواب;
    طالما (((*المحلل).الموضع < العدد) && مستمر) {
        دع ب: ط8 = (*المحلل).النص[(*المحلل).الموضع];
        لو ((ب == 0x20) || (ب == 0x09) || (ب == 0x0A) || (ب == 0x0D)) {
            (*المحلل).الموضع := (*المحلل).الموضع + 1;
        } وإلا { مستمر := خطأ; };
    }
}

عرف طابق_حرفيا(المحلل: &متغير محلل_جسون, الحرفي: نص): منطقي {
        دع الهدف: نص = الحرفي;
    دع العدد: طبيعي = الطول(الهدف) مثل طبيعي;
    لو (!متاح_في_النص(&(*المحلل).النص, (*المحلل).الموضع, العدد)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع موضع_الحرف: طبيعي = (*المحلل).الموضع + ف;
        لو ((*المحلل).النص[موضع_الحرف] != الهدف[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    (*المحلل).الموضع := (*المحلل).الموضع + العدد;
    
    أرجع صواب;
}

عرف قيمة_سداسية(البايت: ط8): اختياري ط32 {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع اختياري.موجود((البايت - 0x30) مثل ط32); };
    لو ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع اختياري.موجود(((البايت - 0x41) مثل ط32) + 10); };
    لو ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع اختياري.موجود(((البايت - 0x61) مثل ط32) + 10); };
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_سداسي4(المحلل: &متغير محلل_جسون): نتيجة ط32, خطأ_جسون {
        لو (!متاح_في_النص(&(*المحلل).النص, (*المحلل).الموضع, 4)) {
        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع));
    };
    دع القيمة: متغير ط32 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        دع موضع_الرقم: طبيعي = (*المحلل).الموضع + ف;
        طابق قيمة_سداسية((*المحلل).النص[موضع_الرقم]) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), موضع_الرقم)); }
        | اختياري.موجود(الرقم) -> { القيمة := (القيمة << 4) | الرقم; };
        ف := ف + 1;
    }
    (*المحلل).الموضع := (*المحلل).الموضع + 4;
    
    أرجع نتيجة.نجح(القيمة);
}

عرف ألحق_سلم_جسون(البايتات: &متغير متجه ط8, القيمة: ط32): منطقي {
    لو (!صالح_كسلم_يونيكود(القيمة)) { أرجع خطأ; };
    دع الحالية: متغير متجه ط8 = [];
    بدّل((*البايتات), الحالية);
    طابق ألحق_محرف_يوتيف8(الحالية, القيمة) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع خطأ; }
    | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { *البايتات := الناتج; أرجع صواب; };
}

عرف حلل_سلسلة_جسون(المحلل: &متغير محلل_جسون): نتيجة نص, خطأ_جسون {
    لو (((*المحلل).الموضع >= (الطول((*المحلل).النص) مثل طبيعي)) || ((*المحلل).النص[(*المحلل).الموضع] != 0x22)) {
        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), (*المحلل).الموضع));
    };
    (*المحلل).الموضع := (*المحلل).الموضع + 1;
    دع البايتات: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول((*المحلل).النص) مثل طبيعي;
    طالما ((*المحلل).الموضع < العدد) {
        دع ب: ط8 = (*المحلل).النص[(*المحلل).الموضع];
        لو (ب == 0x22) {
            (*المحلل).الموضع := (*المحلل).الموضع + 1;
                        أرجع نتيجة.نجح(من_بايتات(&البايتات));
        };
        لو (ب < 0x20) {
            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        لو (ب == 0x5C) {
            (*المحلل).الموضع := (*المحلل).الموضع + 1;
            لو ((*المحلل).الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), (*المحلل).الموضع)); };
            دع هـ: ط8 = (*المحلل).النص[(*المحلل).الموضع];
            (*المحلل).الموضع := (*المحلل).الموضع + 1;
            لو (هـ == 0x22) { ألحق(البايتات, 0x22); }
            وإلا لو (هـ == 0x5C) { ألحق(البايتات, 0x5C); }
            وإلا لو (هـ == 0x2F) { ألحق(البايتات, 0x2F); }
            وإلا لو (هـ == 0x62) { ألحق(البايتات, 0x08); }
            وإلا لو (هـ == 0x66) { ألحق(البايتات, 0x0C); }
            وإلا لو (هـ == 0x6E) { ألحق(البايتات, 0x0A); }
            وإلا لو (هـ == 0x72) { ألحق(البايتات, 0x0D); }
            وإلا لو (هـ == 0x74) { ألحق(البايتات, 0x09); }
            وإلا لو (هـ == 0x75) {
                                طابق اقرأ_سداسي4(المحلل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الأول) -> {
                                        دع السلم: متغير ط32 = الأول;
                    لو ((الأول >= 0xD800) && (الأول <= 0xDBFF)) {
                        لو (!متاح_في_النص(&(*المحلل).النص, (*المحلل).الموضع, 2)) {
                            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع));
                        };
                        دع موضع_الهروب_التالي: طبيعي = (*المحلل).الموضع + 1;
                        لو (((*المحلل).النص[(*المحلل).الموضع] != 0x5C) || ((*المحلل).النص[موضع_الهروب_التالي] != 0x75)) {
                            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع));
                        };
                        (*المحلل).الموضع := (*المحلل).الموضع + 2;
                                                طابق اقرأ_سداسي4(المحلل) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(الثاني) -> {
                                                        لو ((الثاني < 0xDC00) || (الثاني > 0xDFFF)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع)); };
                            السلم := 0x10000 + ((الأول - 0xD800) << 10) + (الثاني - 0xDC00);
                        };
                    } وإلا لو ((الأول >= 0xDC00) && (الأول <= 0xDFFF)) {
                        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع));
                    };
                    لو (!ألحق_سلم_جسون(&متغير البايتات, السلم)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), (*المحلل).الموضع)); };
                };
            } وإلا {
                أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.محرف_هروب_غير_صالح(), (*المحلل).الموضع - 1));
            };
        } وإلا لو (ب < 0x80) {
            ألحق(البايتات, ب);
            (*المحلل).الموضع := (*المحلل).الموضع + 1;
        } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&(*المحلل).النص, (*المحلل).الموضع);
            لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.يوتيف8_غير_صالح(), (*المحلل).الموضع)); };
            لو (!متاح_في_النص(&(*المحلل).النص, (*المحلل).الموضع, المفكوك.العرض)) {
                أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.يوتيف8_غير_صالح(), (*المحلل).الموضع));
            };
            دع نهاية: طبيعي = (*المحلل).الموضع + المفكوك.العرض;
            طالما ((*المحلل).الموضع < نهاية) {
                ألحق(البايتات, (*المحلل).النص[(*المحلل).الموضع]);
                (*المحلل).الموضع := (*المحلل).الموضع + 1;
            }
        };
    }
    أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف رقم_عشري_جسون(ب: ط8): منطقي { أرجع (ب >= 0x30) && (ب <= 0x39); }

عرف حلل_رقم_جسون(المحلل: &متغير محلل_جسون): نتيجة نص, خطأ_جسون {
        دع البداية: طبيعي = (*المحلل).الموضع;
    دع العدد: طبيعي = الطول((*المحلل).النص) مثل طبيعي;
    لو (((*المحلل).الموضع < العدد) && ((*المحلل).النص[(*المحلل).الموضع] == 0x2D)) { (*المحلل).الموضع := (*المحلل).الموضع + 1; };
    لو ((*المحلل).الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), البداية)); };
    لو ((*المحلل).النص[(*المحلل).الموضع] == 0x30) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        لو (((*المحلل).الموضع < العدد) && رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), (*المحلل).الموضع)); };
    } وإلا {
        لو (((*المحلل).النص[(*المحلل).الموضع] < 0x31) || ((*المحلل).النص[(*المحلل).الموضع] > 0x39)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), (*المحلل).الموضع)); };
        طالما (((*المحلل).الموضع < العدد) && رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { (*المحلل).الموضع := (*المحلل).الموضع + 1; }
    };
    لو (((*المحلل).الموضع < العدد) && ((*المحلل).النص[(*المحلل).الموضع] == 0x2E)) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        لو (((*المحلل).الموضع >= العدد) || !رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), (*المحلل).الموضع)); };
        طالما (((*المحلل).الموضع < العدد) && رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { (*المحلل).الموضع := (*المحلل).الموضع + 1; }
    };
    لو (((*المحلل).الموضع < العدد) && (((*المحلل).النص[(*المحلل).الموضع] == 0x65) || ((*المحلل).النص[(*المحلل).الموضع] == 0x45))) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        لو (((*المحلل).الموضع < العدد) && (((*المحلل).النص[(*المحلل).الموضع] == 0x2B) || ((*المحلل).النص[(*المحلل).الموضع] == 0x2D))) { (*المحلل).الموضع := (*المحلل).الموضع + 1; };
        لو (((*المحلل).الموضع >= العدد) || !رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), (*المحلل).الموضع)); };
        طالما (((*المحلل).الموضع < العدد) && رقم_عشري_جسون((*المحلل).النص[(*المحلل).الموضع])) { (*المحلل).الموضع := (*المحلل).الموضع + 1; }
    };
    دع النهاية: طبيعي = (*المحلل).الموضع;
    طابق مقطع_نص(&(*المحلل).النص, البداية, النهاية - البداية) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), البداية)); };
}

عرف حلل_مصفوفة_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    (*المحلل).الموضع := (*المحلل).الموضع + 1;
    تجاوز_فراغ_جسون(المحلل);
    دع القيم: متغير متجه قيمة_جسون = [];
    لو (((*المحلل).الموضع < (الطول((*المحلل).النص) مثل طبيعي)) && ((*المحلل).النص[(*المحلل).الموضع] == 0x5D)) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        دع الفهرس: طبيعي = الطول((*المحلل).المصفوفات) مثل طبيعي;
        دع صف: مصفوفة_جسون = { القيم: القيم }; ألحق((*المحلل).المصفوفات, صف);
        أرجع نتيجة.نجح(قيمة_جسون.مصفوفة(الفهرس));
    };
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق حلل_قيمة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        تجاوز_فراغ_جسون(المحلل);
        لو ((*المحلل).الموضع >= (الطول((*المحلل).النص) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), (*المحلل).الموضع)); };
        دع ب: ط8 = (*المحلل).النص[(*المحلل).الموضع];
        لو (ب == 0x5D) { (*المحلل).الموضع := (*المحلل).الموضع + 1; مستمر := خطأ; }
        وإلا لو (ب == 0x2C) { (*المحلل).الموضع := (*المحلل).الموضع + 1; تجاوز_فراغ_جسون(المحلل); }
        وإلا { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), (*المحلل).الموضع)); };
    }
    دع الفهرس: طبيعي = الطول((*المحلل).المصفوفات) مثل طبيعي;
    دع صف: مصفوفة_جسون = { القيم: القيم }; ألحق((*المحلل).المصفوفات, صف);
    أرجع نتيجة.نجح(قيمة_جسون.مصفوفة(الفهرس));
}

عرف حلل_كائن_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    (*المحلل).الموضع := (*المحلل).الموضع + 1;
    تجاوز_فراغ_جسون(المحلل);
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];
    دع الفهرس: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    لو (((*المحلل).الموضع < (الطول((*المحلل).النص) مثل طبيعي)) && ((*المحلل).النص[(*المحلل).الموضع] == 0x7D)) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        دع موضع_الكائن: طبيعي = الطول((*المحلل).الكائنات) مثل طبيعي;
        دع ك: كائن_جسون = { المداخل: المداخل, الفهرس: الفهرس }; ألحق((*المحلل).الكائنات, ك);
        أرجع نتيجة.نجح(قيمة_جسون.كائن(موضع_الكائن));
    };
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع موضع_قبل: طبيعي = (*المحلل).الموضع;
        لو ((موضع_قبل >= (الطول((*المحلل).النص) مثل طبيعي)) || ((*المحلل).النص[موضع_قبل] != 0x22)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), موضع_قبل)); };
        دع المفتاح: متغير نص = «»;
        طابق حلل_سلسلة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { المفتاح := القيمة; };
        تجاوز_فراغ_جسون(المحلل);
        لو (((*المحلل).الموضع >= (الطول((*المحلل).النص) مثل طبيعي)) || ((*المحلل).النص[(*المحلل).الموضع] != 0x3A)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), (*المحلل).الموضع)); };
        (*المحلل).الموضع := (*المحلل).الموضع + 1; تجاوز_فراغ_جسون(المحلل);
        دع القيمة: متغير قيمة_جسون = قيمة_جسون.عدم();
        طابق حلل_قيمة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النتيجة) -> { القيمة := النتيجة; };
        دع موضع_جديد: طبيعي = الطول(المداخل) مثل طبيعي;
        دع الموضع: متغير طبيعي = موضع_جديد;
        // Keep the first occurrence's index when replacing a duplicate key.
        // The map is updated at most once for each parsed object member.
        طابق ابحث_في_خريطة_نص_فهرس(&الفهرس, &المفتاح) مع
        | اختياري.موجود(قديم) -> { الموضع := قديم; }
        | اختياري.لا_شيء -> { };
        // The index and the entry each own their key.
        دع مفتاح_الفهرس: نص = انسخ_نص(&المفتاح);
        طابق أدرج_في_خريطة_نص_فهرس(&متغير الفهرس, مفتاح_الفهرس, الموضع) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(خطأ_عند(
                صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل(), موضع_قبل
            ));
        }
        | نتيجة.نجح(اختياري.لا_شيء) -> {
            دع مدخل: مدخل_كائن_جسون = { المفتاح: المفتاح, القيمة: القيمة };
            ألحق(المداخل, مدخل);
        }
        | نتيجة.نجح(اختياري.موجود(قديم)) -> {
            دع مدخل: مدخل_كائن_جسون = { المفتاح: المفتاح, القيمة: القيمة };
            المداخل[قديم] := مدخل;
        };
        تجاوز_فراغ_جسون(المحلل);
        لو ((*المحلل).الموضع >= (الطول((*المحلل).النص) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), (*المحلل).الموضع)); };
        دع ب: ط8 = (*المحلل).النص[(*المحلل).الموضع];
        لو (ب == 0x7D) { (*المحلل).الموضع := (*المحلل).الموضع + 1; مستمر := خطأ; }
        وإلا لو (ب == 0x2C) { (*المحلل).الموضع := (*المحلل).الموضع + 1; تجاوز_فراغ_جسون(المحلل); }
        وإلا { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), (*المحلل).الموضع)); };
    }
    دع موضع_الكائن: طبيعي = الطول((*المحلل).الكائنات) مثل طبيعي;
    دع ك: كائن_جسون = { المداخل: المداخل, الفهرس: الفهرس }; ألحق((*المحلل).الكائنات, ك);
    أرجع نتيجة.نجح(قيمة_جسون.كائن(موضع_الكائن));
}

عرف حلل_مصفوفة_أو_كائن_جسون(المحلل: &متغير محلل_جسون, مصفوفة: منطقي): نتيجة قيمة_جسون, خطأ_جسون {
    لو (مصفوفة) { أرجع حلل_مصفوفة_جسون(المحلل); };
    أرجع حلل_كائن_جسون(المحلل);
}

عرف حلل_قيمة_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    تجاوز_فراغ_جسون(المحلل);
    دع موضع_القيمة: طبيعي = (*المحلل).الموضع;
    لو (موضع_القيمة >= (الطول((*المحلل).النص) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), موضع_القيمة)); };
    دع ب: ط8 = (*المحلل).النص[موضع_القيمة];
    لو (ب == 0x22) {
        طابق حلل_سلسلة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(قيمة_جسون.سلسلة(القيمة)); };
    };
    لو (ب == 0x5B || ب == 0x7B) {
        لو ((*المحلل).العمق >= حد_تعشيش_جسون()) {
            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.تعشيش_عميق_جدا(), موضع_القيمة));
        };
        (*المحلل).العمق := (*المحلل).العمق + 1;
        دع المتداخل: نتيجة قيمة_جسون, خطأ_جسون = حلل_مصفوفة_أو_كائن_جسون(المحلل, ب == 0x5B);
        (*المحلل).العمق := (*المحلل).العمق - 1;
        أرجع المتداخل;
    };
    لو ((ب == 0x2D) || رقم_عشري_جسون(ب)) {
        طابق حلل_رقم_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(قيمة_جسون.رقم(القيمة)); };
    };
    لو (طابق_حرفيا(المحلل, «true»)) { أرجع نتيجة.نجح(قيمة_جسون.منطق(صواب)); };
    لو (طابق_حرفيا(المحلل, «false»)) { أرجع نتيجة.نجح(قيمة_جسون.منطق(خطأ)); };
    لو (طابق_حرفيا(المحلل, «null»)) { أرجع نتيجة.نجح(قيمة_جسون.عدم()); };
    أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), موضع_القيمة));
}

عام عرف حلل_جسون(النص: &نص): نتيجة وثيقة_جسون, خطأ_جسون {
    // The parser owns a copy of the input; the document owns what it builds.
    دع القيمة_النصية: نص = انسخ_نص(النص);
    دع المصفوفات_الفارغة: متجه مصفوفة_جسون = [];
    دع الكائنات_الفارغة: متجه كائن_جسون = [];
    دع المحلل: متغير محلل_جسون = { النص: القيمة_النصية, الموضع: 0, المصفوفات: المصفوفات_الفارغة, الكائنات: الكائنات_الفارغة, العمق: 0 };
    دع الجذر: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق حلل_قيمة_جسون(&متغير المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الجذر := القيمة; };
    تجاوز_فراغ_جسون(&متغير المحلل);
    لو (المحلل.الموضع != (الطول(المحلل.النص) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نص_لاحق(), المحلل.الموضع)); };
    دع المصفوفات: متغير متجه مصفوفة_جسون = [];
    بدّل(المحلل.المصفوفات, المصفوفات);
    دع الكائنات: متغير متجه كائن_جسون = [];
    بدّل(المحلل.الكائنات, الكائنات);
    دع الوثيقة: وثيقة_جسون = { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: الكائنات };
    أرجع نتيجة.نجح(الوثيقة);
}

عام مرادف parse_json = حلل_جسون;
