استورد json.value;
استورد collections.text_index_map;
استورد text.substring;
استورد text.compare;
استورد text.from_bytes;
استورد encoding.utf8;

نوع محلل_جسون = {
    النص: نص,
    الموضع: غير_موقع,
    المصفوفات: متجه مصفوفة_جسون,
    الكائنات: متجه كائن_جسون
};

عرف خطأ_عند(الصنف: صنف_خطأ_جسون, الموضع: غير_موقع): خطأ_جسون {
    دع الخطأ: خطأ_جسون = { الصنف: الصنف, الإزاحة: الموضع };
    أرجع الخطأ;
}

عرف تجاوز_فراغ_جسون(المحلل: &متغير محلل_جسون): فراغ {
    دع الحالة: متغير محلل_جسون = *المحلل;
    دع العدد: غير_موقع = الطول(الحالة.النص) مثل غير_موقع;
    دع مستمر: متغير منطقي = صواب;
    بينما ((الحالة.الموضع < العدد) && مستمر) {
        دع ب: غ8 = الحالة.النص[الحالة.الموضع];
        لو ((ب == 0x20) || (ب == 0x09) || (ب == 0x0A) || (ب == 0x0D)) {
            الحالة.الموضع := الحالة.الموضع + 1;
        } وإلا { مستمر := خطأ; };
    }
    *المحلل := الحالة;
}

عرف طابق_حرفيا(المحلل: &متغير محلل_جسون, الحرفي: نص): منطقي {
    دع الحالة: متغير محلل_جسون = *المحلل;
    دع الهدف: نص = الحرفي;
    دع العدد: غير_موقع = الطول(الهدف) مثل غير_موقع;
    لو ((الحالة.الموضع + العدد) > (الطول(الحالة.النص) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع موضع_الحرف: غير_موقع = الحالة.الموضع + ف;
        لو (الحالة.النص[موضع_الحرف] != الهدف[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    الحالة.الموضع := الحالة.الموضع + العدد;
    *المحلل := الحالة;
    أرجع صواب;
}

عرف قيمة_سداسية(البايت: غ8): اختيار غ32 {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع اختيار.بعض((البايت - 0x30) مثل غ32); };
    لو ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع اختيار.بعض(((البايت - 0x41) مثل غ32) + 10); };
    لو ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع اختيار.بعض(((البايت - 0x61) مثل غ32) + 10); };
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_سداسي4(المحلل: &متغير محلل_جسون): نتيجة غ32, خطأ_جسون {
    دع الحالة: متغير محلل_جسون = *المحلل;
    لو ((الحالة.الموضع + 4) > (الطول(الحالة.النص) مثل غير_موقع)) {
        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), الحالة.الموضع));
    };
    دع القيمة: متغير غ32 = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع موضع_الرقم: غير_موقع = الحالة.الموضع + ف;
        طابق قيمة_سداسية(الحالة.النص[موضع_الرقم]) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), موضع_الرقم)); }
        | اختيار.بعض(الرقم) -> { القيمة := (القيمة << 4) | الرقم; };
        ف := ف + 1;
    }
    الحالة.الموضع := الحالة.الموضع + 4;
    *المحلل := الحالة;
    أرجع نتيجة.نجح(القيمة);
}

عرف ألحق_سلم_جسون(البايتات: &متغير متجه غ8, القيمة: غ32): منطقي {
    دع الحالية: متجه غ8 = *البايتات;
    طابق ألحق_محرف_يوتيف8(الحالية, القيمة) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع خطأ; }
    | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { *البايتات := الناتج; أرجع صواب; };
}

عرف حلل_سلسلة_جسون(المحلل: &متغير محلل_جسون): نتيجة نص, خطأ_جسون {
    دع الحالة0: محلل_جسون = *المحلل;
    لو ((الحالة0.الموضع >= (الطول(الحالة0.النص) مثل غير_موقع)) || (الحالة0.النص[الحالة0.الموضع] != 0x22)) {
        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), الحالة0.الموضع));
    };
    دع الحالة: متغير محلل_جسون = الحالة0;
    الحالة.الموضع := الحالة.الموضع + 1;
    دع البايتات: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(الحالة.النص) مثل غير_موقع;
    بينما (الحالة.الموضع < العدد) {
        دع ب: غ8 = الحالة.النص[الحالة.الموضع];
        لو (ب == 0x22) {
            الحالة.الموضع := الحالة.الموضع + 1;
            *المحلل := الحالة;
            أرجع نتيجة.نجح(من_بايتات(&البايتات));
        };
        لو (ب < 0x20) {
            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), الحالة.الموضع));
        };
        لو (ب == 0x5C) {
            الحالة.الموضع := الحالة.الموضع + 1;
            لو (الحالة.الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), الحالة.الموضع)); };
            دع هـ: غ8 = الحالة.النص[الحالة.الموضع];
            الحالة.الموضع := الحالة.الموضع + 1;
            لو (هـ == 0x22) { ألحق(البايتات, 0x22); }
            وإلا لو (هـ == 0x5C) { ألحق(البايتات, 0x5C); }
            وإلا لو (هـ == 0x2F) { ألحق(البايتات, 0x2F); }
            وإلا لو (هـ == 0x62) { ألحق(البايتات, 0x08); }
            وإلا لو (هـ == 0x66) { ألحق(البايتات, 0x0C); }
            وإلا لو (هـ == 0x6E) { ألحق(البايتات, 0x0A); }
            وإلا لو (هـ == 0x72) { ألحق(البايتات, 0x0D); }
            وإلا لو (هـ == 0x74) { ألحق(البايتات, 0x09); }
            وإلا لو (هـ == 0x75) {
                *المحلل := الحالة;
                طابق اقرأ_سداسي4(المحلل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الأول) -> {
                    الحالة := *المحلل;
                    دع السلم: متغير غ32 = الأول;
                    لو ((الأول >= 0xD800) && (الأول <= 0xDBFF)) {
                        دع موضع_الهروب_التالي: غير_موقع = الحالة.الموضع + 1;
                        لو ((الحالة.الموضع + 2) > العدد || (الحالة.النص[الحالة.الموضع] != 0x5C) || (الحالة.النص[موضع_الهروب_التالي] != 0x75)) {
                            أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), الحالة.الموضع));
                        };
                        الحالة.الموضع := الحالة.الموضع + 2;
                        *المحلل := الحالة;
                        طابق اقرأ_سداسي4(المحلل) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(الثاني) -> {
                            الحالة := *المحلل;
                            لو ((الثاني < 0xDC00) || (الثاني > 0xDFFF)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), الحالة.الموضع)); };
                            السلم := 0x10000 + ((الأول - 0xD800) << 10) + (الثاني - 0xDC00);
                        };
                    } وإلا لو ((الأول >= 0xDC00) && (الأول <= 0xDFFF)) {
                        أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), الحالة.الموضع));
                    };
                    لو (!ألحق_سلم_جسون(&متغير البايتات, السلم)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.هروب_يونيكود_غير_صالح(), الحالة.الموضع)); };
                };
            } وإلا {
                أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.محرف_هروب_غير_صالح(), الحالة.الموضع - 1));
            };
        } وإلا لو (ب < 0x80) {
            ألحق(البايتات, ب);
            الحالة.الموضع := الحالة.الموضع + 1;
        } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&الحالة.النص, الحالة.الموضع);
            لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.يوتيف8_غير_صالح(), الحالة.الموضع)); };
            دع نهاية: غير_موقع = الحالة.الموضع + المفكوك.العرض;
            بينما (الحالة.الموضع < نهاية) {
                ألحق(البايتات, الحالة.النص[الحالة.الموضع]);
                الحالة.الموضع := الحالة.الموضع + 1;
            }
        };
    }
    أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), الحالة.الموضع));
}

عرف رقم_عشري_جسون(ب: غ8): منطقي { أرجع (ب >= 0x30) && (ب <= 0x39); }

عرف حلل_رقم_جسون(المحلل: &متغير محلل_جسون): نتيجة نص, خطأ_جسون {
    دع الحالة: متغير محلل_جسون = *المحلل;
    دع البداية: غير_موقع = الحالة.الموضع;
    دع العدد: غير_موقع = الطول(الحالة.النص) مثل غير_موقع;
    لو ((الحالة.الموضع < العدد) && (الحالة.النص[الحالة.الموضع] == 0x2D)) { الحالة.الموضع := الحالة.الموضع + 1; };
    لو (الحالة.الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), البداية)); };
    لو (الحالة.النص[الحالة.الموضع] == 0x30) {
        الحالة.الموضع := الحالة.الموضع + 1;
        لو ((الحالة.الموضع < العدد) && رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), الحالة.الموضع)); };
    } وإلا {
        لو ((الحالة.النص[الحالة.الموضع] < 0x31) || (الحالة.النص[الحالة.الموضع] > 0x39)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), الحالة.الموضع)); };
        بينما ((الحالة.الموضع < العدد) && رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { الحالة.الموضع := الحالة.الموضع + 1; }
    };
    لو ((الحالة.الموضع < العدد) && (الحالة.النص[الحالة.الموضع] == 0x2E)) {
        الحالة.الموضع := الحالة.الموضع + 1;
        لو ((الحالة.الموضع >= العدد) || !رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), الحالة.الموضع)); };
        بينما ((الحالة.الموضع < العدد) && رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { الحالة.الموضع := الحالة.الموضع + 1; }
    };
    لو ((الحالة.الموضع < العدد) && ((الحالة.النص[الحالة.الموضع] == 0x65) || (الحالة.النص[الحالة.الموضع] == 0x45))) {
        الحالة.الموضع := الحالة.الموضع + 1;
        لو ((الحالة.الموضع < العدد) && ((الحالة.النص[الحالة.الموضع] == 0x2B) || (الحالة.النص[الحالة.الموضع] == 0x2D))) { الحالة.الموضع := الحالة.الموضع + 1; };
        لو ((الحالة.الموضع >= العدد) || !رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), الحالة.الموضع)); };
        بينما ((الحالة.الموضع < العدد) && رقم_عشري_جسون(الحالة.النص[الحالة.الموضع])) { الحالة.الموضع := الحالة.الموضع + 1; }
    };
    دع النهاية: غير_موقع = الحالة.الموضع;
    طابق مقطع_نص(&الحالة.النص, البداية, النهاية - البداية) مع
    | اختيار.بعض(القيمة) -> { *المحلل := الحالة; أرجع نتيجة.نجح(القيمة); }
    | اختيار.لا_شيء -> { *المحلل := الحالة; أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رقم_غير_صالح(), البداية)); };
}

عرف حلل_مصفوفة_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    دع الحالة0: متغير محلل_جسون = *المحلل;
    الحالة0.الموضع := الحالة0.الموضع + 1;
    *المحلل := الحالة0;
    تجاوز_فراغ_جسون(المحلل);
    دع القيم: متغير متجه قيمة_جسون = [];
    دع الحالة1: محلل_جسون = *المحلل;
    لو ((الحالة1.الموضع < (الطول(الحالة1.النص) مثل غير_موقع)) && (الحالة1.النص[الحالة1.الموضع] == 0x5D)) {
        دع نهاية: متغير محلل_جسون = الحالة1; نهاية.الموضع := نهاية.الموضع + 1;
        دع الفهرس: غير_موقع = الطول(نهاية.المصفوفات) مثل غير_موقع;
        دع صف: مصفوفة_جسون = { القيم: القيم }; ألحق(نهاية.المصفوفات, صف); *المحلل := نهاية;
        أرجع نتيجة.نجح(قيمة_جسون.مصفوفة(الفهرس));
    };
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق حلل_قيمة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        تجاوز_فراغ_جسون(المحلل);
        دع الحالة: متغير محلل_جسون = *المحلل;
        لو (الحالة.الموضع >= (الطول(الحالة.النص) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), الحالة.الموضع)); };
        دع ب: غ8 = الحالة.النص[الحالة.الموضع];
        لو (ب == 0x5D) { الحالة.الموضع := الحالة.الموضع + 1; *المحلل := الحالة; مستمر := خطأ; }
        وإلا لو (ب == 0x2C) { الحالة.الموضع := الحالة.الموضع + 1; *المحلل := الحالة; تجاوز_فراغ_جسون(المحلل); }
        وإلا { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), الحالة.الموضع)); };
    }
    دع النهاية: متغير محلل_جسون = *المحلل;
    دع الفهرس: غير_موقع = الطول(النهاية.المصفوفات) مثل غير_موقع;
    دع صف: مصفوفة_جسون = { القيم: القيم }; ألحق(النهاية.المصفوفات, صف); *المحلل := النهاية;
    أرجع نتيجة.نجح(قيمة_جسون.مصفوفة(الفهرس));
}

عرف حلل_كائن_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    دع الحالة0: متغير محلل_جسون = *المحلل; الحالة0.الموضع := الحالة0.الموضع + 1; *المحلل := الحالة0;
    تجاوز_فراغ_جسون(المحلل);
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];
    دع الفهرس: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الحالة1: محلل_جسون = *المحلل;
    لو ((الحالة1.الموضع < (الطول(الحالة1.النص) مثل غير_موقع)) && (الحالة1.النص[الحالة1.الموضع] == 0x7D)) {
        دع نهاية: متغير محلل_جسون = الحالة1; نهاية.الموضع := نهاية.الموضع + 1;
        دع موضع_الكائن: غير_موقع = الطول(نهاية.الكائنات) مثل غير_موقع;
        دع ك: كائن_جسون = { المداخل: المداخل, الفهرس: الفهرس }; ألحق(نهاية.الكائنات, ك); *المحلل := نهاية;
        أرجع نتيجة.نجح(قيمة_جسون.كائن(موضع_الكائن));
    };
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع قبل: محلل_جسون = *المحلل;
        لو ((قبل.الموضع >= (الطول(قبل.النص) مثل غير_موقع)) || (قبل.النص[قبل.الموضع] != 0x22)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), قبل.الموضع)); };
        دع المفتاح: متغير نص = «»;
        طابق حلل_سلسلة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { المفتاح := القيمة; };
        تجاوز_فراغ_جسون(المحلل);
        دع فاصلة: متغير محلل_جسون = *المحلل;
        لو ((فاصلة.الموضع >= (الطول(فاصلة.النص) مثل غير_موقع)) || (فاصلة.النص[فاصلة.الموضع] != 0x3A)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), فاصلة.الموضع)); };
        فاصلة.الموضع := فاصلة.الموضع + 1; *المحلل := فاصلة; تجاوز_فراغ_جسون(المحلل);
        دع القيمة: متغير قيمة_جسون = قيمة_جسون.عدم();
        طابق حلل_قيمة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النتيجة) -> { القيمة := النتيجة; };
        دع موضع_جديد: غير_موقع = الطول(المداخل) مثل غير_موقع;
        دع مرجع_المفتاح: &نص = &المفتاح;
        دع مفتاح_الفهرس: نص = *مرجع_المفتاح;
        دع مفتاح_المدخل: نص = *مرجع_المفتاح;
        دع مفتاح_الإعادة: نص = *مرجع_المفتاح;
        طابق أدرج_في_خريطة_نص_فهرس(&متغير الفهرس, مفتاح_الفهرس, موضع_جديد) مع
        | اختيار.لا_شيء -> {
            دع مدخل: مدخل_كائن_جسون = { المفتاح: مفتاح_المدخل, القيمة: القيمة };
            ألحق(المداخل, مدخل);
        }
        | اختيار.بعض(قديم) -> {
            دع مدخل: مدخل_كائن_جسون = { المفتاح: مفتاح_المدخل, القيمة: القيمة };
            المداخل[قديم] := مدخل;
            أدرج_في_خريطة_نص_فهرس(&متغير الفهرس, مفتاح_الإعادة, قديم);
        };
        تجاوز_فراغ_جسون(المحلل);
        دع الحالة: متغير محلل_جسون = *المحلل;
        لو (الحالة.الموضع >= (الطول(الحالة.النص) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), الحالة.الموضع)); };
        دع ب: غ8 = الحالة.النص[الحالة.الموضع];
        لو (ب == 0x7D) { الحالة.الموضع := الحالة.الموضع + 1; *المحلل := الحالة; مستمر := خطأ; }
        وإلا لو (ب == 0x2C) { الحالة.الموضع := الحالة.الموضع + 1; *المحلل := الحالة; تجاوز_فراغ_جسون(المحلل); }
        وإلا { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), الحالة.الموضع)); };
    }
    دع النهاية: متغير محلل_جسون = *المحلل;
    دع موضع_الكائن: غير_موقع = الطول(النهاية.الكائنات) مثل غير_موقع;
    دع ك: كائن_جسون = { المداخل: المداخل, الفهرس: الفهرس }; ألحق(النهاية.الكائنات, ك); *المحلل := النهاية;
    أرجع نتيجة.نجح(قيمة_جسون.كائن(موضع_الكائن));
}

عرف حلل_قيمة_جسون(المحلل: &متغير محلل_جسون): نتيجة قيمة_جسون, خطأ_جسون {
    تجاوز_فراغ_جسون(المحلل);
    دع الحالة: محلل_جسون = *المحلل;
    لو (الحالة.الموضع >= (الطول(الحالة.النص) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نهاية_غير_متوقعة(), الحالة.الموضع)); };
    دع ب: غ8 = الحالة.النص[الحالة.الموضع];
    لو (ب == 0x22) {
        طابق حلل_سلسلة_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(قيمة_جسون.سلسلة(القيمة)); };
    };
    لو (ب == 0x5B) { أرجع حلل_مصفوفة_جسون(المحلل); };
    لو (ب == 0x7B) { أرجع حلل_كائن_جسون(المحلل); };
    لو ((ب == 0x2D) || رقم_عشري_جسون(ب)) {
        طابق حلل_رقم_جسون(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(قيمة_جسون.رقم(القيمة)); };
    };
    لو (طابق_حرفيا(المحلل, «true»)) { أرجع نتيجة.نجح(قيمة_جسون.منطق(صواب)); };
    لو (طابق_حرفيا(المحلل, «false»)) { أرجع نتيجة.نجح(قيمة_جسون.منطق(خطأ)); };
    لو (طابق_حرفيا(المحلل, «null»)) { أرجع نتيجة.نجح(قيمة_جسون.عدم()); };
    أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.رمز_غير_متوقع(), الحالة.الموضع));
}

عام عرف حلل_جسون(النص: &نص): نتيجة وثيقة_جسون, خطأ_جسون {
    دع القيمة_النصية: نص = *النص;
    دع المصفوفات_الفارغة: متجه مصفوفة_جسون = [];
    دع الكائنات_الفارغة: متجه كائن_جسون = [];
    دع المحلل: متغير محلل_جسون = { النص: القيمة_النصية, الموضع: 0, المصفوفات: المصفوفات_الفارغة, الكائنات: الكائنات_الفارغة };
    دع الجذر: متغير قيمة_جسون = قيمة_جسون.عدم();
    طابق حلل_قيمة_جسون(&متغير المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الجذر := القيمة; };
    تجاوز_فراغ_جسون(&متغير المحلل);
    لو (المحلل.الموضع != (الطول(المحلل.النص) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عند(صنف_خطأ_جسون.نص_لاحق(), المحلل.الموضع)); };
    دع مرجع_المصفوفات: &متجه مصفوفة_جسون = &المحلل.المصفوفات;
    دع المصفوفات: متجه مصفوفة_جسون = *مرجع_المصفوفات;
    دع مرجع_الكائنات: &متجه كائن_جسون = &المحلل.الكائنات;
    دع الكائنات: متجه كائن_جسون = *مرجع_الكائنات;
    دع الوثيقة: وثيقة_جسون = { الجذر: الجذر, المصفوفات: المصفوفات, الكائنات: الكائنات };
    أرجع نتيجة.نجح(الوثيقة);
}

عام مرادف parse_json = حلل_جسون;
