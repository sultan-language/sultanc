استورد collections.text_index_map;

عام نوع قيمة_جسون =
    | عدم
    | منطق بنوع منطقي
    | رقم بنوع نص
    | سلسلة بنوع نص
    | مصفوفة بنوع غير_موقع
    | كائن بنوع غير_موقع
;

عام نوع مدخل_كائن_جسون = {
    المفتاح: نص,
    القيمة: قيمة_جسون
};

عام نوع مصفوفة_جسون = {
    القيم: متجه قيمة_جسون
};

عام نوع كائن_جسون = {
    المداخل: متجه مدخل_كائن_جسون,
    الفهرس: خريطة_نص_فهرس
};

عام نوع وثيقة_جسون = {
    الجذر: قيمة_جسون,
    المصفوفات: متجه مصفوفة_جسون,
    الكائنات: متجه كائن_جسون
};

عام نوع صنف_خطأ_جسون =
    | نهاية_غير_متوقعة
    | رمز_غير_متوقع
    | محرف_هروب_غير_صالح
    | هروب_يونيكود_غير_صالح
    | يوتيف8_غير_صالح
    | رقم_غير_صالح
    | نص_لاحق
;

عام نوع خطأ_جسون = {
    الصنف: صنف_خطأ_جسون,
    الإزاحة: غير_موقع
};

عام عرف انسخ_قيمة_جسون(القيمة: &قيمة_جسون): قيمة_جسون {
    طابق *القيمة مع
    | قيمة_جسون.عدم -> { أرجع قيمة_جسون.عدم(); }
    | قيمة_جسون.منطق(المنطق) -> { أرجع قيمة_جسون.منطق(المنطق); }
    | قيمة_جسون.رقم(النص) -> { أرجع قيمة_جسون.رقم(النص); }
    | قيمة_جسون.سلسلة(النص) -> { أرجع قيمة_جسون.سلسلة(النص); }
    | قيمة_جسون.مصفوفة(الفهرس) -> { أرجع قيمة_جسون.مصفوفة(الفهرس); }
    | قيمة_جسون.كائن(الفهرس) -> { أرجع قيمة_جسون.كائن(الفهرس); };
}

عام عرف جذر_وثيقة_جسون(الوثيقة: &وثيقة_جسون): قيمة_جسون {
    دع القيمة: وثيقة_جسون = *الوثيقة;
    أرجع انسخ_قيمة_جسون(&القيمة.الجذر);
}

عام عرف طول_مصفوفة_جسون(الوثيقة: &وثيقة_جسون, الفهرس: غير_موقع): اختيار غير_موقع {
    دع القيمة: وثيقة_جسون = *الوثيقة;
    لو (الفهرس >= (الطول(القيمة.المصفوفات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الطول(القيمة.المصفوفات[الفهرس].القيم) مثل غير_موقع);
}

عام عرف عنصر_مصفوفة_جسون(
    الوثيقة: &وثيقة_جسون,
    الفهرس: غير_موقع,
    الموضع: غير_موقع
): اختيار قيمة_جسون {
    دع القيمة: وثيقة_جسون = *الوثيقة;
    لو (الفهرس >= (الطول(القيمة.المصفوفات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو (الموضع >= (الطول(القيمة.المصفوفات[الفهرس].القيم) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع العنصر: قيمة_جسون = انسخ_قيمة_جسون(&القيمة.المصفوفات[الفهرس].القيم[الموضع]);
    أرجع اختيار.بعض(العنصر);
}

عام عرف طول_كائن_جسون(الوثيقة: &وثيقة_جسون, الفهرس: غير_موقع): اختيار غير_موقع {
    دع القيمة: وثيقة_جسون = *الوثيقة;
    لو (الفهرس >= (الطول(القيمة.الكائنات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الطول(القيمة.الكائنات[الفهرس].المداخل) مثل غير_موقع);
}

عام عرف قيمة_مفتاح_جسون(
    الوثيقة: &وثيقة_جسون,
    الفهرس: غير_موقع,
    المفتاح: &نص
): اختيار قيمة_جسون {
    دع القيمة: وثيقة_جسون = *الوثيقة;
    لو (الفهرس >= (الطول(القيمة.الكائنات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    طابق ابحث_في_خريطة_نص_فهرس(&القيمة.الكائنات[الفهرس].الفهرس, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        لو (الموضع >= (الطول(القيمة.الكائنات[الفهرس].المداخل) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        دع قيمة_المدخل: قيمة_جسون = انسخ_قيمة_جسون(&القيمة.الكائنات[الفهرس].المداخل[الموضع].القيمة);
        أرجع اختيار.بعض(قيمة_المدخل);
    };
}

عام مرادف json_value = قيمة_جسون;
عام مرادف json_object_entry = مدخل_كائن_جسون;
عام مرادف json_array = مصفوفة_جسون;
عام مرادف json_object = كائن_جسون;
عام مرادف json_document = وثيقة_جسون;
عام مرادف json_error_kind = صنف_خطأ_جسون;
عام مرادف json_error = خطأ_جسون;
عام مرادف json_root = جذر_وثيقة_جسون;
عام مرادف json_array_length = طول_مصفوفة_جسون;
عام مرادف json_array_get = عنصر_مصفوفة_جسون;
عام مرادف json_object_length = طول_كائن_جسون;
عام مرادف json_object_get = قيمة_مفتاح_جسون;

عام مرادف json_value.null = قيمة_جسون.عدم;
عام مرادف json_value.boolean = قيمة_جسون.منطق;
عام مرادف json_value.number = قيمة_جسون.رقم;
عام مرادف json_value.string = قيمة_جسون.سلسلة;
عام مرادف json_value.array = قيمة_جسون.مصفوفة;
عام مرادف json_value.object = قيمة_جسون.كائن;
عام مرادف json_error_kind.unexpected_eof = صنف_خطأ_جسون.نهاية_غير_متوقعة;
عام مرادف json_error_kind.unexpected_token = صنف_خطأ_جسون.رمز_غير_متوقع;
عام مرادف json_error_kind.invalid_escape = صنف_خطأ_جسون.محرف_هروب_غير_صالح;
عام مرادف json_error_kind.invalid_unicode_escape = صنف_خطأ_جسون.هروب_يونيكود_غير_صالح;
عام مرادف json_error_kind.invalid_utf8 = صنف_خطأ_جسون.يوتيف8_غير_صالح;
عام مرادف json_error_kind.invalid_number = صنف_خطأ_جسون.رقم_غير_صالح;
عام مرادف json_error_kind.trailing_text = صنف_خطأ_جسون.نص_لاحق;
