استورد json.value;
استورد text.from_bytes;
استورد json.escape;

عرف ألحق_نص_جسون(الناتج: &متغير متجه ط8, النص: نص): فراغ {
    دع القيمة: نص = النص;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        ألحق(*الناتج, القيمة[ف]);
        ف := ف + 1;
    }
}

عرف رقم_جسون_صالح(النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    لو (القيمة[ف] == 0x2D) { ف := ف + 1; لو (ف >= العدد) { أرجع خطأ; }; };
    لو (القيمة[ف] == 0x30) { ف := ف + 1; لو ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { أرجع خطأ; }; }
    وإلا {
        لو ((القيمة[ف] < 0x31) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        طالما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    لو ((ف < العدد) && (القيمة[ف] == 0x2E)) {
        ف := ف + 1;
        لو ((ف >= العدد) || (القيمة[ف] < 0x30) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        طالما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    لو ((ف < العدد) && ((القيمة[ف] == 0x65) || (القيمة[ف] == 0x45))) {
        ف := ف + 1;
        لو ((ف < العدد) && ((القيمة[ف] == 0x2B) || (القيمة[ف] == 0x2D))) { ف := ف + 1; };
        لو ((ف >= العدد) || (القيمة[ف] < 0x30) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        طالما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    أرجع ف == العدد;
}

// Appends a borrowed text's bytes.
عرف ألحق_مرجع_نص_جسون(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(*الناتج, (*النص)[ف]);
        ف := ف + 1;
    }
}

// Writing only reads the document: values, arrays and objects are borrowed.
عرف اكتب_قيمة_جسون(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, الناتج: &متغير متجه ط8): منطقي {
    طابق *القيمة مع
    | قيمة_جسون.عدم -> { ألحق_نص_جسون(الناتج, «null»); أرجع صواب; }
    | قيمة_جسون.منطق(ب) -> {
        لو (ب) { ألحق_نص_جسون(الناتج, «true»); } وإلا { ألحق_نص_جسون(الناتج, «false»); };
        أرجع صواب;
    }
    | قيمة_جسون.رقم(الرقم) -> {
        لو (!رقم_جسون_صالح(&الرقم)) { أرجع خطأ; };
        ألحق_مرجع_نص_جسون(الناتج, &الرقم); أرجع صواب;
    }
    | قيمة_جسون.سلسلة(النص) -> { أرجع ألحق_سلسلة_جسون(الناتج, &النص); }
    | قيمة_جسون.مصفوفة(الفهرس) -> {
        لو (الفهرس >= (الطول((*الوثيقة).المصفوفات) مثل طبيعي)) { أرجع خطأ; };
        دع الصف: &مصفوفة_جسون = &(*الوثيقة).المصفوفات[الفهرس];
        ألحق(*الناتج, 0x5B);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الصف).القيم) مثل طبيعي)) {
            لو (ف > 0) { ألحق(*الناتج, 0x2C); };
            لو (!اكتب_قيمة_جسون(الوثيقة, &(*الصف).القيم[ف], الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق(*الناتج, 0x5D);
        أرجع صواب;
    }
    | قيمة_جسون.كائن(الفهرس) -> {
        لو (الفهرس >= (الطول((*الوثيقة).الكائنات) مثل طبيعي)) { أرجع خطأ; };
        دع الكائن: &كائن_جسون = &(*الوثيقة).الكائنات[الفهرس];
        ألحق(*الناتج, 0x7B);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الكائن).المداخل) مثل طبيعي)) {
            لو (ف > 0) { ألحق(*الناتج, 0x2C); };
            دع المدخل: &مدخل_كائن_جسون = &(*الكائن).المداخل[ف];
            لو (!ألحق_سلسلة_جسون(الناتج, &(*المدخل).المفتاح)) { أرجع خطأ; };
            ألحق(*الناتج, 0x3A);
            لو (!اكتب_قيمة_جسون(الوثيقة, &(*المدخل).القيمة, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق(*الناتج, 0x7D);
        أرجع صواب;
    };
}

عام عرف جسون_إلى_نص(الوثيقة: &وثيقة_جسون): نتيجة نص, صنف_خطأ_جسون {
    دع البايتات: متغير متجه ط8 = [];
    لو (!اكتب_قيمة_جسون(الوثيقة, &(*الوثيقة).الجذر, &متغير البايتات)) { أرجع نتيجة.خطأ(صنف_خطأ_جسون.رمز_غير_متوقع()); };
    أرجع نتيجة.نجح(البايتات مثل نص);
}

عام مرادف stringify_json = جسون_إلى_نص;
