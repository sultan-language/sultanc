استورد json.value;
استورد text.from_bytes;
استورد encoding.utf8;

عرف ألحق_بايت_جسون(الناتج: &متغير متجه غ8, البايت: غ8): فراغ {
    دع الحالية: متغير متجه غ8 = *الناتج;
    ألحق(الحالية, البايت);
    *الناتج := الحالية;
}

عرف ألحق_نص_جسون(الناتج: &متغير متجه غ8, النص: نص): فراغ {
    دع القيمة: نص = النص;
    دع الحالية: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        ألحق(الحالية, القيمة[ف]);
        ف := ف + 1;
    }
    *الناتج := الحالية;
}

عرف رقم_سداسي_جسون(القيمة: غ8): غ8 {
    لو (القيمة < 10) { أرجع 0x30 + القيمة; };
    أرجع 0x41 + (القيمة - 10);
}

عرف ألحق_سلسلة_جسون(الناتج: &متغير متجه غ8, النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    ألحق_بايت_جسون(الناتج, 0x22);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ب: غ8 = القيمة[ف];
        لو (ب == 0x22) { ألحق_بايتات_نص(الناتج, «\\\"»); ف := ف + 1; }
        وإلا لو (ب == 0x5C) { ألحق_بايتات_نص(الناتج, «\\\\»); ف := ف + 1; }
        وإلا لو (ب == 0x08) { ألحق_بايتات_نص(الناتج, «\\b»); ف := ف + 1; }
        وإلا لو (ب == 0x0C) { ألحق_بايتات_نص(الناتج, «\\f»); ف := ف + 1; }
        وإلا لو (ب == 0x0A) { ألحق_بايتات_نص(الناتج, «\\n»); ف := ف + 1; }
        وإلا لو (ب == 0x0D) { ألحق_بايتات_نص(الناتج, «\\r»); ف := ف + 1; }
        وإلا لو (ب == 0x09) { ألحق_بايتات_نص(الناتج, «\\t»); ف := ف + 1; }
        وإلا لو (ب < 0x20) {
            دع بادئة_الهروب: متجه غ8 = بايتات_من_نص(«\\u00»);
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(بادئة_الهروب) مثل غير_موقع)) { ألحق_بايت_جسون(الناتج, بادئة_الهروب[ح]); ح := ح + 1; }
            ألحق_بايت_جسون(الناتج, رقم_سداسي_جسون((ب >> 4) & 0x0F));
            ألحق_بايت_جسون(الناتج, رقم_سداسي_جسون(ب & 0x0F));
            ف := ف + 1;
        } وإلا لو (ب < 0x80) {
            ألحق_بايت_جسون(الناتج, ب); ف := ف + 1;
        } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
            لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع خطأ; };
            دع النهاية: غير_موقع = ف + المفكوك.العرض;
            بينما (ف < النهاية) { ألحق_بايت_جسون(الناتج, القيمة[ف]); ف := ف + 1; }
        };
    }
    ألحق_بايت_جسون(الناتج, 0x22);
    أرجع صواب;
}

عرف رقم_جسون_صالح(النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    لو (القيمة[ف] == 0x2D) { ف := ف + 1; لو (ف >= العدد) { أرجع خطأ; }; };
    لو (القيمة[ف] == 0x30) { ف := ف + 1; لو ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { أرجع خطأ; }; }
    وإلا {
        لو ((القيمة[ف] < 0x31) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        بينما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    لو ((ف < العدد) && (القيمة[ف] == 0x2E)) {
        ف := ف + 1;
        لو ((ف >= العدد) || (القيمة[ف] < 0x30) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        بينما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    لو ((ف < العدد) && ((القيمة[ف] == 0x65) || (القيمة[ف] == 0x45))) {
        ف := ف + 1;
        لو ((ف < العدد) && ((القيمة[ف] == 0x2B) || (القيمة[ف] == 0x2D))) { ف := ف + 1; };
        لو ((ف >= العدد) || (القيمة[ف] < 0x30) || (القيمة[ف] > 0x39)) { أرجع خطأ; };
        بينما ((ف < العدد) && (القيمة[ف] >= 0x30) && (القيمة[ف] <= 0x39)) { ف := ف + 1; }
    };
    أرجع ف == العدد;
}

عرف انسخ_مصفوفة_جسون_للكتابة(القيمة: &مصفوفة_جسون): مصفوفة_جسون {
    دع النسخة: مصفوفة_جسون = *القيمة;
    أرجع النسخة;
}

عرف انسخ_كائن_جسون_للكتابة(القيمة: &كائن_جسون): كائن_جسون {
    دع النسخة: كائن_جسون = *القيمة;
    أرجع النسخة;
}

عرف انسخ_مدخل_جسون_للكتابة(القيمة: &مدخل_كائن_جسون): مدخل_كائن_جسون {
    دع النسخة: مدخل_كائن_جسون = *القيمة;
    أرجع النسخة;
}

عرف اكتب_قيمة_جسون(الوثيقة: &وثيقة_جسون, القيمة: قيمة_جسون, الناتج: &متغير متجه غ8): منطقي {
    دع د: وثيقة_جسون = *الوثيقة;
    طابق القيمة مع
    | قيمة_جسون.عدم -> { ألحق_نص_جسون(الناتج, «null»); أرجع صواب; }
    | قيمة_جسون.منطق(ب) -> {
        لو (ب) { ألحق_نص_جسون(الناتج, «true»); } وإلا { ألحق_نص_جسون(الناتج, «false»); };
        أرجع صواب;
    }
    | قيمة_جسون.رقم(الرقم) -> {
        لو (!رقم_جسون_صالح(&الرقم)) { أرجع خطأ; };
        ألحق_نص_جسون(الناتج, الرقم); أرجع صواب;
    }
    | قيمة_جسون.سلسلة(النص) -> { أرجع ألحق_سلسلة_جسون(الناتج, &النص); }
    | قيمة_جسون.مصفوفة(الفهرس) -> {
        لو (الفهرس >= (الطول(د.المصفوفات) مثل غير_موقع)) { أرجع خطأ; };
        دع الصف: مصفوفة_جسون = انسخ_مصفوفة_جسون_للكتابة(&د.المصفوفات[الفهرس]);
        ألحق_بايت_جسون(الناتج, 0x5B);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الصف.القيم) مثل غير_موقع)) {
            لو (ف > 0) { ألحق_بايت_جسون(الناتج, 0x2C); };
            دع قيمة_الصف: قيمة_جسون = انسخ_قيمة_جسون(&الصف.القيم[ف]);
            لو (!اكتب_قيمة_جسون(&د, قيمة_الصف, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق_بايت_جسون(الناتج, 0x5D);
        أرجع صواب;
    }
    | قيمة_جسون.كائن(الفهرس) -> {
        لو (الفهرس >= (الطول(د.الكائنات) مثل غير_موقع)) { أرجع خطأ; };
        دع الكائن: كائن_جسون = انسخ_كائن_جسون_للكتابة(&د.الكائنات[الفهرس]);
        ألحق_بايت_جسون(الناتج, 0x7B);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الكائن.المداخل) مثل غير_موقع)) {
            لو (ف > 0) { ألحق_بايت_جسون(الناتج, 0x2C); };
            دع المدخل: مدخل_كائن_جسون = انسخ_مدخل_جسون_للكتابة(&الكائن.المداخل[ف]);
            دع قيمة_المدخل: قيمة_جسون = انسخ_قيمة_جسون(&المدخل.القيمة);
            لو (!ألحق_سلسلة_جسون(الناتج, &المدخل.المفتاح)) { أرجع خطأ; };
            ألحق_بايت_جسون(الناتج, 0x3A);
            لو (!اكتب_قيمة_جسون(&د, قيمة_المدخل, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق_بايت_جسون(الناتج, 0x7D);
        أرجع صواب;
    };
}

عام عرف جسون_إلى_نص(الوثيقة: &وثيقة_جسون): نتيجة نص, صنف_خطأ_جسون {
    دع د: وثيقة_جسون = *الوثيقة;
    دع الجذر: قيمة_جسون = انسخ_قيمة_جسون(&د.الجذر);
    دع البايتات: متغير متجه غ8 = [];
    لو (!اكتب_قيمة_جسون(&د, الجذر, &متغير البايتات)) { أرجع نتيجة.خطأ(صنف_خطأ_جسون.رمز_غير_متوقع()); };
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام مرادف stringify_json = جسون_إلى_نص;
