استورد encoding.utf8;
استورد text.from_bytes;

عرف ألحق_بايت_جسون(الناتج: &متغير متجه ط8, البايت: ط8): فراغ {
    ألحق(*الناتج, البايت);
}

عرف رقم_سداسي_جسون(القيمة: ط8, أصغر: منطقي): ط8 {
    لو (القيمة < 10) { أرجع 0x30 + القيمة; };
    لو (أصغر) { أرجع 0x61 + (القيمة - 10); };
    أرجع 0x41 + (القيمة - 10);
}

// The diagnostic mode preserves the historical raw-byte output, lowercase
// \u00XX escapes, and no Unicode validity rejection. Document serialization
// instead validates UTF-8 and uses JSON's short \b and \f escapes.
عام نوع نمط_هروب_سلسلة_جسون =
    | مستند
    | تشخيص
;

عام عرف ألحق_سلسلة_جسون_بنمط(
    الناتج: &متغير متجه ط8, النص: &نص, النمط: نمط_هروب_سلسلة_جسون
): منطقي {
    دع وضع_التشخيص: متغير منطقي = خطأ;
    طابق النمط مع
    | نمط_هروب_سلسلة_جسون.مستند -> { }
    | نمط_هروب_سلسلة_جسون.تشخيص -> { وضع_التشخيص := صواب; };
    دع القيمة: نص = *النص;
    ألحق_بايت_جسون(الناتج, 0x22);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        دع ب: ط8 = القيمة[ف];
        لو (ب == 0x22) { ألحق_بايتات_نص(الناتج, «\\\"»); ف := ف + 1; }
        وإلا لو (ب == 0x5C) { ألحق_بايتات_نص(الناتج, «\\\\»); ف := ف + 1; }
        وإلا لو (!وضع_التشخيص && ب == 0x08) { ألحق_بايتات_نص(الناتج, «\\b»); ف := ف + 1; }
        وإلا لو (!وضع_التشخيص && ب == 0x0C) { ألحق_بايتات_نص(الناتج, «\\f»); ف := ف + 1; }
        وإلا لو (ب == 0x0A) { ألحق_بايتات_نص(الناتج, «\\n»); ف := ف + 1; }
        وإلا لو (ب == 0x0D) { ألحق_بايتات_نص(الناتج, «\\r»); ف := ف + 1; }
        وإلا لو (ب == 0x09) { ألحق_بايتات_نص(الناتج, «\\t»); ف := ف + 1; }
        وإلا لو (ب < 0x20) {
            دع بادئة_الهروب: متجه ط8 = بايتات_من_نص(«\\u00»);
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(بادئة_الهروب) مثل طبيعي)) { ألحق_بايت_جسون(الناتج, بادئة_الهروب[ح]); ح := ح + 1; }
            ألحق_بايت_جسون(الناتج, رقم_سداسي_جسون((ب >> 4) & 0x0F, وضع_التشخيص));
            ألحق_بايت_جسون(الناتج, رقم_سداسي_جسون(ب & 0x0F, وضع_التشخيص));
            ف := ف + 1;
        } وإلا لو (ب < 0x80) {
            ألحق_بايت_جسون(الناتج, ب); ف := ف + 1;
        } وإلا لو (وضع_التشخيص) {
            ألحق_بايت_جسون(الناتج, ب); ف := ف + 1;
        } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
            لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع خطأ; };
            دع النهاية: طبيعي = ف + المفكوك.العرض;
            طالما (ف < النهاية) { ألحق_بايت_جسون(الناتج, القيمة[ف]); ف := ف + 1; }
        };
    }
    ألحق_بايت_جسون(الناتج, 0x22);
    أرجع صواب;
}


عام عرف ألحق_سلسلة_جسون(الناتج: &متغير متجه ط8, النص: &نص): منطقي {
    أرجع ألحق_سلسلة_جسون_بنمط(الناتج, النص, نمط_هروب_سلسلة_جسون.مستند());
}

عام مرادف json_escape_style = نمط_هروب_سلسلة_جسون;
عام مرادف append_json_escaped_string = ألحق_سلسلة_جسون;
عام مرادف append_json_escaped_string_with_style = ألحق_سلسلة_جسون_بنمط;
