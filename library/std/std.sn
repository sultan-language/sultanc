// The root file of the standard library (the package std, Arabic spelling
// المكتبة). It declares the spellings of std's top-level modules; an import
// may use any of them (`استورد المكتبة.دخ.اطبع_سطر;` is `import std.io.println;`).
// A folder's own root file, FOLDER/FOLDER.sn, declares its children's.

module io { ar: دخ, fr: entree_sortie, es: entrada_salida };
module fs { ar: ملفات, fr: fichiers, es: archivos };
module text { ar: نصوص, fr: texte, es: texto };
module memory { ar: ذاكرة, fr: memoire };
module net { ar: شبكة, fr: reseau, es: red };
module http { ar: ويب };
module debug { ar: تصحيح };
module error { ar: أخطاء };
module process { ar: عمليات };
module env { ar: بيئة };
module time { ar: وقت };
module testing { ar: اختبارات };
module async { ar: غير_متزامن };
module os { ar: نظام_التشغيل };
module sync { ar: تزامن };
module thread { ar: خيوط };
module tls { ar: تي_إل_إس };
module uri { ar: عنوان_موحد };
module uuid { ar: معرف_فريد };

// Re-exported: these children are modules and folders of alloc and core, at the same
// paths (docs/en/reference/std-layers.md). One file, one module.
module archive = alloc.archive { ar: أرشيف };
module bytes = alloc.bytes { ar: بايتات, fr: octets };
module checksum = alloc.checksum { ar: مجاميع_تحقق };
module collections = alloc.collections { ar: مجموعات };
module compression = alloc.compression { ar: ضغط };
module crypto = alloc.crypto { ar: تشفير };
module csv = alloc.csv { ar: سي_اس_في };
module encoding = alloc.encoding { ar: ترميز, fr: encodage };
module fmt = alloc.fmt { ar: تنسيق };
module fuzz = alloc.fuzz { ar: فز };
module json = alloc.json { ar: جسون };
module math = alloc.math { ar: رياضيات };
module mime = alloc.mime { ar: أنواع_وسائط };
module toml = alloc.toml { ar: تومل };
module unicode = alloc.unicode { ar: يونيكود };
module version = alloc.version { ar: إصدار };
module chars = core.chars { ar: حروف, fr: caracteres };
module hash = core.hash { ar: تجزئة };
module meta = core.meta { ar: انعكاس };
module random = core.random { ar: عشوائي };
