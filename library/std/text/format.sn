// Single-value to-text helpers, kept for existing callers. Format strings
// with width, precision, alignment, bases and Debug output are std.fmt
// (std.fmt.fmt, docs/en/reference/formatting.md).
استورد text.number;
استورد text.from_bytes;
استورد encoding.utf8;

عام عرف نسق_نصا(القيمة: &نص): نص {
    أرجع انسخ_نص(القيمة);
}

عام عرف نسق_عددا(القيمة: عدد): نص {
    أرجع عدد_إلى_نص(القيمة);
}

عام عرف نسق_طبيعي(القيمة: طبيعي): نص {
    أرجع طبيعي_إلى_نص(القيمة);
}

عام عرف نسق_منطقيا(القيمة: منطقي): نص {
    إذا (القيمة) { أرجع «true»; };
    أرجع «false»;
}

عام عرف نسق_حرفا(القيمة: حرف): نتيجة نص, ط32 {
    دع البايتات: متجه ط8 = [];
    طابق ألحق_محرف_يوتيف8(البايتات, القيمة مثل ط32) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> {
        أرجع نتيجة.خطأ(القيمة مثل ط32);
    }
    | نتيجة_ترميز_يوتيف8.مشفر(المشفرة) -> {
        أرجع نتيجة.نجح(من_بايتات(&المشفرة));
    };
}

عام مرادف format_text = نسق_نصا;
عام مرادف format_int = نسق_عددا;
عام مرادف format_uint = نسق_طبيعي;
عام مرادف format_bool = نسق_منطقيا;
عام مرادف format_char = نسق_حرفا;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف نسق_غير_موقع = نسق_طبيعي;
