استورد text.number;
استورد text.from_bytes;
استورد encoding.utf8;

عام عرف نسق_نصا(القيمة: &نص): نص {
    أرجع *القيمة;
}

عام عرف نسق_عددا(القيمة: عدد): نص {
    أرجع عدد_إلى_نص(القيمة);
}

عام عرف نسق_غير_موقع(القيمة: غير_موقع): نص {
    أرجع غير_موقع_إلى_نص(القيمة);
}

عام عرف نسق_منطقيا(القيمة: منطقي): نص {
    لو (القيمة) { أرجع «true»; };
    أرجع «false»;
}

عام عرف نسق_حرفا(القيمة: حرف): نتيجة نص, غ32 {
    دع البايتات: متجه غ8 = [];
    طابق ألحق_محرف_يوتيف8(البايتات, القيمة مثل غ32) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> {
        أرجع نتيجة.خطأ(القيمة مثل غ32);
    }
    | نتيجة_ترميز_يوتيف8.مشفر(المشفرة) -> {
        أرجع نتيجة.نجح(من_بايتات(&المشفرة));
    };
}

عام مرادف format_text = نسق_نصا;
عام مرادف format_int = نسق_عددا;
عام مرادف format_uint = نسق_غير_موقع;
عام مرادف format_bool = نسق_منطقيا;
عام مرادف format_char = نسق_حرفا;
