استورد text.from_bytes;
استورد chars.ascii;

عام نوع خطأ_تحليل_عدد =
    | نص_فارغ
    | إشارة_بلا_أرقام
    | رقم_غير_صالح بنوع غير_موقع
    | تجاوز
    | سالب_لغير_موقع
;

عرف نص_من_أرقام_معكوسة(الأرقام: &متجه غ8, سالب: منطقي): نص {
    دع المصدر: متجه غ8 = *الأرقام;
    دع الناتج: متغير متجه غ8 = [];
    لو (سالب) { ألحق(الناتج, 0x2D); };
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 0) {
        ف := ف - 1;
        ألحق(الناتج, المصدر[ف]);
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف غير_موقع_إلى_نص(القيمة: غير_موقع): نص {
    لو (القيمة == 0) { أرجع «0»; };
    دع الباقي: متغير غير_موقع = القيمة;
    دع الأرقام: متغير متجه غ8 = [];
    بينما (الباقي > 0) {
        دع الرقم: غير_موقع = الباقي % 10;
        ألحق(الأرقام, (((0x30 مثل غير_موقع) + الرقم) مثل غ8));
        الباقي := الباقي / 10;
    }
    أرجع نص_من_أرقام_معكوسة(&الأرقام, خطأ);
}

عام عرف عدد_إلى_نص(القيمة: عدد): نص {
    لو (القيمة == 0) { أرجع «0»; };
    دع سالب: منطقي = القيمة < 0;
    دع المقدار: متغير غير_موقع = 0;
    لو (سالب) {
        // لا ننفذ -القيمة مباشرة كي يبقى أصغر عدد موقع صالحا.
        دع دون_واحد: عدد = 0 - (القيمة + 1);
        المقدار := (دون_واحد مثل غير_موقع) + 1;
    } وإلا {
        المقدار := القيمة مثل غير_موقع;
    };
    دع الباقي: متغير غير_موقع = المقدار;
    دع الأرقام: متغير متجه غ8 = [];
    بينما (الباقي > 0) {
        دع الرقم: غير_موقع = الباقي % 10;
        ألحق(الأرقام, (((0x30 مثل غير_موقع) + الرقم) مثل غ8));
        الباقي := الباقي / 10;
    }
    أرجع نص_من_أرقام_معكوسة(&الأرقام, سالب);
}

عرف حلل_مقدارا_عشريا(
    النص: &نص,
    البداية: غير_موقع,
    الحد: غير_موقع
): نتيجة غير_موقع, خطأ_تحليل_عدد {
    دع القيمة_النصية: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة_النصية) مثل غير_موقع;
    لو (البداية >= العدد) {
        أرجع نتيجة.خطأ(خطأ_تحليل_عدد.إشارة_بلا_أرقام());
    };
    دع القيمة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < العدد) {
        دع البايت: غ8 = القيمة_النصية[ف];
        لو (!رقم_عشري(البايت)) {
            أرجع نتيجة.خطأ(خطأ_تحليل_عدد.رقم_غير_صالح(ف));
        };
        دع الرقم_الموسع: غير_موقع = البايت مثل غير_موقع;
        دع الرقم: غير_موقع = الرقم_الموسع - 0x30;
        لو (القيمة > ((الحد - الرقم) / 10)) {
            أرجع نتيجة.خطأ(خطأ_تحليل_عدد.تجاوز());
        };
        القيمة := (القيمة * 10) + الرقم;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(القيمة);
}

عام عرف حلل_غير_موقع(النص: &نص): نتيجة غير_موقع, خطأ_تحليل_عدد {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عدد.نص_فارغ()); };
    دع البداية: متغير غير_موقع = 0;
    لو (القيمة[0] == 0x2D) {
        أرجع نتيجة.خطأ(خطأ_تحليل_عدد.سالب_لغير_موقع());
    };
    لو (القيمة[0] == 0x2B) { البداية := 1; };
    دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
    أرجع حلل_مقدارا_عشريا(&القيمة, البداية, الأعلى);
}

عام عرف حلل_عدد(النص: &نص): نتيجة عدد, خطأ_تحليل_عدد {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عدد.نص_فارغ()); };
    دع البداية: متغير غير_موقع = 0;
    دع سالب: متغير منطقي = خطأ;
    لو (القيمة[0] == 0x2D) { سالب := صواب; البداية := 1; }
    وإلا لو (القيمة[0] == 0x2B) { البداية := 1; };
    دع أعلى_موقع: غير_موقع = 9223372036854775807 مثل غير_موقع;
    دع الحد: متغير غير_موقع = أعلى_موقع;
    لو (سالب) { الحد := أعلى_موقع + 1; };
    طابق حلل_مقدارا_عشريا(&القيمة, البداية, الحد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقدار) -> {
        لو (!سالب) { أرجع نتيجة.نجح(المقدار مثل عدد); };
        لو (المقدار == (أعلى_موقع + 1)) {
            أرجع نتيجة.نجح((0 - 9223372036854775807) - 1);
        };
        أرجع نتيجة.نجح(0 - (المقدار مثل عدد));
    };
}

عام مرادف integer_parse_error = خطأ_تحليل_عدد;
عام مرادف uint_to_text = غير_موقع_إلى_نص;
عام مرادف int_to_text = عدد_إلى_نص;
عام مرادف parse_uint = حلل_غير_موقع;
عام مرادف parse_int = حلل_عدد;

عام مرادف integer_parse_error.empty_text = خطأ_تحليل_عدد.نص_فارغ;
عام مرادف integer_parse_error.sign_without_digits = خطأ_تحليل_عدد.إشارة_بلا_أرقام;
عام مرادف integer_parse_error.invalid_digit = خطأ_تحليل_عدد.رقم_غير_صالح;
عام مرادف integer_parse_error.overflow = خطأ_تحليل_عدد.تجاوز;
عام مرادف integer_parse_error.negative_unsigned = خطأ_تحليل_عدد.سالب_لغير_موقع;
