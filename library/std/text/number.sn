استورد text.from_bytes;
استورد chars.ascii;

عام نوع خطأ_تحليل_عدد =
    | نص_فارغ
    | إشارة_بلا_أرقام
    | رقم_غير_صالح بنوع طبيعي
    | تجاوز
    | سالب_لطبيعي
;

// The digits were produced least significant first: popping them gives the
// text in reading order.
عرف نص_من_أرقام_معكوسة(الأرقام: &متغير متجه ط8, سالب: منطقي): نص {
    دع الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, (الطول(*الأرقام) مثل طبيعي) + 1);
    لو (سالب) { ألحق(الناتج, 0x2D); };
    طالما (صواب) {
        طابق أزل_الأخير(*الأرقام) مع
        | اختياري.موجود(الرقم) -> { ألحق(الناتج, الرقم); }
        | اختياري.لا_شيء -> { اخرج_من_حلقة; };
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف طبيعي_إلى_نص(القيمة: طبيعي): نص {
    لو (القيمة == 0) { أرجع «0»; };
    دع الباقي: متغير طبيعي = القيمة;
    دع الأرقام: متغير متجه ط8 = [];
    طالما (الباقي > 0) {
        دع الرقم: طبيعي = الباقي % 10;
        ألحق(الأرقام, (((0x30 مثل طبيعي) + الرقم) مثل ط8));
        الباقي := الباقي / 10;
    }
    أرجع نص_من_أرقام_معكوسة(&متغير الأرقام, خطأ);
}

عام عرف عدد_إلى_نص(القيمة: عدد): نص {
    لو (القيمة == 0) { أرجع «0»; };
    دع سالب: منطقي = القيمة < 0;
    دع المقدار: متغير طبيعي = 0;
    لو (سالب) {
        // لا ننفذ -القيمة مباشرة كي يبقى أصغر عدد موقع صالحا.
        دع دون_واحد: عدد = 0 - (القيمة + 1);
        المقدار := (دون_واحد مثل طبيعي) + 1;
    } وإلا {
        المقدار := القيمة مثل طبيعي;
    };
    دع الباقي: متغير طبيعي = المقدار;
    دع الأرقام: متغير متجه ط8 = [];
    طالما (الباقي > 0) {
        دع الرقم: طبيعي = الباقي % 10;
        ألحق(الأرقام, (((0x30 مثل طبيعي) + الرقم) مثل ط8));
        الباقي := الباقي / 10;
    }
    أرجع نص_من_أرقام_معكوسة(&متغير الأرقام, سالب);
}

عرف حلل_مقدارا_عشريا(
    النص: &نص,
    البداية: طبيعي,
    الحد: طبيعي
): نتيجة طبيعي, خطأ_تحليل_عدد {
    دع القيمة_النصية: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة_النصية) مثل طبيعي;
    لو (البداية >= العدد) {
        أرجع نتيجة.خطأ(خطأ_تحليل_عدد.إشارة_بلا_أرقام());
    };
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < العدد) {
        دع البايت: ط8 = القيمة_النصية[ف];
        لو (!رقم_عشري(البايت)) {
            أرجع نتيجة.خطأ(خطأ_تحليل_عدد.رقم_غير_صالح(ف));
        };
        دع الرقم_الموسع: طبيعي = البايت مثل طبيعي;
        دع الرقم: طبيعي = الرقم_الموسع - 0x30;
        لو (الرقم > الحد) { أرجع نتيجة.خطأ(خطأ_تحليل_عدد.تجاوز()); };
        لو (القيمة > ((الحد - الرقم) / 10)) {
            أرجع نتيجة.خطأ(خطأ_تحليل_عدد.تجاوز());
        };
        القيمة := (القيمة * 10) + الرقم;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(القيمة);
}

عام عرف حلل_طبيعي(النص: &نص): نتيجة طبيعي, خطأ_تحليل_عدد {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عدد.نص_فارغ()); };
    دع البداية: متغير طبيعي = 0;
    لو (القيمة[0] == 0x2D) {
        أرجع نتيجة.خطأ(خطأ_تحليل_عدد.سالب_لطبيعي());
    };
    لو (القيمة[0] == 0x2B) { البداية := 1; };
    دع الأعلى: طبيعي = ~((0 مثل طبيعي));
    أرجع حلل_مقدارا_عشريا(&القيمة, البداية, الأعلى);
}

عام عرف حلل_عدد(النص: &نص): نتيجة عدد, خطأ_تحليل_عدد {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عدد.نص_فارغ()); };
    دع البداية: متغير طبيعي = 0;
    دع سالب: متغير منطقي = خطأ;
    لو (القيمة[0] == 0x2D) { سالب := صواب; البداية := 1; }
    وإلا لو (القيمة[0] == 0x2B) { البداية := 1; };
    دع أعلى_موقع: طبيعي = 9223372036854775807 مثل طبيعي;
    دع الحد: متغير طبيعي = أعلى_موقع;
    لو (سالب) { الحد := أعلى_موقع + 1; };
    طابق حلل_مقدارا_عشريا(&القيمة, البداية, الحد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقدار) -> {
        لو (!سالب) { أرجع نتيجة.نجح(المقدار مثل عدد); };
        لو (المقدار == (أعلى_موقع + 1)) {
            أرجع نتيجة.نجح((0 - 9223372036854775807) - 1);
        };
        أرجع نتيجة.نجح(0 - (المقدار مثل عدد));
    };
}

عام مرادف integer_parse_error = خطأ_تحليل_عدد;
عام مرادف uint_to_text = طبيعي_إلى_نص;
عام مرادف int_to_text = عدد_إلى_نص;
عام مرادف parse_uint = حلل_طبيعي;
عام مرادف parse_int = حلل_عدد;

عام مرادف integer_parse_error.empty_text = خطأ_تحليل_عدد.نص_فارغ;
عام مرادف integer_parse_error.sign_without_digits = خطأ_تحليل_عدد.إشارة_بلا_أرقام;
عام مرادف integer_parse_error.invalid_digit = خطأ_تحليل_عدد.رقم_غير_صالح;
عام مرادف integer_parse_error.overflow = خطأ_تحليل_عدد.تجاوز;
عام مرادف integer_parse_error.negative_unsigned = خطأ_تحليل_عدد.سالب_لطبيعي;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف غير_موقع_إلى_نص = طبيعي_إلى_نص;
عام مرادف حلل_غير_موقع = حلل_طبيعي;
عام مرادف خطأ_تحليل_عدد.سالب_لغير_موقع = خطأ_تحليل_عدد.سالب_لطبيعي;
