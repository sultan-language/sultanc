// std.text.language: BCP 47 language tags (RFC 5646) and the locale value
// (docs/ERRORS.md, "Language versions").
//
// A locale (لغة) is a value, never global state: a program builds one from a
// tag, from an HTTP Accept-Language header or from its environment
// (text.system_language) and passes it to the code that chooses a language,
// so a server can answer each request in its own language. It holds a
// language priority list (RFC 4647 §2.3): one tag, or the ranges of an
// Accept-Language header from the most to the least preferred.
//
// Pure SultanC within the C Stage0's language: no copy primitive, no
// reference returns, no references stored in records or mutable locals, no
// calls inside vector literals, no top-level constants.
استورد text.from_bytes;
استورد text.compare;
استورد chars.ascii;

عام نوع لغة = {
    الوسوم: متجه نص
};

// --- Subtags ---------------------------------------------------------------

عرف فاصل_وسم_لغة(البايت: ط8): منطقي {
    أرجع البايت == 0x2D || البايت == 0x5F;
}

// The subtags of a tag, split at «-» (and «_», the POSIX spelling), as
// written; an empty subtag stays empty.
عرف أجزاء_وسم_لغة(الوسم: &نص): متجه نص {
    دع الأجزاء: متغير متجه نص = [];
    دع العدد: طبيعي = الطول(*الوسم) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        لو (ف == العدد || فاصل_وسم_لغة((*الوسم)[ف])) {
            دع الجزء: متغير متجه ط8 = [];
            دع ي: متغير طبيعي = البداية;
            طالما (ي < ف) {
                ألحق(الجزء, (*الوسم)[ي]);
                ي := ي + 1;
            }
            ألحق(الأجزاء, الجزء مثل نص);
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الأجزاء;
}

عرف كله_حروف(الجزء: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الجزء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (!حرف_لاتيني((*الجزء)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف كله_أرقام(الجزء: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الجزء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (!رقم_عشري((*الجزء)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف كله_حروف_وأرقام(الجزء: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الجزء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (!حرف_أو_رقم_أسكي((*الجزء)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف طول_جزء(الجزء: &نص): طبيعي {
    أرجع الطول(*الجزء) مثل طبيعي;
}

// «x» or «X»: the private-use singleton.
عرف جزء_خاص(الجزء: &نص): منطقي {
    لو (طول_جزء(الجزء) != 1) { أرجع خطأ; };
    دع البايت: ط8 = (*الجزء)[0];
    أرجع البايت == 0x78 || البايت == 0x58;
}

// --- Tags ------------------------------------------------------------------

// Whether the text is a well-formed BCP 47 language tag (RFC 5646 §2.1):
//   language ["-" script] ["-" region] *("-" variant) *("-" extension)
//   ["-" privateuse], or a private-use tag («x-…»).
// «_» is accepted as a separator. Whether a subtag is registered is not
// checked, and the irregular grandfathered tags («i-klingon») are not
// accepted.
عام عرف وسم_لغة_صالح(الوسم: &نص): منطقي {
    دع الأجزاء: متجه نص = أجزاء_وسم_لغة(الوسم);
    دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الطول_الجزئي: طبيعي = طول_جزء(&الأجزاء[ف]);
        لو (الطول_الجزئي == 0 || الطول_الجزئي > 8) { أرجع خطأ; };
        لو (!كله_حروف_وأرقام(&الأجزاء[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    // A private-use tag: «x» and at least one subtag.
    لو (جزء_خاص(&الأجزاء[0])) { أرجع العدد >= 2; };
    // The primary language: 2 to 8 letters.
    دع الأول: طبيعي = طول_جزء(&الأجزاء[0]);
    لو (الأول < 2 || !كله_حروف(&الأجزاء[0])) { أرجع خطأ; };
    ف := 1;
    // Up to three extended language subtags after a 2- or 3-letter language.
    لو (الأول <= 3) {
        دع الموسعة: متغير طبيعي = 0;
        طالما (ف < العدد && الموسعة < 3 && طول_جزء(&الأجزاء[ف]) == 3 && كله_حروف(&الأجزاء[ف])) {
            ف := ف + 1;
            الموسعة := الموسعة + 1;
        }
    };
    // Script: 4 letters.
    لو (ف < العدد && طول_جزء(&الأجزاء[ف]) == 4 && كله_حروف(&الأجزاء[ف])) {
        ف := ف + 1;
    };
    // Region: 2 letters or 3 digits.
    لو (ف < العدد) {
        دع طول_المنطقة: طبيعي = طول_جزء(&الأجزاء[ف]);
        لو ((طول_المنطقة == 2 && كله_حروف(&الأجزاء[ف]))
            || (طول_المنطقة == 3 && كله_أرقام(&الأجزاء[ف]))) {
            ف := ف + 1;
        };
    };
    // Variants: 5 to 8 characters, or 4 starting with a digit.
    طالما (ف < العدد
        && (طول_جزء(&الأجزاء[ف]) >= 5
            || (طول_جزء(&الأجزاء[ف]) == 4 && رقم_عشري(الأجزاء[ف][0])))) {
        ف := ف + 1;
    }
    // Extensions: a singleton other than «x», then subtags of 2 to 8.
    طالما (ف < العدد && طول_جزء(&الأجزاء[ف]) == 1 && !جزء_خاص(&الأجزاء[ف])) {
        ف := ف + 1;
        دع الأجزاء_الملحقة: متغير طبيعي = 0;
        طالما (ف < العدد && طول_جزء(&الأجزاء[ف]) >= 2) {
            ف := ف + 1;
            الأجزاء_الملحقة := الأجزاء_الملحقة + 1;
        }
        لو (الأجزاء_الملحقة == 0) { أرجع خطأ; };
    }
    // Private use: «x» and at least one subtag of 1 to 8.
    لو (ف < العدد && جزء_خاص(&الأجزاء[ف])) {
        لو (ف + 1 >= العدد) { أرجع خطأ; };
        ف := العدد;
    };
    أرجع ف == العدد;
}

// The tag in the canonical case of RFC 5646 §2.1.1, with «-» separators:
// lower case, except a 2-letter region in upper case and a 4-letter script
// in title case, until an extension or private-use singleton («en-us» →
// «en-US», «sr_latn_rs» → «sr-Latn-RS»). The tag is not validated.
عام عرف طبع_وسم_لغة(الوسم: &نص): نص {
    دع الأجزاء: متجه نص = أجزاء_وسم_لغة(الوسم);
    دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [];
    دع بعد_مفرد: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الطول_الجزئي: طبيعي = طول_جزء(&الأجزاء[ف]);
        لو (ف > 0) { ألحق(الناتج, 0x2D مثل ط8); };
        لو (ف > 0 && الطول_الجزئي == 1) { بعد_مفرد := صواب; };
        دع ي: متغير طبيعي = 0;
        طالما (ي < الطول_الجزئي) {
            دع البايت: ط8 = الأجزاء[ف][ي];
            لو (ف > 0 && !بعد_مفرد && الطول_الجزئي == 2) {
                ألحق(الناتج, إلى_كبير_أسكي(البايت));
            } وإلا لو (ف > 0 && !بعد_مفرد && الطول_الجزئي == 4 && ي == 0 && كله_حروف(&الأجزاء[ف])) {
                ألحق(الناتج, إلى_كبير_أسكي(البايت));
            } وإلا {
                ألحق(الناتج, إلى_صغير_أسكي(البايت));
            };
            ي := ي + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

// The primary language subtag of a tag, in lower case («ar-SA» → «ar»);
// empty for an empty tag.
عام عرف اللغة_الأساسية_لوسم(الوسم: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*الوسم) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !فاصل_وسم_لغة((*الوسم)[ف])) {
        ألحق(الناتج, إلى_صغير_أسكي((*الوسم)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

// One step of the RFC 4647 §3.4 lookup fallback: the tag without its last
// subtag, and without a singleton left at the end («zh-Hant-CN-x-p» →
// «zh-Hant-CN», «zh-Hant-CN» → «zh-Hant», «ar» → «»).
عام عرف اختصر_وسم_لغة(الوسم: &نص): نص {
    دع الأجزاء: متجه نص = أجزاء_وسم_لغة(الوسم);
    دع العدد: متغير طبيعي = الطول(الأجزاء) مثل طبيعي;
    لو (العدد > 0) { العدد := العدد - 1; };
    لو (العدد > 1 && طول_جزء(&الأجزاء[العدد - 1]) == 1) { العدد := العدد - 1; };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (ف > 0) { ألحق(الناتج, 0x2D مثل ط8); };
        دع الطول_الجزئي: طبيعي = طول_جزء(&الأجزاء[ف]);
        دع ي: متغير طبيعي = 0;
        طالما (ي < الطول_الجزئي) {
            ألحق(الناتج, الأجزاء[ف][ي]);
            ي := ي + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

// --- Text ranges -----------------------------------------------------------

عرف فراغ_ترويسة(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09;
}

// A copy of the bytes [البداية, النهاية) of the text, without the spaces and
// tabs at both ends.
عرف مقطع_مقصوص(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع أول: متغير طبيعي = البداية;
    دع آخر: متغير طبيعي = النهاية;
    طالما (أول < آخر && فراغ_ترويسة((*النص)[أول])) { أول := أول + 1; }
    طالما (آخر > أول && فراغ_ترويسة((*النص)[آخر - 1])) { آخر := آخر - 1; }
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = أول;
    طالما (ف < آخر) {
        ألحق(الناتج, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

// --- Locales ---------------------------------------------------------------

// A locale of one tag: the tag in canonical case, without the spaces around
// it; «_» is accepted («ar_SA» → «ar-SA»). A text that is not a well-formed
// tag gives a locale without a tag, for which every lookup falls back to the
// author's message.
عام عرف لغة_من_وسم(الوسم: &نص): لغة {
    دع المقصوص: نص = مقطع_مقصوص(الوسم, 0, الطول(*الوسم) مثل طبيعي);
    دع الوسوم: متغير متجه نص = [];
    لو (وسم_لغة_صالح(&المقصوص)) {
        ألحق(الوسوم, طبع_وسم_لغة(&المقصوص));
    };
    دع الناتج: لغة = { الوسوم: الوسوم };
    أرجع الناتج;
}

// The weight of a «q=» parameter in thousandths (RFC 9110 §12.4.2:
// «0», «0.5», «1», «1.000», at most three decimals), or -1 when it is not a
// weight.
عرف وزن_جودة(النص: &نص, البداية: طبيعي, النهاية: طبيعي): عدد {
    لو (البداية >= النهاية) { أرجع -1; };
    دع الأول: ط8 = (*النص)[البداية];
    لو (الأول != 0x30 && الأول != 0x31) { أرجع -1; };
    دع الوزن: متغير عدد = 0;
    لو (الأول == 0x31) { الوزن := 1000; };
    دع ف: متغير طبيعي = البداية + 1;
    لو (ف == النهاية) { أرجع الوزن; };
    لو ((*النص)[ف] != 0x2E) { أرجع -1; };
    ف := ف + 1;
    دع المرتبة: متغير عدد = 100;
    دع الأرقام: متغير طبيعي = 0;
    طالما (ف < النهاية) {
        دع البايت: ط8 = (*النص)[ف];
        لو (!رقم_عشري(البايت) || الأرقام == 3) { أرجع -1; };
        دع الرقم: عدد = قيمة_رقم_أسكي(البايت);
        لو (الأول == 0x31 && الرقم != 0) { أرجع -1; };
        الوزن := الوزن + الرقم * المرتبة;
        المرتبة := المرتبة / 10;
        الأرقام := الأرقام + 1;
        ف := ف + 1;
    }
    أرجع الوزن;
}

// The weight of one Accept-Language element «range;q=…» held in
// [البداية, النهاية) after its range: 1000 without a «q» parameter, -1 when a
// parameter is malformed.
عرف وزن_عنصر_قبول(النص: &نص, البداية: طبيعي, النهاية: طبيعي): عدد {
    دع الوزن: متغير عدد = 1000;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        // One parameter: [ف, نهاية_المعامل).
        دع نهاية_المعامل: متغير طبيعي = ف;
        طالما (نهاية_المعامل < النهاية && (*النص)[نهاية_المعامل] != 0x3B) {
            نهاية_المعامل := نهاية_المعامل + 1;
        }
        دع أول: متغير طبيعي = ف;
        دع آخر: متغير طبيعي = نهاية_المعامل;
        طالما (أول < آخر && فراغ_ترويسة((*النص)[أول])) { أول := أول + 1; }
        طالما (آخر > أول && فراغ_ترويسة((*النص)[آخر - 1])) { آخر := آخر - 1; }
        لو (آخر - أول >= 2
            && ((*النص)[أول] == 0x71 || (*النص)[أول] == 0x51)
            && (*النص)[أول + 1] == 0x3D) {
            الوزن := وزن_جودة(النص, أول + 2, آخر);
            لو (الوزن < 0) { أرجع -1; };
        } وإلا لو (آخر > أول) {
            // Another parameter: Accept-Language defines none; ignored.
        };
        ف := نهاية_المعامل + 1;
    }
    أرجع الوزن;
}

// A locale from an HTTP Accept-Language header (RFC 9110 §12.5.4): its
// language ranges ordered by weight, highest first, equal weights in the
// order written. A range of weight 0, the wildcard «*», a range that is not a
// well-formed tag and an element with a malformed weight are left out; an
// empty header gives a locale without a tag.
//   «fr-CH, fr;q=0.9, en;q=0.8, *;q=0.5» → fr-CH, fr, en
عام عرف لغة_من_قبول_اللغة(الترويسة: &نص): لغة {
    دع المرشحة: متغير متجه نص = [];
    دع الأوزان: متغير متجه عدد = [];
    دع العدد: طبيعي = الطول(*الترويسة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        // One element: [ف, نهاية_العنصر).
        دع نهاية_العنصر: متغير طبيعي = ف;
        طالما (نهاية_العنصر < العدد && (*الترويسة)[نهاية_العنصر] != 0x2C) {
            نهاية_العنصر := نهاية_العنصر + 1;
        }
        دع نهاية_المدى: متغير طبيعي = ف;
        طالما (نهاية_المدى < نهاية_العنصر && (*الترويسة)[نهاية_المدى] != 0x3B) {
            نهاية_المدى := نهاية_المدى + 1;
        }
        دع المدى: نص = مقطع_مقصوص(الترويسة, ف, نهاية_المدى);
        دع الوزن: عدد = وزن_عنصر_قبول(الترويسة, نهاية_المدى, نهاية_العنصر);
        لو (الوزن > 0 && وسم_لغة_صالح(&المدى)) {
            ألحق(المرشحة, طبع_وسم_لغة(&المدى));
            ألحق(الأوزان, الوزن);
        };
        ف := نهاية_العنصر + 1;
    }
    // A stable selection by weight, highest first.
    دع المرشحات: طبيعي = الطول(المرشحة) مثل طبيعي;
    دع مأخوذ: متغير متجه منطقي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < المرشحات) {
        ألحق(مأخوذ, خطأ);
        م := م + 1;
    }
    دع الوسوم: متغير متجه نص = [];
    دع مرة: متغير طبيعي = 0;
    طالما (مرة < المرشحات) {
        دع الأفضل: متغير طبيعي = المرشحات;
        دع ي: متغير طبيعي = 0;
        طالما (ي < المرشحات) {
            لو (!مأخوذ[ي] && (الأفضل == المرشحات || الأوزان[ي] > الأوزان[الأفضل])) {
                الأفضل := ي;
            };
            ي := ي + 1;
        }
        مأخوذ[الأفضل] := صواب;
        ألحق(الوسوم, انسخ_نص(&المرشحة[الأفضل]));
        مرة := مرة + 1;
    }
    دع الناتج: لغة = { الوسوم: الوسوم };
    أرجع الناتج;
}

// A copy of the locale's tags, the most preferred first, in canonical case.
عام عرف وسوم_لغة(اللغة: &لغة): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع العدد: طبيعي = الطول((*اللغة).الوسوم) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, انسخ_نص(&(*اللغة).الوسوم[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The most preferred tag, or empty for a locale without a tag.
عام عرف وسم_لغة(اللغة: &لغة): نص {
    لو ((الطول((*اللغة).الوسوم) مثل طبيعي) == 0) { أرجع «»; };
    أرجع انسخ_نص(&(*اللغة).الوسوم[0]);
}

// The primary language of the most preferred tag («ar-SA» → «ar»), or empty
// for a locale without a tag.
عام عرف اللغة_الأساسية(اللغة: &لغة): نص {
    لو ((الطول((*اللغة).الوسوم) مثل طبيعي) == 0) { أرجع «»; };
    أرجع اللغة_الأساسية_لوسم(&(*اللغة).الوسوم[0]);
}

// An independent copy; `استنسخ(&ل)` gives the same result.
عام عرف انسخ_لغة(اللغة: &لغة): لغة {
    دع الوسوم: متجه نص = وسوم_لغة(اللغة);
    دع الناتج: لغة = { الوسوم: الوسوم };
    أرجع الناتج;
}

عام مرادف Locale = لغة;
