// التحقق العام من حدود نطاق بايتات داخل نص.
عام عرف متاح_في_النص(
    القيمة: &نص,
    الموضع: غير_موقع,
    العدد: غير_موقع
): منطقي {
    دع النص: نص = *القيمة;
    دع الطول_الكلي: غير_موقع = الطول(النص) مثل غير_موقع;

    لو (الموضع > الطول_الكلي) {
        أرجع خطأ;
    };

    أرجع العدد <= (الطول_الكلي - الموضع);
}
// الاسم العام الإنجليزي يرتبط بالتصريح العربي نفسه.
عام مرادف text_range_available = متاح_في_النص;
