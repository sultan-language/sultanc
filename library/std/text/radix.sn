استورد text.from_bytes;
استورد chars.ascii;

عام نوع خطأ_قاعدة_عدد =
    | قاعدة_غير_صالحة
    | نص_فارغ
    | إشارة_بلا_أرقام
    | رقم_غير_صالح بنوع غير_موقع
    | رقم_خارج_القاعدة بنوع غير_موقع
    | تجاوز
    | سالب_لغير_موقع
;

عرف بايت_رقم_قاعدة(القيمة: غير_موقع, كبير: منطقي): غ8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل غ8; };
    لو (كبير) { أرجع (0x41 + القيمة - 10) مثل غ8; };
    أرجع (0x61 + القيمة - 10) مثل غ8;
}

عرف نص_من_أرقام_قاعدة(الأرقام: &متجه غ8, سالب: منطقي): نص {
    دع المصدر: متجه غ8 = *الأرقام;
    دع الناتج: متغير متجه غ8 = [];
    لو (سالب) { ألحق(الناتج, 0x2D); };
    دع ف: متغير غير_موقع = الطول(المصدر) مثل غير_موقع;
    بينما (ف > 0) { ف := ف - 1; ألحق(الناتج, المصدر[ف]); }
    أرجع من_بايتات(&الناتج);
}

عرف رمز_مقدار_بقاعدة(القيمة: غير_موقع, القاعدة: غير_موقع, كبير: منطقي, سالب: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    لو ((القاعدة < 2) || (القاعدة > 36)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.قاعدة_غير_صالحة()); };
    لو (القيمة == 0) { أرجع نتيجة.نجح(«0»); };
    دع الباقي: متغير غير_موقع = القيمة;
    دع الأرقام: متغير متجه غ8 = [];
    بينما (الباقي > 0) {
        دع الرقم: غير_موقع = الباقي % القاعدة;
        ألحق(الأرقام, بايت_رقم_قاعدة(الرقم, كبير));
        الباقي := الباقي / القاعدة;
    }
    أرجع نتيجة.نجح(نص_من_أرقام_قاعدة(&الأرقام, سالب));
}

عام عرف غير_موقع_إلى_نص_بقاعدة(القيمة: غير_موقع, القاعدة: غير_موقع, كبير: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    أرجع رمز_مقدار_بقاعدة(القيمة, القاعدة, كبير, خطأ);
}

عام عرف عدد_إلى_نص_بقاعدة(القيمة: عدد, القاعدة: غير_موقع, كبير: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    دع سالب: منطقي = القيمة < 0;
    دع المقدار: متغير غير_موقع = 0;
    لو (سالب) {
        دع دون_واحد: عدد = 0 - (القيمة + 1);
        المقدار := (دون_واحد مثل غير_موقع) + 1;
    } وإلا {
        المقدار := القيمة مثل غير_موقع;
    };
    أرجع رمز_مقدار_بقاعدة(المقدار, القاعدة, كبير, سالب);
}

عرف حلل_مقدار_بقاعدة(النص: &نص, البداية: غير_موقع, القاعدة: غير_موقع, الحد: غير_موقع): نتيجة غير_موقع, خطأ_قاعدة_عدد {
    لو ((القاعدة < 2) || (القاعدة > 36)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.قاعدة_غير_صالحة()); };
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو (البداية >= العدد) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.إشارة_بلا_أرقام()); };
    دع الناتج: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < العدد) {
        دع الرقم_الموقع: عدد = قيمة_رقم_أسكي(المصدر[ف]);
        لو (الرقم_الموقع < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.رقم_غير_صالح(ف)); };
        دع الرقم: غير_موقع = الرقم_الموقع مثل غير_موقع;
        لو (الرقم >= القاعدة) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.رقم_خارج_القاعدة(ف)); };
        لو (الناتج > ((الحد - الرقم) / القاعدة)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.تجاوز()); };
        الناتج := (الناتج * القاعدة) + الرقم;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_غير_موقع_بقاعدة(النص: &نص, القاعدة: غير_موقع): نتيجة غير_موقع, خطأ_قاعدة_عدد {
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.نص_فارغ()); };
    دع البداية: متغير غير_موقع = 0;
    لو (المصدر[0] == 0x2D) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.سالب_لغير_موقع()); };
    لو (المصدر[0] == 0x2B) { البداية := 1; };
    دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
    أرجع حلل_مقدار_بقاعدة(&المصدر, البداية, القاعدة, الأعلى);
}

عام عرف حلل_عدد_بقاعدة(النص: &نص, القاعدة: غير_موقع): نتيجة عدد, خطأ_قاعدة_عدد {
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.نص_فارغ()); };
    دع البداية: متغير غير_موقع = 0;
    دع سالب: متغير منطقي = خطأ;
    لو (المصدر[0] == 0x2D) { سالب := صواب; البداية := 1; }
    وإلا لو (المصدر[0] == 0x2B) { البداية := 1; };
    دع أعلى_موقع: غير_موقع = 9223372036854775807 مثل غير_موقع;
    دع الحد: متغير غير_موقع = أعلى_موقع;
    لو (سالب) { الحد := أعلى_موقع + 1; };
    طابق حلل_مقدار_بقاعدة(&المصدر, البداية, القاعدة, الحد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقدار) -> {
        لو (!سالب) { أرجع نتيجة.نجح(المقدار مثل عدد); };
        لو (المقدار == (أعلى_موقع + 1)) { أرجع نتيجة.نجح((0 - 9223372036854775807) - 1); };
        أرجع نتيجة.نجح(0 - (المقدار مثل عدد));
    };
}

عام مرادف radix_error = خطأ_قاعدة_عدد;
عام مرادف uint_to_text_radix = غير_موقع_إلى_نص_بقاعدة;
عام مرادف int_to_text_radix = عدد_إلى_نص_بقاعدة;
عام مرادف parse_uint_radix = حلل_غير_موقع_بقاعدة;
عام مرادف parse_int_radix = حلل_عدد_بقاعدة;
عام مرادف radix_error.invalid_radix = خطأ_قاعدة_عدد.قاعدة_غير_صالحة;
عام مرادف radix_error.empty_text = خطأ_قاعدة_عدد.نص_فارغ;
عام مرادف radix_error.sign_without_digits = خطأ_قاعدة_عدد.إشارة_بلا_أرقام;
عام مرادف radix_error.invalid_digit = خطأ_قاعدة_عدد.رقم_غير_صالح;
عام مرادف radix_error.digit_out_of_radix = خطأ_قاعدة_عدد.رقم_خارج_القاعدة;
عام مرادف radix_error.overflow = خطأ_قاعدة_عدد.تجاوز;
عام مرادف radix_error.negative_unsigned = خطأ_قاعدة_عدد.سالب_لغير_موقع;
