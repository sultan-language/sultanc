استورد text.from_bytes;
استورد chars.ascii;

عام نوع خطأ_قاعدة_عدد =
    | قاعدة_غير_صالحة
    | نص_فارغ
    | إشارة_بلا_أرقام
    | رقم_غير_صالح بنوع طبيعي
    | رقم_خارج_القاعدة بنوع طبيعي
    | تجاوز
    | سالب_لطبيعي
;

عرف بايت_رقم_قاعدة(القيمة: طبيعي, كبير: منطقي): ط8 {
    إذا (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    إذا (كبير) { أرجع (0x41 + القيمة - 10) مثل ط8; };
    أرجع (0x61 + القيمة - 10) مثل ط8;
}

عرف نص_من_أرقام_قاعدة(الأرقام: &متجه ط8, سالب: منطقي): نص {
    دع المصدر: متجه ط8 = *الأرقام;
    دع الناتج: متغير متجه ط8 = [];
    إذا (سالب) { ألحق(الناتج, 0x2D); };
    دع ف: متغير طبيعي = الطول(المصدر) مثل طبيعي;
    طالما (ف > 0) { ف := ف - 1; ألحق(الناتج, المصدر[ف]); }
    أرجع من_بايتات(&الناتج);
}

عرف رمز_مقدار_بقاعدة(القيمة: طبيعي, القاعدة: طبيعي, كبير: منطقي, سالب: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    إذا ((القاعدة < 2) || (القاعدة > 36)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.قاعدة_غير_صالحة()); };
    إذا (القيمة == 0) { أرجع نتيجة.نجح(«0»); };
    دع الباقي: متغير طبيعي = القيمة;
    دع الأرقام: متغير متجه ط8 = [];
    طالما (الباقي > 0) {
        دع الرقم: طبيعي = الباقي % القاعدة;
        ألحق(الأرقام, بايت_رقم_قاعدة(الرقم, كبير));
        الباقي := الباقي / القاعدة;
    }
    أرجع نتيجة.نجح(نص_من_أرقام_قاعدة(&الأرقام, سالب));
}

عام عرف طبيعي_إلى_نص_بقاعدة(القيمة: طبيعي, القاعدة: طبيعي, كبير: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    أرجع رمز_مقدار_بقاعدة(القيمة, القاعدة, كبير, خطأ);
}

عام عرف عدد_إلى_نص_بقاعدة(القيمة: عدد, القاعدة: طبيعي, كبير: منطقي): نتيجة نص, خطأ_قاعدة_عدد {
    دع سالب: منطقي = القيمة < 0;
    دع المقدار: متغير طبيعي = 0;
    إذا (سالب) {
        دع دون_واحد: عدد = 0 - (القيمة + 1);
        المقدار := (دون_واحد مثل طبيعي) + 1;
    } وإلا {
        المقدار := القيمة مثل طبيعي;
    };
    أرجع رمز_مقدار_بقاعدة(المقدار, القاعدة, كبير, سالب);
}

عرف حلل_مقدار_بقاعدة(النص: &نص, البداية: طبيعي, القاعدة: طبيعي, الحد: طبيعي): نتيجة طبيعي, خطأ_قاعدة_عدد {
    إذا ((القاعدة < 2) || (القاعدة > 36)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.قاعدة_غير_صالحة()); };
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    إذا (البداية >= العدد) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.إشارة_بلا_أرقام()); };
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < العدد) {
        دع الرقم_الموقع: عدد = قيمة_رقم_أسكي(المصدر[ف]);
        إذا (الرقم_الموقع < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.رقم_غير_صالح(ف)); };
        دع الرقم: طبيعي = الرقم_الموقع مثل طبيعي;
        إذا (الرقم >= القاعدة) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.رقم_خارج_القاعدة(ف)); };
        إذا (الرقم > الحد) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.تجاوز()); };
        إذا (الناتج > ((الحد - الرقم) / القاعدة)) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.تجاوز()); };
        الناتج := (الناتج * القاعدة) + الرقم;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_طبيعي_بقاعدة(النص: &نص, القاعدة: طبيعي): نتيجة طبيعي, خطأ_قاعدة_عدد {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.نص_فارغ()); };
    دع البداية: متغير طبيعي = 0;
    إذا (المصدر[0] == 0x2D) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.سالب_لطبيعي()); };
    إذا (المصدر[0] == 0x2B) { البداية := 1; };
    دع الأعلى: طبيعي = ~((0 مثل طبيعي));
    أرجع حلل_مقدار_بقاعدة(&المصدر, البداية, القاعدة, الأعلى);
}

عام عرف حلل_عدد_بقاعدة(النص: &نص, القاعدة: طبيعي): نتيجة عدد, خطأ_قاعدة_عدد {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.خطأ(خطأ_قاعدة_عدد.نص_فارغ()); };
    دع البداية: متغير طبيعي = 0;
    دع سالب: متغير منطقي = خطأ;
    إذا (المصدر[0] == 0x2D) { سالب := صواب; البداية := 1; }
    وإلا إذا (المصدر[0] == 0x2B) { البداية := 1; };
    دع أعلى_موقع: طبيعي = 9223372036854775807 مثل طبيعي;
    دع الحد: متغير طبيعي = أعلى_موقع;
    إذا (سالب) { الحد := أعلى_موقع + 1; };
    طابق حلل_مقدار_بقاعدة(&المصدر, البداية, القاعدة, الحد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقدار) -> {
        إذا (!سالب) { أرجع نتيجة.نجح(المقدار مثل عدد); };
        إذا (المقدار == (أعلى_موقع + 1)) { أرجع نتيجة.نجح((0 - 9223372036854775807) - 1); };
        أرجع نتيجة.نجح(0 - (المقدار مثل عدد));
    };
}

عام مرادف radix_error = خطأ_قاعدة_عدد;
عام مرادف uint_to_text_radix = طبيعي_إلى_نص_بقاعدة;
عام مرادف int_to_text_radix = عدد_إلى_نص_بقاعدة;
عام مرادف parse_uint_radix = حلل_طبيعي_بقاعدة;
عام مرادف parse_int_radix = حلل_عدد_بقاعدة;
عام مرادف radix_error.invalid_radix = خطأ_قاعدة_عدد.قاعدة_غير_صالحة;
عام مرادف radix_error.empty_text = خطأ_قاعدة_عدد.نص_فارغ;
عام مرادف radix_error.sign_without_digits = خطأ_قاعدة_عدد.إشارة_بلا_أرقام;
عام مرادف radix_error.invalid_digit = خطأ_قاعدة_عدد.رقم_غير_صالح;
عام مرادف radix_error.digit_out_of_radix = خطأ_قاعدة_عدد.رقم_خارج_القاعدة;
عام مرادف radix_error.overflow = خطأ_قاعدة_عدد.تجاوز;
عام مرادف radix_error.negative_unsigned = خطأ_قاعدة_عدد.سالب_لطبيعي;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف غير_موقع_إلى_نص_بقاعدة = طبيعي_إلى_نص_بقاعدة;
عام مرادف حلل_غير_موقع_بقاعدة = حلل_طبيعي_بقاعدة;
عام مرادف خطأ_قاعدة_عدد.سالب_لغير_موقع = خطأ_قاعدة_عدد.سالب_لطبيعي;
