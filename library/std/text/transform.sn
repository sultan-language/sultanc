استورد text.from_bytes;
استورد text.substring;
استورد text.search;
استورد encoding.utf8;
استورد chars.unicode;

عرف ألحق_نطاق_نص(
    الناتج: &متغير متجه غ8,
    القيمة: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع
): فراغ {
    دع النص: نص = *القيمة;
    دع البايتات: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }
    *الناتج := البايتات;
}

عام عرف قص_بداية_النص(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر && (الموضع < العدد)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&النص, الموضع);
        لو (!المفكوك.صالح || !فراغ_يونيكود(المفكوك.القيمة)) {
            مستمر := خطأ;
        } وإلا {
            الموضع := الموضع + المفكوك.العرض;
        };
    }
    طابق مقطع_نص(&النص, الموضع, العدد - الموضع) مع
    | اختيار.بعض(الناتج) -> { أرجع الناتج; }
    | اختيار.لا_شيء -> { أرجع «»; };
}

عام عرف قص_نهاية_النص(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    دع نهاية_غير_فارغة: متغير غير_موقع = 0;
    بينما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&النص, الموضع);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            نهاية_غير_فارغة := الموضع + 1;
            الموضع := الموضع + 1;
        } وإلا {
            الموضع := الموضع + المفكوك.العرض;
            لو (!فراغ_يونيكود(المفكوك.القيمة)) {
                نهاية_غير_فارغة := الموضع;
            };
        };
    }
    طابق مقطع_نص(&النص, 0, نهاية_غير_فارغة) مع
    | اختيار.بعض(الناتج) -> { أرجع الناتج; }
    | اختيار.لا_شيء -> { أرجع «»; };
}

عام عرف قص_النص(القيمة: &نص): نص {
    دع من_البداية: نص = قص_بداية_النص(القيمة);
    أرجع قص_نهاية_النص(&من_البداية);
}

عام عرف قسم_النص(القيمة: &نص, الفاصل: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    دع عدد_الفاصل: غير_موقع = الطول(*الفاصل) مثل غير_موقع;
    لو (عدد_الفاصل == 0) {
        ألحق(الناتج, *القيمة);
        أرجع الناتج;
    };
    دع البداية: متغير غير_موقع = 0;
    بينما (البداية <= عدد_القيمة) {
        طابق ابحث_نصا_من(القيمة, الفاصل, البداية) مع
        | اختيار.لا_شيء -> {
            طابق مقطع_نص(القيمة, البداية, عدد_القيمة - البداية) مع
            | اختيار.بعض(الجزء) -> { ألحق(الناتج, الجزء); }
            | اختيار.لا_شيء -> { };
            أرجع الناتج;
        }
        | اختيار.بعض(الموضع) -> {
            طابق مقطع_نص(القيمة, البداية, الموضع - البداية) مع
            | اختيار.بعض(الجزء) -> { ألحق(الناتج, الجزء); }
            | اختيار.لا_شيء -> { };
            البداية := الموضع + عدد_الفاصل;
        };
    }
    أرجع الناتج;
}

عرف انسخ_جزء_نص_للتحويل(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عام عرف صل_النصوص(القيم: &متجه نص, الفاصل: &نص): نص {
    دع الأجزاء: متجه نص = *القيم;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
        لو (ف > 0) {
            ألحق_نطاق_نص(&متغير البايتات, الفاصل, 0, الطول(*الفاصل) مثل غير_موقع);
        };
        دع الجزء: نص = انسخ_جزء_نص_للتحويل(&الأجزاء[ف]);
        ألحق_نطاق_نص(&متغير البايتات, &الجزء, 0, الطول(الجزء) مثل غير_موقع);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف استبدل_في_النص(القيمة: &نص, المطلوب: &نص, البديل: &نص): نص {
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    دع عدد_المطلوب: غير_موقع = الطول(*المطلوب) مثل غير_موقع;
    لو (عدد_المطلوب == 0) { أرجع *القيمة; };
    دع البايتات: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < عدد_القيمة) {
        طابق ابحث_نصا_من(القيمة, المطلوب, الموضع) مع
        | اختيار.لا_شيء -> {
            ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, عدد_القيمة);
            الموضع := عدد_القيمة;
        }
        | اختيار.بعض(المطابقة) -> {
            ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, المطابقة);
            ألحق_نطاق_نص(&متغير البايتات, البديل, 0, الطول(*البديل) مثل غير_موقع);
            الموضع := المطابقة + عدد_المطلوب;
        };
    }
    أرجع من_بايتات(&البايتات);
}

عام مرادف trim_start = قص_بداية_النص;
عام مرادف trim_end = قص_نهاية_النص;
عام مرادف trim = قص_النص;
عام مرادف split = قسم_النص;
عام مرادف join = صل_النصوص;
عام مرادف replace = استبدل_في_النص;

// Splits LF/CRLF text into logical lines. A final line terminator does not
// synthesize an additional empty line; interior empty lines are preserved.
عام عرف أسطر_النص(القيمة: &نص): متجه نص {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع الناتج: متغير متجه نص = [];
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (النص[ف] == 0x0A) {
            دع النهاية: متغير غير_موقع = ف;
            لو (النهاية > البداية) {
                دع السابق: غير_موقع = النهاية - 1;
                لو (النص[السابق] == 0x0D) { النهاية := السابق; };
            };
            طابق مقطع_نص(&النص, البداية, النهاية - البداية) مع
            | اختيار.بعض(السطر) -> { ألحق(الناتج, السطر); }
            | اختيار.لا_شيء -> { };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    لو (البداية < العدد) {
        طابق مقطع_نص(&النص, البداية, العدد - البداية) مع
        | اختيار.بعض(السطر) -> { ألحق(الناتج, السطر); }
        | اختيار.لا_شيء -> { };
    };
    أرجع الناتج;
}

عام عرف كرر_النص(القيمة: &نص, المرات: غير_موقع): نص {
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    بينما (ف < المرات) {
        ألحق_نطاق_نص(&متغير البايتات, القيمة, 0, العدد);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام مرادف lines = أسطر_النص;
عام مرادف repeat_text = كرر_النص;
