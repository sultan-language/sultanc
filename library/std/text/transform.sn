استورد text.from_bytes;
استورد text.substring;
استورد text.search;
استورد encoding.utf8;
استورد unicode.properties;

عرف ألحق_نطاق_نص(
    الناتج: &متغير متجه ط8,
    القيمة: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): فراغ {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(*الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
}

عام عرف قص_بداية_النص(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && (الموضع < العدد)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&النص, الموضع);
        لو (!المفكوك.صالح || !محرف_فراغ_يونيكود(المفكوك.القيمة)) {
            مستمر := خطأ;
        } وإلا {
            الموضع := الموضع + المفكوك.العرض;
        };
    }
    طابق مقطع_نص(&النص, الموضع, العدد - الموضع) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام عرف قص_نهاية_النص(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    دع نهاية_غير_فارغة: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&النص, الموضع);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            نهاية_غير_فارغة := الموضع + 1;
            الموضع := الموضع + 1;
        } وإلا {
            الموضع := الموضع + المفكوك.العرض;
            لو (!محرف_فراغ_يونيكود(المفكوك.القيمة)) {
                نهاية_غير_فارغة := الموضع;
            };
        };
    }
    طابق مقطع_نص(&النص, 0, نهاية_غير_فارغة) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام عرف قص_النص(القيمة: &نص): نص {
    دع من_البداية: نص = قص_بداية_النص(القيمة);
    أرجع قص_نهاية_النص(&من_البداية);
}

عام عرف قسم_النص(القيمة: &نص, الفاصل: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_الفاصل: طبيعي = الطول(*الفاصل) مثل طبيعي;
    لو (عدد_الفاصل == 0) {
        ألحق(الناتج, انسخ_نص(القيمة));
        أرجع الناتج;
    };
    دع البداية: متغير طبيعي = 0;
    طالما (البداية <= عدد_القيمة) {
        طابق ابحث_نصا_من(القيمة, الفاصل, البداية) مع
        | اختياري.لا_شيء -> {
            طابق مقطع_نص(القيمة, البداية, عدد_القيمة - البداية) مع
            | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
            | اختياري.لا_شيء -> { };
            أرجع الناتج;
        }
        | اختياري.موجود(الموضع) -> {
            طابق مقطع_نص(القيمة, البداية, الموضع - البداية) مع
            | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
            | اختياري.لا_شيء -> { };
            البداية := الموضع + عدد_الفاصل;
        };
    }
    أرجع الناتج;
}

عام عرف صل_النصوص(القيم: &متجه نص, الفاصل: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        لو (ف > 0) {
            ألحق_نطاق_نص(&متغير البايتات, الفاصل, 0, الطول(*الفاصل) مثل طبيعي);
        };
        ألحق_نطاق_نص(&متغير البايتات, &(*القيم)[ف], 0, الطول((*القيم)[ف]) مثل طبيعي);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف استبدل_في_النص(القيمة: &نص, المطلوب: &نص, البديل: &نص): نص {
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    لو (عدد_المطلوب == 0) { أرجع انسخ_نص(القيمة); };
    دع البايتات: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < عدد_القيمة) {
        طابق ابحث_نصا_من(القيمة, المطلوب, الموضع) مع
        | اختياري.لا_شيء -> {
            ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, عدد_القيمة);
            الموضع := عدد_القيمة;
        }
        | اختياري.موجود(المطابقة) -> {
            ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, المطابقة);
            ألحق_نطاق_نص(&متغير البايتات, البديل, 0, الطول(*البديل) مثل طبيعي);
            الموضع := المطابقة + عدد_المطلوب;
        };
    }
    أرجع من_بايتات(&البايتات);
}

عام مرادف trim_start = قص_بداية_النص;
عام مرادف trim_end = قص_نهاية_النص;
عام مرادف trim = قص_النص;
عام مرادف split = قسم_النص;
عام مرادف join = صل_النصوص;
عام مرادف replace = استبدل_في_النص;

// Splits LF/CRLF text into logical lines. A final line terminator does not
// synthesize an additional empty line; interior empty lines are preserved.
عام عرف أسطر_النص(القيمة: &نص): متجه نص {
    دع النص: نص = *القيمة;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الناتج: متغير متجه نص = [];
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (النص[ف] == 0x0A) {
            دع النهاية: متغير طبيعي = ف;
            لو (النهاية > البداية) {
                دع السابق: طبيعي = النهاية - 1;
                لو (النص[السابق] == 0x0D) { النهاية := السابق; };
            };
            طابق مقطع_نص(&النص, البداية, النهاية - البداية) مع
            | اختياري.موجود(السطر) -> { ألحق(الناتج, السطر); }
            | اختياري.لا_شيء -> { };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    لو (البداية < العدد) {
        طابق مقطع_نص(&النص, البداية, العدد - البداية) مع
        | اختياري.موجود(السطر) -> { ألحق(الناتج, السطر); }
        | اختياري.لا_شيء -> { };
    };
    أرجع الناتج;
}

عام عرف كرر_النص(القيمة: &نص, المرات: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    لو ((العدد == 0) || (المرات == 0)) { أرجع «»; };
    طالما (ف < المرات) {
        ألحق_نطاق_نص(&متغير البايتات, القيمة, 0, العدد);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام مرادف lines = أسطر_النص;
عام مرادف repeat_text = كرر_النص;

// Splits on runs of Unicode white space (Rust split_whitespace, Go
// strings.Fields): no empty pieces, leading and trailing space ignored.
// Invalid UTF-8 bytes are kept inside pieces.
عام عرف قسم_بالفراغات(القيمة: &نص): متجه نص {
    دع النص: نص = *القيمة;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الناتج: متغير متجه نص = [];
    دع البداية: متغير طبيعي = 0;
    دع داخل: متغير منطقي = خطأ;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&النص, الموضع);
        دع العرض: متغير طبيعي = المفكوك.العرض;
        لو (العرض == 0) { العرض := 1; };
        دع فاصل_أبيض: منطقي = المفكوك.صالح && محرف_فراغ_يونيكود(المفكوك.القيمة);
        لو (فاصل_أبيض) {
            لو (داخل) {
                طابق مقطع_نص(&النص, البداية, الموضع - البداية) مع
                | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
                | اختياري.لا_شيء -> { };
                داخل := خطأ;
            };
        } وإلا لو (!داخل) {
            البداية := الموضع;
            داخل := صواب;
        };
        الموضع := الموضع + العرض;
    }
    لو (داخل) {
        طابق مقطع_نص(&النص, البداية, العدد - البداية) مع
        | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
        | اختياري.لا_شيء -> { };
    };
    أرجع الناتج;
}

// At most الحد pieces: the last one holds the rest unsplit (Rust splitn, Go
// strings.SplitN with n > 0). الحد 0 gives no pieces.
عام عرف قسم_النص_بحد(القيمة: &نص, الفاصل: &نص, الحد: طبيعي): متجه نص {
    دع الناتج: متغير متجه نص = [];
    لو (الحد == 0) { أرجع الناتج; };
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_الفاصل: طبيعي = الطول(*الفاصل) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    طالما ((الطول(الناتج) مثل طبيعي) + 1 < الحد && عدد_الفاصل > 0) {
        طابق ابحث_نصا_من(القيمة, الفاصل, البداية) مع
        | اختياري.لا_شيء -> { اخرج_من_حلقة; }
        | اختياري.موجود(الموضع) -> {
            طابق مقطع_نص(القيمة, البداية, الموضع - البداية) مع
            | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
            | اختياري.لا_شيء -> { };
            البداية := الموضع + عدد_الفاصل;
        };
    }
    طابق مقطع_نص(القيمة, البداية, عدد_القيمة - البداية) مع
    | اختياري.موجود(الجزء) -> { ألحق(الناتج, الجزء); }
    | اختياري.لا_شيء -> { };
    أرجع الناتج;
}

// Replaces the first الحد non-overlapping matches (Rust replacen, Go
// strings.Replace with n >= 0).
عام عرف استبدل_في_النص_بحد(القيمة: &نص, المطلوب: &نص, البديل: &نص, الحد: طبيعي): نص {
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    لو (عدد_المطلوب == 0 || الحد == 0) { أرجع انسخ_نص(القيمة); };
    دع البايتات: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    دع المستبدل: متغير طبيعي = 0;
    طالما (الموضع < عدد_القيمة && المستبدل < الحد) {
        طابق ابحث_نصا_من(القيمة, المطلوب, الموضع) مع
        | اختياري.لا_شيء -> { اخرج_من_حلقة; }
        | اختياري.موجود(المطابقة) -> {
            ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, المطابقة);
            ألحق_نطاق_نص(&متغير البايتات, البديل, 0, الطول(*البديل) مثل طبيعي);
            الموضع := المطابقة + عدد_المطلوب;
            المستبدل := المستبدل + 1;
        };
    }
    ألحق_نطاق_نص(&متغير البايتات, القيمة, الموضع, عدد_القيمة);
    أرجع من_بايتات(&البايتات);
}

// The text without البادئة, or nothing when it does not start with it
// (Rust strip_prefix, Go strings.CutPrefix).
عام عرف أزل_البادئة(القيمة: &نص, البادئة: &نص): اختياري نص {
    لو (!يبدأ_بـ(القيمة, البادئة)) { أرجع اختياري.لا_شيء(); };
    دع البداية: طبيعي = الطول(*البادئة) مثل طبيعي;
    أرجع مقطع_نص(القيمة, البداية, (الطول(*القيمة) مثل طبيعي) - البداية);
}

عام عرف أزل_اللاحقة(القيمة: &نص, اللاحقة: &نص): اختياري نص {
    لو (!ينتهي_بـ(القيمة, اللاحقة)) { أرجع اختياري.لا_شيء(); };
    أرجع مقطع_نص(القيمة, 0, (الطول(*القيمة) مثل طبيعي) - (الطول(*اللاحقة) مثل طبيعي));
}

// ASCII letters A-Z / a-z mapped; every other byte unchanged (Rust
// to_ascii_lowercase / to_ascii_uppercase). std.unicode.case_mapping maps
// every script.
عام عرف حول_النص_إلى_صغير_أسكي(القيمة: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        دع البايت: ط8 = (*القيمة)[ف];
        لو (البايت >= 0x41 && البايت <= 0x5A) { ألحق(البايتات, البايت + 0x20); }
        وإلا { ألحق(البايتات, البايت); };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف حول_النص_إلى_كبير_أسكي(القيمة: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        دع البايت: ط8 = (*القيمة)[ف];
        لو (البايت >= 0x61 && البايت <= 0x7A) { ألحق(البايتات, البايت - 0x20); }
        وإلا { ألحق(البايتات, البايت); };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام مرادف split_whitespace = قسم_بالفراغات;
عام مرادف splitn = قسم_النص_بحد;
عام مرادف replacen = استبدل_في_النص_بحد;
عام مرادف strip_prefix = أزل_البادئة;
عام مرادف strip_suffix = أزل_اللاحقة;
عام مرادف to_ascii_lowercase = حول_النص_إلى_صغير_أسكي;
عام مرادف to_ascii_uppercase = حول_النص_إلى_كبير_أسكي;
