// std.text.bidi: direction isolation for mixed right-to-left and
// left-to-right text (docs/ERRORS.md, "Language versions").
//
// A value of one direction embedded in a sentence of the other (a Latin
// message after an Arabic word, an Arabic one after an English word) is
// wrapped in a Unicode first-strong isolate, U+2068 … U+2069 (UAX #9), so it
// keeps its own order and the punctuation around it stays in place.
//
// A character's direction is approximated by script ranges, not by the
// Unicode Bidi_Class table: Hebrew, Arabic, Syriac, Thaana, NKo and the other
// right-to-left blocks are right-to-left (their digits and combining marks
// excepted); Latin, Greek, Cyrillic, Armenian, the Indic and East Asian
// scripts are left-to-right; everything else is neutral.
//
// Pure SultanC within the C Stage0's language.

عام نوع اتجاه_نص =
    | محايد
    | من_اليسار_إلى_اليمين
    | من_اليمين_إلى_اليسار;

// The length in bytes of the UTF-8 sequence starting at byte الموضع: 1 for
// a malformed or truncated sequence, which then reads as its first byte.
عرف طول_محرف_عند(النص: &نص, الموضع: طبيعي): طبيعي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع الأول: ط8 = (*النص)[الموضع];
    دع المطلوب: متغير طبيعي = 1;
    لو (الأول >= 0xF0 && الأول < 0xF8) {
        المطلوب := 4;
    } وإلا لو (الأول >= 0xE0 && الأول < 0xF0) {
        المطلوب := 3;
    } وإلا لو (الأول >= 0xC0 && الأول < 0xE0) {
        المطلوب := 2;
    };
    لو (الموضع + المطلوب > العدد) { أرجع 1; };
    أرجع المطلوب;
}

// The code point of the الطول_بالبايت-byte sequence starting at byte الموضع.
عرف قيمة_محرف_عند(النص: &نص, الموضع: طبيعي, الطول_بالبايت: طبيعي): ط32 {
    دع الأول: ط32 = (*النص)[الموضع] مثل ط32;
    لو (الطول_بالبايت == 1) { أرجع الأول; };
    دع الناتج: متغير ط32 = الأول & 0x07;
    لو (الطول_بالبايت == 3) { الناتج := الأول & 0x0F; };
    لو (الطول_بالبايت == 2) { الناتج := الأول & 0x1F; };
    دع ف: متغير طبيعي = 1;
    طالما (ف < الطول_بالبايت) {
        دع التالي: ط32 = (*النص)[الموضع + ف] مثل ط32;
        الناتج := (الناتج << 6) | (التالي & 0x3F);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// 0 neutral, 1 left-to-right, 2 right-to-left.
عرف اتجاه_محرف(القيمة: ط32): عدد {
    لو ((القيمة >= 0x41 && القيمة <= 0x5A) || (القيمة >= 0x61 && القيمة <= 0x7A)) { أرجع 1; };
    لو (القيمة < 0x80) { أرجع 0; };
    // Right-to-left blocks, without their digits and combining marks.
    لو (القيمة >= 0x0590 && القيمة <= 0x08FF) {
        لو (القيمة >= 0x0591 && القيمة <= 0x05C7) { أرجع 0; };
        لو (القيمة >= 0x0600 && القيمة <= 0x0605) { أرجع 0; };
        لو (القيمة >= 0x0610 && القيمة <= 0x061A) { أرجع 0; };
        لو (القيمة >= 0x064B && القيمة <= 0x066C) { أرجع 0; };
        لو (القيمة == 0x0670) { أرجع 0; };
        لو (القيمة >= 0x06D6 && القيمة <= 0x06ED && القيمة != 0x06E5 && القيمة != 0x06E6) { أرجع 0; };
        لو (القيمة >= 0x06F0 && القيمة <= 0x06F9) { أرجع 0; };
        أرجع 2;
    };
    لو (القيمة >= 0xFB1D && القيمة <= 0xFDFF) { أرجع 2; };
    لو (القيمة >= 0xFE70 && القيمة <= 0xFEFF) { أرجع 2; };
    لو (القيمة >= 0x10800 && القيمة <= 0x10FFF) { أرجع 2; };
    لو (القيمة >= 0x1E800 && القيمة <= 0x1EFFF) { أرجع 2; };
    // Left-to-right scripts.
    لو (القيمة == 0xAA || القيمة == 0xB5 || القيمة == 0xBA) { أرجع 1; };
    لو (القيمة >= 0xC0 && القيمة <= 0x02B8 && القيمة != 0xD7 && القيمة != 0xF7) { أرجع 1; };
    لو (القيمة >= 0x0370 && القيمة <= 0x058F) {
        لو (القيمة >= 0x0483 && القيمة <= 0x0489) { أرجع 0; };
        لو (القيمة == 0x037E || القيمة == 0x0384 || القيمة == 0x0385 || القيمة == 0x0387) { أرجع 0; };
        أرجع 1;
    };
    لو (القيمة >= 0x0900 && القيمة <= 0x1FFF) { أرجع 1; };
    لو (القيمة >= 0x2C00 && القيمة <= 0x2DFF) { أرجع 1; };
    لو (القيمة >= 0x3040 && القيمة <= 0xD7FF) { أرجع 1; };
    لو (القيمة >= 0xF900 && القيمة <= 0xFB17) { أرجع 1; };
    لو ((القيمة >= 0xFF21 && القيمة <= 0xFF3A) || (القيمة >= 0xFF41 && القيمة <= 0xFF5A)) { أرجع 1; };
    لو (القيمة >= 0x10000 && القيمة <= 0x107FF) { أرجع 1; };
    لو (القيمة >= 0x11000 && القيمة <= 0x1E7FF) { أرجع 1; };
    لو (القيمة >= 0x20000 && القيمة <= 0x3FFFF) { أرجع 1; };
    أرجع 0;
}

// 0, 1 or 2 as above: the direction of the text's first strong character,
// skipping what lies inside isolates (U+2066, U+2067, U+2068 … U+2069), as
// rules P2 and P3 of UAX #9 do.
عرف رمز_اتجاه_النص(النص: &نص): عدد {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع العمق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الطول_بالبايت: طبيعي = طول_محرف_عند(النص, ف);
        دع القيمة: ط32 = قيمة_محرف_عند(النص, ف, الطول_بالبايت);
        لو (القيمة >= 0x2066 && القيمة <= 0x2068) {
            العمق := العمق + 1;
        } وإلا لو (القيمة == 0x2069) {
            لو (العمق > 0) { العمق := العمق - 1; };
        } وإلا لو (العمق == 0) {
            دع الاتجاه: عدد = اتجاه_محرف(القيمة);
            لو (الاتجاه != 0) { أرجع الاتجاه; };
        };
        ف := ف + الطول_بالبايت;
    }
    أرجع 0;
}

عرف رمز_اتجاه(الاتجاه: &اتجاه_نص): عدد {
    طابق *الاتجاه مع
    | اتجاه_نص.محايد -> { أرجع 0; }
    | اتجاه_نص.من_اليسار_إلى_اليمين -> { أرجع 1; }
    | اتجاه_نص.من_اليمين_إلى_اليسار -> { أرجع 2; };
}

// The direction of the text's first strong character: the direction a
// first-strong isolate gives it.
عام عرف اتجاه_النص(النص: &نص): اتجاه_نص {
    دع الرمز: عدد = رمز_اتجاه_النص(النص);
    لو (الرمز == 1) { أرجع اتجاه_نص.من_اليسار_إلى_اليمين(); };
    لو (الرمز == 2) { أرجع اتجاه_نص.من_اليمين_إلى_اليسار(); };
    أرجع اتجاه_نص.محايد();
}

// The text wrapped in a first-strong isolate: U+2068, the text, U+2069.
عام عرف اعزل_اتجاه(النص: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, 0xE2 مثل ط8);
    ألحق(الناتج, 0x81 مثل ط8);
    ألحق(الناتج, 0xA8 مثل ط8);
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, (*النص)[ف]);
        ف := ف + 1;
    }
    ألحق(الناتج, 0xE2 مثل ط8);
    ألحق(الناتج, 0x81 مثل ط8);
    ألحق(الناتج, 0xA9 مثل ط8);
    أرجع الناتج مثل نص;
}

// The text as it goes into a sentence of direction السياق: isolated when its
// own direction is the other one, an unchanged copy otherwise (a neutral
// text, a neutral context, or the same direction).
عام عرف اعزل_اتجاه_في(النص: &نص, السياق: اتجاه_نص): نص {
    دع الخاص: عدد = رمز_اتجاه_النص(النص);
    دع العام: عدد = رمز_اتجاه(&السياق);
    لو (الخاص != 0 && العام != 0 && الخاص != العام) { أرجع اعزل_اتجاه(النص); };
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

عام مرادف text_direction = اتجاه_نص;
عام مرادف text_direction.neutral = اتجاه_نص.محايد;
عام مرادف text_direction.left_to_right = اتجاه_نص.من_اليسار_إلى_اليمين;
عام مرادف text_direction.right_to_left = اتجاه_نص.من_اليمين_إلى_اليسار;
عام مرادف text_direction_of = اتجاه_النص;
عام مرادف bidi_isolate = اعزل_اتجاه;
عام مرادف bidi_isolate_in = اعزل_اتجاه_في;
