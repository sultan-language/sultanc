استورد text.compare;

عام عرف نص_فارغ(القيمة: &نص): منطقي {
    أرجع الطول(*القيمة) == 0;
}

عام عرف يبدأ_بـ(القيمة: &نص, المطلوب: &نص): منطقي {
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    لو (عدد_المطلوب > عدد_القيمة) { أرجع خطأ; };
    أرجع يطابق_شريحتين(القيمة, 0, عدد_المطلوب, المطلوب, 0, عدد_المطلوب);
}

عام عرف ينتهي_بـ(القيمة: &نص, المطلوب: &نص): منطقي {
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    لو (عدد_المطلوب > عدد_القيمة) { أرجع خطأ; };
    دع البداية: طبيعي = عدد_القيمة - عدد_المطلوب;
    أرجع يطابق_شريحتين(القيمة, البداية, عدد_القيمة, المطلوب, 0, عدد_المطلوب);
}

عام عرف ابحث_نصا_من(
    القيمة: &نص,
    المطلوب: &نص,
    البداية: طبيعي
): اختياري طبيعي {
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    لو (البداية > عدد_القيمة) { أرجع اختياري.لا_شيء(); };
    لو (عدد_المطلوب == 0) { أرجع اختياري.موجود(البداية); };
    لو (عدد_المطلوب > (عدد_القيمة - البداية)) { أرجع اختياري.لا_شيء(); };
    دع الحد: طبيعي = عدد_القيمة - عدد_المطلوب;
    دع ف: متغير طبيعي = البداية;
    طالما (ف <= الحد) {
        لو (يطابق_شريحتين(القيمة, ف, ف + عدد_المطلوب, المطلوب, 0, عدد_المطلوب)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ابحث_نصا(القيمة: &نص, المطلوب: &نص): اختياري طبيعي {
    أرجع ابحث_نصا_من(القيمة, المطلوب, 0);
}

عام عرف ابحث_نصا_عكسيا(القيمة: &نص, المطلوب: &نص): اختياري طبيعي {
    دع عدد_القيمة: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    لو (عدد_المطلوب == 0) { أرجع اختياري.موجود(عدد_القيمة); };
    لو (عدد_المطلوب > عدد_القيمة) { أرجع اختياري.لا_شيء(); };
    دع البداية: طبيعي = عدد_القيمة - عدد_المطلوب;
    دع ف: متغير طبيعي = البداية;
    طالما (صواب) {
        لو (يطابق_شريحتين(القيمة, ف, ف + عدد_المطلوب, المطلوب, 0, عدد_المطلوب)) {
            أرجع اختياري.موجود(ف);
        };
        لو (ف == 0) { أرجع اختياري.لا_شيء(); };
        ف := ف - 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف يحتوي_نصا(القيمة: &نص, المطلوب: &نص): منطقي {
    طابق ابحث_نصا(القيمة, المطلوب) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام مرادف is_empty = نص_فارغ;
عام مرادف starts_with = يبدأ_بـ;
عام مرادف ends_with = ينتهي_بـ;
عام مرادف find_from = ابحث_نصا_من;
عام مرادف find = ابحث_نصا;
عام مرادف rfind = ابحث_نصا_عكسيا;
عام مرادف contains = يحتوي_نصا;

// Non-overlapping occurrences of المطلوب (Go strings.Count); an empty
// المطلوب occurs before every Unicode scalar and at the end.
عام عرف عد_تكرارات_النص(القيمة: &نص, المطلوب: &نص): طبيعي {
    دع عدد_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    لو (عدد_المطلوب == 0) { أرجع عدد_محارف_النص(القيمة) + 1; };
    دع العدد: متغير طبيعي = 0;
    دع الموضع: متغير طبيعي = 0;
    طالما (صواب) {
        طابق ابحث_نصا_من(القيمة, المطلوب, الموضع) مع
        | اختياري.لا_شيء -> { أرجع العدد; }
        | اختياري.موجود(المطابقة) -> {
            العدد := العدد + 1;
            الموضع := المطابقة + عدد_المطلوب;
        };
    }
    أرجع العدد;
}

// The number of Unicode scalars: bytes that are not UTF-8 continuation
// bytes (10xxxxxx). Byte length is الطول.
عام عرف عدد_محارف_النص(القيمة: &نص): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        لو (((*القيمة)[ف] & 0xC0) != 0x80) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

// Equal when ASCII letters are compared without case (Rust
// eq_ignore_ascii_case); other bytes must match exactly.
عام عرف نصان_متساويان_بلا_حالة_أسكي(الأول: &نص, الثاني: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الأول) مثل طبيعي;
    لو (العدد != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع أ: متغير ط8 = (*الأول)[ف];
        دع ب: متغير ط8 = (*الثاني)[ف];
        لو (أ >= 0x41 && أ <= 0x5A) { أ := أ + 0x20; };
        لو (ب >= 0x41 && ب <= 0x5A) { ب := ب + 0x20; };
        لو (أ != ب) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام مرادف count_matches = عد_تكرارات_النص;
عام مرادف char_count = عدد_محارف_النص;
عام مرادف eq_ignore_ascii_case = نصان_متساويان_بلا_حالة_أسكي;
