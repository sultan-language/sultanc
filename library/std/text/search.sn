استورد text.compare;

عام عرف نص_فارغ(القيمة: &نص): منطقي {
    أرجع الطول(*القيمة) == 0;
}

عام عرف يبدأ_بـ(القيمة: &نص, المطلوب: &نص): منطقي {
    دع عدد_المطلوب: غير_موقع = الطول(*المطلوب) مثل غير_موقع;
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    لو (عدد_المطلوب > عدد_القيمة) { أرجع خطأ; };
    أرجع يطابق_شريحتين(القيمة, 0, عدد_المطلوب, المطلوب, 0, عدد_المطلوب);
}

عام عرف ينتهي_بـ(القيمة: &نص, المطلوب: &نص): منطقي {
    دع عدد_المطلوب: غير_موقع = الطول(*المطلوب) مثل غير_موقع;
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    لو (عدد_المطلوب > عدد_القيمة) { أرجع خطأ; };
    دع البداية: غير_موقع = عدد_القيمة - عدد_المطلوب;
    أرجع يطابق_شريحتين(القيمة, البداية, عدد_القيمة, المطلوب, 0, عدد_المطلوب);
}

عام عرف ابحث_نصا_من(
    القيمة: &نص,
    المطلوب: &نص,
    البداية: غير_موقع
): اختيار غير_موقع {
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    دع عدد_المطلوب: غير_موقع = الطول(*المطلوب) مثل غير_موقع;
    لو (البداية > عدد_القيمة) { أرجع اختيار.لا_شيء(); };
    لو (عدد_المطلوب == 0) { أرجع اختيار.بعض(البداية); };
    لو (عدد_المطلوب > (عدد_القيمة - البداية)) { أرجع اختيار.لا_شيء(); };
    دع الحد: غير_موقع = عدد_القيمة - عدد_المطلوب;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف <= الحد) {
        لو (يطابق_شريحتين(القيمة, ف, ف + عدد_المطلوب, المطلوب, 0, عدد_المطلوب)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابحث_نصا(القيمة: &نص, المطلوب: &نص): اختيار غير_موقع {
    أرجع ابحث_نصا_من(القيمة, المطلوب, 0);
}

عام عرف ابحث_نصا_عكسيا(القيمة: &نص, المطلوب: &نص): اختيار غير_موقع {
    دع عدد_القيمة: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    دع عدد_المطلوب: غير_موقع = الطول(*المطلوب) مثل غير_موقع;
    لو (عدد_المطلوب == 0) { أرجع اختيار.بعض(عدد_القيمة); };
    لو (عدد_المطلوب > عدد_القيمة) { أرجع اختيار.لا_شيء(); };
    دع البداية: غير_موقع = عدد_القيمة - عدد_المطلوب;
    دع ف: متغير غير_موقع = البداية;
    بينما (صواب) {
        لو (يطابق_شريحتين(القيمة, ف, ف + عدد_المطلوب, المطلوب, 0, عدد_المطلوب)) {
            أرجع اختيار.بعض(ف);
        };
        لو (ف == 0) { أرجع اختيار.لا_شيء(); };
        ف := ف - 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف يحتوي_نصا(القيمة: &نص, المطلوب: &نص): منطقي {
    طابق ابحث_نصا(القيمة, المطلوب) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام مرادف is_empty = نص_فارغ;
عام مرادف starts_with = يبدأ_بـ;
عام مرادف ends_with = ينتهي_بـ;
عام مرادف find_from = ابحث_نصا_من;
عام مرادف find = ابحث_نصا;
عام مرادف rfind = ابحث_نصا_عكسيا;
عام مرادف contains = يحتوي_نصا;
