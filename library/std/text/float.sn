// Float text: parsing a decimal into the nearest f64/f32 and formatting a
// float as the shortest decimal that reads back to it (Rust's f64::from_str
// and Display, Go's strconv.ParseFloat and FormatFloat(f, 'g', -1, 64)).
//
// Parsing is exact: the decimal D * 10^E is turned into a 64-bit binary
// quotient with a remainder bit using big integers, then rounded half to
// even (the results of the compiler's float-literal algorithm,
// compiler/msir/decimal_float_bits.sn, which std cannot import).
//
// Formatting finds the shortest round-trip digits exactly, as the
// Steele & White / Burger & Dybvig free-format algorithm ("Printing
// Floating-Point Numbers Quickly and Accurately", PLDI 1996) does with big
// integers: the float's rounding interval [v - ulp/2, v + ulp/2] (the bounds
// included when the significand is even, as round-half-even parsing reads
// them) is computed as exact decimals, and the closest decimal with the fewest
// significant digits inside it is chosen. The layout follows ECMAScript's
// Number::toString: positional between 1e-7 and 1e21, otherwise d.ddde±x.
// The binary values are made exact decimals with base-10^9 integers (one
// power of two or five, by 2^29 or 5^13 per step, shared by the value and its
// two bounds); the comparisons and rounding then work on digit vectors. This needs no tables, unlike Ryu, and gives the same
// digits.

استورد math.float;
استورد text.from_bytes;
استورد text.compare;

// ---- Exact decimals: digits (most significant first) and the number of
// digits before the point.
نوع عمل_عشري = {
    الأرقام: متجه ط8,
    النقطة: عدد
};


// ---- Exact parsing with binary big integers -----------------------------
// A decimal D * 10^E (D an integer of the input's digits) is rounded to the
// nearest float, half to even, exactly: D * 5^E * 2^E for E >= 0, and the
// quotient of D * 2^s by 5^-E with a remainder bit for E < 0, as the big
// integer fallback of Clinger's algorithm (and Go's strconv, Rust's dec2flt)
// computes it. Integers are base-2^32 limbs, least significant first.

// The integer times المضروب (below 2^32) plus الإضافة (below 2^32).
عرف اضرب_وأضف_أطرافا(الأطراف: &متغير متجه طبيعي, المضروب: طبيعي, الإضافة: طبيعي): فراغ {
    دع الحمل: متغير طبيعي = الإضافة;
    دع العدد: طبيعي = الطول(*الأطراف) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الجداء: طبيعي = (*الأطراف)[ف] * المضروب + الحمل;
        (*الأطراف)[ف] := الجداء & 0xFFFFFFFF;
        الحمل := الجداء >> 32;
        ف := ف + 1;
    }
    إذا (الحمل != 0) { ألحق(*الأطراف, الحمل); };
}

// The number of significant bits (0 for zero).
عرف بتات_أطراف(الأطراف: &متجه طبيعي): طبيعي {
    دع ف: متغير طبيعي = الطول(*الأطراف) مثل طبيعي;
    طالما (ف > 0 && (*الأطراف)[ف - 1] == 0) { ف := ف - 1; }
    إذا (ف == 0) { أرجع 0; };
    دع الأعلى: متغير طبيعي = (*الأطراف)[ف - 1];
    دع البتات: متغير طبيعي = (ف - 1) * 32;
    طالما (الأعلى != 0) { البتات := البتات + 1; الأعلى := الأعلى >> 1; }
    أرجع البتات;
}

// The integer shifted left by الإزاحة bits.
عرف أطراف_مزاحة_يسارا(الأطراف: &متجه طبيعي, الإزاحة: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الإزاحة / 32) { ألحق(الناتج, 0); ف := ف + 1; }
    دع البتات: طبيعي = الإزاحة % 32;
    دع الحمل: متغير طبيعي = 0;
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(*الأطراف) مثل طبيعي)) {
        دع القيمة: طبيعي = ((*الأطراف)[ي] << البتات) | الحمل;
        ألحق(الناتج, القيمة & 0xFFFFFFFF);
        الحمل := القيمة >> 32;
        ي := ي + 1;
    }
    إذا (الحمل != 0) { ألحق(الناتج, الحمل); };
    أرجع الناتج;
}

عرف بت_أطراف(الأطراف: &متجه طبيعي, الموضع: طبيعي): طبيعي {
    دع الطرف: طبيعي = الموضع / 32;
    إذا (الطرف >= (الطول(*الأطراف) مثل طبيعي)) { أرجع 0; };
    أرجع ((*الأطراف)[الطرف] >> (الموضع % 32)) & 1;
}

// -1, 0 or 1: أ against ب.
عرف قارن_أطرافا(أ: &متجه طبيعي, ب: &متجه طبيعي): عدد {
    دع طول_أ: طبيعي = الطول(*أ) مثل طبيعي;
    دع طول_ب: طبيعي = الطول(*ب) مثل طبيعي;
    دع ف: متغير طبيعي = طول_أ;
    إذا (طول_ب > ف) { ف := طول_ب; };
    طالما (ف > 0) {
        ف := ف - 1;
        دع س: متغير طبيعي = 0;
        دع ص: متغير طبيعي = 0;
        إذا (ف < طول_أ) { س := (*أ)[ف]; };
        إذا (ف < طول_ب) { ص := (*ب)[ف]; };
        إذا (س != ص) { إذا (س < ص) { أرجع -1; }; أرجع 1; };
    }
    أرجع 0;
}

// أ - ب in place, for أ >= ب.
عرف اطرح_أطرافا(أ: &متغير متجه طبيعي, ب: &متجه طبيعي): فراغ {
    دع الاستلاف: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        دع المطروح: متغير طبيعي = الاستلاف;
        إذا (ف < (الطول(*ب) مثل طبيعي)) { المطروح := المطروح + (*ب)[ف]; };
        إذا ((*أ)[ف] >= المطروح) {
            (*أ)[ف] := (*أ)[ف] - المطروح;
            الاستلاف := 0;
        } وإلا {
            (*أ)[ف] := ((*أ)[ف] + 0x100000000) - المطروح;
            الاستلاف := 1;
        };
        ف := ف + 1;
    }
}

// 2r + bit in place.
عرف ضاعف_أطرافا_مع_بت(أ: &متغير متجه طبيعي, البت: طبيعي): فراغ {
    دع الحمل: متغير طبيعي = البت;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        دع القيمة: طبيعي = ((*أ)[ف] << 1) | الحمل;
        (*أ)[ف] := القيمة & 0xFFFFFFFF;
        الحمل := القيمة >> 32;
        ف := ف + 1;
    }
    إذا (الحمل != 0) { ألحق(*أ, الحمل); };
}

// The bits of the nearest float of the given precision to q * 2^x (q nonzero,
// at most 64 bits; اللاصق: the exact value is a little above q * 2^x).
عرف قرب_إلى_عائم(ق: طبيعي, س: عدد, اللاصق_الأصلي: منطقي, الدقة: طبيعي, بتات_الأس: طبيعي): طبيعي {
    دع واحد: طبيعي = 1;
    دع الانحياز: عدد = ((واحد << (بتات_الأس - 1)) - 1) مثل عدد;
    دع أصغر_أس: عدد = 1 - الانحياز;
    دع كل_الأس: طبيعي = (واحد << بتات_الأس) - 1;
    دع لانهاية: طبيعي = كل_الأس << (الدقة - 1);
    // Normalise q to 64 bits.
    دع الدلالة: متغير طبيعي = ق;
    دع الأس: متغير عدد = س;
    طالما ((الدلالة >> 63) == 0) { الدلالة := الدلالة << 1; الأس := الأس - 1; }
    // value = significand * 2^(e - 63), in [2^e, 2^(e+1)).
    دع الرتبة: عدد = الأس + 63;
    إذا (الرتبة > الانحياز) { أرجع لانهاية; };
    // Bits dropped below the kept precision (more for a subnormal).
    دع المسقطة: متغير طبيعي = 64 - الدقة;
    إذا (الرتبة < أصغر_أس) {
        دع الفرق: طبيعي = (أصغر_أس - الرتبة) مثل طبيعي;
        إذا (الفرق > 64) { أرجع 0; };
        المسقطة := المسقطة + الفرق;
    };
    دع المحتفظ: متغير طبيعي = 0;
    دع الحارس: متغير منطقي = خطأ;
    دع اللاصق: متغير منطقي = اللاصق_الأصلي;
    إذا (المسقطة < 64) {
        المحتفظ := الدلالة >> المسقطة;
        الحارس := ((الدلالة >> (المسقطة - 1)) & 1) != 0;
        إذا ((الدلالة & ((واحد << (المسقطة - 1)) - 1)) != 0) { اللاصق := صواب; };
    } وإلا إذا (المسقطة == 64) {
        الحارس := (الدلالة >> 63) != 0;
        إذا ((الدلالة & ((واحد << 63) - 1)) != 0) { اللاصق := صواب; };
    } وإلا {
        أرجع 0;
    };
    إذا (الحارس && (اللاصق || (المحتفظ & 1) != 0)) { المحتفظ := المحتفظ + 1; };
    إذا (الرتبة < أصغر_أس) {
        // A subnormal; rounding up to 2^(p-1) is the smallest normal, whose
        // encoding is that same integer.
        أرجع المحتفظ;
    };
    دع الرتبة_النهائية: متغير عدد = الرتبة;
    إذا (المحتفظ == (واحد << الدقة)) { المحتفظ := المحتفظ >> 1; الرتبة_النهائية := الرتبة_النهائية + 1; };
    إذا (الرتبة_النهائية > الانحياز) { أرجع لانهاية; };
    دع حقل_الأس: طبيعي = (الرتبة_النهائية + الانحياز) مثل طبيعي;
    أرجع (حقل_الأس << (الدقة - 1)) | (المحتفظ & ((واحد << (الدقة - 1)) - 1));
}

عرف بتات_عائم_مطلق_من_عشري(البايتات: &متجه ط8, العرض: طبيعي): اختياري طبيعي {
    إذا (العرض != 32 && العرض != 64) { أرجع اختياري.لا_شيء(); };
    دع الدقة: متغير طبيعي = 53;
    دع بتات_الأس: متغير طبيعي = 11;
    دع أكبر_رتبة_عشرية: متغير عدد = 400;
    دع أصغر_رتبة_عشرية: متغير عدد = -500;
    إذا (العرض == 32) { الدقة := 24; بتات_الأس := 8; أكبر_رتبة_عشرية := 50; أصغر_رتبة_عشرية := -60; };
    دع واحد: طبيعي = 1;
    دع لانهاية: طبيعي = ((واحد << بتات_الأس) - 1) << (الدقة - 1);
    // The significant digits (no leading zeros) and the exponent of the last.
    دع الأرقام: متغير متجه ط8 = [];
    دع بعد_النقطة: متغير منطقي = خطأ;
    دع في_الأس: متغير منطقي = خطأ;
    دع الأس_سالب: متغير منطقي = خطأ;
    دع قيمة_الأس: متغير عدد = 0;
    دع أرقام_الكسر: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        دع ب: ط8 = (*البايتات)[ف];
        إذا (ب == 0x2E) {
            بعد_النقطة := صواب;
        } وإلا إذا (ب == 0x65 || ب == 0x45) {
            في_الأس := صواب;
        } وإلا إذا (في_الأس && ب == 0x2D) {
            الأس_سالب := صواب;
        } وإلا إذا (ب >= 0x30 && ب <= 0x39) {
            إذا (في_الأس) {
                إذا (قيمة_الأس < 100000) { قيمة_الأس := قيمة_الأس * 10 + ((ب - 0x30) مثل عدد); };
            } وإلا {
                إذا (بعد_النقطة) { أرقام_الكسر := أرقام_الكسر + 1; };
                إذا ((الطول(الأرقام) مثل طبيعي) > 0 || ب != 0x30) { ألحق(الأرقام, ب - 0x30); };
            };
        };
        ف := ف + 1;
    }
    دع الأس_العشري: متغير عدد = 0 - أرقام_الكسر;
    إذا (الأس_سالب) { الأس_العشري := الأس_العشري - قيمة_الأس; } وإلا { الأس_العشري := الأس_العشري + قيمة_الأس; };
    // Trailing zeros only scale.
    طالما ((الطول(الأرقام) مثل طبيعي) > 0 && الأرقام[(الطول(الأرقام) مثل طبيعي) - 1] == 0) {
        دع المختصرة: متغير متجه ط8 = [];
        دع ي: متغير طبيعي = 0;
        دع النهاية: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
        طالما (النهاية > 0 && الأرقام[النهاية - 1] == 0) { النهاية := النهاية - 1; الأس_العشري := الأس_العشري + 1; }
        طالما (ي < النهاية) { ألحق(المختصرة, الأرقام[ي]); ي := ي + 1; }
        الأرقام := المختصرة;
    }
    دع العدد: عدد = الطول(الأرقام) مثل عدد;
    إذا (العدد == 0) { أرجع اختياري.موجود(0); };
    // The decimal exponent of the leading digit bounds the result.
    دع الرتبة_العشرية: عدد = العدد - 1 + الأس_العشري;
    إذا (الرتبة_العشرية > أكبر_رتبة_عشرية) { أرجع اختياري.موجود(لانهاية); };
    إذا (الرتبة_العشرية < أصغر_رتبة_عشرية) { أرجع اختياري.موجود(0); };
    // D, nine digits at a time.
    دع البسط: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (العدد مثل طبيعي)) {
        دع القطعة: متغير طبيعي = 0;
        دع القوة: متغير طبيعي = 1;
        دع ك: متغير طبيعي = 0;
        طالما (ك < 9 && م < (العدد مثل طبيعي)) {
            القطعة := القطعة * 10 + (الأرقام[م] مثل طبيعي);
            القوة := القوة * 10;
            م := م + 1;
            ك := ك + 1;
        }
        اضرب_وأضف_أطرافا(&متغير البسط, القوة, القطعة);
        إذا ((الطول(البسط) مثل طبيعي) == 0) { ألحق(البسط, القطعة); };
    }
    إذا (الأس_العشري >= 0) {
        // D * 5^E, then 2^E.
        دع الباقي: متغير طبيعي = الأس_العشري مثل طبيعي;
        طالما (الباقي >= 13) { اضرب_وأضف_أطرافا(&متغير البسط, 1220703125, 0); الباقي := الباقي - 13; }
        دع القوة: متغير طبيعي = 1;
        طالما (الباقي > 0) { القوة := القوة * 5; الباقي := الباقي - 1; }
        إذا (القوة > 1) { اضرب_وأضف_أطرافا(&متغير البسط, القوة, 0); };
        دع البتات: طبيعي = بتات_أطراف(&البسط);
        دع ق: متغير طبيعي = 0;
        دع اللاصق: متغير منطقي = خطأ;
        دع الإزاحة: متغير طبيعي = 0;
        إذا (البتات > 64) { الإزاحة := البتات - 64; };
        دع ب: متغير طبيعي = البتات;
        طالما (ب > الإزاحة) { ب := ب - 1; ق := (ق << 1) | بت_أطراف(&البسط, ب); }
        دع ل: متغير طبيعي = 0;
        طالما (ل < الإزاحة) { إذا (بت_أطراف(&البسط, ل) != 0) { اللاصق := صواب; }; ل := ل + 1; }
        أرجع اختياري.موجود(قرب_إلى_عائم(ق, الأس_العشري + (الإزاحة مثل عدد), اللاصق, الدقة, بتات_الأس));
    };
    // D / (5^k * 2^k): a 64-bit quotient of the scaled integers and whether
    // a remainder is left.
    دع ك5: طبيعي = (0 - الأس_العشري) مثل طبيعي;
    دع المقام: متغير متجه طبيعي = [1];
    دع الباقي: متغير طبيعي = ك5;
    طالما (الباقي >= 13) { اضرب_وأضف_أطرافا(&متغير المقام, 1220703125, 0); الباقي := الباقي - 13; }
    دع القوة: متغير طبيعي = 1;
    طالما (الباقي > 0) { القوة := القوة * 5; الباقي := الباقي - 1; }
    إذا (القوة > 1) { اضرب_وأضف_أطرافا(&متغير المقام, القوة, 0); };
    دع بتات_البسط: عدد = بتات_أطراف(&البسط) مثل عدد;
    دع بتات_المقام: عدد = بتات_أطراف(&المقام) مثل عدد;
    // Scale so bits(A) = bits(B) + 63: the quotient lies in (2^62, 2^64).
    دع الفرق: عدد = بتات_المقام + 63 - بتات_البسط;
    دع الأس: متغير عدد = 0 - (ك5 مثل عدد);
    دع أ: متغير متجه طبيعي = [];
    دع ب_مقسوم: متغير متجه طبيعي = [];
    إذا (الفرق >= 0) {
        أ := أطراف_مزاحة_يسارا(&البسط, الفرق مثل طبيعي);
        ب_مقسوم := أطراف_مزاحة_يسارا(&المقام, 0);
        الأس := الأس - الفرق;
    } وإلا {
        أ := أطراف_مزاحة_يسارا(&البسط, 0);
        ب_مقسوم := أطراف_مزاحة_يسارا(&المقام, (0 - الفرق) مثل طبيعي);
        الأس := الأس - الفرق;
    };
    // Long division over the low 64 bits of A, from a remainder below B.
    دع بتات_أ: طبيعي = بتات_أطراف(&أ);
    دع المتبقي: متغير متجه طبيعي = [];
    دع ب: متغير طبيعي = بتات_أ;
    طالما (ب > 64) {
        ب := ب - 1;
        ضاعف_أطرافا_مع_بت(&متغير المتبقي, بت_أطراف(&أ, ب));
    }
    دع ق: متغير طبيعي = 0;
    طالما (ب > 0) {
        ب := ب - 1;
        ضاعف_أطرافا_مع_بت(&متغير المتبقي, بت_أطراف(&أ, ب));
        ق := ق << 1;
        إذا (قارن_أطرافا(&المتبقي, &ب_مقسوم) >= 0) {
            اطرح_أطرافا(&متغير المتبقي, &ب_مقسوم);
            ق := ق | 1;
        };
    }
    دع اللاصق: منطقي = بتات_أطراف(&المتبقي) != 0;
    إذا (ق == 0) { أرجع اختياري.موجود(0); };
    أرجع اختياري.موجود(قرب_إلى_عائم(ق, الأس, اللاصق, الدقة, بتات_الأس));
}

// The lexical sign is not part of the magnitude's decimal normalization.
// Preserve IEEE-754 negative zero, subnormals and infinities with the same
// sign-bit rule across Native, LLVM and the interpreter.
عرف بتات_عائم_من_عشري_معيار(البايتات: &متجه ط8, العرض: طبيعي): اختياري طبيعي {
    إذا (العرض != 32 && العرض != 64) { أرجع اختياري.لا_شيء(); };
    دع سالب: منطقي = (الطول(*البايتات) مثل طبيعي) > 0
        && (*البايتات)[0] == 0x2D;
    طابق بتات_عائم_مطلق_من_عشري(البايتات, العرض) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        إذا (!سالب) { أرجع اختياري.موجود(القيمة); };
        دع بت_الإشارة: طبيعي = (1 مثل طبيعي) << (العرض - 1);
        أرجع اختياري.موجود(القيمة | بت_الإشارة);
    };
}

// ---- Shortest formatting ---------------------------------------------------

// One step of a base-10^9 integer (limbs least significant first) times
// المضروب, which is below 2^31: a limb times it plus the carry stays below
// 2^62.
عرف اضرب_أطرافا_عشرية(الأطراف: &متغير متجه طبيعي, المضروب: طبيعي): فراغ {
    دع الحمل: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الأطراف) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الجداء: طبيعي = (*الأطراف)[ف] * المضروب + الحمل;
        (*الأطراف)[ف] := الجداء % 1000000000;
        الحمل := الجداء / 1000000000;
        ف := ف + 1;
    }
    طالما (الحمل != 0) {
        ألحق(*الأطراف, الحمل % 1000000000);
        الحمل := الحمل / 1000000000;
    }
}

// 2^q (q >= 0) or 5^-q (q < 0) in base-10^9 limbs, multiplying by 2^29 or
// 5^13 at a time: m * 2^q is that integer times m, times 10^q when q < 0.
عرف أطراف_قوة_ثنائية(الأس: عدد): متجه طبيعي {
    دع الأطراف: متغير متجه طبيعي = [1];
    إذا (الأس >= 0) {
        دع الباقي: متغير طبيعي = الأس مثل طبيعي;
        طالما (الباقي >= 29) { اضرب_أطرافا_عشرية(&متغير الأطراف, 536870912); الباقي := الباقي - 29; }
        إذا (الباقي > 0) { اضرب_أطرافا_عشرية(&متغير الأطراف, (1 مثل طبيعي) << الباقي); };
    } وإلا {
        دع الباقي: متغير طبيعي = (0 - الأس) مثل طبيعي;
        طالما (الباقي >= 13) { اضرب_أطرافا_عشرية(&متغير الأطراف, 1220703125); الباقي := الباقي - 13; }
        دع القوة: متغير طبيعي = 1;
        طالما (الباقي > 0) { القوة := القوة * 5; الباقي := الباقي - 1; }
        إذا (القوة > 1) { اضرب_أطرافا_عشرية(&متغير الأطراف, القوة); };
    };
    أرجع الأطراف;
}

// A base-10^9 integer times المضروب (any u64): schoolbook over the
// multiplier's own base-10^9 digits; each column stays below 2^63.
عرف جداء_أطراف_عشرية(الأطراف: &متجه طبيعي, المضروب: طبيعي): متجه طبيعي {
    دع أرقام_المضروب: متغير متجه طبيعي = [];
    دع ق: متغير طبيعي = المضروب;
    طالما (ق != 0) { ألحق(أرقام_المضروب, ق % 1000000000); ق := ق / 1000000000; }
    دع العدد: طبيعي = الطول(*الأطراف) مثل طبيعي;
    دع عدد_المضروب: طبيعي = الطول(أرقام_المضروب) مثل طبيعي;
    دع الناتج: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد + عدد_المضروب + 1) { ألحق(الناتج, 0); م := م + 1; }
    دع ي: متغير طبيعي = 0;
    طالما (ي < عدد_المضروب) {
        دع الحمل: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            دع الخانة: طبيعي = الناتج[ف + ي] + (*الأطراف)[ف] * أرقام_المضروب[ي] + الحمل;
            الناتج[ف + ي] := الخانة % 1000000000;
            الحمل := الخانة / 1000000000;
            ف := ف + 1;
        }
        دع ك: متغير طبيعي = العدد + ي;
        طالما (الحمل != 0) {
            دع الخانة: طبيعي = الناتج[ك] + الحمل;
            الناتج[ك] := الخانة % 1000000000;
            الحمل := الخانة / 1000000000;
            ك := ك + 1;
        }
        ي := ي + 1;
    }
    أرجع الناتج;
}

// A base-10^9 integer N as the exact decimal N * 10^min(q, 0), without
// leading or trailing zeros.
عرف عشري_من_أطراف(الأطراف: &متجه طبيعي, الأس: عدد): عمل_عشري {
    دع الأرقام: متغير متجه ط8 = [];
    دع ط: متغير طبيعي = الطول(*الأطراف) مثل طبيعي;
    طالما (ط > 0 && (*الأطراف)[ط - 1] == 0) { ط := ط - 1; }
    دع الأول: متغير منطقي = صواب;
    طالما (ط > 0) {
        ط := ط - 1;
        دع المعكوسة: متغير متجه ط8 = [];
        دع ر: متغير طبيعي = (*الأطراف)[ط];
        دع م: متغير طبيعي = 0;
        طالما (م < 9) { ألحق(المعكوسة, (ر % 10) مثل ط8); ر := ر / 10; م := م + 1; }
        دع ي: متغير طبيعي = 9;
        إذا (الأول) { طالما (ي > 1 && المعكوسة[ي - 1] == 0) { ي := ي - 1; } };
        طالما (ي > 0) { ي := ي - 1; ألحق(الأرقام, المعكوسة[ي]); }
        الأول := خطأ;
    }
    دع النقطة: متغير عدد = الطول(الأرقام) مثل عدد;
    إذا (الأس < 0) { النقطة := النقطة + الأس; };
    دع العمل: عمل_عشري = { الأرقام: الأرقام, النقطة: النقطة };
    أرجع طبع_عشري(&العمل);
}

// Drops leading zeros (moving the point) and trailing zeros.
عرف طبع_عشري(القيمة: &عمل_عشري): عمل_عشري {
    دع الأرقام: &متجه ط8 = &(*القيمة).الأرقام;
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < (الطول(*الأرقام) مثل طبيعي) && (*الأرقام)[البداية] == 0) { البداية := البداية + 1; }
    دع النهاية: متغير طبيعي = الطول(*الأرقام) مثل طبيعي;
    طالما (النهاية > البداية && (*الأرقام)[النهاية - 1] == 0) { النهاية := النهاية - 1; }
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(الناتج, (*الأرقام)[ف]); ف := ف + 1; }
    دع النقطة: عدد = (*القيمة).النقطة - (البداية مثل عدد);
    دع العمل: عمل_عشري = { الأرقام: الناتج, النقطة: النقطة };
    أرجع العمل;
}

// -1, 0 or 1 for two normalised decimals.
عرف قارن_عشريين(أ: &عمل_عشري, ب: &عمل_عشري): عدد {
    دع أ_صفر: منطقي = الطول((*أ).الأرقام) == 0;
    دع ب_صفر: منطقي = الطول((*ب).الأرقام) == 0;
    إذا (أ_صفر || ب_صفر) {
        إذا (أ_صفر && ب_صفر) { أرجع 0; };
        إذا (أ_صفر) { أرجع -1; };
        أرجع 1;
    };
    إذا ((*أ).النقطة != (*ب).النقطة) { إذا ((*أ).النقطة < (*ب).النقطة) { أرجع -1; }; أرجع 1; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*أ).الأرقام) مثل طبيعي) || ف < (الطول((*ب).الأرقام) مثل طبيعي)) {
        دع س: متغير ط8 = 0;
        دع ص: متغير ط8 = 0;
        إذا (ف < (الطول((*أ).الأرقام) مثل طبيعي)) { س := (*أ).الأرقام[ف]; };
        إذا (ف < (الطول((*ب).الأرقام) مثل طبيعي)) { ص := (*ب).الأرقام[ف]; };
        إذا (س != ص) { إذا (س < ص) { أرجع -1; }; أرجع 1; };
        ف := ف + 1;
    }
    أرجع 0;
}

// The first الدقة significant digits of a normalised decimal, rounded half
// to even, then moved by الخطوة units of the last kept digit (-1, 0 or 1).
عرف قرب_عشريا(القيمة: &عمل_عشري, الدقة: طبيعي, الخطوة: عدد): عمل_عشري {
    دع المصدر: &متجه ط8 = &(*القيمة).الأرقام;
    دع الأرقام: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الدقة) {
        إذا (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(الأرقام, (*المصدر)[ف]); } وإلا { ألحق(الأرقام, 0); };
        ف := ف + 1;
    }
    دع الزيادة: متغير عدد = الخطوة;
    إذا ((الطول(*المصدر) مثل طبيعي) > الدقة) {
        دع التالي: ط8 = (*المصدر)[الدقة];
        دع ما_بعد: متغير منطقي = خطأ;
        دع ي: متغير طبيعي = الدقة + 1;
        طالما (ي < (الطول(*المصدر) مثل طبيعي)) { إذا ((*المصدر)[ي] != 0) { ما_بعد := صواب; }; ي := ي + 1; }
        إذا (التالي > 5 || (التالي == 5 && (ما_بعد || (الأرقام[الدقة - 1] % 2) == 1))) { الزيادة := الزيادة + 1; };
    };
    دع النقطة: متغير عدد = (*القيمة).النقطة;
    إذا (الزيادة > 0) {
        دع م: متغير طبيعي = الدقة;
        دع الحمل: متغير منطقي = صواب;
        طالما (الحمل && م > 0) {
            م := م - 1;
            إذا (الأرقام[م] == 9) { الأرقام[م] := 0; } وإلا { الأرقام[م] := الأرقام[م] + 1; الحمل := خطأ; };
        }
        إذا (الحمل) {
            دع الموسعة: متغير متجه ط8 = [1];
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الأرقام) مثل طبيعي)) { ألحق(الموسعة, الأرقام[ك]); ك := ك + 1; }
            الأرقام := الموسعة;
            النقطة := النقطة + 1;
        };
    } وإلا إذا (الزيادة < 0) {
        دع م: متغير طبيعي = الدقة;
        دع الاستلاف: متغير منطقي = صواب;
        طالما (الاستلاف && م > 0) {
            م := م - 1;
            إذا (الأرقام[م] == 0) { الأرقام[م] := 9; } وإلا { الأرقام[م] := الأرقام[م] - 1; الاستلاف := خطأ; };
        }
    };
    دع العمل: عمل_عشري = { الأرقام: الأرقام, النقطة: النقطة };
    أرجع طبع_عشري(&العمل);
}

// Whether a decimal lies in the rounding interval.
عرف ضمن_الفترة(القيمة: &عمل_عشري, الأدنى: &عمل_عشري, الأعلى: &عمل_عشري, شامل: منطقي): منطقي {
    دع م1: عدد = قارن_عشريين(القيمة, الأدنى);
    دع م2: عدد = قارن_عشريين(القيمة, الأعلى);
    إذا (شامل) { أرجع م1 >= 0 && م2 <= 0; };
    أرجع م1 > 0 && م2 < 0;
}

// ---- Grisu3 fast path -------------------------------------------------------
// Shortest digits with 64-bit integers (Loitsch, "Printing Floating-Point
// Numbers Quickly and Accurately with Integers", PLDI 2010; the Grisu3 of
// double-conversion's fast-dtoa.cc). It either gives the shortest decimal
// in the rounding interval that is closest to the value, the same digits
// the exact algorithm below finds, or says it cannot be sure (about 0.5% of
// values), and the exact algorithm decides. Rust's flt2dec does the same
// (grisu::format_shortest_opt, then dragon::format_shortest).

// 10^k for k = -348, -340, ..., 340: 64-bit significands rounded to nearest
// and their binary exponents (10^k ~ significand * 2^exponent).
دع دلالات_قوى_عشرة_جريسو: متجه ط64 = [
    18054884314459144840, 13451937075301367670, 10022474136428063862, 14934650266808366570,
    11127181549972568877, 16580792590934885855, 12353653155963782858, 18408377700990114895,
    13715310171984221708, 10218702384817765436, 15227053142812498563, 11345038669416679861,
    16905424996341287883, 12595523146049147757, 9384396036005875287, 13983839803942852151,
    10418772551374772303, 15525180923007089351, 11567161174868858868, 17236413322193710309,
    12842128665889583758, 9568131466127621947, 14257626930069360058, 10622759856335341974,
    15829145694278690180, 11793632577567316726, 17573882009934360870, 13093562431584567480,
    9755464219737475723, 14536774485912137811, 10830740992659433045, 16139061738043178685,
    12024538023802026127, 17917957937422433684, 13349918974505688015, 9946464728195732843,
    14821387422376473014, 11042794154864902060, 16455045573212060422, 12259964326927110867,
    18268770466636286478, 13611294676837538539, 10141204801825835212, 15111572745182864684,
    11258999068426240000, 16777216000000000000, 12500000000000000000, 9313225746154785156,
    13877787807814456755, 10339757656912845936, 15407439555097886824, 11479437019748901445,
    17105694144590052135, 12744735289059618216, 9495567745759798747, 14149498560666738074,
    10542197943230523224, 15709099088952724970, 11704190886730495818, 17440603504673385349,
    12994262207056124023, 9681479787123295682, 14426529090290212157, 10748601772107342003,
    16016664761464807395, 11933345169920330789, 17782069995880619868, 13248674568444952270,
    9871031767461413346, 14708983551653345445, 10959046745042015199, 16330252207878254650,
    12166986024289022870, 18130221999122236476, 13508068024458167312, 10064294952495520794,
    14996968138956309548, 11173611982879273257, 16649979327439178909, 12405201291620119593,
    9242595204427927429, 13772540099066387757, 10261342003245940623, 15290591125556738113,
    11392378155556871081, 16975966327722178521, 12648080533535911531
];
دع أسس_قوى_عشرة_جريسو: متجه عدد = [
    -1220, -1193, -1166, -1140, -1113, -1087, -1060, -1034, -1007, -980, -954, -927,
    -901, -874, -847, -821, -794, -768, -741, -715, -688, -661, -635, -608,
    -582, -555, -529, -502, -475, -449, -422, -396, -369, -343, -316, -289,
    -263, -236, -210, -183, -157, -130, -103, -77, -50, -24, 3, 30,
    56, 83, 109, 136, 162, 189, 216, 242, 269, 295, 322, 348,
    375, 402, 428, 455, 481, 508, 534, 561, 588, 614, 641, 667,
    694, 720, 747, 774, 800, 827, 853, 880, 907, 933, 960, 986,
    1013, 1039, 1066
];

// A float with a 64-bit significand: الدلالة * 2^الأس (double-conversion's DiyFp).
نوع عائم_جريسو = { الدلالة: ط64, الأس: عدد };

عرف طبع_عائم_جريسو(الدلالة: ط64, الأس: عدد): عائم_جريسو {
    دع د: متغير ط64 = الدلالة;
    دع أ: متغير عدد = الأس;
    دع العلوي: ط64 = (1 مثل ط64) << 63;
    طالما ((د & العلوي) == 0) { د := د << 1; أ := أ - 1; }
    دع الناتج: عائم_جريسو = { الدلالة: د, الأس: أ };
    أرجع الناتج;
}

// The upper 64 bits of the 128-bit product, rounded (DiyFp::Times).
عرف اضرب_عائمي_جريسو(أ: &عائم_جريسو, ب: &عائم_جريسو): عائم_جريسو {
    دع القناع: ط64 = 0xFFFFFFFF;
    دع أع: ط64 = (*أ).الدلالة >> 32;
    دع أد: ط64 = (*أ).الدلالة & القناع;
    دع بع: ط64 = (*ب).الدلالة >> 32;
    دع بد: ط64 = (*ب).الدلالة & القناع;
    دع عع: ط64 = أع * بع;
    دع دع_: ط64 = أد * بع;
    دع عد: ط64 = أع * بد;
    دع دد: ط64 = أد * بد;
    دع الوسط: ط64 = (دد >> 32) + (عد & القناع) + (دع_ & القناع) + ((1 مثل ط64) << 31);
    دع الناتج: عائم_جريسو = {
        الدلالة: عع + (عد >> 32) + (دع_ >> 32) + (الوسط >> 32),
        الأس: (*أ).الأس + (*ب).الأس + 64
    };
    أرجع الناتج;
}

// Grisu's weeding (RoundWeed): moves the last digit towards the value while
// that stays inside the safe interval, then checks that the result is
// certainly the closest.
عرف قص_جريسو(
    الأرقام: &متغير متجه ط8, المسافة_إلى_الأعلى: ط64, الفترة_غير_الآمنة: ط64,
    الباقي_: ط64, عشرة_كابا: ط64, الوحدة: ط64
): منطقي {
    إذا (المسافة_إلى_الأعلى < الوحدة) { أرجع خطأ; };
    دع الصغرى: ط64 = المسافة_إلى_الأعلى - الوحدة;
    دع الكبرى: ط64 = المسافة_إلى_الأعلى + الوحدة;
    دع الباقي: متغير ط64 = الباقي_;
    دع الأخير: طبيعي = (الطول(*الأرقام) مثل طبيعي) - 1;
    طالما (الباقي < الصغرى && الفترة_غير_الآمنة - الباقي >= عشرة_كابا
        && (الباقي + عشرة_كابا < الصغرى || الصغرى - الباقي >= الباقي + عشرة_كابا - الصغرى)) {
        إذا ((*الأرقام)[الأخير] == 0) { أرجع خطأ; };
        (*الأرقام)[الأخير] := (*الأرقام)[الأخير] - 1;
        الباقي := الباقي + عشرة_كابا;
    }
    إذا (الباقي < الكبرى && الفترة_غير_الآمنة - الباقي >= عشرة_كابا
        && (الباقي + عشرة_كابا < الكبرى || الكبرى - الباقي > الباقي + عشرة_كابا - الكبرى)) {
        أرجع خطأ;
    };
    إذا (الفترة_غير_الآمنة < 4 * الوحدة) { أرجع خطأ; };
    أرجع (2 * الوحدة <= الباقي) && (الباقي <= الفترة_غير_الآمنة - 4 * الوحدة);
}

// Digits D (an integer of n digits) times 10^الأس_العشري as 0.D * 10^(n + الأس_العشري).
عرف عمل_من_أرقام_جريسو(الأرقام: متجه ط8, الأس_العشري: عدد): عمل_عشري {
    دع النقطة: عدد = (الطول(الأرقام) مثل عدد) + الأس_العشري;
    دع العمل: عمل_عشري = { الأرقام: الأرقام, النقطة: النقطة };
    أرجع طبع_عشري(&العمل);
}

// The shortest digits of m * 2^e, or none when Grisu cannot be sure.
عرف أقصر_أرقام_جريسو(الدلالة: طبيعي, الأس: عدد, حدود_غير_متناظرة: منطقي): اختياري عمل_عشري {
    دع و: عائم_جريسو = طبع_عائم_جريسو(الدلالة مثل ط64, الأس);
    دع الأعلى_الخام: عائم_جريسو = طبع_عائم_جريسو(((الدلالة مثل ط64) << 1) + 1, الأس - 1);
    دع دلالة_الأدنى: متغير ط64 = ((الدلالة مثل ط64) << 1) - 1;
    دع أس_الأدنى: متغير عدد = الأس - 1;
    إذا (حدود_غير_متناظرة) { دلالة_الأدنى := ((الدلالة مثل ط64) << 2) - 1; أس_الأدنى := الأس - 2; };
    دع الأدنى_الخام: عائم_جريسو = {
        الدلالة: دلالة_الأدنى << ((أس_الأدنى - الأعلى_الخام.الأس) مثل ط64),
        الأس: الأعلى_الخام.الأس
    };
    // A cached power that puts the product's exponent in [-60, -32].
    دع أدنى_أس: عدد = -60 - (و.الأس + 64);
    دع أعلى_أس: عدد = -32 - (و.الأس + 64);
    دع الموضع: متغير طبيعي = 0;
    دع وجد: متغير منطقي = خطأ;
    طالما (!وجد && الموضع < (الطول(أسس_قوى_عشرة_جريسو) مثل طبيعي)) {
        دع أس_القوة: عدد = أسس_قوى_عشرة_جريسو[الموضع];
        إذا (أس_القوة >= أدنى_أس && أس_القوة <= أعلى_أس) { وجد := صواب; } وإلا { الموضع := الموضع + 1; };
    }
    إذا (!وجد) { أرجع اختياري.لا_شيء(); };
    دع القوة: عائم_جريسو = { الدلالة: دلالات_قوى_عشرة_جريسو[الموضع], الأس: أسس_قوى_عشرة_جريسو[الموضع] };
    دع أس_القوة_العشري: عدد = (الموضع مثل عدد) * 8 - 348;
    دع المقيس: عائم_جريسو = اضرب_عائمي_جريسو(&و, &القوة);
    دع الأدنى: عائم_جريسو = اضرب_عائمي_جريسو(&الأدنى_الخام, &القوة);
    دع الأعلى: عائم_جريسو = اضرب_عائمي_جريسو(&الأعلى_الخام, &القوة);
    // Digit generation (DigitGen): too_low and too_high widen the interval
    // by the multiplication's error; digits stop once the rest is inside.
    دع الوحدة: متغير ط64 = 1;
    إذا (الأعلى.الدلالة == ~(0 مثل ط64) || الأدنى.الدلالة < 1) { أرجع اختياري.لا_شيء(); };
    دع المنخفض_جدا: ط64 = الأدنى.الدلالة - الوحدة;
    دع المرتفع_جدا: ط64 = الأعلى.الدلالة + الوحدة;
    دع غير_الآمنة: متغير ط64 = المرتفع_جدا - المنخفض_جدا;
    دع الإزاحة: ط64 = (0 - المقيس.الأس) مثل ط64;
    دع الواحد: ط64 = (1 مثل ط64) << الإزاحة;
    دع الصحيح: متغير ط64 = المرتفع_جدا >> الإزاحة;
    دع الكسري: متغير ط64 = المرتفع_جدا & (الواحد - 1);
    دع المقسوم_عليه: متغير ط64 = 1;
    دع كابا: متغير عدد = 0;
    إذا (الصحيح > 0) {
        كابا := 1;
        طالما (المقسوم_عليه * 10 <= الصحيح) { المقسوم_عليه := المقسوم_عليه * 10; كابا := كابا + 1; }
    };
    دع المسافة: ط64 = المرتفع_جدا - المقيس.الدلالة;
    دع الأرقام: متغير متجه ط8 = [];
    طالما (كابا > 0) {
        ألحق(الأرقام, (الصحيح / المقسوم_عليه) مثل ط8);
        الصحيح := الصحيح % المقسوم_عليه;
        كابا := كابا - 1;
        دع الباقي: ط64 = (الصحيح << الإزاحة) + الكسري;
        إذا (الباقي < غير_الآمنة) {
            إذا (!قص_جريسو(&متغير الأرقام, المسافة, غير_الآمنة, الباقي, المقسوم_عليه << الإزاحة, الوحدة)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(عمل_من_أرقام_جريسو(الأرقام, كابا - أس_القوة_العشري));
        };
        المقسوم_عليه := المقسوم_عليه / 10;
    }
    طالما ((الطول(الأرقام) مثل طبيعي) < 20) {
        الكسري := الكسري * 10;
        الوحدة := الوحدة * 10;
        غير_الآمنة := غير_الآمنة * 10;
        ألحق(الأرقام, (الكسري >> الإزاحة) مثل ط8);
        الكسري := الكسري & (الواحد - 1);
        كابا := كابا - 1;
        إذا (الكسري < غير_الآمنة) {
            إذا (!قص_جريسو(&متغير الأرقام, المسافة * الوحدة, غير_الآمنة, الكسري, الواحد, الوحدة)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(عمل_من_أرقام_جريسو(الأرقام, كابا - أس_القوة_العشري));
        };
    }
    أرجع اختياري.لا_شيء();
}

// Grisu's counted mode (double-conversion's DigitGenCounted and
// RoundWeedCounted): a fixed number of correctly rounded digits, or none
// when the multiplication's error leaves the rounding in doubt (an exact
// tie included), where the exact digits decide. ثابتة: الخانات digits after
// the point (Rust's {:.N}); otherwise الخانات significant digits ({:.Ne}).
عرف أرقام_معدودة_جريسو(الدلالة: طبيعي, الأس: عدد, ثابتة: منطقي, الخانات: طبيعي): اختياري عمل_عشري {
    دع و: عائم_جريسو = طبع_عائم_جريسو(الدلالة مثل ط64, الأس);
    دع أدنى_أس: عدد = -60 - (و.الأس + 64);
    دع أعلى_أس: عدد = -32 - (و.الأس + 64);
    دع الموضع: متغير طبيعي = 0;
    دع وجد: متغير منطقي = خطأ;
    طالما (!وجد && الموضع < (الطول(أسس_قوى_عشرة_جريسو) مثل طبيعي)) {
        دع أس_القوة: عدد = أسس_قوى_عشرة_جريسو[الموضع];
        إذا (أس_القوة >= أدنى_أس && أس_القوة <= أعلى_أس) { وجد := صواب; } وإلا { الموضع := الموضع + 1; };
    }
    إذا (!وجد) { أرجع اختياري.لا_شيء(); };
    دع القوة: عائم_جريسو = { الدلالة: دلالات_قوى_عشرة_جريسو[الموضع], الأس: أسس_قوى_عشرة_جريسو[الموضع] };
    دع أس_القوة_العشري: عدد = (الموضع مثل عدد) * 8 - 348;
    دع المقيس: عائم_جريسو = اضرب_عائمي_جريسو(&و, &القوة);
    دع الخطأ_: متغير ط64 = 1;
    دع الإزاحة: ط64 = (0 - المقيس.الأس) مثل ط64;
    دع الواحد: ط64 = (1 مثل ط64) << الإزاحة;
    دع الصحيح: متغير ط64 = المقيس.الدلالة >> الإزاحة;
    دع الكسري: متغير ط64 = المقيس.الدلالة & (الواحد - 1);
    دع المقسوم_عليه: متغير ط64 = 1;
    دع كابا: متغير عدد = 0;
    إذا (الصحيح > 0) {
        كابا := 1;
        طالما (المقسوم_عليه * 10 <= الصحيح) { المقسوم_عليه := المقسوم_عليه * 10; كابا := كابا + 1; }
    };
    // The value is 0.d1d2... * 10^(كابا - أس_القوة_العشري).
    دع المطلوب: متغير عدد = الخانات مثل عدد;
    إذا (ثابتة) { المطلوب := كابا - أس_القوة_العشري + (الخانات مثل عدد); };
    إذا (المطلوب <= 0 || المطلوب > 17) { أرجع اختياري.لا_شيء(); };
    دع الأرقام: متغير متجه ط8 = [];
    طالما (كابا > 0 && المطلوب > 0) {
        ألحق(الأرقام, (الصحيح / المقسوم_عليه) مثل ط8);
        الصحيح := الصحيح % المقسوم_عليه;
        كابا := كابا - 1;
        المطلوب := المطلوب - 1;
        إذا (المطلوب > 0) { المقسوم_عليه := المقسوم_عليه / 10; };
    }
    دع الباقي: متغير ط64 = 0;
    دع عشرة_كابا: متغير ط64 = 0;
    إذا (المطلوب == 0) {
        الباقي := (الصحيح << الإزاحة) + الكسري;
        عشرة_كابا := المقسوم_عليه << الإزاحة;
    } وإلا {
        طالما (المطلوب > 0 && الكسري > الخطأ_) {
            الكسري := الكسري * 10;
            الخطأ_ := الخطأ_ * 10;
            ألحق(الأرقام, (الكسري >> الإزاحة) مثل ط8);
            الكسري := الكسري & (الواحد - 1);
            كابا := كابا - 1;
            المطلوب := المطلوب - 1;
        }
        إذا (المطلوب != 0) { أرجع اختياري.لا_شيء(); };
        الباقي := الكسري;
        عشرة_كابا := الواحد;
    };
    // RoundWeedCounted: round down or up only when the error allows no doubt.
    إذا (الخطأ_ >= عشرة_كابا || عشرة_كابا - الخطأ_ <= الخطأ_) { أرجع اختياري.لا_شيء(); };
    إذا (عشرة_كابا - الباقي > الباقي && عشرة_كابا - 2 * الباقي >= 2 * الخطأ_) {
        أرجع اختياري.موجود(عمل_من_أرقام_جريسو(الأرقام, كابا - أس_القوة_العشري));
    };
    إذا (الباقي > الخطأ_ && عشرة_كابا - (الباقي - الخطأ_) <= الباقي - الخطأ_) {
        دع ف: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
        دع الحمل: متغير منطقي = صواب;
        طالما (الحمل && ف > 0) {
            ف := ف - 1;
            إذا (الأرقام[ف] == 9) { الأرقام[ف] := 0; } وإلا { الأرقام[ف] := الأرقام[ف] + 1; الحمل := خطأ; };
        }
        إذا (الحمل) {
            // 99..9 rounded up is 10..0: the same count of digits, 1 then
            // zeros, worth ten times more (double-conversion's kappa + 1).
            الأرقام[0] := 1;
            كابا := كابا + 1;
        };
        أرجع اختياري.موجود(عمل_من_أرقام_جريسو(الأرقام, كابا - أس_القوة_العشري));
    };
    أرجع اختياري.لا_شيء();
}

// Keeps the first المحفوظ significant digits of a normalised decimal,
// rounding the exact value half to even; past the last digit nothing
// changes, and before the first the value rounds to zero or to one unit.
عرف قرب_عشريا_إلى(العمل: &متغير عمل_عشري, المحفوظ: عدد): فراغ {
    دع العدد: عدد = الطول((*العمل).الأرقام) مثل عدد;
    إذا (المحفوظ >= العدد) { أرجع; };
    إذا (المحفوظ < 0) { اقتطع((*العمل).الأرقام, 0); أرجع; };
    دع القطع: طبيعي = المحفوظ مثل طبيعي;
    دع التالي: ط8 = (*العمل).الأرقام[القطع];
    // Digits carry no trailing zeros: a digit after the next one means more.
    دع ما_بعده: منطقي = العدد > المحفوظ + 1;
    دع فردي: متغير منطقي = خطأ;
    إذا (القطع > 0) { فردي := ((*العمل).الأرقام[القطع - 1] % 2) == 1; };
    دع للأعلى: منطقي = التالي > 5 || (التالي == 5 && (ما_بعده || فردي));
    اقتطع((*العمل).الأرقام, القطع);
    إذا (للأعلى) {
        دع ف: متغير طبيعي = القطع;
        دع الحمل: متغير منطقي = صواب;
        طالما (الحمل && ف > 0) {
            ف := ف - 1;
            إذا ((*العمل).الأرقام[ف] == 9) { (*العمل).الأرقام[ف] := 0; }
            وإلا { (*العمل).الأرقام[ف] := (*العمل).الأرقام[ف] + 1; الحمل := خطأ; };
        }
        إذا (الحمل) {
            اقتطع((*العمل).الأرقام, 0);
            ألحق((*العمل).الأرقام, 1);
            (*العمل).النقطة := (*العمل).النقطة + 1;
        };
    };
    دع ش: متغير طبيعي = الطول((*العمل).الأرقام) مثل طبيعي;
    طالما (ش > 0 && (*العمل).الأرقام[ش - 1] == 0) { ش := ش - 1; }
    اقتطع((*العمل).الأرقام, ش);
}

// The shortest digits for a finite, non-zero magnitude m * 2^e.
عرف أقصر_أرقام(الدلالة: طبيعي, الأس: عدد, حدود_غير_متناظرة: منطقي): عمل_عشري {
    طابق أقصر_أرقام_جريسو(الدلالة, الأس, حدود_غير_متناظرة) مع
    | اختياري.موجود(السريعة) -> { أرجع السريعة; }
    | اختياري.لا_شيء -> { };
    أرجع أقصر_أرقام_دقيقة(الدلالة, الأس, حدود_غير_متناظرة);
}

// The exact algorithm: the decimal bounds compared digit by digit.
عرف أقصر_أرقام_دقيقة(الدلالة: طبيعي, الأس: عدد, حدود_غير_متناظرة: منطقي): عمل_عشري {
    // v = 4m * 2^(e-2) and its rounding bounds share one power of two.
    دع القوة: متجه طبيعي = أطراف_قوة_ثنائية(الأس - 2);
    دع أطراف_القيمة: متجه طبيعي = جداء_أطراف_عشرية(&القوة, 4 * الدلالة);
    دع القيمة: عمل_عشري = عشري_من_أطراف(&أطراف_القيمة, الأس - 2);
    دع أطراف_الأعلى: متجه طبيعي = جداء_أطراف_عشرية(&القوة, 4 * الدلالة + 2);
    دع الأعلى: عمل_عشري = عشري_من_أطراف(&أطراف_الأعلى, الأس - 2);
    دع مضروب_الأدنى: متغير طبيعي = 4 * الدلالة - 2;
    إذا (حدود_غير_متناظرة) { مضروب_الأدنى := 4 * الدلالة - 1; };
    دع أطراف_الأدنى: متجه طبيعي = جداء_أطراف_عشرية(&القوة, مضروب_الأدنى);
    دع الأدنى: عمل_عشري = عشري_من_أطراف(&أطراف_الأدنى, الأس - 2);
    دع شامل: منطقي = (الدلالة % 2) == 0;
    دع الدقة: متغير طبيعي = 1;
    طالما (الدقة < 17) {
        دع المرشح: عمل_عشري = قرب_عشريا(&القيمة, الدقة, 0);
        إذا (ضمن_الفترة(&المرشح, &الأدنى, &الأعلى, شامل)) { أرجع المرشح; };
        // A power of two's lower gap is half the upper one: the nearest
        // p-digit decimal may fall below it while the next one fits.
        إذا (قارن_عشريين(&المرشح, &الأدنى) < 0) {
            دع التالي: عمل_عشري = قرب_عشريا(&القيمة, الدقة, 1);
            إذا (ضمن_الفترة(&التالي, &الأدنى, &الأعلى, شامل)) { أرجع التالي; };
        };
        الدقة := الدقة + 1;
    }
    أرجع قرب_عشريا(&القيمة, 17, 0);
}

// The decimal text: digits d1..dk with value 0.d1...dk * 10^n, laid out as
// ECMAScript's Number::toString.
عرف نص_من_أرقام(القيمة: &عمل_عشري, سالب: منطقي): نص {
    دع الناتج: متغير متجه ط8 = [];
    إذا (سالب) { ألحق(الناتج, 0x2D); };
    دع الأرقام: &متجه ط8 = &(*القيمة).الأرقام;
    دع ك: عدد = الطول(*الأرقام) مثل عدد;
    دع ن: عدد = (*القيمة).النقطة;
    إذا (ك <= ن && ن <= 21) {
        دع ف: متغير طبيعي = 0;
        طالما ((ف مثل عدد) < ك) { ألحق(الناتج, (*الأرقام)[ف] + 0x30); ف := ف + 1; }
        دع ص: متغير عدد = ك;
        طالما (ص < ن) { ألحق(الناتج, 0x30); ص := ص + 1; }
    } وإلا إذا (0 < ن && ن <= 21) {
        دع ف: متغير طبيعي = 0;
        طالما ((ف مثل عدد) < ك) {
            إذا ((ف مثل عدد) == ن) { ألحق(الناتج, 0x2E); };
            ألحق(الناتج, (*الأرقام)[ف] + 0x30);
            ف := ف + 1;
        }
    } وإلا إذا (-6 < ن && ن <= 0) {
        ألحق(الناتج, 0x30); ألحق(الناتج, 0x2E);
        دع ص: متغير عدد = ن;
        طالما (ص < 0) { ألحق(الناتج, 0x30); ص := ص + 1; }
        دع ف: متغير طبيعي = 0;
        طالما ((ف مثل عدد) < ك) { ألحق(الناتج, (*الأرقام)[ف] + 0x30); ف := ف + 1; }
    } وإلا {
        ألحق(الناتج, (*الأرقام)[0] + 0x30);
        إذا (ك > 1) {
            ألحق(الناتج, 0x2E);
            دع ف: متغير طبيعي = 1;
            طالما ((ف مثل عدد) < ك) { ألحق(الناتج, (*الأرقام)[ف] + 0x30); ف := ف + 1; }
        };
        ألحق(الناتج, 0x65);
        دع الأس: عدد = ن - 1;
        إذا (الأس < 0) { ألحق(الناتج, 0x2D); } وإلا { ألحق(الناتج, 0x2B); };
        دع المطلق: متغير طبيعي = 0;
        إذا (الأس < 0) { المطلق := (0 - الأس) مثل طبيعي; } وإلا { المطلق := الأس مثل طبيعي; };
        دع المعكوسة: متغير متجه ط8 = [];
        طالما (المطلق != 0) { ألحق(المعكوسة, ((المطلق % 10) + 0x30) مثل ط8); المطلق := المطلق / 10; }
        دع ف: متغير طبيعي = الطول(المعكوسة) مثل طبيعي;
        طالما (ف > 0) { ف := ف - 1; ألحق(الناتج, المعكوسة[ف]); }
    };
    أرجع من_بايتات(&الناتج);
}

عرف نسق_عائم_ببتات(البتات: طبيعي, بتات_الكسر: طبيعي, بتات_الأس: طبيعي): نص {
    دع واحد: طبيعي = 1;
    دع العرض: طبيعي = بتات_الكسر + بتات_الأس + 1;
    دع سالب: منطقي = ((البتات >> (العرض - 1)) & 1) != 0;
    دع أقصى_أس: طبيعي = (واحد << بتات_الأس) - 1;
    دع الأس_الخام: طبيعي = (البتات >> بتات_الكسر) & أقصى_أس;
    دع الكسر: طبيعي = البتات & ((واحد << بتات_الكسر) - 1);
    إذا (الأس_الخام == أقصى_أس) {
        إذا (الكسر != 0) { أرجع «NaN»; };
        إذا (سالب) { أرجع «-inf»; };
        أرجع «inf»;
    };
    إذا (الأس_الخام == 0 && الكسر == 0) {
        إذا (سالب) { أرجع «-0»; };
        أرجع «0»;
    };
    دع الانحياز: عدد = ((واحد << (بتات_الأس - 1)) - 1) مثل عدد;
    دع الدلالة: متغير طبيعي = الكسر;
    دع الأس: متغير عدد = 1 - الانحياز - (بتات_الكسر مثل عدد);
    دع غير_متناظرة: متغير منطقي = خطأ;
    إذا (الأس_الخام != 0) {
        الدلالة := الكسر | (واحد << بتات_الكسر);
        الأس := (الأس_الخام مثل عدد) - الانحياز - (بتات_الكسر مثل عدد);
        غير_متناظرة := الكسر == 0 && الأس_الخام > 1;
    };
    دع الأرقام: عمل_عشري = أقصر_أرقام(الدلالة, الأس, غير_متناظرة);
    أرجع نص_من_أرقام(&الأرقام, سالب);
}

// The shortest decimal text that reads back to the same f64 ("0.1",
// "1e+21", "-inf", "NaN").
عام عرف ع64_إلى_نص(القيمة: ع64): نص { أرجع نسق_عائم_ببتات(بتات_ع64(القيمة), 52, 11); }
عام عرف ع32_إلى_نص(القيمة: ع32): نص { أرجع نسق_عائم_ببتات(بتات_ع32(القيمة) مثل طبيعي, 23, 8); }

// ---- Decimal digits for formatters (std.fmt) --------------------------------
// A float as decimal digits: the value is 0.d1d2...dk * 10^النقطة (digits
// 0-9, most significant first, no leading or trailing zeros; zero has no
// digits). الصنف is 0 for a finite value, 1 for an infinity, 2 for NaN.
// The shortest form is the one ع64_إلى_نص prints (Rust's Display digits);
// the exact form is every digit of the binary value, which formatters round
// to a precision (Rust's {:.N} and {:.Ne} round the exact value half to even).
عام نوع أرقام_عائم = {
    الأرقام: متجه ط8,
    النقطة: عدد,
    سالب: منطقي,
    الصنف: ط8
};

// النمط: 0 shortest, 1 exact, 2 rounded to الخانات digits after the point,
// 3 rounded to الخانات significant digits.
عرف أرقام_عائم_ببتات(البتات: طبيعي, بتات_الكسر: طبيعي, بتات_الأس: طبيعي, النمط: ط8, الخانات: طبيعي): أرقام_عائم {
    دع واحد: طبيعي = 1;
    دع العرض: طبيعي = بتات_الكسر + بتات_الأس + 1;
    دع سالب: منطقي = ((البتات >> (العرض - 1)) & 1) != 0;
    دع أقصى_أس: طبيعي = (واحد << بتات_الأس) - 1;
    دع الأس_الخام: طبيعي = (البتات >> بتات_الكسر) & أقصى_أس;
    دع الكسر: طبيعي = البتات & ((واحد << بتات_الكسر) - 1);
    دع فارغة: متجه ط8 = [];
    إذا (الأس_الخام == أقصى_أس) {
        دع الصنف: متغير ط8 = 1;
        إذا (الكسر != 0) { الصنف := 2; };
        دع الخاص: أرقام_عائم = { الأرقام: فارغة, النقطة: 0, سالب: سالب, الصنف: الصنف };
        أرجع الخاص;
    };
    إذا (الأس_الخام == 0 && الكسر == 0) {
        دع الصفر: أرقام_عائم = { الأرقام: فارغة, النقطة: 0, سالب: سالب, الصنف: 0 };
        أرجع الصفر;
    };
    دع الانحياز: عدد = ((واحد << (بتات_الأس - 1)) - 1) مثل عدد;
    دع الدلالة: متغير طبيعي = الكسر;
    دع الأس: متغير عدد = 1 - الانحياز - (بتات_الكسر مثل عدد);
    دع غير_متناظرة: متغير منطقي = خطأ;
    إذا (الأس_الخام != 0) {
        الدلالة := الكسر | (واحد << بتات_الكسر);
        الأس := (الأس_الخام مثل عدد) - الانحياز - (بتات_الكسر مثل عدد);
        غير_متناظرة := الكسر == 0 && الأس_الخام > 1;
    };
    دع العمل: متغير عمل_عشري = { الأرقام: فارغة, النقطة: 0 };
    دع جاهز: متغير منطقي = خطأ;
    إذا (النمط == 0) {
        العمل := أقصر_أرقام(الدلالة, الأس, غير_متناظرة);
        جاهز := صواب;
    } وإلا إذا (النمط >= 2) {
        طابق أرقام_معدودة_جريسو(الدلالة, الأس, النمط == 2, الخانات) مع
        | اختياري.موجود(السريعة) -> { العمل := السريعة; جاهز := صواب; }
        | اختياري.لا_شيء -> { };
    };
    إذا (!جاهز) {
        // m * 2^e exactly: 2^e (or 5^-e, read with the point moved by e).
        دع القوة: متجه طبيعي = أطراف_قوة_ثنائية(الأس);
        دع الأطراف: متجه طبيعي = جداء_أطراف_عشرية(&القوة, الدلالة);
        العمل := عشري_من_أطراف(&الأطراف, الأس);
        إذا (النمط == 2) { قرب_عشريا_إلى(&متغير العمل, العمل.النقطة + (الخانات مثل عدد)); };
        إذا (النمط == 3) { قرب_عشريا_إلى(&متغير العمل, الخانات مثل عدد); };
    };
    دع الأرقام: متغير متجه ط8 = [];
    بدّل(الأرقام, العمل.الأرقام);
    دع الناتج: أرقام_عائم = { الأرقام: الأرقام, النقطة: العمل.النقطة, سالب: سالب, الصنف: 0 };
    أرجع الناتج;
}

عام عرف أرقام_ع64_الأقصر(القيمة: ع64): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع64(القيمة), 52, 11, 0, 0); }
عام عرف أرقام_ع32_الأقصر(القيمة: ع32): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع32(القيمة) مثل طبيعي, 23, 8, 0, 0); }
عام عرف أرقام_ع64_الدقيقة(القيمة: ع64): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع64(القيمة), 52, 11, 1, 0); }
عام عرف أرقام_ع32_الدقيقة(القيمة: ع32): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع32(القيمة) مثل طبيعي, 23, 8, 1, 0); }

// The value rounded half to even (exactly, as Rust's {:.N} and {:.Ne}):
// to الخانات digits after the point, or to الخانات significant digits. A
// Grisu fast path gives the digits when it can be sure of the rounding.
عام عرف أرقام_ع64_بخانات_كسرية(القيمة: ع64, الخانات: طبيعي): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع64(القيمة), 52, 11, 2, الخانات); }
عام عرف أرقام_ع32_بخانات_كسرية(القيمة: ع32, الخانات: طبيعي): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع32(القيمة) مثل طبيعي, 23, 8, 2, الخانات); }
عام عرف أرقام_ع64_بخانات_معنوية(القيمة: ع64, الخانات: طبيعي): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع64(القيمة), 52, 11, 3, الخانات); }
عام عرف أرقام_ع32_بخانات_معنوية(القيمة: ع32, الخانات: طبيعي): أرقام_عائم { أرجع أرقام_عائم_ببتات(بتات_ع32(القيمة) مثل طبيعي, 23, 8, 3, الخانات); }

// ---- Parsing ---------------------------------------------------------------

عام نوع خطأ_تحليل_عائم =
    | فارغ
    | صيغة_غير_صالحة
;

// [+-] (digits [. digits] | . digits) [(e|E) [+-] digits], or inf,
// infinity, nan (any case), as Rust's f64::from_str; no spaces.
عرف حلل_عائما_ببتات(النص: &نص, العرض: طبيعي): نتيجة طبيعي, خطأ_تحليل_عائم {
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(النص));
    دع العدد: طبيعي = الطول(البايتات) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عائم.فارغ()); };
    دع ف: متغير طبيعي = 0;
    دع سالب: متغير منطقي = خطأ;
    إذا (البايتات[0] == 0x2D || البايتات[0] == 0x2B) { سالب := البايتات[0] == 0x2D; ف := 1; };
    دع الكلمة: متغير متجه ط8 = [];
    دع ك: متغير طبيعي = ف;
    طالما (ك < العدد) {
        دع ب: ط8 = البايتات[ك];
        إذا (ب >= 0x41 && ب <= 0x5A) { ألحق(الكلمة, ب + 32); } وإلا { ألحق(الكلمة, ب); };
        ك := ك + 1;
    }
    دع الكلمة_نصا: نص = من_بايتات(&الكلمة);
    دع واحد: طبيعي = 1;
    دع بت_الإشارة: متغير طبيعي = 0;
    إذا (سالب) { بت_الإشارة := واحد << (العرض - 1); };
    دع لانهاية_قصيرة: نص = «inf»;
    دع لانهاية_طويلة: نص = «infinity»;
    دع ليس_رقما: نص = «nan»;
    إذا (نصان_متساويان(&الكلمة_نصا, &لانهاية_قصيرة) || نصان_متساويان(&الكلمة_نصا, &لانهاية_طويلة)) {
        إذا (العرض == 32) { أرجع نتيجة.نجح(بت_الإشارة | 0x7F800000); };
        أرجع نتيجة.نجح(بت_الإشارة | 0x7FF0000000000000);
    };
    إذا (نصان_متساويان(&الكلمة_نصا, &ليس_رقما)) {
        إذا (العرض == 32) { أرجع نتيجة.نجح(0x7FC00000); };
        أرجع نتيجة.نجح(0x7FF8000000000000);
    };
    دع أرقام_الجزء: متغير طبيعي = 0;
    طالما (ف < العدد && البايتات[ف] >= 0x30 && البايتات[ف] <= 0x39) { ف := ف + 1; أرقام_الجزء := أرقام_الجزء + 1; }
    إذا (ف < العدد && البايتات[ف] == 0x2E) {
        ف := ف + 1;
        طالما (ف < العدد && البايتات[ف] >= 0x30 && البايتات[ف] <= 0x39) { ف := ف + 1; أرقام_الجزء := أرقام_الجزء + 1; }
    };
    إذا (أرقام_الجزء == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عائم.صيغة_غير_صالحة()); };
    إذا (ف < العدد && (البايتات[ف] == 0x65 || البايتات[ف] == 0x45)) {
        ف := ف + 1;
        إذا (ف < العدد && (البايتات[ف] == 0x2D || البايتات[ف] == 0x2B)) { ف := ف + 1; };
        دع أرقام_الأس: متغير طبيعي = 0;
        طالما (ف < العدد && البايتات[ف] >= 0x30 && البايتات[ف] <= 0x39) { ف := ف + 1; أرقام_الأس := أرقام_الأس + 1; }
        إذا (أرقام_الأس == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_عائم.صيغة_غير_صالحة()); };
    };
    إذا (ف != العدد) { أرجع نتيجة.خطأ(خطأ_تحليل_عائم.صيغة_غير_صالحة()); };
    طابق بتات_عائم_من_عشري_معيار(&البايتات, العرض) مع
    | اختياري.موجود(البتات) -> { أرجع نتيجة.نجح(البتات); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تحليل_عائم.صيغة_غير_صالحة()); };
}

عام عرف حلل_ع64(النص: &نص): نتيجة ع64, خطأ_تحليل_عائم {
    طابق حلل_عائما_ببتات(النص, 64) مع
    | نتيجة.نجح(البتات) -> { أرجع نتيجة.نجح(ع64_من_بتات(البتات)); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
}

عام عرف حلل_ع32(النص: &نص): نتيجة ع32, خطأ_تحليل_عائم {
    طابق حلل_عائما_ببتات(النص, 32) مع
    | نتيجة.نجح(البتات) -> { أرجع نتيجة.نجح(ع32_من_بتات(البتات مثل ط32)); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
}

عام مرادف f64_to_string = ع64_إلى_نص;
عام مرادف f32_to_string = ع32_إلى_نص;
عام مرادف parse_f64 = حلل_ع64;
عام مرادف parse_f32 = حلل_ع32;
عام نوع float_parse_error = خطأ_تحليل_عائم;
عام مرادف float_digits = أرقام_عائم;
عام مرادف f64_shortest_digits = أرقام_ع64_الأقصر;
عام مرادف f32_shortest_digits = أرقام_ع32_الأقصر;
عام مرادف f64_exact_digits = أرقام_ع64_الدقيقة;
عام مرادف f32_exact_digits = أرقام_ع32_الدقيقة;
عام مرادف f64_fixed_digits = أرقام_ع64_بخانات_كسرية;
عام مرادف f32_fixed_digits = أرقام_ع32_بخانات_كسرية;
عام مرادف f64_significant_digits = أرقام_ع64_بخانات_معنوية;
عام مرادف f32_significant_digits = أرقام_ع32_بخانات_معنوية;
