// User-facing message catalogs (Nahr item 28), as Fluent and ICU
// MessageFormat: a message is an identifier with one template per language
// (BCP 47 tag), and a program shows it in the reader's language. Templates
// name their arguments in braces (`{field}`; `{{` and `}}` are literal
// braces). A message may have plural forms by CLDR category, selected by a
// count: Arabic has six (zero, one, two, few, many, other), English two
// (one, other). The language is a locale value (std.text.language): an
// Accept-Language header, the system language, or one tag. Lookup follows
// RFC 4647 §3.4 for each preferred tag in order (ar-SA, then ar), then the
// catalog's default language. An argument whose direction differs from the
// message's (a Latin name inside an Arabic sentence) is isolated
// (std.text.bidi), so it does not reorder the sentence around it.
//
// Every lookup is a scan of the catalog's entries; a catalog is built once
// at startup and read by every request.
استورد text.from_bytes;
استورد text.compare;
استورد text.language;
استورد text.bidi;
استورد chars.ascii;

// CLDR plural categories.
عام نوع صنف_جمع =
    | صفر
    | واحد
    | اثنان
    | قليل
    | كثير
    | آخر
;
عام مرادف plural_category = صنف_جمع;
عام مرادف plural_category.zero = صنف_جمع.صفر;
عام مرادف plural_category.one = صنف_جمع.واحد;
عام مرادف plural_category.two = صنف_جمع.اثنان;
عام مرادف plural_category.few = صنف_جمع.قليل;
عام مرادف plural_category.many = صنف_جمع.كثير;
عام مرادف plural_category.other = صنف_جمع.آخر;

عرف رقم_صنف_جمع(الصنف: صنف_جمع): طبيعي {
    طابق الصنف مع
    | صنف_جمع.صفر -> { أرجع 0; }
    | صنف_جمع.واحد -> { أرجع 1; }
    | صنف_جمع.اثنان -> { أرجع 2; }
    | صنف_جمع.قليل -> { أرجع 3; }
    | صنف_جمع.كثير -> { أرجع 4; }
    | صنف_جمع.آخر -> { أرجع 5; };
}

// The CLDR cardinal category of an integer in a language (its primary
// subtag): Arabic's six, Hebrew's one/two/other, the Slavic one/few/many,
// French's one for 0 and 1, and one/other elsewhere (English and most
// European languages); languages without plurals (Chinese, Japanese,
// Korean, Turkish ...) are always other.
عام عرف صنف_جمع_لعدد(الوسم: &نص, العدد: عدد): صنف_جمع {
    دع اللغة: نص = اللغة_الأساسية_لوسم(الوسم);
    دع ن: عدد = إذا_سالب_موجب(العدد);
    دع ن10: عدد = ن % 10;
    دع ن100: عدد = ن % 100;
    إذا (نصان_متساويان(&اللغة, &«ar»)) {
        إذا (ن == 0) { أرجع صنف_جمع.صفر(); };
        إذا (ن == 1) { أرجع صنف_جمع.واحد(); };
        إذا (ن == 2) { أرجع صنف_جمع.اثنان(); };
        إذا (ن100 >= 3 && ن100 <= 10) { أرجع صنف_جمع.قليل(); };
        إذا (ن100 >= 11 && ن100 <= 99) { أرجع صنف_جمع.كثير(); };
        أرجع صنف_جمع.آخر();
    };
    إذا (نصان_متساويان(&اللغة, &«he»)) {
        إذا (ن == 1) { أرجع صنف_جمع.واحد(); };
        إذا (ن == 2) { أرجع صنف_جمع.اثنان(); };
        أرجع صنف_جمع.آخر();
    };
    إذا (نصان_متساويان(&اللغة, &«ru») || نصان_متساويان(&اللغة, &«uk»)
        || نصان_متساويان(&اللغة, &«be») || نصان_متساويان(&اللغة, &«pl»)) {
        إذا (ن10 == 1 && ن100 != 11 && !نصان_متساويان(&اللغة, &«pl»)) { أرجع صنف_جمع.واحد(); };
        إذا (ن == 1) { أرجع صنف_جمع.واحد(); };
        إذا (ن10 >= 2 && ن10 <= 4 && (ن100 < 12 || ن100 > 14)) { أرجع صنف_جمع.قليل(); };
        أرجع صنف_جمع.كثير();
    };
    إذا (نصان_متساويان(&اللغة, &«fr») || نصان_متساويان(&اللغة, &«pt»)) {
        إذا (ن == 0 || ن == 1) { أرجع صنف_جمع.واحد(); };
        أرجع صنف_جمع.آخر();
    };
    إذا (نصان_متساويان(&اللغة, &«zh») || نصان_متساويان(&اللغة, &«ja») || نصان_متساويان(&اللغة, &«ko»)
        || نصان_متساويان(&اللغة, &«tr») || نصان_متساويان(&اللغة, &«id») || نصان_متساويان(&اللغة, &«th»)) {
        أرجع صنف_جمع.آخر();
    };
    إذا (ن == 1) { أرجع صنف_جمع.واحد(); };
    أرجع صنف_جمع.آخر();
}
عام مرادف plural_category_of = صنف_جمع_لعدد;

عرف إذا_سالب_موجب(العدد: عدد): عدد {
    إذا (العدد < 0) { أرجع 0 - العدد; };
    أرجع العدد;
}

// One message in one language: a template per plural category (index
// رقم_صنف_جمع; a message without plurals has only «other»).
عام نوع ترجمة_رسالة = {
    المعرف: نص,
    الوسم: نص,
    الصيغ: متجه اختياري نص
};

عام نوع فهرس_رسائل = {
    الترجمات: متجه ترجمة_رسالة,
    // The language every message should have, used when none of the
    // reader's languages has it.
    الافتراضية: نص
};
عام مرادف message_catalog = فهرس_رسائل;

// A named argument of a message.
عام نوع وسيطة_رسالة = { الاسم: نص, القيمة: نص };
عام مرادف message_argument = وسيطة_رسالة;

عام عرف وسيطة(الاسم: نص, القيمة: نص): وسيطة_رسالة {
    دع الناتج: وسيطة_رسالة = { الاسم: الاسم, القيمة: القيمة };
    أرجع الناتج;
}
عام مرادف message_arg = وسيطة;

عام عرف أنشئ_فهرس_رسائل(اللغة_الافتراضية: &نص): فهرس_رسائل {
    دع الترجمات: متجه ترجمة_رسالة = [];
    دع الناتج: فهرس_رسائل = { الترجمات: الترجمات, الافتراضية: طبع_وسم_لغة(اللغة_الافتراضية) };
    أرجع الناتج;
}
عام مرادف message_catalog_new = أنشئ_فهرس_رسائل;

عرف موضع_ترجمة(الفهرس: &فهرس_رسائل, المعرف: &نص, الوسم: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الفهرس).الترجمات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الفهرس).الترجمات[ف].المعرف, المعرف)
            && نصان_متساويان(&(*الفهرس).الترجمات[ف].الوسم, الوسم)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف صيغ_فارغة(): متجه اختياري نص {
    دع الناتج: متغير متجه اختياري نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    أرجع الناتج;
}

// Sets the template of a plural category of a message in a language (a
// second call for the same message, language and category replaces it).
عام عرف أضف_صيغة_رسالة(الفهرس: &متغير فهرس_رسائل, المعرف: &نص, الوسم: &نص, الصنف: صنف_جمع, القالب: &نص): فراغ {
    دع الوسم_المطبع: نص = طبع_وسم_لغة(الوسم);
    دع الموضع: طبيعي;
    طابق موضع_ترجمة(الفهرس, المعرف, &الوسم_المطبع) مع
    | اختياري.موجود(م) -> { الموضع := م; }
    | اختياري.لا_شيء -> {
        دع الجديدة: ترجمة_رسالة = { المعرف: انسخ_نص(المعرف), الوسم: الوسم_المطبع, الصيغ: صيغ_فارغة() };
        ألحق((*الفهرس).الترجمات, الجديدة);
        الموضع := (الطول((*الفهرس).الترجمات) مثل طبيعي) - 1;
    };
    (*الفهرس).الترجمات[الموضع].الصيغ[رقم_صنف_جمع(الصنف)] := اختياري.موجود(انسخ_نص(القالب));
}
عام مرادف message_catalog_add_form = أضف_صيغة_رسالة;

// A message without plural forms.
عام عرف أضف_رسالة(الفهرس: &متغير فهرس_رسائل, المعرف: &نص, الوسم: &نص, القالب: &نص): فراغ {
    أضف_صيغة_رسالة(الفهرس, المعرف, الوسم, صنف_جمع.آخر(), القالب);
}
عام مرادف message_catalog_add = أضف_رسالة;

// The translation of a message for the reader's languages: each preferred
// tag and its shorter forms in order, then the default language.
عرف اختر_ترجمة(الفهرس: &فهرس_رسائل, المعرف: &نص, اللغة: &لغة): اختياري طبيعي {
    دع الوسوم: متجه نص = وسوم_لغة(اللغة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوسوم) مثل طبيعي)) {
        دع الوسم: متغير نص = طبع_وسم_لغة(&الوسوم[ف]);
        طالما ((الطول(الوسم) مثل طبيعي) > 0) {
            طابق موضع_ترجمة(الفهرس, المعرف, &الوسم) مع
            | اختياري.موجود(م) -> { أرجع اختياري.موجود(م); }
            | اختياري.لا_شيء -> { };
            الوسم := اختصر_وسم_لغة(&الوسم);
        }
        ف := ف + 1;
    }
    أرجع موضع_ترجمة(الفهرس, المعرف, &(*الفهرس).الافتراضية);
}

عرف اتجاه_لغة_الرسالة(الوسم: &نص): اتجاه_نص {
    دع اللغة: نص = اللغة_الأساسية_لوسم(الوسم);
    إذا (نصان_متساويان(&اللغة, &«ar») || نصان_متساويان(&اللغة, &«he») || نصان_متساويان(&اللغة, &«fa»)
        || نصان_متساويان(&اللغة, &«ur») || نصان_متساويان(&اللغة, &«ps») || نصان_متساويان(&اللغة, &«yi»)) {
        أرجع اتجاه_نص.من_اليمين_إلى_اليسار();
    };
    أرجع اتجاه_نص.من_اليسار_إلى_اليمين();
}

// Fills a template: `{name}` takes the argument of that name (isolated
// when its direction differs from the message's), an unknown name stays
// as written, `{{` and `}}` are braces.
عام عرف املأ_قالب_رسالة(القالب: &نص, الوسائط: &متجه وسيطة_رسالة, الاتجاه: اتجاه_نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*القالب) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*القالب)[ف];
        إذا (ب == 0x7B && ف + 1 < العدد && (*القالب)[ف + 1] == 0x7B) {
            ألحق(الناتج, 0x7B مثل ط8); ف := ف + 2;
        } وإلا إذا (ب == 0x7D && ف + 1 < العدد && (*القالب)[ف + 1] == 0x7D) {
            ألحق(الناتج, 0x7D مثل ط8); ف := ف + 2;
        } وإلا إذا (ب == 0x7B) {
            دع ن: متغير طبيعي = ف + 1;
            طالما (ن < العدد && (*القالب)[ن] != 0x7D) { ن := ن + 1; }
            إذا (ن >= العدد) {
                ألحق(الناتج, ب); ف := ف + 1;
            } وإلا {
                دع الاسم_البايتات: متغير متجه ط8 = [];
                دع ك: متغير طبيعي = ف + 1;
                طالما (ك < ن) { ألحق(الاسم_البايتات, (*القالب)[ك]); ك := ك + 1; }
                دع الاسم: نص = الاسم_البايتات مثل نص;
                دع وجد: متغير منطقي = خطأ;
                دع و: متغير طبيعي = 0;
                طالما (!وجد && و < (الطول(*الوسائط) مثل طبيعي)) {
                    إذا (نصان_متساويان(&(*الوسائط)[و].الاسم, &الاسم)) {
                        دع القيمة: نص = اعزل_اتجاه_في(&(*الوسائط)[و].القيمة, الاتجاه);
                        دع ق: متغير طبيعي = 0;
                        طالما (ق < (الطول(القيمة) مثل طبيعي)) { ألحق(الناتج, القيمة[ق]); ق := ق + 1; }
                        وجد := صواب;
                    };
                    و := و + 1;
                }
                إذا (!وجد) {
                    دع ك2: متغير طبيعي = ف;
                    طالما (ك2 <= ن) { ألحق(الناتج, (*القالب)[ك2]); ك2 := ك2 + 1; }
                };
                ف := ن + 1;
            };
        } وإلا {
            ألحق(الناتج, ب); ف := ف + 1;
        };
    }
    أرجع الناتج مثل نص;
}
عام مرادف fill_message_template = املأ_قالب_رسالة;

// The message in the reader's language, or none when no language has it.
عام عرف رسالة_بلغة(الفهرس: &فهرس_رسائل, اللغة: &لغة, المعرف: &نص, الوسائط: &متجه وسيطة_رسالة): اختياري نص {
    طابق اختر_ترجمة(الفهرس, المعرف, اللغة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        دع الترجمة: &ترجمة_رسالة = &(*الفهرس).الترجمات[م];
        طابق (*الترجمة).الصيغ[5] مع
        | اختياري.موجود(القالب) -> {
            أرجع اختياري.موجود(املأ_قالب_رسالة(&القالب, الوسائط, اتجاه_لغة_الرسالة(&(*الترجمة).الوسم)));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
}
عام مرادف message = رسالة_بلغة;

// The plural form for العدد in the chosen language (falling back to
// «other»); the argument `{count}` is the number.
عام عرف رسالة_بعدد(الفهرس: &فهرس_رسائل, اللغة: &لغة, المعرف: &نص, العدد: عدد, الوسائط: &متجه وسيطة_رسالة): اختياري نص {
    طابق اختر_ترجمة(الفهرس, المعرف, اللغة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        دع الترجمة: &ترجمة_رسالة = &(*الفهرس).الترجمات[م];
        دع الصنف: طبيعي = رقم_صنف_جمع(صنف_جمع_لعدد(&(*الترجمة).الوسم, العدد));
        دع الموضع: متغير طبيعي = 5;
        طابق (*الترجمة).الصيغ[الصنف] مع
        | اختياري.موجود(_) -> { الموضع := الصنف; }
        | اختياري.لا_شيء -> { };
        دع الكل: متغير متجه وسيطة_رسالة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
            ألحق(الكل, وسيطة(انسخ_نص(&(*الوسائط)[ف].الاسم), انسخ_نص(&(*الوسائط)[ف].القيمة)));
            ف := ف + 1;
        }
        ألحق(الكل, وسيطة(«count», نص_عدد_رسالة(العدد)));
        طابق (*الترجمة).الصيغ[الموضع] مع
        | اختياري.موجود(القالب) -> {
            أرجع اختياري.موجود(املأ_قالب_رسالة(&القالب, &الكل, اتجاه_لغة_الرسالة(&(*الترجمة).الوسم)));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
}
عام مرادف message_count = رسالة_بعدد;

عرف نص_عدد_رسالة(العدد: عدد): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ن: متغير عدد = إذا_سالب_موجب(العدد);
    إذا (ن == 0) { ألحق(الناتج, 0x30 مثل ط8); };
    دع الأرقام: متغير متجه ط8 = [];
    طالما (ن > 0) { ألحق(الأرقام, ((ن % 10) + 48) مثل ط8); ن := ن / 10; }
    إذا (العدد < 0) { ألحق(الناتج, 0x2D مثل ط8); };
    دع ف: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
    طالما (ف > 0) { ف := ف - 1; ألحق(الناتج, الأرقام[ف]); }
    أرجع الناتج مثل نص;
}
