// Materializes text by copying bytes; it does not validate UTF-8.
عام عرف من_بايتات(البايتات: &متجه ط8): نص {
    أرجع انسخ_بايتات(البايتات) مثل نص;
}

// An independent copy of a byte vector: new storage holding the same bytes.
// Owned values are never duplicated by reading them through a reference
// (docs/OWNERSHIP_AND_DESTRUCTION.md); a copy is this explicit allocation.
عام عرف انسخ_بايتات(البايتات: &متجه ط8): متجه ط8 {
    دع النسخة: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(النسخة, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع النسخة;
}

// An independent copy of a text value.
عام عرف انسخ_نص(القيمة: &نص): نص {
    دع النسخة: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(النسخة, (*القيمة)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع النسخة مثل نص;
}

// The bytes of a text value (its UTF-8 encoding). Names, paths and ABI
// spellings are written as readable literals and converted here where an API
// needs bytes, instead of being hand-encoded as byte arrays.
عام عرف بايتات_من_نص(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(الناتج, النص[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

// The same bytes followed by one NUL byte (the C string ABI, e.g. LLVM names).
عام عرف بايتات_منتهية_بصفر_من_نص(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(النص);
    ألحق(الناتج, 0 مثل ط8);
    أرجع الناتج;
}

// Appends the bytes of a text value to an existing byte vector, for output
// built piecewise (escape sequences, separators, suffixes) without spelling
// the text as byte codes and without an intermediate vector.
عام عرف ألحق_بايتات_نص(الهدف: &متغير متجه ط8, النص: نص): فراغ {
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(*الهدف, النص[الفهرس]);
        الفهرس := الفهرس + 1;
    }
}

// The byte of a one-byte (ASCII) text value, so byte-oriented parsers can
// compare against «:» instead of a concealed byte code. A text of any other
// length yields none.
عام عرف بايت_نص(النص: نص): اختياري ط8 {
    لو ((الطول(النص) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(النص[0]);
}

// Independent copies of optional text and bytes.
عام عرف انسخ_اختيار_نص(القيمة: &اختياري نص): اختياري نص {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_نص(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف انسخ_اختيار_بايتات(القيمة: &اختياري متجه ط8): اختياري متجه ط8 {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_بايتات(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام مرادف from_bytes = من_بايتات;
عام مرادف copy_optional_text = انسخ_اختيار_نص;
عام مرادف copy_optional_bytes = انسخ_اختيار_بايتات;
عام مرادف copy_bytes = انسخ_بايتات;
عام مرادف copy_text = انسخ_نص;
عام مرادف bytes_from_text = بايتات_من_نص;
عام مرادف nul_terminated_bytes_from_text = بايتات_منتهية_بصفر_من_نص;
عام مرادف append_text_bytes = ألحق_بايتات_نص;
عام مرادف text_byte = بايت_نص;
