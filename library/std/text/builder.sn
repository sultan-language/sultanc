استورد bytes.builder;
استورد text.from_bytes;
استورد encoding.utf8;

// Text builder reuses the byte builder so repeated text concatenation does not
// repeatedly materialize intermediate Text values.
عام نوع باني_نص = { البايتات: باني_بايتات };

عام عرف أنشئ_باني_نص_بسعة(السعة: غير_موقع): باني_نص {
    دع البايتات: باني_بايتات = أنشئ_باني_بايتات_بسعة(السعة);
    دع الناتج: باني_نص = { البايتات: البايتات };
    أرجع الناتج;
}

عام عرف أنشئ_باني_نص(): باني_نص {
    أرجع أنشئ_باني_نص_بسعة(0);
}

عام عرف احجز_لباني_النص(الباني: &متغير باني_نص, إضافي: غير_موقع): فراغ {
    احجز_لباني_البايتات(&متغير (*الباني).البايتات, إضافي);
}

عام عرف ألحق_نصا_بباني_النص(الباني: &متغير باني_نص, النص: &نص): فراغ {
    ألحق_نصا_بباني_البايتات(&متغير (*الباني).البايتات, النص);
}

// Returns false for a non-Unicode-scalar value and leaves the builder unchanged.
عام عرف ألحق_محرفا_بباني_النص(الباني: &متغير باني_نص, المحرف: حرف): منطقي {
    دع فارغ: متجه غ8 = [];
    طابق ألحق_محرف_يوتيف8(فارغ, المحرف مثل غ32) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع خطأ; }
    | نتيجة_ترميز_يوتيف8.مشفر(المشفرة) -> {
        ألحق_بايتات_بباني_البايتات(&متغير (*الباني).البايتات, &المشفرة);
        أرجع صواب;
    };
}

عام عرف طول_باني_النص(الباني: &باني_نص): غير_موقع {
    أرجع طول_باني_البايتات(&(*الباني).البايتات);
}

عام عرف سعة_باني_النص(الباني: &باني_نص): غير_موقع {
    أرجع سعة_باني_البايتات(&(*الباني).البايتات);
}

عام عرف باني_النص_فارغ(الباني: &باني_نص): منطقي {
    أرجع باني_البايتات_فارغ(&(*الباني).البايتات);
}

عام عرف نص_باني_النص(الباني: &باني_نص): نص {
    دع البايتات: متجه غ8 = بايتات_باني_البايتات(&(*الباني).البايتات);
    أرجع من_بايتات(&البايتات);
}

عام عرف امسح_باني_النص(الباني: &متغير باني_نص): فراغ {
    امسح_باني_البايتات(&متغير (*الباني).البايتات);
}

عام عرف أعد_ضبط_باني_النص(الباني: &متغير باني_نص): فراغ {
    أعد_ضبط_باني_البايتات(&متغير (*الباني).البايتات);
}

عام مرادف text_builder = باني_نص;
عام مرادف new_text_builder = أنشئ_باني_نص;
عام مرادف new_text_builder_with_capacity = أنشئ_باني_نص_بسعة;
عام مرادف text_builder_reserve = احجز_لباني_النص;
عام مرادف text_builder_append_text = ألحق_نصا_بباني_النص;
عام مرادف text_builder_append_char = ألحق_محرفا_بباني_النص;
عام مرادف text_builder_length = طول_باني_النص;
عام مرادف text_builder_capacity = سعة_باني_النص;
عام مرادف text_builder_is_empty = باني_النص_فارغ;
عام مرادف text_builder_text = نص_باني_النص;
عام مرادف text_builder_clear = امسح_باني_النص;
عام مرادف text_builder_reset = أعد_ضبط_باني_النص;
