استورد text.range;
استورد text.from_bytes;

عام عرف مقطع_نص(
    القيمة: &نص,
    الموضع: طبيعي,
    العدد: طبيعي
): اختياري نص {
    لو (!متاح_في_النص(القيمة, الموضع, العدد)) {
        أرجع اختياري.لا_شيء();
    };
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع موضع_البايت: طبيعي = الموضع + ف;
        ألحق(البايتات, (*القيمة)[موضع_البايت]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}

عام مرادف substring = مقطع_نص;
