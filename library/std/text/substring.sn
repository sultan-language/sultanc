استورد text.range;
استورد text.from_bytes;

عام عرف مقطع_نص(
    القيمة: &نص,
    الموضع: طبيعي,
    العدد: طبيعي
): اختياري نص {
    إذا (!متاح_في_النص(القيمة, الموضع, العدد)) {
        أرجع اختياري.لا_شيء();
    };
    // One allocation and one block copy; the bytes then become the text.
    دع البايتات: متغير متجه ط8 = [];
    احجز_سعة(البايتات, العدد);
    ألحق_من(البايتات, القيمة, الموضع, العدد);
    أرجع اختياري.موجود(البايتات مثل نص);
}

عام مرادف substring = مقطع_نص;
