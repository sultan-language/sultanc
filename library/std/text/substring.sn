استورد text.range;
استورد text.from_bytes;

عام عرف مقطع_نص(
    القيمة: &نص,
    الموضع: غير_موقع,
    العدد: غير_موقع
): اختيار نص {
    لو (!متاح_في_النص(القيمة, الموضع, العدد)) {
        أرجع اختيار.لا_شيء();
    };
    دع الأصل: نص = *القيمة;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع موضع_البايت: غير_موقع = الموضع + ف;
        ألحق(البايتات, الأصل[موضع_البايت]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(من_بايتات(&البايتات));
}

عام مرادف substring = مقطع_نص;
