module format { ar: تنسيق };
module from_bytes { ar: من_بايتات };
module language { ar: لغة };
module messages { ar: رسائل };
module number { ar: أعداد };
module radix { ar: أساس };
module range { ar: نطاق };
module search { ar: بحث };
module substring { ar: مقطع };
module system_language { ar: لغة_النظام };
module transform { ar: تحويل };
