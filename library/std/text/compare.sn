استورد text.range;

// مقارنة شريحتين من نصين بالبايتات.
عام عرف يطابق_شريحتين(
    الأول: &نص,
    بداية_الأول: غير_موقع,
    نهاية_الأول: غير_موقع,
    الثاني: &نص,
    بداية_الثاني: غير_موقع,
    نهاية_الثاني: غير_موقع
): منطقي {
    لو ((نهاية_الأول < بداية_الأول) || (نهاية_الثاني < بداية_الثاني)) {
        أرجع خطأ;
    };

    دع عدد_الأول: غير_موقع = نهاية_الأول - بداية_الأول;
    دع عدد_الثاني: غير_موقع = نهاية_الثاني - بداية_الثاني;

    لو (عدد_الأول != عدد_الثاني) {
        أرجع خطأ;
    };
    لو (!متاح_في_النص(الأول, بداية_الأول, عدد_الأول)) {
        أرجع خطأ;
    };
    لو (!متاح_في_النص(الثاني, بداية_الثاني, عدد_الثاني)) {
        أرجع خطأ;
    };

    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < عدد_الأول) {
        دع موضع_الأول: غير_موقع = بداية_الأول + الفهرس;
        دع موضع_الثاني: غير_موقع = بداية_الثاني + الفهرس;
        لو ((*الأول)[موضع_الأول] != (*الثاني)[موضع_الثاني]) {
            أرجع خطأ;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عام عرف يطابق_عند(
    القيمة: &نص,
    الموضع: غير_موقع,
    المطلوب: نص
): منطقي {
    دع النمط: نص = المطلوب;
    دع العدد: غير_موقع = الطول(النمط) مثل غير_موقع;
    لو (!متاح_في_النص(القيمة, الموضع, العدد)) { أرجع خطأ; };
    أرجع يطابق_شريحتين(
        القيمة,
        الموضع,
        الموضع + العدد,
        &النمط,
        0,
        العدد
    );
}

عام عرف يطابق_شريحة(
    القيمة: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    المطلوب: نص
): منطقي {
    دع النمط: نص = المطلوب;
    دع العدد: غير_موقع = الطول(النمط) مثل غير_موقع;
    أرجع يطابق_شريحتين(
        القيمة,
        البداية,
        النهاية,
        &النمط,
        0,
        العدد
    );
}

// مساواة نصين كاملين بالبايتات؛ سياسة هوية معرف SultanC ليست جزءا من هذه العملية.
عام عرف نصان_متساويان(الأول: &نص, الثاني: &نص): منطقي {
    دع عدد_أ: غير_موقع = الطول(*الأول) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(*الثاني) مثل غير_موقع;
    أرجع يطابق_شريحتين(الأول, 0, عدد_أ, الثاني, 0, عدد_ب);
}

// مقارنة معجمية كاملة للنص حسب تسلسل بايتاته: -1 أو 0 أو 1.
// لا تطبق هذه العملية تطبيعا أو قواعد هوية معرفات أو مسارات.
عام عرف قارن_نصين_معجميا(الأول: &نص, الثاني: &نص): عدد {
    دع عدد_أ: غير_موقع = الطول(*الأول) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(*الثاني) مثل غير_موقع;
    دع الحد: متغير غير_موقع = عدد_أ;

    لو (عدد_ب < الحد) {
        الحد := عدد_ب;
    };

    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحد) {
        لو ((*الأول)[الفهرس] < (*الثاني)[الفهرس]) {
            أرجع -1;
        };
        لو ((*الأول)[الفهرس] > (*الثاني)[الفهرس]) {
            أرجع 1;
        };
        الفهرس := الفهرس + 1;
    }

    لو (عدد_أ < عدد_ب) {
        أرجع -1;
    };
    لو (عدد_أ > عدد_ب) {
        أرجع 1;
    };
    أرجع 0;
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف text_slices_match = يطابق_شريحتين;
عام مرادف text_matches_at = يطابق_عند;
عام مرادف text_slice_matches = يطابق_شريحة;
عام مرادف texts_equal = نصان_متساويان;
عام مرادف compare_texts_lexicographically = قارن_نصين_معجميا;
