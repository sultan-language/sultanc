// Pure data-integrity checksums. These are not cryptographic hashes.
// Table-driven CRC-32 (IEEE 802.3, reflected polynomial 0xEDB88320), one
// table lookup per byte as zlib's and Go's hash/crc32 generic path.
عرف جدول_سي_ار_سي32(): متجه ط32 {
    دع الجدول: متغير متجه ط32 = [];
    دع ف: متغير ط32 = 0;
    طالما (ف < 256) {
        دع القيمة: متغير ط32 = ف;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            إذا ((القيمة & 1) != 0) { القيمة := (القيمة >> 1) ^ 0xEDB88320; }
            وإلا { القيمة := القيمة >> 1; };
            ب := ب + 1;
        }
        ألحق(الجدول, القيمة);
        ف := ف + 1;
    }
    أرجع الجدول;
}

// The CRC-32 table, for callers that keep it between inputs
// (حدث_سي_ار_سي32_بجدول).
عام عرف أنشئ_جدول_سي_ار_سي32(): متجه ط32 { أرجع جدول_سي_ار_سي32(); }
عام مرادف crc32_table_new = أنشئ_جدول_سي_ار_سي32;

// As حدث_سي_ار_سي32 with a table from أنشئ_جدول_سي_ار_سي32.
عام عرف حدث_سي_ار_سي32_بجدول(
    الجدول: &متجه ط32, السابق: ط32, البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي
): ط32 {
    دع القيمة: متغير ط32 = السابق ^ 0xFFFFFFFF;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع الفهرس: طبيعي = ((القيمة ^ ((*البايتات)[ف] مثل ط32)) & 0xFF) مثل طبيعي;
        القيمة := (*الجدول)[الفهرس] ^ (القيمة >> 8);
        ف := ف + 1;
    }
    أرجع القيمة ^ 0xFFFFFFFF;
}
عام مرادف crc32_update_with_table = حدث_سي_ار_سي32_بجدول;

// Continues a CRC-32 over البايتات[البداية..النهاية): السابق is the CRC of
// the bytes before (0 to start), as Go's crc32.Update.
عام عرف حدث_سي_ار_سي32(السابق: ط32, البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): ط32 {
    دع القيمة: متغير ط32 = السابق ^ 0xFFFFFFFF;
    دع ف: متغير طبيعي = البداية;
    إذا (النهاية - البداية < 256) {
        // Short ranges bit by bit: cheaper than building the table.
        طالما (ف < النهاية) {
            القيمة := القيمة ^ ((*البايتات)[ف] مثل ط32);
            دع ب: متغير طبيعي = 0;
            طالما (ب < 8) {
                إذا ((القيمة & 1) != 0) { القيمة := (القيمة >> 1) ^ 0xEDB88320; }
                وإلا { القيمة := القيمة >> 1; };
                ب := ب + 1;
            }
            ف := ف + 1;
        }
        أرجع القيمة ^ 0xFFFFFFFF;
    };
    دع الجدول: متجه ط32 = جدول_سي_ار_سي32();
    طالما (ف < النهاية) {
        دع الفهرس: طبيعي = ((القيمة ^ ((*البايتات)[ف] مثل ط32)) & 0xFF) مثل طبيعي;
        القيمة := الجدول[الفهرس] ^ (القيمة >> 8);
        ف := ف + 1;
    }
    أرجع القيمة ^ 0xFFFFFFFF;
}

عام عرف احسب_سي_ار_سي32(البايتات: &متجه ط8): ط32 {
    أرجع حدث_سي_ار_سي32(0, البايتات, 0, الطول(*البايتات) مثل طبيعي);
}

// CRC-64/XZ (ECMA-182 polynomial, reflected 0xC96C5795D7870F42, initial and
// final value all ones): the .xz check type 4, as Go's hash/crc64 ECMA table.
عرف جدول_سي_ار_سي64(): متجه طبيعي {
    دع الجدول: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 256) {
        دع القيمة: متغير طبيعي = ف;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            إذا ((القيمة & 1) != 0) { القيمة := (القيمة >> 1) ^ 0xC96C5795D7870F42; }
            وإلا { القيمة := القيمة >> 1; };
            ب := ب + 1;
        }
        ألحق(الجدول, القيمة);
        ف := ف + 1;
    }
    أرجع الجدول;
}

عام عرف حدث_سي_ار_سي64(السابق: طبيعي, البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع القيمة: متغير طبيعي = السابق ^ 0xFFFFFFFFFFFFFFFF;
    دع ف: متغير طبيعي = البداية;
    إذا (النهاية - البداية < 256) {
        طالما (ف < النهاية) {
            القيمة := القيمة ^ ((*البايتات)[ف] مثل طبيعي);
            دع ب: متغير طبيعي = 0;
            طالما (ب < 8) {
                إذا ((القيمة & 1) != 0) { القيمة := (القيمة >> 1) ^ 0xC96C5795D7870F42; }
                وإلا { القيمة := القيمة >> 1; };
                ب := ب + 1;
            }
            ف := ف + 1;
        }
        أرجع القيمة ^ 0xFFFFFFFFFFFFFFFF;
    };
    دع الجدول: متجه طبيعي = جدول_سي_ار_سي64();
    طالما (ف < النهاية) {
        دع الفهرس: طبيعي = (القيمة ^ ((*البايتات)[ف] مثل طبيعي)) & 0xFF;
        القيمة := الجدول[الفهرس] ^ (القيمة >> 8);
        ف := ف + 1;
    }
    أرجع القيمة ^ 0xFFFFFFFFFFFFFFFF;
}

عام عرف احسب_سي_ار_سي64(البايتات: &متجه ط8): طبيعي {
    أرجع حدث_سي_ار_سي64(0, البايتات, 0, الطول(*البايتات) مثل طبيعي);
}

عام عرف احسب_أدلر32(البايتات: &متجه ط8): ط32 {
    دع المصدر: متجه ط8 = *البايتات;
    دع أ: متغير ط32 = 1;
    دع ب: متغير ط32 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        أ := (أ + (المصدر[ف] مثل ط32)) % 65521;
        ب := (ب + أ) % 65521;
        ف := ف + 1;
    }
    أرجع (ب << 16) | أ;
}

عام مرادف crc32 = احسب_سي_ار_سي32;
عام مرادف adler32 = احسب_أدلر32;
عام مرادف crc32_update = حدث_سي_ار_سي32;
عام مرادف crc64 = احسب_سي_ار_سي64;
عام مرادف crc64_update = حدث_سي_ار_سي64;
