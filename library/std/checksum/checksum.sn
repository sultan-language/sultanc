// Pure data-integrity checksums. These are not cryptographic hashes.
عام عرف احسب_سي_ار_سي32(البايتات: &متجه غ8): غ32 {
    دع المصدر: متجه غ8 = *البايتات;
    دع القيمة: متغير غ32 = 0xFFFFFFFF;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        القيمة := القيمة ^ (المصدر[ف] مثل غ32);
        دع ب: متغير غير_موقع = 0;
        بينما (ب < 8) {
            لو ((القيمة & 1) != 0) {
                القيمة := (القيمة >> 1) ^ 0xEDB88320;
            } وإلا {
                القيمة := القيمة >> 1;
            };
            ب := ب + 1;
        }
        ف := ف + 1;
    }
    أرجع القيمة ^ 0xFFFFFFFF;
}

عام عرف احسب_أدلر32(البايتات: &متجه غ8): غ32 {
    دع المصدر: متجه غ8 = *البايتات;
    دع أ: متغير غ32 = 1;
    دع ب: متغير غ32 = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        أ := (أ + (المصدر[ف] مثل غ32)) % 65521;
        ب := (ب + أ) % 65521;
        ف := ف + 1;
    }
    أرجع (ب << 16) | أ;
}

عام مرادف crc32 = احسب_سي_ار_سي32;
عام مرادف adler32 = احسب_أدلر32;
