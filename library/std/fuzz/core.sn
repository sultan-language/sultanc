استورد bytes.cursor;

// Deterministic fuzz-data provider. Coverage instrumentation and corpus
// scheduling belong to compiler/tooling; this module only maps an input byte
// sequence into reproducible typed choices for fuzz targets.
عام نوع مدخل_فز = {
    المؤشر: مؤشر_بايتات
};

عام عرف أنشئ_مدخل_فز(البايتات: &متجه ط8): مدخل_فز {
    دع المؤشر: مؤشر_بايتات = أنشئ_مؤشر_بايتات(البايتات);
    دع الناتج: مدخل_فز = { المؤشر: المؤشر };
    أرجع الناتج;
}

عام عرف فز_متبقي(المدخل: &مدخل_فز): طبيعي {
    دع الحالة: مدخل_فز = *المدخل;
    أرجع متبقي_مؤشر_بايتات(&الحالة.المؤشر);
}

عام عرف فز_ط8(المدخل: &متغير مدخل_فز): اختياري ط8 {
    دع القيمة: اختياري ط8 = اقرأ_ط8(&متغير (*المدخل).المؤشر);
    أرجع القيمة;
}

عام عرف فز_منطقي(المدخل: &متغير مدخل_فز): اختياري منطقي {
    طابق فز_ط8(المدخل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود((القيمة & 1) != 0); };
}

عام عرف فز_ط16(المدخل: &متغير مدخل_فز): اختياري ط16 {
    دع القيمة: اختياري ط16 = اقرأ_ط16_صغير(&متغير (*المدخل).المؤشر);
    أرجع القيمة;
}

عام عرف فز_ط32(المدخل: &متغير مدخل_فز): اختياري ط32 {
    دع القيمة: اختياري ط32 = اقرأ_ط32_صغير(&متغير (*المدخل).المؤشر);
    أرجع القيمة;
}

عام عرف فز_أقل_من(المدخل: &متغير مدخل_فز, الحد: طبيعي): اختياري طبيعي {
    لو (الحد == 0) { أرجع اختياري.لا_شيء(); };
    طابق فز_ط32(المدخل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود((القيمة مثل طبيعي) % الحد); };
}

عام عرف فز_بايتات(المدخل: &متغير مدخل_فز, الأقصى: طبيعي): متجه ط8 {
    دع المتبقي: طبيعي = متبقي_مؤشر_بايتات(&(*المدخل).المؤشر);
    دع العدد: متغير طبيعي = المتبقي;
    لو (العدد > الأقصى) { العدد := الأقصى; };
    دع الناتج: متجه ط8;
    طابق اقرأ_بايتات(&متغير (*المدخل).المؤشر, العدد) مع
    | اختياري.موجود(القيمة) -> { الناتج := القيمة; }
    | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; الناتج := فارغ; };
    أرجع الناتج;
}

عام عرف فز_الباقي(المدخل: &متغير مدخل_فز): متجه ط8 {
    دع الحالة: مدخل_فز = *المدخل;
    دع العدد: طبيعي = متبقي_مؤشر_بايتات(&الحالة.المؤشر);
    أرجع فز_بايتات(المدخل, العدد);
}


عام عرف فز_اقلب_بتا(البايتات: &متجه ط8, موضع_البت: طبيعي): متجه ط8 {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع عدد_البايتات: طبيعي = الطول(المصدر) مثل طبيعي;
    لو (عدد_البايتات == 0) { أرجع الناتج; };
    دع قسمة_البايت: طبيعي = موضع_البت / 8;
    دع موضع_البايت: طبيعي = قسمة_البايت % عدد_البايتات;
    دع داخل_البايت: طبيعي = موضع_البت % 8;
    دع القناع_الكبير: طبيعي = 1 << داخل_البايت;
    دع القناع: ط8 = القناع_الكبير مثل ط8;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_البايتات) {
        دع القيمة: متغير ط8 = المصدر[ف];
        لو (ف == موضع_البايت) { القيمة := القيمة ^ القناع; };
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_استبدل_بايتا(البايتات: &متجه ط8, الموضع: طبيعي, القيمة: ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو (ف == الموضع) { ألحق(الناتج, القيمة); } وإلا { ألحق(الناتج, المصدر[ف]); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_احذف_مدى(البايتات: &متجه ط8, البداية: طبيعي, العدد: طبيعي): متجه ط8 {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع النهاية: طبيعي = البداية + العدد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        لو ((ف < البداية) || (ف >= النهاية)) { ألحق(الناتج, المصدر[ف]); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_أدخل_بايتات(البايتات: &متجه ط8, الموضع: طبيعي, الإضافة: &متجه ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *البايتات;
    دع الملحق: متجه ط8 = *الإضافة;
    دع الناتج: متغير متجه ط8 = [];
    دع النهاية: طبيعي = الطول(المصدر) مثل طبيعي;
    دع موضع_فعلي: متغير طبيعي = الموضع;
    لو (موضع_فعلي > النهاية) { موضع_فعلي := النهاية; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < موضع_فعلي) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    دع ج: متغير طبيعي = 0;
    طالما (ج < (الطول(الملحق) مثل طبيعي)) { ألحق(الناتج, الملحق[ج]); ج := ج + 1; }
    طالما (ف < النهاية) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام نوع fuzz_input = مدخل_فز;
عام مرادف new_fuzz_input = أنشئ_مدخل_فز;
عام مرادف fuzz_remaining = فز_متبقي;
عام مرادف fuzz_u8 = فز_ط8;
عام مرادف fuzz_bool = فز_منطقي;
عام مرادف fuzz_u16 = فز_ط16;
عام مرادف fuzz_u32 = فز_ط32;
عام مرادف fuzz_below = فز_أقل_من;
عام مرادف fuzz_bytes = فز_بايتات;
عام مرادف fuzz_remainder = فز_الباقي;
عام مرادف fuzz_flip_bit = فز_اقلب_بتا;
عام مرادف fuzz_replace_byte = فز_استبدل_بايتا;
عام مرادف fuzz_delete_range = فز_احذف_مدى;
عام مرادف fuzz_insert_bytes = فز_أدخل_بايتات;

// Old names, kept for one release: the unsigned types are now `طبيعي` and `ط8`..`ط64`.
عام مرادف فز_غ8 = فز_ط8;
عام مرادف فز_غ16 = فز_ط16;
عام مرادف فز_غ32 = فز_ط32;
