استورد bytes.cursor;

// Deterministic fuzz-data provider. Coverage instrumentation and corpus
// scheduling belong to compiler/tooling; this module only maps an input byte
// sequence into reproducible typed choices for fuzz targets.
عام نوع مدخل_فز = {
    المؤشر: مؤشر_بايتات
};

عام عرف أنشئ_مدخل_فز(البايتات: &متجه غ8): مدخل_فز {
    دع المؤشر: مؤشر_بايتات = أنشئ_مؤشر_بايتات(البايتات);
    دع الناتج: مدخل_فز = { المؤشر: المؤشر };
    أرجع الناتج;
}

عام عرف فز_متبقي(المدخل: &مدخل_فز): غير_موقع {
    دع الحالة: مدخل_فز = *المدخل;
    أرجع متبقي_مؤشر_بايتات(&الحالة.المؤشر);
}

عام عرف فز_غ8(المدخل: &متغير مدخل_فز): اختيار غ8 {
    دع الحالة: متغير مدخل_فز = *المدخل;
    دع القيمة: اختيار غ8 = اقرأ_غ8(&متغير الحالة.المؤشر);
    *المدخل := الحالة;
    أرجع القيمة;
}

عام عرف فز_منطقي(المدخل: &متغير مدخل_فز): اختيار منطقي {
    طابق فز_غ8(المدخل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض((القيمة & 1) != 0); };
}

عام عرف فز_غ16(المدخل: &متغير مدخل_فز): اختيار غ16 {
    دع الحالة: متغير مدخل_فز = *المدخل;
    دع القيمة: اختيار غ16 = اقرأ_غ16_صغير(&متغير الحالة.المؤشر);
    *المدخل := الحالة;
    أرجع القيمة;
}

عام عرف فز_غ32(المدخل: &متغير مدخل_فز): اختيار غ32 {
    دع الحالة: متغير مدخل_فز = *المدخل;
    دع القيمة: اختيار غ32 = اقرأ_غ32_صغير(&متغير الحالة.المؤشر);
    *المدخل := الحالة;
    أرجع القيمة;
}

عام عرف فز_أقل_من(المدخل: &متغير مدخل_فز, الحد: غير_موقع): اختيار غير_موقع {
    لو (الحد == 0) { أرجع اختيار.لا_شيء(); };
    طابق فز_غ32(المدخل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض((القيمة مثل غير_موقع) % الحد); };
}

عام عرف فز_بايتات(المدخل: &متغير مدخل_فز, الأقصى: غير_موقع): متجه غ8 {
    دع الحالة: متغير مدخل_فز = *المدخل;
    دع المتبقي: غير_موقع = متبقي_مؤشر_بايتات(&الحالة.المؤشر);
    دع العدد: متغير غير_موقع = المتبقي;
    لو (العدد > الأقصى) { العدد := الأقصى; };
    دع الناتج: متجه غ8;
    طابق اقرأ_بايتات(&متغير الحالة.المؤشر, العدد) مع
    | اختيار.بعض(القيمة) -> { الناتج := القيمة; }
    | اختيار.لا_شيء -> { دع فارغ: متجه غ8 = []; الناتج := فارغ; };
    *المدخل := الحالة;
    أرجع الناتج;
}

عام عرف فز_الباقي(المدخل: &متغير مدخل_فز): متجه غ8 {
    دع الحالة: مدخل_فز = *المدخل;
    دع العدد: غير_موقع = متبقي_مؤشر_بايتات(&الحالة.المؤشر);
    أرجع فز_بايتات(المدخل, العدد);
}


عام عرف فز_اقلب_بتا(البايتات: &متجه غ8, موضع_البت: غير_موقع): متجه غ8 {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع عدد_البايتات: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو (عدد_البايتات == 0) { أرجع الناتج; };
    دع قسمة_البايت: غير_موقع = موضع_البت / 8;
    دع موضع_البايت: غير_موقع = قسمة_البايت % عدد_البايتات;
    دع داخل_البايت: غير_موقع = موضع_البت % 8;
    دع القناع_الكبير: غير_موقع = 1 << داخل_البايت;
    دع القناع: غ8 = القناع_الكبير مثل غ8;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_البايتات) {
        دع القيمة: متغير غ8 = المصدر[ف];
        لو (ف == موضع_البايت) { القيمة := القيمة ^ القناع; };
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_استبدل_بايتا(البايتات: &متجه غ8, الموضع: غير_موقع, القيمة: غ8): متجه غ8 {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف == الموضع) { ألحق(الناتج, القيمة); } وإلا { ألحق(الناتج, المصدر[ف]); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_احذف_مدى(البايتات: &متجه غ8, البداية: غير_موقع, العدد: غير_موقع): متجه غ8 {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع النهاية: غير_موقع = البداية + العدد;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        لو ((ف < البداية) || (ف >= النهاية)) { ألحق(الناتج, المصدر[ف]); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف فز_أدخل_بايتات(البايتات: &متجه غ8, الموضع: غير_موقع, الإضافة: &متجه غ8): متجه غ8 {
    دع المصدر: متجه غ8 = *البايتات;
    دع الملحق: متجه غ8 = *الإضافة;
    دع الناتج: متغير متجه غ8 = [];
    دع النهاية: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع موضع_فعلي: متغير غير_موقع = الموضع;
    لو (موضع_فعلي > النهاية) { موضع_فعلي := النهاية; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < موضع_فعلي) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    دع ج: متغير غير_موقع = 0;
    بينما (ج < (الطول(الملحق) مثل غير_موقع)) { ألحق(الناتج, الملحق[ج]); ج := ج + 1; }
    بينما (ف < النهاية) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام نوع fuzz_input = مدخل_فز;
عام مرادف new_fuzz_input = أنشئ_مدخل_فز;
عام مرادف fuzz_remaining = فز_متبقي;
عام مرادف fuzz_u8 = فز_غ8;
عام مرادف fuzz_bool = فز_منطقي;
عام مرادف fuzz_u16 = فز_غ16;
عام مرادف fuzz_u32 = فز_غ32;
عام مرادف fuzz_below = فز_أقل_من;
عام مرادف fuzz_bytes = فز_بايتات;
عام مرادف fuzz_remainder = فز_الباقي;
عام مرادف fuzz_flip_bit = فز_اقلب_بتا;
عام مرادف fuzz_replace_byte = فز_استبدل_بايتا;
عام مرادف fuzz_delete_range = فز_احذف_مدى;
عام مرادف fuzz_insert_bytes = فز_أدخل_بايتات;
