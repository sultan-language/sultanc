// The .xz container (the .xz file format specification 1.2.1, tukaani.org):
// stream header and footer, blocks with their headers, filter chains and
// integrity checks, the index, stream padding and concatenated streams.
//
// The decoder accepts the checks None, CRC32, CRC64 and SHA-256 and the
// filters LZMA2 (std.compression.lzma) with, before it, the x86 BCJ and
// Delta filters (liblzma's simple/x86.c and delta_decoder.c). The block
// sizes recorded in block headers and the index are checked against the
// decoded data, and every CRC32 over headers and the index is verified, as
// liblzma and xz-embedded do. The encoder writes one stream with one LZMA2
// block and a CRC64 check, as `xz --format=xz --check=crc64` does.

استورد compression.lzma;
استورد checksum.checksum;
استورد crypto.sha256;

عام نوع خطأ_إكس_زد =
    | نهاية_غير_متوقعة
    | ترويسة_غير_صالحة
    | أعلام_غير_مدعومة
    | سي_ار_سي_غير_صالح
    | نوع_تحقق_غير_مدعوم
    | مرشح_غير_مدعوم
    | فهرس_غير_صالح
    | تذييل_غير_صالح
    | تحقق_غير_مطابق
    | حجم_غير_مطابق
    | إل_زد_إم_إيه بنوع خطأ_إل_زد_إم_إيه
    | تجاوز_حد_الإخراج
;

عرف صغير_إكس_زد(المصدر: &متجه ط8, الموضع: طبيعي, العدد: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        الناتج := الناتج | (((*المصدر)[الموضع + ف] مثل طبيعي) << (8 * ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_صغير_إكس_زد(الناتج: &متغير متجه ط8, القيمة: طبيعي, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(*الناتج, ((القيمة >> (8 * ف)) & 0xFF) مثل ط8);
        ف := ف + 1;
    }
}

// A multibyte integer (spec 1.2): 7 bits per byte, at most 9 bytes, no
// trailing zero byte.
عرف اقرأ_متغير_إكس_زد(المصدر: &متجه ط8, الموضع: &متغير طبيعي, النهاية: طبيعي): نتيجة طبيعي, خطأ_إكس_زد {
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 9) {
        إذا (*الموضع >= النهاية) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
        دع ب: طبيعي = (*المصدر)[*الموضع] مثل طبيعي;
        *الموضع := *الموضع + 1;
        القيمة := القيمة | ((ب & 0x7F) << (7 * ف));
        إذا ((ب & 0x80) == 0) {
            إذا (ف > 0 && ب == 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
            أرجع نتيجة.نجح(القيمة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة());
}

عرف ألحق_متغير_إكس_زد(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع س: متغير طبيعي = القيمة;
    طالما (س >= 0x80) {
        ألحق(*الناتج, ((س & 0x7F) | 0x80) مثل ط8);
        س := س >> 7;
    }
    ألحق(*الناتج, س مثل ط8);
}

// The size of a check field for a check type (spec 3.4).
عرف حجم_التحقق_إكس_زد(النوع: طبيعي): طبيعي {
    إذا (النوع == 0) { أرجع 0; };
    إذا (النوع <= 3) { أرجع 4; };
    إذا (النوع <= 6) { أرجع 8; };
    إذا (النوع <= 9) { أرجع 16; };
    إذا (النوع <= 12) { أرجع 32; };
    أرجع 64;
}

// The x86 BCJ filter, decoding direction, over الناتج[البداية..النهاية)
// (liblzma simple/x86.c; the last four bytes stay as they are).
عرف فك_مرشح_إكس86_إكس_زد(الناتج: &متغير متجه ط8, البداية: طبيعي, النهاية: طبيعي, موضع_البدء: طبيعي): فراغ {
    دع مسموح: متجه منطقي = [صواب, صواب, صواب, خطأ, صواب, خطأ, خطأ, خطأ];
    دع رقم_البت: متجه طبيعي = [0, 1, 2, 2, 3, 3, 3, 3];
    دع الحجم: طبيعي = النهاية - البداية;
    إذا (الحجم < 5) { أرجع; };
    دع قناع_سابق: متغير طبيعي = 0;
    دع موضع_سابق: متغير طبيعي = (موضع_البدء + 0x100000000 - 5) & 0xFFFFFFFF;
    دع الحد: طبيعي = الحجم - 5;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الحد) {
        دع ب: طبيعي = (*الناتج)[البداية + ف] مثل طبيعي;
        إذا (ب != 0xE8 && ب != 0xE9) { ف := ف + 1; تابع_حلقة; };
        دع الآن: طبيعي = (موضع_البدء + ف) & 0xFFFFFFFF;
        دع الفرق: طبيعي = (الآن + 0x100000000 - موضع_سابق) & 0xFFFFFFFF;
        موضع_سابق := الآن;
        إذا (الفرق > 5) {
            قناع_سابق := 0;
        } وإلا {
            دع ك: متغير طبيعي = 0;
            طالما (ك < الفرق) { قناع_سابق := (قناع_سابق & 0x77) << 1; ك := ك + 1; }
        };
        دع ب4: طبيعي = (*الناتج)[البداية + ف + 4] مثل طبيعي;
        إذا ((ب4 == 0 || ب4 == 0xFF) && مسموح[(قناع_سابق >> 1) & 7] && (قناع_سابق >> 1) < 0x10) {
            دع المصدر_: متغير طبيعي = (ب4 << 24)
                | (((*الناتج)[البداية + ف + 3] مثل طبيعي) << 16)
                | (((*الناتج)[البداية + ف + 2] مثل طبيعي) << 8)
                | ((*الناتج)[البداية + ف + 1] مثل طبيعي);
            دع الوجهة: متغير طبيعي = 0;
            طالما (صواب) {
                الوجهة := (المصدر_ + 0x100000000 - ((الآن + 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
                إذا (قناع_سابق == 0) { اخرج_من_حلقة; };
                دع ي: طبيعي = رقم_البت[قناع_سابق >> 1];
                دع بايت: طبيعي = (الوجهة >> (24 - ي * 8)) & 0xFF;
                إذا (!(بايت == 0 || بايت == 0xFF)) { اخرج_من_حلقة; };
                المصدر_ := الوجهة ^ ((1 << (32 - ي * 8)) - 1);
            }
            دع العلوي: طبيعي = (الوجهة >> 24) & 1;
            إذا (العلوي == 1) { (*الناتج)[البداية + ف + 4] := 0xFF; } وإلا { (*الناتج)[البداية + ف + 4] := 0; };
            (*الناتج)[البداية + ف + 3] := ((الوجهة >> 16) & 0xFF) مثل ط8;
            (*الناتج)[البداية + ف + 2] := ((الوجهة >> 8) & 0xFF) مثل ط8;
            (*الناتج)[البداية + ف + 1] := (الوجهة & 0xFF) مثل ط8;
            ف := ف + 5;
            قناع_سابق := 0;
        } وإلا {
            ف := ف + 1;
            قناع_سابق := قناع_سابق | 1;
            إذا (ب4 == 0 || ب4 == 0xFF) { قناع_سابق := قناع_سابق | 0x10; };
        };
    }
}

// The Delta filter, decoding direction (liblzma delta_decoder.c).
عرف فك_مرشح_الفرق_إكس_زد(الناتج: &متغير متجه ط8, البداية: طبيعي, النهاية: طبيعي, المسافة: طبيعي): فراغ {
    دع ف: متغير طبيعي = البداية + المسافة;
    طالما (ف < النهاية) {
        دع المجموع: طبيعي = (((*الناتج)[ف] مثل طبيعي) + ((*الناتج)[ف - المسافة] مثل طبيعي)) & 0xFF;
        (*الناتج)[ف] := المجموع مثل ط8;
        ف := ف + 1;
    }
}

نوع مرشح_إكس_زد = {
    المعرف: طبيعي,
    الخاصية: طبيعي
};

نوع سجل_كتلة_إكس_زد = {
    غير_المبطن: طبيعي,
    غير_المضغوط: طبيعي
};

// One block at البداية; returns the position after its check field.
عرف فك_كتلة_إكس_زد(
    المصدر: &متجه ط8,
    البداية: طبيعي,
    نوع_التحقق: طبيعي,
    الناتج: &متغير متجه ط8,
    الحد: طبيعي,
    السجلات: &متغير متجه سجل_كتلة_إكس_زد
): نتيجة طبيعي, خطأ_إكس_زد {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع حجم_الترويسة: طبيعي = (((*المصدر)[البداية] مثل طبيعي) + 1) * 4;
    إذا (البداية + حجم_الترويسة > العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
    دع نهاية_الترويسة: طبيعي = البداية + حجم_الترويسة - 4;
    إذا (حدث_سي_ار_سي32(0, المصدر, البداية, نهاية_الترويسة) مثل طبيعي != صغير_إكس_زد(المصدر, نهاية_الترويسة, 4)) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.سي_ار_سي_غير_صالح());
    };
    دع الأعلام: طبيعي = (*المصدر)[البداية + 1] مثل طبيعي;
    إذا ((الأعلام & 0x3C) != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.أعلام_غير_مدعومة()); };
    دع الموضع: متغير طبيعي = البداية + 2;
    دع مضغوط_معلن: متغير طبيعي = 0;
    دع غير_مضغوط_معلن: متغير طبيعي = 0;
    دع له_مضغوط: منطقي = (الأعلام & 0x40) != 0;
    دع له_غير_مضغوط: منطقي = (الأعلام & 0x80) != 0;
    إذا (له_مضغوط) {
        مضغوط_معلن := اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, نهاية_الترويسة)؟;
        إذا (مضغوط_معلن == 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
    };
    إذا (له_غير_مضغوط) {
        غير_مضغوط_معلن := اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, نهاية_الترويسة)؟;
    };
    دع عدد_المرشحات: طبيعي = (الأعلام & 3) + 1;
    دع المرشحات: متغير متجه مرشح_إكس_زد = [];
    دع حجم_القاموس: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المرشحات) {
        دع المعرف: طبيعي = اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, نهاية_الترويسة)؟;
        دع حجم_الخصائص: طبيعي = اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, نهاية_الترويسة)؟;
        إذا (الموضع + حجم_الخصائص > نهاية_الترويسة) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
        دع الأخير: منطقي = ف + 1 == عدد_المرشحات;
        إذا (المعرف == 0x21) {
            إذا (!الأخير || حجم_الخصائص != 1) { أرجع نتيجة.خطأ(خطأ_إكس_زد.مرشح_غير_مدعوم()); };
            طابق حجم_قاموس_إل_زد_إم_إيه2((*المصدر)[الموضع] مثل طبيعي) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_إكس_زد.إل_زد_إم_إيه(خ)); }
            | نتيجة.نجح(ق) -> { حجم_القاموس := ق; };
        } وإلا إذا (المعرف == 0x04 && !الأخير) {
            دع البدء: متغير طبيعي = 0;
            إذا (حجم_الخصائص == 4) { البدء := صغير_إكس_زد(المصدر, الموضع, 4); }
            وإلا إذا (حجم_الخصائص != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.مرشح_غير_مدعوم()); };
            دع المرشح: مرشح_إكس_زد = { المعرف: المعرف, الخاصية: البدء };
            ألحق(المرشحات, المرشح);
        } وإلا إذا (المعرف == 0x03 && !الأخير) {
            إذا (حجم_الخصائص != 1) { أرجع نتيجة.خطأ(خطأ_إكس_زد.مرشح_غير_مدعوم()); };
            دع المرشح: مرشح_إكس_زد = { المعرف: المعرف, الخاصية: ((*المصدر)[الموضع] مثل طبيعي) + 1 };
            ألحق(المرشحات, المرشح);
        } وإلا {
            أرجع نتيجة.خطأ(خطأ_إكس_زد.مرشح_غير_مدعوم());
        };
        الموضع := الموضع + حجم_الخصائص;
        ف := ف + 1;
    }
    طالما (الموضع < نهاية_الترويسة) {
        إذا ((*المصدر)[الموضع] != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
        الموضع := الموضع + 1;
    }
    دع بداية_البيانات: طبيعي = البداية + حجم_الترويسة;
    دع بداية_الناتج: طبيعي = الطول(*الناتج) مثل طبيعي;
    دع النهاية: متغير طبيعي = 0;
    طابق فك_إل_زد_إم_إيه2_إلى(المصدر, بداية_البيانات, حجم_القاموس, الناتج, الحد) مع
    | نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج) -> { أرجع نتيجة.خطأ(خطأ_إكس_زد.تجاوز_حد_الإخراج()); }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_إكس_زد.إل_زد_إم_إيه(خ)); }
    | نتيجة.نجح(ق) -> { النهاية := ق; };
    دع المضغوط: طبيعي = النهاية - بداية_البيانات;
    دع نهاية_الناتج: طبيعي = الطول(*الناتج) مثل طبيعي;
    دع غير_المضغوط: طبيعي = نهاية_الناتج - بداية_الناتج;
    إذا ((له_مضغوط && المضغوط != مضغوط_معلن) || (له_غير_مضغوط && غير_المضغوط != غير_مضغوط_معلن)) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.حجم_غير_مطابق());
    };
    // Filters run last to first in decoding.
    دع م: متغير طبيعي = الطول(المرشحات) مثل طبيعي;
    طالما (م > 0) {
        م := م - 1;
        إذا (المرشحات[م].المعرف == 0x04) {
            فك_مرشح_إكس86_إكس_زد(الناتج, بداية_الناتج, نهاية_الناتج, المرشحات[م].الخاصية);
        } وإلا {
            فك_مرشح_الفرق_إكس_زد(الناتج, بداية_الناتج, نهاية_الناتج, المرشحات[م].الخاصية);
        };
    }
    دع الموضع_: متغير طبيعي = النهاية;
    طالما ((الموضع_ - بداية_البيانات) % 4 != 0) {
        إذا (الموضع_ >= العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
        إذا ((*المصدر)[الموضع_] != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
        الموضع_ := الموضع_ + 1;
    }
    دع حجم_التحقق: طبيعي = حجم_التحقق_إكس_زد(نوع_التحقق);
    إذا (الموضع_ + حجم_التحقق > العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
    إذا (نوع_التحقق == 1) {
        إذا (حدث_سي_ار_سي32(0, الناتج, بداية_الناتج, نهاية_الناتج) مثل طبيعي != صغير_إكس_زد(المصدر, الموضع_, 4)) {
            أرجع نتيجة.خطأ(خطأ_إكس_زد.تحقق_غير_مطابق());
        };
    } وإلا إذا (نوع_التحقق == 4) {
        إذا (حدث_سي_ار_سي64(0, الناتج, بداية_الناتج, نهاية_الناتج) != صغير_إكس_زد(المصدر, الموضع_, 8)) {
            أرجع نتيجة.خطأ(خطأ_إكس_زد.تحقق_غير_مطابق());
        };
    } وإلا إذا (نوع_التحقق == 10) {
        دع الجزء: متغير متجه ط8 = [];
        دع ك: متغير طبيعي = بداية_الناتج;
        طالما (ك < نهاية_الناتج) { ألحق(الجزء, (*الناتج)[ك]); ك := ك + 1; }
        دع الملخص: متجه ط8 = شا256(&الجزء);
        ك := 0;
        طالما (ك < 32) {
            إذا (الملخص[ك] != (*المصدر)[الموضع_ + ك]) { أرجع نتيجة.خطأ(خطأ_إكس_زد.تحقق_غير_مطابق()); };
            ك := ك + 1;
        }
    };
    دع السجل: سجل_كتلة_إكس_زد = { غير_المبطن: حجم_الترويسة + المضغوط + حجم_التحقق, غير_المضغوط: غير_المضغوط };
    ألحق(*السجلات, السجل);
    أرجع نتيجة.نجح(الموضع_ + حجم_التحقق);
}

// One stream at البداية; returns the position after its footer.
عرف فك_تيار_إكس_زد(
    المصدر: &متجه ط8,
    البداية: طبيعي,
    الناتج: &متغير متجه ط8,
    الحد: طبيعي
): نتيجة طبيعي, خطأ_إكس_زد {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    إذا (البداية + 12 > العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
    دع السحري: متجه ط8 = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6) {
        إذا ((*المصدر)[البداية + ف] != السحري[ف]) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
        ف := ف + 1;
    }
    إذا (حدث_سي_ار_سي32(0, المصدر, البداية + 6, البداية + 8) مثل طبيعي != صغير_إكس_زد(المصدر, البداية + 8, 4)) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.سي_ار_سي_غير_صالح());
    };
    دع علم0: طبيعي = (*المصدر)[البداية + 6] مثل طبيعي;
    دع علم1: طبيعي = (*المصدر)[البداية + 7] مثل طبيعي;
    إذا (علم0 != 0 || (علم1 & 0xF0) != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.أعلام_غير_مدعومة()); };
    دع نوع_التحقق: طبيعي = علم1;
    إذا (نوع_التحقق != 0 && نوع_التحقق != 1 && نوع_التحقق != 4 && نوع_التحقق != 10) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.نوع_تحقق_غير_مدعوم());
    };
    دع الموضع: متغير طبيعي = البداية + 12;
    دع السجلات: متغير متجه سجل_كتلة_إكس_زد = [];
    طالما (صواب) {
        إذا (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
        إذا ((*المصدر)[الموضع] == 0) { اخرج_من_حلقة; };
        الموضع := فك_كتلة_إكس_زد(المصدر, الموضع, نوع_التحقق, الناتج, الحد, &متغير السجلات)؟;
    }
    // The index (spec 4).
    دع بداية_الفهرس: طبيعي = الموضع;
    الموضع := الموضع + 1;
    دع عدد_السجلات: طبيعي = اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, العدد)؟;
    إذا (عدد_السجلات != (الطول(السجلات) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_إكس_زد.فهرس_غير_صالح()); };
    ف := 0;
    طالما (ف < عدد_السجلات) {
        دع غير_المبطن: طبيعي = اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, العدد)؟;
        دع غير_المضغوط: طبيعي = اقرأ_متغير_إكس_زد(المصدر, &متغير الموضع, العدد)؟;
        إذا (غير_المبطن != السجلات[ف].غير_المبطن || غير_المضغوط != السجلات[ف].غير_المضغوط) {
            أرجع نتيجة.خطأ(خطأ_إكس_زد.فهرس_غير_صالح());
        };
        ف := ف + 1;
    }
    طالما ((الموضع - بداية_الفهرس) % 4 != 0) {
        إذا (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
        إذا ((*المصدر)[الموضع] != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.فهرس_غير_صالح()); };
        الموضع := الموضع + 1;
    }
    إذا (الموضع + 4 > العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
    إذا (حدث_سي_ار_سي32(0, المصدر, بداية_الفهرس, الموضع) مثل طبيعي != صغير_إكس_زد(المصدر, الموضع, 4)) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.سي_ار_سي_غير_صالح());
    };
    الموضع := الموضع + 4;
    دع حجم_الفهرس: طبيعي = الموضع - بداية_الفهرس;
    // The footer (spec 2.1.2).
    إذا (الموضع + 12 > العدد) { أرجع نتيجة.خطأ(خطأ_إكس_زد.نهاية_غير_متوقعة()); };
    إذا (حدث_سي_ار_سي32(0, المصدر, الموضع + 4, الموضع + 10) مثل طبيعي != صغير_إكس_زد(المصدر, الموضع, 4)) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.سي_ار_سي_غير_صالح());
    };
    دع الحجم_الخلفي: طبيعي = (صغير_إكس_زد(المصدر, الموضع + 4, 4) + 1) * 4;
    إذا (الحجم_الخلفي != حجم_الفهرس) { أرجع نتيجة.خطأ(خطأ_إكس_زد.تذييل_غير_صالح()); };
    إذا (((*المصدر)[الموضع + 8] مثل طبيعي) != علم0 || ((*المصدر)[الموضع + 9] مثل طبيعي) != علم1) {
        أرجع نتيجة.خطأ(خطأ_إكس_زد.تذييل_غير_صالح());
    };
    إذا ((*المصدر)[الموضع + 10] != 0x59 || (*المصدر)[الموضع + 11] != 0x5A) { أرجع نتيجة.خطأ(خطأ_إكس_زد.تذييل_غير_صالح()); };
    أرجع نتيجة.نجح(الموضع + 12);
}

// Decodes every stream of المصدر (with stream padding between them);
// الحد_الأقصى_للإخراج 0 means unbounded.
عام عرف فك_ضغط_إكس_زد_بحد(المصدر: &متجه ط8, الحد_الأقصى_للإخراج: طبيعي): نتيجة متجه ط8, خطأ_إكس_زد {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    دع أول: متغير منطقي = صواب;
    طالما (أول || الموضع < العدد) {
        أول := خطأ;
        الموضع := فك_تيار_إكس_زد(المصدر, الموضع, &متغير الناتج, الحد_الأقصى_للإخراج)؟;
        // Stream padding: zero bytes in multiples of four.
        دع بداية_الحشو: طبيعي = الموضع;
        طالما (الموضع < العدد && (*المصدر)[الموضع] == 0) { الموضع := الموضع + 1; }
        إذا ((الموضع - بداية_الحشو) % 4 != 0) { أرجع نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة()); };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف فك_ضغط_إكس_زد(المصدر: &متجه ط8): نتيجة متجه ط8, خطأ_إكس_زد {
    أرجع فك_ضغط_إكس_زد_بحد(المصدر, 0);
}

// One stream with one LZMA2 block and a CRC64 check (none for empty input).
عام عرف اضغط_إكس_زد(المصدر: &متجه ط8): متجه ط8 {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04];
    ألحق_صغير_إكس_زد(&متغير الناتج, حدث_سي_ار_سي32(0, &الناتج, 6, 8) مثل طبيعي, 4);
    دع الفهرس: متغير متجه ط8 = [0];
    إذا (العدد == 0) {
        ألحق_متغير_إكس_زد(&متغير الفهرس, 0);
    } وإلا {
        دع البيانات: متجه ط8 = اضغط_إل_زد_إم_إيه2(المصدر);
        دع الخاصية: طبيعي = خاصية_قاموس_إل_زد_إم_إيه2(حجم_قاموس_ضغط_إل_زد_إم_إيه2(العدد));
        دع الترويسة: متغير متجه ط8 = [0, 0xC0];
        ألحق_متغير_إكس_زد(&متغير الترويسة, الطول(البيانات) مثل طبيعي);
        ألحق_متغير_إكس_زد(&متغير الترويسة, العدد);
        ألحق(الترويسة, 0x21);
        ألحق(الترويسة, 0x01);
        ألحق(الترويسة, الخاصية مثل ط8);
        طالما (((الطول(الترويسة) مثل طبيعي) + 4) % 4 != 0) { ألحق(الترويسة, 0); }
        الترويسة[0] := ((((الطول(الترويسة) مثل طبيعي) + 4) / 4) - 1) مثل ط8;
        دع سي_ار_سي: طبيعي = حدث_سي_ار_سي32(0, &الترويسة, 0, الطول(الترويسة) مثل طبيعي) مثل طبيعي;
        ألحق_صغير_إكس_زد(&متغير الترويسة, سي_ار_سي, 4);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الترويسة) مثل طبيعي)) { ألحق(الناتج, الترويسة[ف]); ف := ف + 1; }
        ف := 0;
        طالما (ف < (الطول(البيانات) مثل طبيعي)) { ألحق(الناتج, البيانات[ف]); ف := ف + 1; }
        ف := الطول(البيانات) مثل طبيعي;
        طالما (ف % 4 != 0) { ألحق(الناتج, 0); ف := ف + 1; }
        ألحق_صغير_إكس_زد(&متغير الناتج, احسب_سي_ار_سي64(المصدر), 8);
        ألحق_متغير_إكس_زد(&متغير الفهرس, 1);
        ألحق_متغير_إكس_زد(&متغير الفهرس, (الطول(الترويسة) مثل طبيعي) + (الطول(البيانات) مثل طبيعي) + 8);
        ألحق_متغير_إكس_زد(&متغير الفهرس, العدد);
    };
    طالما ((الطول(الفهرس) مثل طبيعي) % 4 != 0) { ألحق(الفهرس, 0); }
    دع سي_ار_سي_الفهرس: طبيعي = حدث_سي_ار_سي32(0, &الفهرس, 0, الطول(الفهرس) مثل طبيعي) مثل طبيعي;
    ألحق_صغير_إكس_زد(&متغير الفهرس, سي_ار_سي_الفهرس, 4);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الفهرس) مثل طبيعي)) { ألحق(الناتج, الفهرس[ف]); ف := ف + 1; }
    دع التذييل: متغير متجه ط8 = [];
    ألحق_صغير_إكس_زد(&متغير التذييل, (الطول(الفهرس) مثل طبيعي) / 4 - 1, 4);
    ألحق(التذييل, 0x00);
    ألحق(التذييل, 0x04);
    ألحق_صغير_إكس_زد(&متغير الناتج, حدث_سي_ار_سي32(0, &التذييل, 0, 6) مثل طبيعي, 4);
    ف := 0;
    طالما (ف < 6) { ألحق(الناتج, التذييل[ف]); ف := ف + 1; }
    ألحق(الناتج, 0x59);
    ألحق(الناتج, 0x5A);
    أرجع الناتج;
}

عام مرادف xz_compress = اضغط_إكس_زد;

عام مرادف xz_error = خطأ_إكس_زد;
عام مرادف xz_decompress = فك_ضغط_إكس_زد;
عام مرادف xz_decompress_limited = فك_ضغط_إكس_زد_بحد;
عام مرادف xz_error.unexpected_end = خطأ_إكس_زد.نهاية_غير_متوقعة;
عام مرادف xz_error.bad_header = خطأ_إكس_زد.ترويسة_غير_صالحة;
عام مرادف xz_error.unsupported_flags = خطأ_إكس_زد.أعلام_غير_مدعومة;
عام مرادف xz_error.bad_crc = خطأ_إكس_زد.سي_ار_سي_غير_صالح;
عام مرادف xz_error.unsupported_check = خطأ_إكس_زد.نوع_تحقق_غير_مدعوم;
عام مرادف xz_error.unsupported_filter = خطأ_إكس_زد.مرشح_غير_مدعوم;
عام مرادف xz_error.bad_index = خطأ_إكس_زد.فهرس_غير_صالح;
عام مرادف xz_error.bad_footer = خطأ_إكس_زد.تذييل_غير_صالح;
عام مرادف xz_error.check_mismatch = خطأ_إكس_زد.تحقق_غير_مطابق;
عام مرادف xz_error.size_mismatch = خطأ_إكس_زد.حجم_غير_مطابق;
عام مرادف xz_error.lzma = خطأ_إكس_زد.إل_زد_إم_إيه;
عام مرادف xz_error.output_limit_exceeded = خطأ_إكس_زد.تجاوز_حد_الإخراج;
