استورد compression.deflate;
استورد checksum.checksum;

عرف بايت_جي_زيب_عند(المصدر: &متجه ط8, الموضع: طبيعي): ط8 { أرجع (*المصدر)[الموضع]; }

// RFC 1952 gzip wrapper around the raw DEFLATE codec. The decoder accepts
// concatenated members and validates header CRC16 when present, data CRC32,
// and ISIZE for every member.
عام نوع خطأ_جي_زيب =
    | نهاية_غير_متوقعة
    | ترويسة_غير_صالحة
    | طريقة_ضغط_غير_مدعومة
    | أعلام_محجوزة
    | سي_ار_سي_ترويسة_غير_صالح
    | ديفليت بنوع خطأ_ديفليت
    | سي_ار_سي_بيانات_غير_صالح
    | حجم_بيانات_غير_صالح
    | تجاوز_حد_الإخراج
;

عرف اقرأ_ط16_صغير_جي_زيب(المصدر: &متجه ط8, الموضع: طبيعي): اختياري ط16 {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (الموضع + 2 > العدد) { أرجع اختياري.لا_شيء(); };
    دع أ: ط16 = بايت_جي_زيب_عند(المصدر, الموضع) مثل ط16;
    دع ب: ط16 = بايت_جي_زيب_عند(المصدر, الموضع + 1) مثل ط16;
    أرجع اختياري.موجود(أ | (ب << 8));
}

عرف اقرأ_ط32_صغير_جي_زيب(المصدر: &متجه ط8, الموضع: طبيعي): اختياري ط32 {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (الموضع + 4 > العدد) { أرجع اختياري.لا_شيء(); };
    دع أ: ط32 = بايت_جي_زيب_عند(المصدر, الموضع) مثل ط32;
    دع ب: ط32 = بايت_جي_زيب_عند(المصدر, الموضع + 1) مثل ط32;
    دع ج: ط32 = بايت_جي_زيب_عند(المصدر, الموضع + 2) مثل ط32;
    دع د: ط32 = بايت_جي_زيب_عند(المصدر, الموضع + 3) مثل ط32;
    أرجع اختياري.موجود(أ | (ب << 8) | (ج << 16) | (د << 24));
}

عرف ألحق_ط32_صغير_جي_زيب(الناتج: &متغير متجه ط8, القيمة: ط32): فراغ {
    ألحق(*الناتج, (القيمة & 0xFF) مثل ط8);
    ألحق(*الناتج, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الناتج, ((القيمة >> 16) & 0xFF) مثل ط8);
    ألحق(*الناتج, ((القيمة >> 24) & 0xFF) مثل ط8);
}

عرف انسخ_نطاق_جي_زيب(المصدر: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(الناتج, بايت_جي_زيب_عند(المصدر, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف تخط_حتى_الصفر_جي_زيب(المصدر: &متجه ط8, البداية: طبيعي): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < العدد) {
        لو (بايت_جي_زيب_عند(المصدر, ف) == 0) { أرجع اختياري.موجود(ف + 1); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف حلل_ترويسة_جي_زيب(المصدر: &متجه ط8, البداية: طبيعي): نتيجة طبيعي, خطأ_جي_زيب {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (البداية + 10 > العدد) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
    لو ((بايت_جي_زيب_عند(المصدر, البداية) != 0x1F) || (بايت_جي_زيب_عند(المصدر, البداية + 1) != 0x8B)) {
        أرجع نتيجة.خطأ(خطأ_جي_زيب.ترويسة_غير_صالحة());
    };
    لو (بايت_جي_زيب_عند(المصدر, البداية + 2) != 8) {
        أرجع نتيجة.خطأ(خطأ_جي_زيب.طريقة_ضغط_غير_مدعومة());
    };
    دع الأعلام: ط8 = بايت_جي_زيب_عند(المصدر, البداية + 3);
    لو ((الأعلام & 0xE0) != 0) { أرجع نتيجة.خطأ(خطأ_جي_زيب.أعلام_محجوزة()); };

    دع الموضع: متغير طبيعي = البداية + 10;
    لو ((الأعلام & 0x04) != 0) {
        دع طول_الإضافة: متغير ط16 = 0;
        طابق اقرأ_ط16_صغير_جي_زيب(المصدر, الموضع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { طول_الإضافة := ق; };
        الموضع := الموضع + 2;
        لو (الموضع + (طول_الإضافة مثل طبيعي) > العدد) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة());
        };
        الموضع := الموضع + (طول_الإضافة مثل طبيعي);
    };

    لو ((الأعلام & 0x08) != 0) {
        طابق تخط_حتى_الصفر_جي_زيب(المصدر, الموضع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { الموضع := ق; };
    };
    لو ((الأعلام & 0x10) != 0) {
        طابق تخط_حتى_الصفر_جي_زيب(المصدر, الموضع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { الموضع := ق; };
    };

    لو ((الأعلام & 0x02) != 0) {
        دع المطلوب: متغير ط16 = 0;
        طابق اقرأ_ط16_صغير_جي_زيب(المصدر, الموضع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { المطلوب := ق; };
        دع الترويسة: متجه ط8 = انسخ_نطاق_جي_زيب(المصدر, البداية, الموضع);
        دع الفعلي: ط16 = (احسب_سي_ار_سي32(&الترويسة) & 0xFFFF) مثل ط16;
        لو (الفعلي != المطلوب) { أرجع نتيجة.خطأ(خطأ_جي_زيب.سي_ار_سي_ترويسة_غير_صالح()); };
        الموضع := الموضع + 2;
    };
    أرجع نتيجة.نجح(الموضع);
}

عام عرف اضغط_جي_زيب_بوقت(المصدر: &متجه ط8, وقت_يونكس: ط32): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [0x1F,0x8B,0x08,0x00];
    ألحق_ط32_صغير_جي_زيب(&متغير الناتج, وقت_يونكس);
    // XFL=0, OS=255 (unknown/portable).
    ألحق(الناتج, 0);
    ألحق(الناتج, 255);

    دع المضغوط: متجه ط8 = اضغط_ديفليت(المصدر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المضغوط) مثل طبيعي)) {
        ألحق(الناتج, المضغوط[ف]);
        ف := ف + 1;
    }

    دع سي_ار_سي: ط32 = احسب_سي_ار_سي32(المصدر);
    ألحق_ط32_صغير_جي_زيب(&متغير الناتج, سي_ار_سي);
    دع الحجم: ط32 = ((الطول(*المصدر) مثل طبيعي) & 0xFFFFFFFF) مثل ط32;
    ألحق_ط32_صغير_جي_زيب(&متغير الناتج, الحجم);
    أرجع الناتج;
}

عام عرف اضغط_جي_زيب(المصدر: &متجه ط8): متجه ط8 {
    أرجع اضغط_جي_زيب_بوقت(المصدر, 0);
}

عام عرف فك_ضغط_جي_زيب_بحد(
    المصدر: &متجه ط8,
    الحد_الأقصى_للإخراج: طبيعي
): نتيجة متجه ط8, خطأ_جي_زيب {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
    دع الموضع: متغير طبيعي = 0;
    دع الناتج: متغير متجه ط8 = [];

    طالما (الموضع < العدد) {
        دع بداية_البيانات: متغير طبيعي = 0;
        طابق حلل_ترويسة_جي_زيب(المصدر, الموضع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { بداية_البيانات := ق; };

        دع المتبقي_المسموح: متغير طبيعي = 0;
        دع الحد_لهذا_العضو: متغير طبيعي = 0;
        لو (الحد_الأقصى_للإخراج > 0) {
            دع الحالي: طبيعي = الطول(الناتج) مثل طبيعي;
            لو (الحالي > الحد_الأقصى_للإخراج) { أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج()); };
            المتبقي_المسموح := الحد_الأقصى_للإخراج - الحالي;
            // Raw DEFLATE uses 0 as "unbounded". If the caller has exactly
            // exhausted the limit, decode at most one byte to distinguish an
            // empty member from a member that would exceed the limit.
            لو (المتبقي_المسموح == 0) { الحد_لهذا_العضو := 1; }
            وإلا { الحد_لهذا_العضو := المتبقي_المسموح; };
        };

        دع بايتات_مفكوكة: متجه ط8 = [];
        دع المفكوك: متغير ناتج_فك_ديفليت = { البايتات: بايتات_مفكوكة, المستهلك: 0 };
        طابق فك_ضغط_ديفليت_من_موضع_بحد(المصدر, بداية_البيانات, الحد_لهذا_العضو) مع
        | نتيجة.خطأ(خ) -> {
            طابق خ مع
            | خطأ_ديفليت.تجاوز_حد_الإخراج -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج()); }
            | _ -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.ديفليت(خ)); };
        }
        | نتيجة.نجح(ق) -> { المفكوك := ق; };

        لو ((الحد_الأقصى_للإخراج > 0) && (المتبقي_المسموح == 0)
            && ((الطول(المفكوك.البايتات) مثل طبيعي) > 0)) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج());
        };

        دع موضع_الذيل: طبيعي = بداية_البيانات + المفكوك.المستهلك;
        لو (موضع_الذيل + 8 > العدد) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
        دع سي_ار_سي_المطلوب: متغير ط32 = 0;
        دع الحجم_المطلوب: متغير ط32 = 0;
        طابق اقرأ_ط32_صغير_جي_زيب(المصدر, موضع_الذيل) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { سي_ار_سي_المطلوب := ق; };
        طابق اقرأ_ط32_صغير_جي_زيب(المصدر, موضع_الذيل + 4) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختياري.موجود(ق) -> { الحجم_المطلوب := ق; };

        دع سي_ار_سي_الفعلي: ط32 = احسب_سي_ار_سي32(&المفكوك.البايتات);
        لو (سي_ار_سي_الفعلي != سي_ار_سي_المطلوب) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.سي_ار_سي_بيانات_غير_صالح());
        };
        دع الحجم_الفعلي: ط32 = ((الطول(المفكوك.البايتات) مثل طبيعي) & 0xFFFFFFFF) مثل ط32;
        لو (الحجم_الفعلي != الحجم_المطلوب) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.حجم_بيانات_غير_صالح());
        };

        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المفكوك.البايتات) مثل طبيعي)) {
            ألحق(الناتج, المفكوك.البايتات[ف]);
            ف := ف + 1;
        }
        لو ((الحد_الأقصى_للإخراج > 0) && ((الطول(الناتج) مثل طبيعي) > الحد_الأقصى_للإخراج)) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج());
        };
        الموضع := موضع_الذيل + 8;
    }

    أرجع نتيجة.نجح(الناتج);
}

عام عرف فك_ضغط_جي_زيب(المصدر: &متجه ط8): نتيجة متجه ط8, خطأ_جي_زيب {
    أرجع فك_ضغط_جي_زيب_بحد(المصدر, 0);
}

عام نوع gzip_error = خطأ_جي_زيب;
عام مرادف gzip_compress = اضغط_جي_زيب;
عام مرادف gzip_compress_with_mtime = اضغط_جي_زيب_بوقت;
عام مرادف gzip_decompress = فك_ضغط_جي_زيب;
عام مرادف gzip_decompress_limited = فك_ضغط_جي_زيب_بحد;
