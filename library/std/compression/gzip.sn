استورد compression.deflate;
استورد checksum.checksum;

عرف بايت_جي_زيب_عند(المصدر: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*المصدر)[الموضع]; }

// RFC 1952 gzip wrapper around the raw DEFLATE codec. The decoder accepts
// concatenated members and validates header CRC16 when present, data CRC32,
// and ISIZE for every member.
عام نوع خطأ_جي_زيب =
    | نهاية_غير_متوقعة
    | ترويسة_غير_صالحة
    | طريقة_ضغط_غير_مدعومة
    | أعلام_محجوزة
    | سي_ار_سي_ترويسة_غير_صالح
    | ديفليت بنوع خطأ_ديفليت
    | سي_ار_سي_بيانات_غير_صالح
    | حجم_بيانات_غير_صالح
    | تجاوز_حد_الإخراج
;

عرف اقرأ_غ16_صغير_جي_زيب(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غ16 {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (الموضع + 2 > العدد) { أرجع اختيار.لا_شيء(); };
    دع أ: غ16 = بايت_جي_زيب_عند(المصدر, الموضع) مثل غ16;
    دع ب: غ16 = بايت_جي_زيب_عند(المصدر, الموضع + 1) مثل غ16;
    أرجع اختيار.بعض(أ | (ب << 8));
}

عرف اقرأ_غ32_صغير_جي_زيب(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غ32 {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (الموضع + 4 > العدد) { أرجع اختيار.لا_شيء(); };
    دع أ: غ32 = بايت_جي_زيب_عند(المصدر, الموضع) مثل غ32;
    دع ب: غ32 = بايت_جي_زيب_عند(المصدر, الموضع + 1) مثل غ32;
    دع ج: غ32 = بايت_جي_زيب_عند(المصدر, الموضع + 2) مثل غ32;
    دع د: غ32 = بايت_جي_زيب_عند(المصدر, الموضع + 3) مثل غ32;
    أرجع اختيار.بعض(أ | (ب << 8) | (ج << 16) | (د << 24));
}

عرف ألحق_غ32_صغير_جي_زيب(الناتج: &متغير متجه غ8, القيمة: غ32): فراغ {
    ألحق(*الناتج, (القيمة & 0xFF) مثل غ8);
    ألحق(*الناتج, ((القيمة >> 8) & 0xFF) مثل غ8);
    ألحق(*الناتج, ((القيمة >> 16) & 0xFF) مثل غ8);
    ألحق(*الناتج, ((القيمة >> 24) & 0xFF) مثل غ8);
}

عرف انسخ_نطاق_جي_زيب(المصدر: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        ألحق(الناتج, بايت_جي_زيب_عند(المصدر, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف تخط_حتى_الصفر_جي_زيب(المصدر: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < العدد) {
        لو (بايت_جي_زيب_عند(المصدر, ف) == 0) { أرجع اختيار.بعض(ف + 1); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف حلل_ترويسة_جي_زيب(المصدر: &متجه غ8, البداية: غير_موقع): نتيجة غير_موقع, خطأ_جي_زيب {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (البداية + 10 > العدد) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
    لو ((بايت_جي_زيب_عند(المصدر, البداية) != 0x1F) || (بايت_جي_زيب_عند(المصدر, البداية + 1) != 0x8B)) {
        أرجع نتيجة.خطأ(خطأ_جي_زيب.ترويسة_غير_صالحة());
    };
    لو (بايت_جي_زيب_عند(المصدر, البداية + 2) != 8) {
        أرجع نتيجة.خطأ(خطأ_جي_زيب.طريقة_ضغط_غير_مدعومة());
    };
    دع الأعلام: غ8 = بايت_جي_زيب_عند(المصدر, البداية + 3);
    لو ((الأعلام & 0xE0) != 0) { أرجع نتيجة.خطأ(خطأ_جي_زيب.أعلام_محجوزة()); };

    دع الموضع: متغير غير_موقع = البداية + 10;
    لو ((الأعلام & 0x04) != 0) {
        دع طول_الإضافة: متغير غ16 = 0;
        طابق اقرأ_غ16_صغير_جي_زيب(المصدر, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { طول_الإضافة := ق; };
        الموضع := الموضع + 2;
        لو (الموضع + (طول_الإضافة مثل غير_موقع) > العدد) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة());
        };
        الموضع := الموضع + (طول_الإضافة مثل غير_موقع);
    };

    لو ((الأعلام & 0x08) != 0) {
        طابق تخط_حتى_الصفر_جي_زيب(المصدر, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { الموضع := ق; };
    };
    لو ((الأعلام & 0x10) != 0) {
        طابق تخط_حتى_الصفر_جي_زيب(المصدر, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { الموضع := ق; };
    };

    لو ((الأعلام & 0x02) != 0) {
        دع المطلوب: متغير غ16 = 0;
        طابق اقرأ_غ16_صغير_جي_زيب(المصدر, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { المطلوب := ق; };
        دع الترويسة: متجه غ8 = انسخ_نطاق_جي_زيب(المصدر, البداية, الموضع);
        دع الفعلي: غ16 = (احسب_سي_ار_سي32(&الترويسة) & 0xFFFF) مثل غ16;
        لو (الفعلي != المطلوب) { أرجع نتيجة.خطأ(خطأ_جي_زيب.سي_ار_سي_ترويسة_غير_صالح()); };
        الموضع := الموضع + 2;
    };
    أرجع نتيجة.نجح(الموضع);
}

عام عرف اضغط_جي_زيب_بوقت(المصدر: &متجه غ8, وقت_يونكس: غ32): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [0x1F,0x8B,0x08,0x00];
    ألحق_غ32_صغير_جي_زيب(&متغير الناتج, وقت_يونكس);
    // XFL=0, OS=255 (unknown/portable).
    ألحق(الناتج, 0);
    ألحق(الناتج, 255);

    دع المضغوط: متجه غ8 = اضغط_ديفليت(المصدر);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المضغوط) مثل غير_موقع)) {
        ألحق(الناتج, المضغوط[ف]);
        ف := ف + 1;
    }

    دع سي_ار_سي: غ32 = احسب_سي_ار_سي32(المصدر);
    ألحق_غ32_صغير_جي_زيب(&متغير الناتج, سي_ار_سي);
    دع الحجم: غ32 = ((الطول(*المصدر) مثل غير_موقع) & 0xFFFFFFFF) مثل غ32;
    ألحق_غ32_صغير_جي_زيب(&متغير الناتج, الحجم);
    أرجع الناتج;
}

عام عرف اضغط_جي_زيب(المصدر: &متجه غ8): متجه غ8 {
    أرجع اضغط_جي_زيب_بوقت(المصدر, 0);
}

عام عرف فك_ضغط_جي_زيب_بحد(
    المصدر: &متجه غ8,
    الحد_الأقصى_للإخراج: غير_موقع
): نتيجة متجه غ8, خطأ_جي_زيب {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
    دع الموضع: متغير غير_موقع = 0;
    دع الناتج: متغير متجه غ8 = [];

    بينما (الموضع < العدد) {
        دع بداية_البيانات: متغير غير_موقع = 0;
        طابق حلل_ترويسة_جي_زيب(المصدر, الموضع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { بداية_البيانات := ق; };

        دع المتبقي_المسموح: متغير غير_موقع = 0;
        دع الحد_لهذا_العضو: متغير غير_موقع = 0;
        لو (الحد_الأقصى_للإخراج > 0) {
            دع الحالي: غير_موقع = الطول(الناتج) مثل غير_موقع;
            لو (الحالي > الحد_الأقصى_للإخراج) { أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج()); };
            المتبقي_المسموح := الحد_الأقصى_للإخراج - الحالي;
            // Raw DEFLATE uses 0 as "unbounded". If the caller has exactly
            // exhausted the limit, decode at most one byte to distinguish an
            // empty member from a member that would exceed the limit.
            لو (المتبقي_المسموح == 0) { الحد_لهذا_العضو := 1; }
            وإلا { الحد_لهذا_العضو := المتبقي_المسموح; };
        };

        دع بايتات_مفكوكة: متجه غ8 = [];
        دع المفكوك: متغير ناتج_فك_ديفليت = { البايتات: بايتات_مفكوكة, المستهلك: 0 };
        طابق فك_ضغط_ديفليت_من_موضع_بحد(المصدر, بداية_البيانات, الحد_لهذا_العضو) مع
        | نتيجة.خطأ(خ) -> {
            طابق خ مع
            | خطأ_ديفليت.تجاوز_حد_الإخراج -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج()); }
            | _ -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.ديفليت(خ)); };
        }
        | نتيجة.نجح(ق) -> { المفكوك := ق; };

        لو ((الحد_الأقصى_للإخراج > 0) && (المتبقي_المسموح == 0)
            && ((الطول(المفكوك.البايتات) مثل غير_موقع) > 0)) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج());
        };

        دع موضع_الذيل: غير_موقع = بداية_البيانات + المفكوك.المستهلك;
        لو (موضع_الذيل + 8 > العدد) { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); };
        دع سي_ار_سي_المطلوب: متغير غ32 = 0;
        دع الحجم_المطلوب: متغير غ32 = 0;
        طابق اقرأ_غ32_صغير_جي_زيب(المصدر, موضع_الذيل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { سي_ار_سي_المطلوب := ق; };
        طابق اقرأ_غ32_صغير_جي_زيب(المصدر, موضع_الذيل + 4) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_جي_زيب.نهاية_غير_متوقعة()); }
        | اختيار.بعض(ق) -> { الحجم_المطلوب := ق; };

        دع سي_ار_سي_الفعلي: غ32 = احسب_سي_ار_سي32(&المفكوك.البايتات);
        لو (سي_ار_سي_الفعلي != سي_ار_سي_المطلوب) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.سي_ار_سي_بيانات_غير_صالح());
        };
        دع الحجم_الفعلي: غ32 = ((الطول(المفكوك.البايتات) مثل غير_موقع) & 0xFFFFFFFF) مثل غ32;
        لو (الحجم_الفعلي != الحجم_المطلوب) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.حجم_بيانات_غير_صالح());
        };

        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المفكوك.البايتات) مثل غير_موقع)) {
            ألحق(الناتج, المفكوك.البايتات[ف]);
            ف := ف + 1;
        }
        لو ((الحد_الأقصى_للإخراج > 0) && ((الطول(الناتج) مثل غير_موقع) > الحد_الأقصى_للإخراج)) {
            أرجع نتيجة.خطأ(خطأ_جي_زيب.تجاوز_حد_الإخراج());
        };
        الموضع := موضع_الذيل + 8;
    }

    أرجع نتيجة.نجح(الناتج);
}

عام عرف فك_ضغط_جي_زيب(المصدر: &متجه غ8): نتيجة متجه غ8, خطأ_جي_زيب {
    أرجع فك_ضغط_جي_زيب_بحد(المصدر, 0);
}

عام نوع gzip_error = خطأ_جي_زيب;
عام مرادف gzip_compress = اضغط_جي_زيب;
عام مرادف gzip_compress_with_mtime = اضغط_جي_زيب_بوقت;
عام مرادف gzip_decompress = فك_ضغط_جي_زيب;
عام مرادف gzip_decompress_limited = فك_ضغط_جي_زيب_بحد;
