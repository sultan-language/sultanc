// LZMA and LZMA2: the codecs under .xz (std.compression.xz) and the legacy
// .lzma ("LZMA alone") format.
//
// The decoder follows the LZMA specification (lzma-specification.txt in the
// LZMA SDK) and xz-embedded's xz_dec_lzma2.c: an adaptive binary range
// decoder over the literal, match, repeat-match and length models; LZMA2
// chunks (RFC-less; the format is described in liblzma's lzma2_decoder.c)
// with dictionary, state and property resets and uncompressed chunks. Every
// distance is checked against the decoded history and the dictionary size,
// every chunk must consume exactly its compressed size and end with the
// range coder flushed, so malformed input ends with an error.
//
// The encoder is a greedy LZMA encoder with one-step lazy matching (as
// liblzma's "fast" mode, lzma_encoder_optimum_fast.c): a hash-chain match
// finder, the four repeat distances and short repeats, the same models as
// the decoder, and the range encoder of the LZMA SDK (LzmaEnc.c). LZMA2
// output is cut into chunks of at most 2 MiB uncompressed and 64 KiB
// compressed; a chunk that does not shrink is stored uncompressed.

عام نوع خطأ_إل_زد_إم_إيه =
    | نهاية_غير_متوقعة
    | خصائص_غير_صالحة
    | بيانات_تالفة
    | مسافة_غير_صالحة
    | حجم_غير_مطابق
    | تجاوز_حد_الإخراج
;

// Probability-model layout (one vector; offsets as in the LZMA SDK's LzmaDec.c).
عرف احتمال_تطابق_لزم(): طبيعي { أرجع 0; }
عرف احتمال_تكرار_لزم(): طبيعي { أرجع 192; }
عرف احتمال_تكرار0_لزم(): طبيعي { أرجع 204; }
عرف احتمال_تكرار1_لزم(): طبيعي { أرجع 216; }
عرف احتمال_تكرار2_لزم(): طبيعي { أرجع 228; }
عرف احتمال_تكرار0_طويل_لزم(): طبيعي { أرجع 240; }
عرف احتمال_خانة_المسافة_لزم(): طبيعي { أرجع 432; }
عرف احتمال_مسافة_خاصة_لزم(): طبيعي { أرجع 688; }
عرف احتمال_محاذاة_لزم(): طبيعي { أرجع 802; }
عرف احتمال_طول_لزم(): طبيعي { أرجع 818; }
عرف احتمال_طول_تكرار_لزم(): طبيعي { أرجع 1332; }
عرف احتمال_حرفي_لزم(): طبيعي { أرجع 1846; }

عرف احتمالات_أولية_لزم(مجموع_البتات: طبيعي): متجه طبيعي {
    دع العدد: طبيعي = احتمال_حرفي_لزم() + (0x300 << مجموع_البتات);
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, 1024); ف := ف + 1; }
    أرجع الناتج;
}

// Decoder state: the models, the range decoder and the dictionary bounds
// over the caller's output vector.
نوع فاك_لزم = {
    الاحتمالات: متجه طبيعي,
    بتات_السياق: طبيعي,
    بتات_موضع_الحرف: طبيعي,
    بتات_الموضع: طبيعي,
    الحالة: طبيعي,
    ت0: طبيعي,
    ت1: طبيعي,
    ت2: طبيعي,
    ت3: طبيعي,
    المدى: طبيعي,
    الشفرة: طبيعي,
    الموضع: طبيعي,
    النهاية: طبيعي,
    منقطع: منطقي,
    بداية_القاموس: طبيعي,
    حجم_القاموس: طبيعي
};

عرف فاك_لزم_جديد(): فاك_لزم {
    دع لا_احتمالات: متجه طبيعي = [];
    دع الفاك: فاك_لزم = {
        الاحتمالات: لا_احتمالات,
        بتات_السياق: 3, بتات_موضع_الحرف: 0, بتات_الموضع: 2,
        الحالة: 0, ت0: 0, ت1: 0, ت2: 0, ت3: 0,
        المدى: 0xFFFFFFFF, الشفرة: 0, الموضع: 0, النهاية: 0, منقطع: خطأ,
        بداية_القاموس: 0, حجم_القاموس: 0
    };
    أرجع الفاك;
}

// The lc/lp/pb properties byte (LZMA SDK LzmaProps_Decode).
عرف اضبط_خصائص_لزم(الفاك: &متغير فاك_لزم, الخصائص: طبيعي): نتيجة طبيعي, خطأ_إل_زد_إم_إيه {
    لو (الخصائص >= 225) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.خصائص_غير_صالحة()); };
    (*الفاك).بتات_السياق := الخصائص % 9;
    (*الفاك).بتات_موضع_الحرف := (الخصائص / 9) % 5;
    (*الفاك).بتات_الموضع := الخصائص / 45;
    أرجع نتيجة.نجح(الخصائص);
}

// State reset: models to 1/2, state and repeat distances to zero.
عرف أعد_حالة_لزم(الفاك: &متغير فاك_لزم): فراغ {
    دع العدد: طبيعي = احتمال_حرفي_لزم() + (0x300 << ((*الفاك).بتات_السياق + (*الفاك).بتات_موضع_الحرف));
    لو ((الطول((*الفاك).الاحتمالات) مثل طبيعي) == العدد) {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) { (*الفاك).الاحتمالات[ف] := 1024; ف := ف + 1; }
    } وإلا {
        (*الفاك).الاحتمالات := احتمالات_أولية_لزم((*الفاك).بتات_السياق + (*الفاك).بتات_موضع_الحرف);
    };
    (*الفاك).الحالة := 0;
    (*الفاك).ت0 := 0;
    (*الفاك).ت1 := 0;
    (*الفاك).ت2 := 0;
    (*الفاك).ت3 := 0;
}

// Range decoder start (rc_read_init): five bytes, the first zero.
عرف ابدأ_مفكك_المدى_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, البداية: طبيعي, النهاية: طبيعي): نتيجة طبيعي, خطأ_إل_زد_إم_إيه {
    لو (البداية + 5 > النهاية) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
    لو ((*المصدر)[البداية] != 0) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
    دع الشفرة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 1;
    طالما (ف < 5) { الشفرة := (الشفرة << 8) | ((*المصدر)[البداية + ف] مثل طبيعي); ف := ف + 1; }
    (*الفاك).المدى := 0xFFFFFFFF;
    (*الفاك).الشفرة := الشفرة;
    (*الفاك).الموضع := البداية + 5;
    (*الفاك).النهاية := النهاية;
    (*الفاك).منقطع := خطأ;
    لو (الشفرة == 0xFFFFFFFF) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
    أرجع نتيجة.نجح(البداية + 5);
}

عرف طبع_مدى_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم): فراغ {
    لو ((*الفاك).المدى < 0x1000000) {
        لو ((*الفاك).الموضع >= (*الفاك).النهاية) {
            (*الفاك).منقطع := صواب;
            (*الفاك).المدى := ((*الفاك).المدى << 8) & 0xFFFFFFFF;
            (*الفاك).الشفرة := ((*الفاك).الشفرة << 8) & 0xFFFFFFFF;
        } وإلا {
            (*الفاك).المدى := ((*الفاك).المدى << 8) & 0xFFFFFFFF;
            (*الفاك).الشفرة := (((*الفاك).الشفرة << 8) & 0xFFFFFFFF) | ((*المصدر)[(*الفاك).الموضع] مثل طبيعي);
            (*الفاك).الموضع := (*الفاك).الموضع + 1;
        };
    };
}

عرف بت_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, الفهرس: طبيعي): طبيعي {
    طبع_مدى_لزم(المصدر, الفاك);
    دع الاحتمال: طبيعي = (*الفاك).الاحتمالات[الفهرس];
    دع الحد: طبيعي = ((*الفاك).المدى >> 11) * الاحتمال;
    لو ((*الفاك).الشفرة < الحد) {
        (*الفاك).المدى := الحد;
        (*الفاك).الاحتمالات[الفهرس] := الاحتمال + ((2048 - الاحتمال) >> 5);
        أرجع 0;
    };
    (*الفاك).المدى := (*الفاك).المدى - الحد;
    (*الفاك).الشفرة := (*الفاك).الشفرة - الحد;
    (*الفاك).الاحتمالات[الفهرس] := الاحتمال - (الاحتمال >> 5);
    أرجع 1;
}

عرف بتات_مباشرة_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, العدد: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طبع_مدى_لزم(المصدر, الفاك);
        (*الفاك).المدى := (*الفاك).المدى >> 1;
        لو ((*الفاك).الشفرة >= (*الفاك).المدى) {
            (*الفاك).الشفرة := (*الفاك).الشفرة - (*الفاك).المدى;
            الناتج := (الناتج << 1) | 1;
        } وإلا {
            الناتج := الناتج << 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف شجرة_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, الأساس: طبيعي, البتات: طبيعي): طبيعي {
    دع م: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البتات) { م := (م << 1) | بت_لزم(المصدر, الفاك, الأساس + م); ف := ف + 1; }
    أرجع م - (1 << البتات);
}

عرف شجرة_معكوسة_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, الأساس: طبيعي, البتات: طبيعي): طبيعي {
    دع م: متغير طبيعي = 1;
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البتات) {
        دع ب: طبيعي = بت_لزم(المصدر, الفاك, الأساس + م);
        م := (م << 1) | ب;
        الناتج := الناتج | (ب << ف);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A match length (2..273) from the length model at الأساس.
عرف طول_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, الأساس: طبيعي, حالة_الموضع: طبيعي): طبيعي {
    لو (بت_لزم(المصدر, الفاك, الأساس) == 0) {
        أرجع 2 + شجرة_لزم(المصدر, الفاك, الأساس + 2 + حالة_الموضع * 8, 3);
    };
    لو (بت_لزم(المصدر, الفاك, الأساس + 1) == 0) {
        أرجع 10 + شجرة_لزم(المصدر, الفاك, الأساس + 130 + حالة_الموضع * 8, 3);
    };
    أرجع 18 + شجرة_لزم(المصدر, الفاك, الأساس + 258, 8);
}

// A zero-based match distance for a match of length الطول_.
عرف مسافة_لزم(المصدر: &متجه ط8, الفاك: &متغير فاك_لزم, طول_التطابق: طبيعي): طبيعي {
    دع حالة_الطول: متغير طبيعي = طول_التطابق - 2;
    لو (حالة_الطول > 3) { حالة_الطول := 3; };
    دع الخانة: طبيعي = شجرة_لزم(المصدر, الفاك, احتمال_خانة_المسافة_لزم() + حالة_الطول * 64, 6);
    لو (الخانة < 4) { أرجع الخانة; };
    دع البتات: طبيعي = (الخانة >> 1) - 1;
    دع المسافة: طبيعي = (2 | (الخانة & 1)) << البتات;
    لو (الخانة < 14) {
        أرجع المسافة + شجرة_معكوسة_لزم(المصدر, الفاك, احتمال_مسافة_خاصة_لزم() + المسافة - الخانة - 1, البتات);
    };
    دع العليا: طبيعي = بتات_مباشرة_لزم(المصدر, الفاك, البتات - 4) << 4;
    أرجع المسافة + العليا + شجرة_معكوسة_لزم(المصدر, الفاك, احتمال_محاذاة_لزم(), 4);
}

عرف يسمح_لزم(الحالي: طبيعي, الإضافة: طبيعي, الحد: طبيعي): منطقي {
    لو (الحد == 0) { أرجع صواب; };
    لو (الحالي > الحد) { أرجع خطأ; };
    أرجع الإضافة <= الحد - الحالي;
}

// Decodes symbols until the output reaches التوقف (an absolute length of
// الناتج). With نهاية_مسموحة an end-of-payload marker may come first; the
// result says whether it did.
عرف فك_رموز_لزم(
    المصدر: &متجه ط8,
    الفاك: &متغير فاك_لزم,
    الناتج: &متغير متجه ط8,
    التوقف: طبيعي,
    نهاية_مسموحة: منطقي,
    الحد: طبيعي
): نتيجة منطقي, خطأ_إل_زد_إم_إيه {
    دع قناع_الموضع: طبيعي = (1 << (*الفاك).بتات_الموضع) - 1;
    دع قناع_موضع_الحرف: طبيعي = (1 << (*الفاك).بتات_موضع_الحرف) - 1;
    طالما ((الطول(*الناتج) مثل طبيعي) < التوقف) {
        لو ((*الفاك).منقطع) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
        دع الطول_الحالي: طبيعي = الطول(*الناتج) مثل طبيعي;
        دع الموقع: طبيعي = الطول_الحالي - (*الفاك).بداية_القاموس;
        دع حالة_الموضع: طبيعي = الموقع & قناع_الموضع;
        دع الحالة: طبيعي = (*الفاك).الحالة;
        لو (بت_لزم(المصدر, الفاك, احتمال_تطابق_لزم() + الحالة * 16 + حالة_الموضع) == 0) {
            دع السابق: متغير طبيعي = 0;
            لو (الموقع > 0) { السابق := (*الناتج)[الطول_الحالي - 1] مثل طبيعي; };
            دع حالة_الحرف: طبيعي = ((الموقع & قناع_موضع_الحرف) << (*الفاك).بتات_السياق) + (السابق >> (8 - (*الفاك).بتات_السياق));
            دع الأساس: طبيعي = احتمال_حرفي_لزم() + 0x300 * حالة_الحرف;
            دع الرمز: متغير طبيعي = 1;
            لو (الحالة < 7) {
                طالما (الرمز < 0x100) { الرمز := (الرمز << 1) | بت_لزم(المصدر, الفاك, الأساس + الرمز); }
            } وإلا {
                لو ((*الفاك).ت0 >= الموقع) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.مسافة_غير_صالحة()); };
                دع بايت_التطابق: متغير طبيعي = (*الناتج)[الطول_الحالي - (*الفاك).ت0 - 1] مثل طبيعي;
                دع الإزاحة: متغير طبيعي = 0x100;
                طالما (الرمز < 0x100) {
                    بايت_التطابق := بايت_التطابق << 1;
                    دع بت_التطابق: طبيعي = بايت_التطابق & الإزاحة;
                    دع ب: طبيعي = بت_لزم(المصدر, الفاك, الأساس + الإزاحة + بت_التطابق + الرمز);
                    الرمز := (الرمز << 1) | ب;
                    لو (ب == 1) { الإزاحة := بت_التطابق; } وإلا { الإزاحة := الإزاحة ^ بت_التطابق; };
                }
            };
            لو (!يسمح_لزم(الطول_الحالي, 1, الحد)) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج()); };
            ألحق(*الناتج, (الرمز & 0xFF) مثل ط8);
            لو (الحالة < 4) { (*الفاك).الحالة := 0; }
            وإلا لو (الحالة < 10) { (*الفاك).الحالة := الحالة - 3; }
            وإلا { (*الفاك).الحالة := الحالة - 6; };
        } وإلا {
            دع طول_التطابق: متغير طبيعي = 0;
            لو (بت_لزم(المصدر, الفاك, احتمال_تكرار_لزم() + الحالة) == 0) {
                // A match with a new distance.
                (*الفاك).ت3 := (*الفاك).ت2;
                (*الفاك).ت2 := (*الفاك).ت1;
                (*الفاك).ت1 := (*الفاك).ت0;
                طول_التطابق := طول_لزم(المصدر, الفاك, احتمال_طول_لزم(), حالة_الموضع);
                لو (الحالة < 7) { (*الفاك).الحالة := 7; } وإلا { (*الفاك).الحالة := 10; };
                دع المسافة: طبيعي = مسافة_لزم(المصدر, الفاك, طول_التطابق);
                لو (المسافة == 0xFFFFFFFF) {
                    لو (!نهاية_مسموحة || (*الفاك).منقطع) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
                    أرجع نتيجة.نجح(صواب);
                };
                (*الفاك).ت0 := المسافة;
            } وإلا {
                لو (بت_لزم(المصدر, الفاك, احتمال_تكرار0_لزم() + الحالة) == 0) {
                    لو (بت_لزم(المصدر, الفاك, احتمال_تكرار0_طويل_لزم() + الحالة * 16 + حالة_الموضع) == 0) {
                        // Short repeat: one byte at the last distance.
                        لو ((*الفاك).ت0 >= الموقع) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.مسافة_غير_صالحة()); };
                        لو (الحالة < 7) { (*الفاك).الحالة := 9; } وإلا { (*الفاك).الحالة := 11; };
                        لو (!يسمح_لزم(الطول_الحالي, 1, الحد)) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج()); };
                        دع ب: ط8 = (*الناتج)[الطول_الحالي - (*الفاك).ت0 - 1];
                        ألحق(*الناتج, ب);
                        تابع_حلقة;
                    };
                } وإلا {
                    دع المسافة: متغير طبيعي = 0;
                    لو (بت_لزم(المصدر, الفاك, احتمال_تكرار1_لزم() + الحالة) == 0) {
                        المسافة := (*الفاك).ت1;
                    } وإلا {
                        لو (بت_لزم(المصدر, الفاك, احتمال_تكرار2_لزم() + الحالة) == 0) {
                            المسافة := (*الفاك).ت2;
                        } وإلا {
                            المسافة := (*الفاك).ت3;
                            (*الفاك).ت3 := (*الفاك).ت2;
                        };
                        (*الفاك).ت2 := (*الفاك).ت1;
                    };
                    (*الفاك).ت1 := (*الفاك).ت0;
                    (*الفاك).ت0 := المسافة;
                };
                طول_التطابق := طول_لزم(المصدر, الفاك, احتمال_طول_تكرار_لزم(), حالة_الموضع);
                لو (الحالة < 7) { (*الفاك).الحالة := 8; } وإلا { (*الفاك).الحالة := 11; };
            };
            دع المسافة: طبيعي = (*الفاك).ت0;
            لو (المسافة >= الموقع || المسافة >= (*الفاك).حجم_القاموس) {
                أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.مسافة_غير_صالحة());
            };
            لو (طول_التطابق > التوقف - الطول_الحالي) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
            لو (!يسمح_لزم(الطول_الحالي, طول_التطابق, الحد)) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج()); };
            دع م: متغير طبيعي = الطول_الحالي - المسافة - 1;
            دع ك: متغير طبيعي = 0;
            طالما (ك < طول_التطابق) {
                دع ب: ط8 = (*الناتج)[م];
                ألحق(*الناتج, ب);
                م := م + 1;
                ك := ك + 1;
            }
        };
    }
    لو ((*الفاك).منقطع) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
    أرجع نتيجة.نجح(خطأ);
}

// Dictionary size from an LZMA2 properties byte (liblzma lzma2_decoder.c).
عام عرف حجم_قاموس_إل_زد_إم_إيه2(الخاصية: طبيعي): نتيجة طبيعي, خطأ_إل_زد_إم_إيه {
    لو (الخاصية > 40) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.خصائص_غير_صالحة()); };
    لو (الخاصية == 40) { أرجع نتيجة.نجح(0xFFFFFFFF); };
    أرجع نتيجة.نجح((2 | (الخاصية & 1)) << ((الخاصية >> 1) + 11));
}

نوع ناتج_فك_لزم = {
    البايتات: متجه ط8,
    المستهلك: طبيعي
};

// Decodes an LZMA2 stream at المصدر[البداية..) up to and including its end
// byte, appending to الناتج; returns the position after the end byte.
عام عرف فك_إل_زد_إم_إيه2_إلى(
    المصدر: &متجه ط8,
    البداية: طبيعي,
    حجم_القاموس: طبيعي,
    الناتج: &متغير متجه ط8,
    الحد: طبيعي
): نتيجة طبيعي, خطأ_إل_زد_إم_إيه {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الفاك: متغير فاك_لزم = فاك_لزم_جديد();
    الفاك.حجم_القاموس := حجم_القاموس;
    الفاك.بداية_القاموس := الطول(*الناتج) مثل طبيعي;
    دع يلزم_قاموس: متغير منطقي = صواب;
    دع يلزم_خصائص: متغير منطقي = صواب;
    دع الموضع: متغير طبيعي = البداية;
    طالما (صواب) {
        لو (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
        دع التحكم: طبيعي = (*المصدر)[الموضع] مثل طبيعي;
        الموضع := الموضع + 1;
        لو (التحكم == 0) { أرجع نتيجة.نجح(الموضع); };
        لو (التحكم >= 0xE0 || التحكم == 1) {
            يلزم_خصائص := صواب;
            يلزم_قاموس := خطأ;
            الفاك.بداية_القاموس := الطول(*الناتج) مثل طبيعي;
        } وإلا لو (يلزم_قاموس) {
            أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة());
        };
        لو (التحكم >= 0x80) {
            لو (الموضع + 4 > العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
            دع غير_المضغوط: طبيعي = ((التحكم & 0x1F) << 16)
                + (((*المصدر)[الموضع] مثل طبيعي) << 8) + ((*المصدر)[الموضع + 1] مثل طبيعي) + 1;
            دع المضغوط: طبيعي = (((*المصدر)[الموضع + 2] مثل طبيعي) << 8) + ((*المصدر)[الموضع + 3] مثل طبيعي) + 1;
            الموضع := الموضع + 4;
            لو (التحكم >= 0xC0) {
                لو (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
                اضبط_خصائص_لزم(&متغير الفاك, (*المصدر)[الموضع] مثل طبيعي)؟;
                لو (الفاك.بتات_السياق + الفاك.بتات_موضع_الحرف > 4) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.خصائص_غير_صالحة()); };
                الموضع := الموضع + 1;
                يلزم_خصائص := خطأ;
                أعد_حالة_لزم(&متغير الفاك);
            } وإلا لو (يلزم_خصائص) {
                أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة());
            } وإلا لو (التحكم >= 0xA0) {
                أعد_حالة_لزم(&متغير الفاك);
            };
            لو (الموضع + المضغوط > العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
            ابدأ_مفكك_المدى_لزم(المصدر, &متغير الفاك, الموضع, الموضع + المضغوط)؟;
            دع التوقف: طبيعي = (الطول(*الناتج) مثل طبيعي) + غير_المضغوط;
            فك_رموز_لزم(المصدر, &متغير الفاك, الناتج, التوقف, خطأ, الحد)؟;
            طبع_مدى_لزم(المصدر, &متغير الفاك);
            لو (الفاك.منقطع || الفاك.الشفرة != 0 || الفاك.الموضع != الموضع + المضغوط) {
                أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة());
            };
            الموضع := الموضع + المضغوط;
        } وإلا {
            لو (التحكم > 2) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
            لو (الموضع + 2 > العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
            دع الحجم: طبيعي = (((*المصدر)[الموضع] مثل طبيعي) << 8) + ((*المصدر)[الموضع + 1] مثل طبيعي) + 1;
            الموضع := الموضع + 2;
            لو (الموضع + الحجم > العدد) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
            لو (!يسمح_لزم(الطول(*الناتج) مثل طبيعي, الحجم, الحد)) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج()); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < الحجم) { ألحق(*الناتج, (*المصدر)[الموضع + ف]); ف := ف + 1; }
            الموضع := الموضع + الحجم;
        };
    }
    أرجع نتيجة.نجح(الموضع);
}

// A whole raw LZMA2 stream.
عام عرف فك_ضغط_إل_زد_إم_إيه2(المصدر: &متجه ط8, حجم_القاموس: طبيعي, الحد_الأقصى_للإخراج: طبيعي): نتيجة متجه ط8, خطأ_إل_زد_إم_إيه {
    دع الناتج: متغير متجه ط8 = [];
    دع النهاية: طبيعي = فك_إل_زد_إم_إيه2_إلى(المصدر, 0, حجم_القاموس, &متغير الناتج, الحد_الأقصى_للإخراج)؟;
    لو (النهاية != (الطول(*المصدر) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.بيانات_تالفة()); };
    أرجع نتيجة.نجح(الناتج);
}

// The .lzma ("LZMA alone") format: a properties byte, a 32-bit dictionary
// size and a 64-bit uncompressed size (all ones: unknown, end marker
// required), then one LZMA stream.
عام عرف فك_ضغط_إل_زد_إم_إيه_بحد(المصدر: &متجه ط8, الحد_الأقصى_للإخراج: طبيعي): نتيجة متجه ط8, خطأ_إل_زد_إم_إيه {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (العدد < 13) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة()); };
    دع الفاك: متغير فاك_لزم = فاك_لزم_جديد();
    اضبط_خصائص_لزم(&متغير الفاك, (*المصدر)[0] مثل طبيعي)؟;
    دع القاموس: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 4;
    طالما (ف >= 1) { القاموس := (القاموس << 8) | ((*المصدر)[ف] مثل طبيعي); ف := ف - 1; }
    لو (القاموس < 4096) { القاموس := 4096; };
    دع الحجم: متغير طبيعي = 0;
    ف := 12;
    طالما (ف >= 5) { الحجم := (الحجم << 8) | ((*المصدر)[ف] مثل طبيعي); ف := ف - 1; }
    دع معروف: منطقي = الحجم != 0xFFFFFFFFFFFFFFFF;
    الفاك.حجم_القاموس := القاموس;
    أعد_حالة_لزم(&متغير الفاك);
    ابدأ_مفكك_المدى_لزم(المصدر, &متغير الفاك, 13, العدد)؟;
    دع الناتج: متغير متجه ط8 = [];
    دع التوقف: متغير طبيعي = 0xFFFFFFFFFFFFFFFF;
    لو (معروف) {
        لو (الحد_الأقصى_للإخراج > 0 && الحجم > الحد_الأقصى_للإخراج) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج()); };
        التوقف := الحجم;
    };
    دع انتهى: منطقي = فك_رموز_لزم(المصدر, &متغير الفاك, &متغير الناتج, التوقف, صواب, الحد_الأقصى_للإخراج)؟;
    لو (معروف && انتهى && (الطول(الناتج) مثل طبيعي) != الحجم) { أرجع نتيجة.خطأ(خطأ_إل_زد_إم_إيه.حجم_غير_مطابق()); };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف فك_ضغط_إل_زد_إم_إيه(المصدر: &متجه ط8): نتيجة متجه ط8, خطأ_إل_زد_إم_إيه {
    أرجع فك_ضغط_إل_زد_إم_إيه_بحد(المصدر, 0);
}

// ---------------------------------------------------------------- encoder

// Range encoder (LZMA SDK RangeEnc_*): low carries one bit past 32.
نوع مرمز_مدى_لزم = {
    المنخفض: طبيعي,
    المدى: طبيعي,
    المخبأ: طبيعي,
    حجم_المخبأ: طبيعي,
    الناتج: متجه ط8
};

عرف مرمز_مدى_لزم_جديد(): مرمز_مدى_لزم {
    دع الناتج: متجه ط8 = [];
    دع المرمز: مرمز_مدى_لزم = { المنخفض: 0, المدى: 0xFFFFFFFF, المخبأ: 0, حجم_المخبأ: 1, الناتج: الناتج };
    أرجع المرمز;
}

عرف انقل_منخفض_لزم(المرمز: &متغير مرمز_مدى_لزم): فراغ {
    دع المنخفض: طبيعي = (*المرمز).المنخفض;
    لو ((المنخفض & 0xFFFFFFFF) < 0xFF000000 || المنخفض >= 0x100000000) {
        دع الحمل: طبيعي = المنخفض >> 32;
        دع المؤقت: متغير طبيعي = (*المرمز).المخبأ;
        طالما ((*المرمز).حجم_المخبأ > 0) {
            ألحق((*المرمز).الناتج, ((المؤقت + الحمل) & 0xFF) مثل ط8);
            المؤقت := 0xFF;
            (*المرمز).حجم_المخبأ := (*المرمز).حجم_المخبأ - 1;
        }
        (*المرمز).المخبأ := (المنخفض >> 24) & 0xFF;
    };
    (*المرمز).حجم_المخبأ := (*المرمز).حجم_المخبأ + 1;
    (*المرمز).المنخفض := (المنخفض & 0x00FFFFFF) << 8;
}

// The encoder: models, range encoder, coding state and the hash-chain
// match finder over the whole input.
نوع ضاغط_لزم = {
    الاحتمالات: متجه طبيعي,
    المرمز: مرمز_مدى_لزم,
    الحالة: طبيعي,
    ت0: طبيعي,
    ت1: طبيعي,
    ت2: طبيعي,
    ت3: طبيعي,
    الرؤوس: متجه طبيعي,
    السابق: متجه طبيعي,
    بتات_الهاش: طبيعي,
    حجم_القاموس: طبيعي
};

// Encoder parameters: lc=3, lp=0, pb=2 (the xz and LZMA SDK defaults).
عرف خصائص_الضاغط_لزم(): طبيعي { أرجع 93; }
عرف عمق_البحث_لزم(): طبيعي { أرجع 24; }
عرف طول_كاف_لزم(): طبيعي { أرجع 64; }

عرف أعد_ضاغط_لزم(الضاغط: &متغير ضاغط_لزم): فراغ {
    (*الضاغط).الاحتمالات := احتمالات_أولية_لزم(3);
    (*الضاغط).الحالة := 0;
    (*الضاغط).ت0 := 0;
    (*الضاغط).ت1 := 0;
    (*الضاغط).ت2 := 0;
    (*الضاغط).ت3 := 0;
}

عرف رمز_بت_لزم(الضاغط: &متغير ضاغط_لزم, الفهرس: طبيعي, البت: طبيعي): فراغ {
    دع الاحتمال: طبيعي = (*الضاغط).الاحتمالات[الفهرس];
    دع الحد: طبيعي = ((*الضاغط).المرمز.المدى >> 11) * الاحتمال;
    لو (البت == 0) {
        (*الضاغط).المرمز.المدى := الحد;
        (*الضاغط).الاحتمالات[الفهرس] := الاحتمال + ((2048 - الاحتمال) >> 5);
    } وإلا {
        (*الضاغط).المرمز.المنخفض := (*الضاغط).المرمز.المنخفض + الحد;
        (*الضاغط).المرمز.المدى := (*الضاغط).المرمز.المدى - الحد;
        (*الضاغط).الاحتمالات[الفهرس] := الاحتمال - (الاحتمال >> 5);
    };
    طالما ((*الضاغط).المرمز.المدى < 0x1000000) {
        (*الضاغط).المرمز.المدى := ((*الضاغط).المرمز.المدى << 8) & 0xFFFFFFFF;
        انقل_منخفض_لزم(&متغير (*الضاغط).المرمز);
    }
}

عرف رمز_مباشر_لزم(الضاغط: &متغير ضاغط_لزم, القيمة: طبيعي, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = العدد;
    طالما (ف > 0) {
        ف := ف - 1;
        (*الضاغط).المرمز.المدى := (*الضاغط).المرمز.المدى >> 1;
        لو (((القيمة >> ف) & 1) == 1) {
            (*الضاغط).المرمز.المنخفض := (*الضاغط).المرمز.المنخفض + (*الضاغط).المرمز.المدى;
        };
        طالما ((*الضاغط).المرمز.المدى < 0x1000000) {
            (*الضاغط).المرمز.المدى := ((*الضاغط).المرمز.المدى << 8) & 0xFFFFFFFF;
            انقل_منخفض_لزم(&متغير (*الضاغط).المرمز);
        }
    }
}

عرف رمز_شجرة_لزم(الضاغط: &متغير ضاغط_لزم, الأساس: طبيعي, البتات: طبيعي, القيمة: طبيعي): فراغ {
    دع م: متغير طبيعي = 1;
    دع ف: متغير طبيعي = البتات;
    طالما (ف > 0) {
        ف := ف - 1;
        دع ب: طبيعي = (القيمة >> ف) & 1;
        رمز_بت_لزم(الضاغط, الأساس + م, ب);
        م := (م << 1) | ب;
    }
}

عرف رمز_شجرة_معكوسة_لزم(الضاغط: &متغير ضاغط_لزم, الأساس: طبيعي, البتات: طبيعي, القيمة: طبيعي): فراغ {
    دع م: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البتات) {
        دع ب: طبيعي = (القيمة >> ف) & 1;
        رمز_بت_لزم(الضاغط, الأساس + م, ب);
        م := (م << 1) | ب;
        ف := ف + 1;
    }
}

عرف رمز_طول_لزم(الضاغط: &متغير ضاغط_لزم, الأساس: طبيعي, طول_التطابق: طبيعي, حالة_الموضع: طبيعي): فراغ {
    دع ط: طبيعي = طول_التطابق - 2;
    لو (ط < 8) {
        رمز_بت_لزم(الضاغط, الأساس, 0);
        رمز_شجرة_لزم(الضاغط, الأساس + 2 + حالة_الموضع * 8, 3, ط);
    } وإلا لو (ط < 16) {
        رمز_بت_لزم(الضاغط, الأساس, 1);
        رمز_بت_لزم(الضاغط, الأساس + 1, 0);
        رمز_شجرة_لزم(الضاغط, الأساس + 130 + حالة_الموضع * 8, 3, ط - 8);
    } وإلا {
        رمز_بت_لزم(الضاغط, الأساس, 1);
        رمز_بت_لزم(الضاغط, الأساس + 1, 1);
        رمز_شجرة_لزم(الضاغط, الأساس + 258, 8, ط - 16);
    };
}

عرف أعلى_بت_لزم(القيمة: طبيعي): طبيعي {
    دع س: متغير طبيعي = القيمة;
    دع الناتج: متغير طبيعي = 0;
    طالما (س > 1) { س := س >> 1; الناتج := الناتج + 1; }
    أرجع الناتج;
}

عرف رمز_حرف_لزم(الضاغط: &متغير ضاغط_لزم, المصدر: &متجه ط8, الموضع: طبيعي): فراغ {
    دع حالة_الموضع: طبيعي = الموضع & 3;
    دع الحالة: طبيعي = (*الضاغط).الحالة;
    رمز_بت_لزم(الضاغط, احتمال_تطابق_لزم() + الحالة * 16 + حالة_الموضع, 0);
    دع السابق: متغير طبيعي = 0;
    لو (الموضع > 0) { السابق := (*المصدر)[الموضع - 1] مثل طبيعي; };
    دع الأساس: طبيعي = احتمال_حرفي_لزم() + 0x300 * (السابق >> 5);
    دع البايت: طبيعي = (*المصدر)[الموضع] مثل طبيعي;
    دع الرمز: متغير طبيعي = 1;
    لو (الحالة < 7) {
        دع ف: متغير طبيعي = 8;
        طالما (ف > 0) {
            ف := ف - 1;
            دع ب: طبيعي = (البايت >> ف) & 1;
            رمز_بت_لزم(الضاغط, الأساس + الرمز, ب);
            الرمز := (الرمز << 1) | ب;
        }
    } وإلا {
        دع بايت_التطابق: متغير طبيعي = (*المصدر)[الموضع - (*الضاغط).ت0 - 1] مثل طبيعي;
        دع الإزاحة: متغير طبيعي = 0x100;
        دع ف: متغير طبيعي = 8;
        طالما (ف > 0) {
            ف := ف - 1;
            دع ب: طبيعي = (البايت >> ف) & 1;
            بايت_التطابق := بايت_التطابق << 1;
            دع بت_التطابق: طبيعي = بايت_التطابق & الإزاحة;
            رمز_بت_لزم(الضاغط, الأساس + الإزاحة + بت_التطابق + الرمز, ب);
            الرمز := (الرمز << 1) | ب;
            لو (ب == 1) { الإزاحة := بت_التطابق; } وإلا { الإزاحة := الإزاحة ^ بت_التطابق; };
        }
    };
    لو (الحالة < 4) { (*الضاغط).الحالة := 0; }
    وإلا لو (الحالة < 10) { (*الضاغط).الحالة := الحالة - 3; }
    وإلا { (*الضاغط).الحالة := الحالة - 6; };
}

عرف رمز_تطابق_لزم(الضاغط: &متغير ضاغط_لزم, الموضع: طبيعي, المسافة: طبيعي, طول_التطابق: طبيعي): فراغ {
    دع حالة_الموضع: طبيعي = الموضع & 3;
    دع الحالة: طبيعي = (*الضاغط).الحالة;
    رمز_بت_لزم(الضاغط, احتمال_تطابق_لزم() + الحالة * 16 + حالة_الموضع, 1);
    رمز_بت_لزم(الضاغط, احتمال_تكرار_لزم() + الحالة, 0);
    رمز_طول_لزم(الضاغط, احتمال_طول_لزم(), طول_التطابق, حالة_الموضع);
    دع حالة_الطول: متغير طبيعي = طول_التطابق - 2;
    لو (حالة_الطول > 3) { حالة_الطول := 3; };
    دع الخانة: متغير طبيعي = المسافة;
    لو (المسافة >= 4) {
        دع ب: طبيعي = أعلى_بت_لزم(المسافة);
        الخانة := (ب << 1) | ((المسافة >> (ب - 1)) & 1);
    };
    رمز_شجرة_لزم(الضاغط, احتمال_خانة_المسافة_لزم() + حالة_الطول * 64, 6, الخانة);
    لو (الخانة >= 4) {
        دع البتات: طبيعي = (الخانة >> 1) - 1;
        دع القاعدة: طبيعي = (2 | (الخانة & 1)) << البتات;
        دع الباقي: طبيعي = المسافة - القاعدة;
        لو (الخانة < 14) {
            رمز_شجرة_معكوسة_لزم(الضاغط, احتمال_مسافة_خاصة_لزم() + القاعدة - الخانة - 1, البتات, الباقي);
        } وإلا {
            رمز_مباشر_لزم(الضاغط, الباقي >> 4, البتات - 4);
            رمز_شجرة_معكوسة_لزم(الضاغط, احتمال_محاذاة_لزم(), 4, الباقي & 15);
        };
    };
    (*الضاغط).ت3 := (*الضاغط).ت2;
    (*الضاغط).ت2 := (*الضاغط).ت1;
    (*الضاغط).ت1 := (*الضاغط).ت0;
    (*الضاغط).ت0 := المسافة;
    لو (الحالة < 7) { (*الضاغط).الحالة := 7; } وإلا { (*الضاغط).الحالة := 10; };
}

عرف رمز_تكرار_لزم(الضاغط: &متغير ضاغط_لزم, الموضع: طبيعي, الفهرس: طبيعي, طول_التطابق: طبيعي): فراغ {
    دع حالة_الموضع: طبيعي = الموضع & 3;
    دع الحالة: طبيعي = (*الضاغط).الحالة;
    رمز_بت_لزم(الضاغط, احتمال_تطابق_لزم() + الحالة * 16 + حالة_الموضع, 1);
    رمز_بت_لزم(الضاغط, احتمال_تكرار_لزم() + الحالة, 1);
    لو (الفهرس == 0) {
        رمز_بت_لزم(الضاغط, احتمال_تكرار0_لزم() + الحالة, 0);
        رمز_بت_لزم(الضاغط, احتمال_تكرار0_طويل_لزم() + الحالة * 16 + حالة_الموضع, 1);
    } وإلا {
        رمز_بت_لزم(الضاغط, احتمال_تكرار0_لزم() + الحالة, 1);
        دع المسافة: متغير طبيعي = 0;
        لو (الفهرس == 1) {
            رمز_بت_لزم(الضاغط, احتمال_تكرار1_لزم() + الحالة, 0);
            المسافة := (*الضاغط).ت1;
        } وإلا {
            رمز_بت_لزم(الضاغط, احتمال_تكرار1_لزم() + الحالة, 1);
            لو (الفهرس == 2) {
                رمز_بت_لزم(الضاغط, احتمال_تكرار2_لزم() + الحالة, 0);
                المسافة := (*الضاغط).ت2;
            } وإلا {
                رمز_بت_لزم(الضاغط, احتمال_تكرار2_لزم() + الحالة, 1);
                المسافة := (*الضاغط).ت3;
                (*الضاغط).ت3 := (*الضاغط).ت2;
            };
            (*الضاغط).ت2 := (*الضاغط).ت1;
        };
        (*الضاغط).ت1 := (*الضاغط).ت0;
        (*الضاغط).ت0 := المسافة;
    };
    رمز_طول_لزم(الضاغط, احتمال_طول_تكرار_لزم(), طول_التطابق, حالة_الموضع);
    لو (الحالة < 7) { (*الضاغط).الحالة := 8; } وإلا { (*الضاغط).الحالة := 11; };
}

عرف هاش3_لزم(المصدر: &متجه ط8, الموضع: طبيعي, البتات: طبيعي): طبيعي {
    دع القيمة: طبيعي = ((*المصدر)[الموضع] مثل طبيعي)
        | (((*المصدر)[الموضع + 1] مثل طبيعي) << 8)
        | (((*المصدر)[الموضع + 2] مثل طبيعي) << 16);
    أرجع ((القيمة * 2654435761) & 0xFFFFFFFF) >> (32 - البتات);
}

// Adds الموضع to the hash chains.
عرف أدرج_موضع_لزم(الضاغط: &متغير ضاغط_لزم, المصدر: &متجه ط8, الموضع: طبيعي): فراغ {
    لو (الموضع + 3 > (الطول(*المصدر) مثل طبيعي)) { أرجع; };
    دع ه: طبيعي = هاش3_لزم(المصدر, الموضع, (*الضاغط).بتات_الهاش);
    (*الضاغط).السابق[الموضع] := (*الضاغط).الرؤوس[ه];
    (*الضاغط).الرؤوس[ه] := الموضع + 1;
}

عرف طول_التطابق_لزم(المصدر: &متجه ط8, الموضع: طبيعي, المسافة: طبيعي, الأقصى: طبيعي): طبيعي {
    لو (المسافة + 1 > الموضع) { أرجع 0; };
    دع م: طبيعي = الموضع - المسافة - 1;
    دع ط: متغير طبيعي = 0;
    طالما (ط < الأقصى && (*المصدر)[م + ط] == (*المصدر)[الموضع + ط]) { ط := ط + 1; }
    أرجع ط;
}

نوع تطابق_لزم = {
    الطول: طبيعي,
    المسافة: طبيعي
};

// The longest match at الموضع over the hash chain (BT/HC4 in liblzma; a
// plain hash chain here), before الموضع is inserted.
عرف أفضل_تطابق_لزم(الضاغط: &ضاغط_لزم, المصدر: &متجه ط8, الموضع: طبيعي, الأقصى: طبيعي): تطابق_لزم {
    دع الأفضل: متغير تطابق_لزم = { الطول: 0, المسافة: 0 };
    لو (الأقصى < 3) { أرجع الأفضل; };
    دع المرشح: متغير طبيعي = (*الضاغط).الرؤوس[هاش3_لزم(المصدر, الموضع, (*الضاغط).بتات_الهاش)];
    دع العمق: متغير طبيعي = 0;
    طالما (المرشح > 0 && العمق < عمق_البحث_لزم()) {
        دع م: طبيعي = المرشح - 1;
        دع المسافة: طبيعي = الموضع - م - 1;
        لو (المسافة >= (*الضاغط).حجم_القاموس) { اخرج_من_حلقة; };
        لو ((*المصدر)[م + الأفضل.الطول] == (*المصدر)[الموضع + الأفضل.الطول]) {
            دع ط: طبيعي = طول_التطابق_لزم(المصدر, الموضع, المسافة, الأقصى);
            لو (ط > الأفضل.الطول) {
                الأفضل.الطول := ط;
                الأفضل.المسافة := المسافة;
                لو (ط >= طول_كاف_لزم() || ط >= الأقصى) { اخرج_من_حلقة; };
            };
        };
        المرشح := (*الضاغط).السابق[م];
        العمق := العمق + 1;
    }
    أرجع الأفضل;
}

// change_pair of liblzma: a distance much larger than the other.
عرف أكبر_بكثير_لزم(الصغرى: طبيعي, الكبرى: طبيعي): منطقي {
    أرجع (الكبرى >> 7) > الصغرى;
}

// Encodes المصدر[البداية..) into the range encoder until the input ends or
// the LZMA2 chunk limits are reached; returns the position reached.
عرف رمز_مقطع_لزم(
    الضاغط: &متغير ضاغط_لزم,
    المصدر: &متجه ط8,
    البداية: طبيعي,
    أقصى_غير_مضغوط: طبيعي,
    أقصى_مضغوط: طبيعي
): طبيعي {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الموضع: متغير طبيعي = البداية;
    طالما (الموضع < العدد) {
        لو (الموضع - البداية + 273 > أقصى_غير_مضغوط) { أرجع الموضع; };
        لو ((الطول((*الضاغط).المرمز.الناتج) مثل طبيعي) + (*الضاغط).المرمز.حجم_المخبأ + 48 > أقصى_مضغوط) { أرجع الموضع; };
        دع المتاح: متغير طبيعي = العدد - الموضع;
        لو (المتاح > 273) { المتاح := 273; };
        // Repeat distances first.
        دع طول_التكرار: متغير طبيعي = 0;
        دع فهرس_التكرار: متغير طبيعي = 0;
        لو (المتاح >= 2) {
            دع التكرارات: متجه طبيعي = [(*الضاغط).ت0, (*الضاغط).ت1, (*الضاغط).ت2, (*الضاغط).ت3];
            دع ر: متغير طبيعي = 0;
            طالما (ر < 4) {
                دع ط: طبيعي = طول_التطابق_لزم(المصدر, الموضع, التكرارات[ر], المتاح);
                لو (ط > طول_التكرار) { طول_التكرار := ط; فهرس_التكرار := ر; };
                ر := ر + 1;
            }
        };
        دع الرئيسي: متغير تطابق_لزم = أفضل_تطابق_لزم(الضاغط, المصدر, الموضع, المتاح);
        أدرج_موضع_لزم(الضاغط, المصدر, الموضع);
        لو (الرئيسي.الطول == 2 && الرئيسي.المسافة >= 0x80) { الرئيسي.الطول := 0; };
        دع اختيار_تكرار: منطقي = طول_التكرار >= 2 && (
            طول_التكرار + 1 >= الرئيسي.الطول
            || (طول_التكرار + 2 >= الرئيسي.الطول && الرئيسي.المسافة > 512)
            || (طول_التكرار + 3 >= الرئيسي.الطول && الرئيسي.المسافة > 32768));
        دع الطول_المختار: متغير طبيعي = 0;
        لو (اختيار_تكرار) {
            رمز_تكرار_لزم(الضاغط, الموضع, فهرس_التكرار, طول_التكرار);
            الطول_المختار := طول_التكرار;
        } وإلا لو (الرئيسي.الطول >= 3) {
            // One-step lazy evaluation (lzma_encoder_optimum_fast.c).
            دع مؤجل: متغير منطقي = خطأ;
            لو (الرئيسي.الطول < طول_كاف_لزم() && الموضع + 1 < العدد) {
                دع المتاح_التالي: متغير طبيعي = العدد - الموضع - 1;
                لو (المتاح_التالي > 273) { المتاح_التالي := 273; };
                دع التالي: تطابق_لزم = أفضل_تطابق_لزم(الضاغط, المصدر, الموضع + 1, المتاح_التالي);
                لو ((التالي.الطول >= الرئيسي.الطول && التالي.المسافة < الرئيسي.المسافة)
                    || (التالي.الطول == الرئيسي.الطول + 1 && !أكبر_بكثير_لزم(الرئيسي.المسافة, التالي.المسافة))
                    || التالي.الطول > الرئيسي.الطول + 1) {
                    مؤجل := صواب;
                };
            };
            لو (!مؤجل) {
                رمز_تطابق_لزم(الضاغط, الموضع, الرئيسي.المسافة, الرئيسي.الطول);
                الطول_المختار := الرئيسي.الطول;
            };
        };
        لو (الطول_المختار == 0) {
            رمز_حرف_لزم(الضاغط, المصدر, الموضع);
            الموضع := الموضع + 1;
        } وإلا {
            دع ف: متغير طبيعي = 1;
            طالما (ف < الطول_المختار) { أدرج_موضع_لزم(الضاغط, المصدر, الموضع + ف); ف := ف + 1; }
            الموضع := الموضع + الطول_المختار;
        };
    }
    أرجع الموضع;
}

عرف ضاغط_لزم_جديد(العدد: طبيعي, حجم_القاموس: طبيعي): ضاغط_لزم {
    // The hash table grows with the input up to 2^16 heads.
    دع البتات: متغير طبيعي = 10;
    طالما (البتات < 16 && (1 << البتات) < العدد) { البتات := البتات + 1; }
    دع الرؤوس: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (1 << البتات)) { ألحق(الرؤوس, 0); ف := ف + 1; }
    دع السابق: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(السابق, 0); ف := ف + 1; }
    دع الضاغط: ضاغط_لزم = {
        الاحتمالات: احتمالات_أولية_لزم(3),
        المرمز: مرمز_مدى_لزم_جديد(),
        الحالة: 0, ت0: 0, ت1: 0, ت2: 0, ت3: 0,
        الرؤوس: الرؤوس,
        السابق: السابق,
        بتات_الهاش: البتات,
        حجم_القاموس: حجم_القاموس
    };
    أرجع الضاغط;
}

// Flushes the range encoder (five ShiftLow calls) and takes its bytes.
عرف أنه_مرمز_لزم(الضاغط: &متغير ضاغط_لزم): متجه ط8 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) { انقل_منخفض_لزم(&متغير (*الضاغط).المرمز); ف := ف + 1; }
    دع القديم: متغير مرمز_مدى_لزم = مرمز_مدى_لزم_جديد();
    بدّل((*الضاغط).المرمز, القديم);
    طابق القديم مع
    | { المنخفض: _, المدى: _, المخبأ: _, حجم_المخبأ: _, الناتج: الناتج } -> { أرجع الناتج; };
}

// The LZMA2 dictionary-size properties byte for at least الحجم bytes.
عام عرف خاصية_قاموس_إل_زد_إم_إيه2(الحجم: طبيعي): طبيعي {
    دع ب: متغير طبيعي = 0;
    طالما (ب < 40) {
        دع الحجم_ب: طبيعي = (2 | (ب & 1)) << ((ب >> 1) + 11);
        لو (الحجم_ب >= الحجم) { أرجع ب; };
        ب := ب + 1;
    }
    أرجع 40;
}

عرف حجم_قاموس_الضاغط_لزم(العدد: طبيعي): طبيعي {
    // 8 MiB (xz -6), smaller for small inputs.
    دع الحجم: متغير طبيعي = 4096;
    طالما (الحجم < العدد && الحجم < 8388608) { الحجم := الحجم * 2; }
    أرجع الحجم;
}

// A raw LZMA2 stream of المصدر, ending with the end byte; the dictionary
// size the decoder needs is حجم_قاموس_الضاغط (see خاصية_قاموس_إل_زد_إم_إيه2).
عام عرف اضغط_إل_زد_إم_إيه2(المصدر: &متجه ط8): متجه ط8 {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الضاغط: متغير ضاغط_لزم = ضاغط_لزم_جديد(العدد, حجم_قاموس_الضاغط_لزم(العدد));
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    // 3: dictionary reset (first chunk); then 0 after an LZMA chunk, 1 or 2
    // after a chunk stored uncompressed.
    دع الإعادة: متغير طبيعي = 3;
    طالما (الموضع < العدد) {
        لو (الإعادة >= 1) { أعد_ضاغط_لزم(&متغير الضاغط); };
        دع النهاية: طبيعي = رمز_مقطع_لزم(&متغير الضاغط, المصدر, الموضع, 2097152, 65536);
        دع المقطع: متجه ط8 = أنه_مرمز_لزم(&متغير الضاغط);
        دع غير_المضغوط: طبيعي = النهاية - الموضع;
        دع المضغوط: طبيعي = الطول(المقطع) مثل طبيعي;
        لو (المضغوط < غير_المضغوط && المضغوط <= 65536) {
            دع الحجم: طبيعي = غير_المضغوط - 1;
            ألحق(الناتج, (0x80 | (الإعادة << 5) | (الحجم >> 16)) مثل ط8);
            ألحق(الناتج, ((الحجم >> 8) & 0xFF) مثل ط8);
            ألحق(الناتج, (الحجم & 0xFF) مثل ط8);
            ألحق(الناتج, (((المضغوط - 1) >> 8) & 0xFF) مثل ط8);
            ألحق(الناتج, ((المضغوط - 1) & 0xFF) مثل ط8);
            لو (الإعادة >= 2) { ألحق(الناتج, خصائص_الضاغط_لزم() مثل ط8); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < المضغوط) { ألحق(الناتج, المقطع[ف]); ف := ف + 1; }
            الإعادة := 0;
        } وإلا {
            دع ف: متغير طبيعي = الموضع;
            دع أول_قطعة: منطقي = الإعادة == 3;
            طالما (ف < النهاية) {
                دع القطعة: متغير طبيعي = النهاية - ف;
                لو (القطعة > 65536) { القطعة := 65536; };
                لو (ف == الموضع && أول_قطعة) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 2); };
                ألحق(الناتج, (((القطعة - 1) >> 8) & 0xFF) مثل ط8);
                ألحق(الناتج, ((القطعة - 1) & 0xFF) مثل ط8);
                دع ك: متغير طبيعي = 0;
                طالما (ك < القطعة) { ألحق(الناتج, (*المصدر)[ف + ك]); ك := ك + 1; }
                ف := ف + القطعة;
            }
            لو (أول_قطعة) { الإعادة := 2; } وإلا لو (الإعادة == 0) { الإعادة := 1; };
        };
        الموضع := النهاية;
    }
    ألحق(الناتج, 0);
    أرجع الناتج;
}

// The dictionary size اضغط_إل_زد_إم_إيه2 uses for an input of العدد bytes.
عام عرف حجم_قاموس_ضغط_إل_زد_إم_إيه2(العدد: طبيعي): طبيعي {
    أرجع حجم_قاموس_الضاغط_لزم(العدد);
}

// The .lzma format with the uncompressed size known and no end marker.
عام عرف اضغط_إل_زد_إم_إيه(المصدر: &متجه ط8): متجه ط8 {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع القاموس: طبيعي = حجم_قاموس_الضاغط_لزم(العدد);
    دع الضاغط: متغير ضاغط_لزم = ضاغط_لزم_جديد(العدد, القاموس);
    دع الناتج: متغير متجه ط8 = [خصائص_الضاغط_لزم() مثل ط8];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) { ألحق(الناتج, ((القاموس >> (8 * ف)) & 0xFF) مثل ط8); ف := ف + 1; }
    ف := 0;
    طالما (ف < 8) { ألحق(الناتج, ((العدد >> (8 * ف)) & 0xFF) مثل ط8); ف := ف + 1; }
    دع النهاية: طبيعي = رمز_مقطع_لزم(&متغير الضاغط, المصدر, 0, 0xFFFFFFFFFFFF, 0xFFFFFFFFFFFF);
    دع التيار: متجه ط8 = أنه_مرمز_لزم(&متغير الضاغط);
    ف := 0;
    طالما (ف < (الطول(التيار) مثل طبيعي)) { ألحق(الناتج, التيار[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام مرادف lzma_compress = اضغط_إل_زد_إم_إيه;
عام مرادف lzma2_compress = اضغط_إل_زد_إم_إيه2;
عام مرادف lzma2_compress_dictionary_size = حجم_قاموس_ضغط_إل_زد_إم_إيه2;
عام مرادف lzma2_dictionary_property = خاصية_قاموس_إل_زد_إم_إيه2;

عام مرادف lzma_error = خطأ_إل_زد_إم_إيه;
عام مرادف lzma_decompress = فك_ضغط_إل_زد_إم_إيه;
عام مرادف lzma_decompress_limited = فك_ضغط_إل_زد_إم_إيه_بحد;
عام مرادف lzma2_decompress = فك_ضغط_إل_زد_إم_إيه2;
عام مرادف lzma2_decode_into = فك_إل_زد_إم_إيه2_إلى;
عام مرادف lzma2_dictionary_size = حجم_قاموس_إل_زد_إم_إيه2;
عام مرادف lzma_error.unexpected_end = خطأ_إل_زد_إم_إيه.نهاية_غير_متوقعة;
عام مرادف lzma_error.bad_properties = خطأ_إل_زد_إم_إيه.خصائص_غير_صالحة;
عام مرادف lzma_error.corrupt_data = خطأ_إل_زد_إم_إيه.بيانات_تالفة;
عام مرادف lzma_error.bad_distance = خطأ_إل_زد_إم_إيه.مسافة_غير_صالحة;
عام مرادف lzma_error.size_mismatch = خطأ_إل_زد_إم_إيه.حجم_غير_مطابق;
عام مرادف lzma_error.output_limit_exceeded = خطأ_إل_زد_إم_إيه.تجاوز_حد_الإخراج;
