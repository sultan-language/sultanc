استورد unicode.data.segmentation;
استورد unicode.algorithms.lookup;
استورد unicode.algorithms.text_offsets;

// Unicode 18.0 UAX #29 default sentence boundaries. Scalar offsets.
عرف صنف_جملة(القيمة: ط32): ط32 {
    أرجع قيمة_نطاق_مرتب(&نطاقات_SentenceBreakProperty, القيمة, 0);
}
عرف فاصل_فقرة_جملة(الفئة: ط32): منطقي {
    أرجع الفئة == 1 || الفئة == 2 || الفئة == 3;
}
عرف لاحقة_مهملة_جملة(الفئة: ط32): منطقي {
    أرجع الفئة == 4 || الفئة == 5;
}
عرف نهاية_جملة(الفئة: ط32): منطقي {
    أرجع الفئة == 11 || الفئة == 12;
}

// UAX #29 SB5: ignore Format/Extend except at text start and after ParaSep.
عرف سابق_جملة_مهم(الرموز: &متجه ط32, الموضع: طبيعي): اختياري طبيعي {
    دع البحث: متغير طبيعي = الموضع;
    طالما (البحث > 0) {
        البحث := البحث - 1;
        إذا (!لاحقة_مهملة_جملة(صنف_جملة((*الرموز)[البحث]))) {
            أرجع اختياري.موجود(البحث);
        };
    }
    أرجع اختياري.لا_شيء();
}
عرف لاحق_جملة_مهم(الرموز: &متجه ط32, الموضع: طبيعي): اختياري طبيعي {
    دع البحث: متغير طبيعي = الموضع;
    طالما (البحث < (الطول(*الرموز) مثل طبيعي)) {
        إذا (!لاحقة_مهملة_جملة(صنف_جملة((*الرموز)[البحث]))) {
            أرجع اختياري.موجود(البحث);
        };
        البحث := البحث + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف حد_جملة_يونيكود(الرموز: &متجه ط32, الموضع: طبيعي): اختياري منطقي {
    دع العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع اختياري.لا_شيء(); };
    // SB1/SB2: empty text does not have a boundary.
    إذا (العدد == 0) { أرجع اختياري.موجود(خطأ); };
    إذا (الموضع == 0 || الموضع == العدد) { أرجع اختياري.موجود(صواب); };
    دع السابق_الخام: ط32 = صنف_جملة((*الرموز)[الموضع - 1]);
    دع التالي_الخام: ط32 = صنف_جملة((*الرموز)[الموضع]);
    // SB3-SB5: CRLF, paragraph separators and ignoring marks.
    إذا (السابق_الخام == 1 && التالي_الخام == 2) { أرجع اختياري.موجود(خطأ); };
    إذا (فاصل_فقرة_جملة(السابق_الخام)) { أرجع اختياري.موجود(صواب); };
    إذا (لاحقة_مهملة_جملة(التالي_الخام)) { أرجع اختياري.موجود(خطأ); };
    دع السابق_الموضع: طبيعي;
    طابق سابق_جملة_مهم(الرموز, الموضع) مع
    | اختياري.موجود(ف) -> { السابق_الموضع := ف; }
    | _ -> { أرجع اختياري.موجود(خطأ); };
    دع السابق: ط32 = صنف_جملة((*الرموز)[السابق_الموضع]);
    دع التالي: ط32 = التالي_الخام;
    // SB6: ATerm × Numeric.
    إذا (السابق == 11 && التالي == 10) { أرجع اختياري.موجود(خطأ); };
    // SB7: (Upper | Lower) ATerm × Upper.
    إذا (السابق == 11 && التالي == 8) {
        طابق سابق_جملة_مهم(الرموز, السابق_الموضع) مع
        | اختياري.موجود(ف) -> {
            دع الصنف: ط32 = صنف_جملة((*الرموز)[ف]);
            إذا (الصنف == 7 || الصنف == 8) { أرجع اختياري.موجود(خطأ); };
        }
        | _ -> { };
    };
    // For SB8..SB11, read the suffix in reverse: Sp*, then Close*,
    // then a sentence terminator. Closing marks after spaces are not part
    // of SATerm Close* Sp*; SB9 accepts Close only before any Sp.
    دع البحث: متغير طبيعي = الموضع;
    دع نهاية_المجموعة: متغير ط32 = 0;
    دع سبق_فراغ: متغير منطقي = خطأ;
    دع سبق_إغلاق: متغير منطقي = خطأ;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق سابق_جملة_مهم(الرموز, البحث) مع
        | اختياري.موجود(ف) -> {
            دع الصنف: ط32 = صنف_جملة((*الرموز)[ف]);
            إذا (الصنف == 6 && !سبق_إغلاق) {
                سبق_فراغ := صواب;
                البحث := ف;
            } وإلا إذا (الصنف == 13) {
                سبق_إغلاق := صواب;
                البحث := ف;
            } وإلا {
                إذا (نهاية_جملة(الصنف)) { نهاية_المجموعة := الصنف; };
                مستمر := خطأ;
            };
        }
        | _ -> { مستمر := خطأ; };
    }
    // SB8: ATerm Close* Sp* × (not OLetter/Upper/Lower/ParaSep/SATerm)* Lower.
    // The look-ahead is required even when the immediately following scalar
    // is punctuation or a number, as specified in UAX #29.
    إذا (نهاية_المجموعة == 11) {
        دع التالي_الموضع: متغير طبيعي = الموضع;
        دع يسمح: متغير منطقي = صواب;
        طالما (يسمح) {
            طابق لاحق_جملة_مهم(الرموز, التالي_الموضع) مع
            | اختياري.لا_شيء -> { يسمح := خطأ; }
            | اختياري.موجود(ف) -> {
                دع الصنف: ط32 = صنف_جملة((*الرموز)[ف]);
                إذا (الصنف == 7) { أرجع اختياري.موجود(خطأ); };
                إذا (الصنف == 8 || الصنف == 9 || نهاية_جملة(الصنف)
                    || فاصل_فقرة_جملة(الصنف)) {
                    يسمح := خطأ;
                } وإلا {
                    التالي_الموضع := ف + 1;
                };
            };
        }
    };
    إذا (نهاية_المجموعة != 0) {
        // SB8a: no break before SContinue, ATerm or STerm.
        إذا (التالي == 14 || نهاية_جملة(التالي)) { أرجع اختياري.موجود(خطأ); };
        // SB9: Close may follow SATerm Close*, but not the subsequent Sp*.
        إذا (التالي == 13 && !سبق_فراغ) { أرجع اختياري.موجود(خطأ); };
        // SB9/SB10: absorb spaces and paragraph separators.
        إذا (التالي == 6 || فاصل_فقرة_جملة(التالي)) {
            أرجع اختياري.موجود(خطأ);
        };
        // SB11: break after sentence ending punctuation and trailing marks.
        أرجع اختياري.موجود(صواب);
    };
    أرجع اختياري.موجود(خطأ);
}

عام عرف حدود_جمل_يونيكود(الرموز: &متجه ط32): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع <= (الطول(*الرموز) مثل طبيعي)) {
        طابق حد_جملة_يونيكود(الرموز, الموضع) مع
        | اختياري.موجود(النتيجة) -> { إذا (النتيجة) { ألحق(الناتج, الموضع); }; }
        | _ -> { };
        الموضع := الموضع + 1;
    }
    أرجع الناتج;
}

عام عرف حدود_جمل_بايتات_يونيكود(النص: &نص): نتيجة متجه طبيعي, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الحدود: متجه طبيعي = حدود_جمل_يونيكود(&المراجع.القيم);
        أرجع نتيجة.نجح(حدود_بايتات_من_سلالم(&المراجع, &الحدود));
    };
}

عام مرادف unicode_sentence_boundaries = حدود_جمل_يونيكود;
