استورد unicode.data.segmentation;
استورد unicode.algorithms.lookup;
استورد unicode.algorithms.text_offsets;

// Unicode 18.0 UAX #29 default sentence boundaries. Scalar offsets.
عرف صنف_جملة(القيمة: غ32): غ32 {
    أرجع قيمة_نطاق_مرتب(&نطاقات_SentenceBreakProperty, القيمة, 0);
}
عرف فاصل_فقرة_جملة(الفئة: غ32): منطقي {
    أرجع الفئة == 1 || الفئة == 2 || الفئة == 3;
}
عرف لاحقة_مهملة_جملة(الفئة: غ32): منطقي {
    أرجع الفئة == 4 || الفئة == 5;
}
عرف نهاية_جملة(الفئة: غ32): منطقي {
    أرجع الفئة == 11 || الفئة == 12;
}

// UAX #29 SB5: ignore Format/Extend except at text start and after ParaSep.
عرف سابق_جملة_مهم(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار غير_موقع {
    دع البحث: متغير غير_موقع = الموضع;
    بينما (البحث > 0) {
        البحث := البحث - 1;
        لو (!لاحقة_مهملة_جملة(صنف_جملة((*الرموز)[البحث]))) {
            أرجع اختيار.بعض(البحث);
        };
    }
    أرجع اختيار.لا_شيء();
}
عرف لاحق_جملة_مهم(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار غير_موقع {
    دع البحث: متغير غير_موقع = الموضع;
    بينما (البحث < (الطول(*الرموز) مثل غير_موقع)) {
        لو (!لاحقة_مهملة_جملة(صنف_جملة((*الرموز)[البحث]))) {
            أرجع اختيار.بعض(البحث);
        };
        البحث := البحث + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف حد_جملة_يونيكود(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار منطقي {
    دع العدد: غير_موقع = الطول(*الرموز) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع اختيار.لا_شيء(); };
    // SB1/SB2: empty text does not have a boundary.
    لو (العدد == 0) { أرجع اختيار.بعض(خطأ); };
    لو (الموضع == 0 || الموضع == العدد) { أرجع اختيار.بعض(صواب); };
    دع السابق_الخام: غ32 = صنف_جملة((*الرموز)[الموضع - 1]);
    دع التالي_الخام: غ32 = صنف_جملة((*الرموز)[الموضع]);
    // SB3-SB5: CRLF, paragraph separators and ignoring marks.
    لو (السابق_الخام == 1 && التالي_الخام == 2) { أرجع اختيار.بعض(خطأ); };
    لو (فاصل_فقرة_جملة(السابق_الخام)) { أرجع اختيار.بعض(صواب); };
    لو (لاحقة_مهملة_جملة(التالي_الخام)) { أرجع اختيار.بعض(خطأ); };
    دع السابق_الموضع: غير_موقع;
    طابق سابق_جملة_مهم(الرموز, الموضع) مع
    | اختيار.بعض(ف) -> { السابق_الموضع := ف; }
    | _ -> { أرجع اختيار.بعض(خطأ); };
    دع السابق: غ32 = صنف_جملة((*الرموز)[السابق_الموضع]);
    دع التالي: غ32 = التالي_الخام;
    // SB6: ATerm × Numeric.
    لو (السابق == 11 && التالي == 10) { أرجع اختيار.بعض(خطأ); };
    // SB7: (Upper | Lower) ATerm × Upper.
    لو (السابق == 11 && التالي == 8) {
        طابق سابق_جملة_مهم(الرموز, السابق_الموضع) مع
        | اختيار.بعض(ف) -> {
            دع الصنف: غ32 = صنف_جملة((*الرموز)[ف]);
            لو (الصنف == 7 || الصنف == 8) { أرجع اختيار.بعض(خطأ); };
        }
        | _ -> { };
    };
    // For SB8..SB11, read the suffix in reverse: Sp*, then Close*,
    // then a sentence terminator. Closing marks after spaces are not part
    // of SATerm Close* Sp*; SB9 accepts Close only before any Sp.
    دع البحث: متغير غير_موقع = الموضع;
    دع نهاية_المجموعة: متغير غ32 = 0;
    دع سبق_فراغ: متغير منطقي = خطأ;
    دع سبق_إغلاق: متغير منطقي = خطأ;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق سابق_جملة_مهم(الرموز, البحث) مع
        | اختيار.بعض(ف) -> {
            دع الصنف: غ32 = صنف_جملة((*الرموز)[ف]);
            لو (الصنف == 6 && !سبق_إغلاق) {
                سبق_فراغ := صواب;
                البحث := ف;
            } وإلا لو (الصنف == 13) {
                سبق_إغلاق := صواب;
                البحث := ف;
            } وإلا {
                لو (نهاية_جملة(الصنف)) { نهاية_المجموعة := الصنف; };
                مستمر := خطأ;
            };
        }
        | _ -> { مستمر := خطأ; };
    }
    // SB8: ATerm Close* Sp* × (not OLetter/Upper/Lower/ParaSep/SATerm)* Lower.
    // The look-ahead is required even when the immediately following scalar
    // is punctuation or a number, as specified in UAX #29.
    لو (نهاية_المجموعة == 11) {
        دع التالي_الموضع: متغير غير_موقع = الموضع;
        دع يسمح: متغير منطقي = صواب;
        بينما (يسمح) {
            طابق لاحق_جملة_مهم(الرموز, التالي_الموضع) مع
            | اختيار.لا_شيء -> { يسمح := خطأ; }
            | اختيار.بعض(ف) -> {
                دع الصنف: غ32 = صنف_جملة((*الرموز)[ف]);
                لو (الصنف == 7) { أرجع اختيار.بعض(خطأ); };
                لو (الصنف == 8 || الصنف == 9 || نهاية_جملة(الصنف)
                    || فاصل_فقرة_جملة(الصنف)) {
                    يسمح := خطأ;
                } وإلا {
                    التالي_الموضع := ف + 1;
                };
            };
        }
    };
    لو (نهاية_المجموعة != 0) {
        // SB8a: no break before SContinue, ATerm or STerm.
        لو (التالي == 14 || نهاية_جملة(التالي)) { أرجع اختيار.بعض(خطأ); };
        // SB9: Close may follow SATerm Close*, but not the subsequent Sp*.
        لو (التالي == 13 && !سبق_فراغ) { أرجع اختيار.بعض(خطأ); };
        // SB9/SB10: absorb spaces and paragraph separators.
        لو (التالي == 6 || فاصل_فقرة_جملة(التالي)) {
            أرجع اختيار.بعض(خطأ);
        };
        // SB11: break after sentence ending punctuation and trailing marks.
        أرجع اختيار.بعض(صواب);
    };
    أرجع اختيار.بعض(خطأ);
}

عام عرف حدود_جمل_يونيكود(الرموز: &متجه غ32): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع <= (الطول(*الرموز) مثل غير_موقع)) {
        طابق حد_جملة_يونيكود(الرموز, الموضع) مع
        | اختيار.بعض(النتيجة) -> { لو (النتيجة) { ألحق(الناتج, الموضع); }; }
        | _ -> { };
        الموضع := الموضع + 1;
    }
    أرجع الناتج;
}

عام عرف حدود_جمل_بايتات_يونيكود(النص: &نص): نتيجة متجه غير_موقع, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الحدود: متجه غير_موقع = حدود_جمل_يونيكود(&المراجع.القيم);
        أرجع نتيجة.نجح(حدود_بايتات_من_سلالم(&المراجع, &الحدود));
    };
}
