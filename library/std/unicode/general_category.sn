استورد unicode.algorithms.lookup;
استورد unicode.data.categories;

// UCD 18.0.0 general category, including surrogate and private-use code points.
عام نوع فئة_يونيكود =
    | حرف_كبير
    | حرف_صغير
    | حرف_عنوان
    | حرف_معدل
    | حرف_آخر
    | علامة_غير_متباعدة
    | علامة_دمج_متباعدة
    | علامة_إحاطة
    | رقم_عشري
    | رقم_حرفي
    | رقم_آخر
    | ترقيم_واصل
    | ترقيم_شرطة
    | ترقيم_فتح
    | ترقيم_إغلاق
    | اقتباس_افتتاح
    | اقتباس_ختام
    | ترقيم_آخر
    | رمز_رياضي
    | رمز_عملة
    | رمز_معدل
    | رمز_آخر
    | فاصل_مسافة
    | فاصل_سطر
    | فاصل_فقرة
    | تحكم
    | تنسيق
    | بديل
    | استخدام_خاص
    | غير_معين
;

عام عرف فئة_محرف_يونيكود(القيمة: غ32): فئة_يونيكود {
    دع الفئة: غ32 = قيمة_نطاق_مرتب(&نطاقات_فئات_يونيكود, القيمة, 29);
    طابق الفئة مع
    | 0 -> { أرجع فئة_يونيكود.حرف_كبير(); }
    | 1 -> { أرجع فئة_يونيكود.حرف_صغير(); }
    | 2 -> { أرجع فئة_يونيكود.حرف_عنوان(); }
    | 3 -> { أرجع فئة_يونيكود.حرف_معدل(); }
    | 4 -> { أرجع فئة_يونيكود.حرف_آخر(); }
    | 5 -> { أرجع فئة_يونيكود.علامة_غير_متباعدة(); }
    | 6 -> { أرجع فئة_يونيكود.علامة_دمج_متباعدة(); }
    | 7 -> { أرجع فئة_يونيكود.علامة_إحاطة(); }
    | 8 -> { أرجع فئة_يونيكود.رقم_عشري(); }
    | 9 -> { أرجع فئة_يونيكود.رقم_حرفي(); }
    | 10 -> { أرجع فئة_يونيكود.رقم_آخر(); }
    | 11 -> { أرجع فئة_يونيكود.ترقيم_واصل(); }
    | 12 -> { أرجع فئة_يونيكود.ترقيم_شرطة(); }
    | 13 -> { أرجع فئة_يونيكود.ترقيم_فتح(); }
    | 14 -> { أرجع فئة_يونيكود.ترقيم_إغلاق(); }
    | 15 -> { أرجع فئة_يونيكود.اقتباس_افتتاح(); }
    | 16 -> { أرجع فئة_يونيكود.اقتباس_ختام(); }
    | 17 -> { أرجع فئة_يونيكود.ترقيم_آخر(); }
    | 18 -> { أرجع فئة_يونيكود.رمز_رياضي(); }
    | 19 -> { أرجع فئة_يونيكود.رمز_عملة(); }
    | 20 -> { أرجع فئة_يونيكود.رمز_معدل(); }
    | 21 -> { أرجع فئة_يونيكود.رمز_آخر(); }
    | 22 -> { أرجع فئة_يونيكود.فاصل_مسافة(); }
    | 23 -> { أرجع فئة_يونيكود.فاصل_سطر(); }
    | 24 -> { أرجع فئة_يونيكود.فاصل_فقرة(); }
    | 25 -> { أرجع فئة_يونيكود.تحكم(); }
    | 26 -> { أرجع فئة_يونيكود.تنسيق(); }
    | 27 -> { أرجع فئة_يونيكود.بديل(); }
    | 28 -> { أرجع فئة_يونيكود.استخدام_خاص(); }
    | _ -> { أرجع فئة_يونيكود.غير_معين(); };
}
عام نوع unicode_category = فئة_يونيكود;
