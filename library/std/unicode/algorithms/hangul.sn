// Algorithmic Hangul canonical decomposition and composition (UAX #15).
// This algorithm is independent of the versioned Unicode Character Database.
// The UCD's other decomposition mappings and composition exclusions are
// intentionally NOT approximated by these Hangul-only operations.

عام عرف فك_مقطع_هانغول(القيمة: غ32): متجه غ32 {
    دع الناتج: متغير متجه غ32 = [];
    لو ((القيمة < 0xAC00) || (القيمة >= 0xD7A4)) {
        أرجع الناتج;
    };

    دع فهرس_المقطع: غ32 = القيمة - 0xAC00;
    دع فهرس_البداية: غ32 = فهرس_المقطع / 588;
    دع فهرس_الحركة: غ32 = (فهرس_المقطع % 588) / 28;
    دع فهرس_الختام: غ32 = فهرس_المقطع % 28;

    ألحق(الناتج, 0x1100 + فهرس_البداية);
    ألحق(الناتج, 0x1161 + فهرس_الحركة);
    لو (فهرس_الختام != 0) {
        ألحق(الناتج, 0x11A7 + فهرس_الختام);
    };
    أرجع الناتج;
}

عام عرف ركب_مقطعي_هانغول(الأول: غ32, الثاني: غ32): اختيار غ32 {
    لو (
        (الأول >= 0x1100) && (الأول < 0x1113)
        && (الثاني >= 0x1161) && (الثاني < 0x1176)
    ) {
        دع فهرس_البداية: غ32 = الأول - 0x1100;
        دع فهرس_الحركة: غ32 = الثاني - 0x1161;
        أرجع اختيار.بعض(0xAC00 + (فهرس_البداية * 588) + (فهرس_الحركة * 28));
    };

    لو (
        (الأول >= 0xAC00) && (الأول < 0xD7A4)
        && (((الأول - 0xAC00) % 28) == 0)
        && (الثاني >= 0x11A8) && (الثاني < 0x11C3)
    ) {
        أرجع اختيار.بعض(الأول + (الثاني - 0x11A7));
    };
    أرجع اختيار.لا_شيء();
}
