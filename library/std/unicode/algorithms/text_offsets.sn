استورد encoding.utf8;
استورد text.from_bytes;

// Keep UTF-8 byte offsets separate from Unicode scalar indexes. UAX #29
// operates on Unicode scalars; callers can map its boundaries to byte offsets.
عام نوع نص_سلالم_يونيكود = {
    القيم: متجه غ32,
    بدايات_البايتات: متجه غير_موقع
};
عام نوع خطأ_تحويل_يونيكود =
    | يوتيف8_غير_صالح بنوع غير_موقع
    | سلم_غير_صالح بنوع غير_موقع
;

عام عرف فك_نص_إلى_سلالم_يونيكود(النص: &نص): نتيجة نص_سلالم_يونيكود, خطأ_تحويل_يونيكود {
    دع القيم: متغير متجه غ32 = [];
    دع البدايات: متغير متجه غير_موقع = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(*النص) مثل غير_موقع)) {
        دع المحرف: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        لو (!المحرف.صالح || المحرف.العرض == 0) {
            أرجع نتيجة.خطأ(خطأ_تحويل_يونيكود.يوتيف8_غير_صالح(الموضع));
        };
        ألحق(البدايات, الموضع);
        ألحق(القيم, المحرف.القيمة);
        الموضع := الموضع + المحرف.العرض;
    }
    ألحق(البدايات, الموضع);
    دع الناتج: نص_سلالم_يونيكود = { القيم: القيم, بدايات_البايتات: البدايات };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حدود_بايتات_من_سلالم(
    المراجع: &نص_سلالم_يونيكود,
    الحدود: &متجه غير_موقع
): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الحدود) مثل غير_موقع)) {
        ألحق(الناتج, (*المراجع).بدايات_البايتات[(*الحدود)[ف]]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// UTF-8 encoding is performed only after scalar-level transformations.
عام عرف حول_سلالم_إلى_نص_يونيكود(القيم: &متجه غ32): نتيجة نص, خطأ_تحويل_يونيكود {
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيم) مثل غير_موقع)) {
        طابق ألحق_محرف_يوتيف8(البايتات, (*القيم)[ف]) مع
        | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { البايتات := الناتج; }
        | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> {
            أرجع نتيجة.خطأ(خطأ_تحويل_يونيكود.سلم_غير_صالح(ف));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}
