// Unicode 18.0 UAX #29 extended grapheme boundary rules GB1..GB999.
// This algorithm consumes classified scalar values from a single UCD version.
// It does not attempt to derive Unicode properties from character ranges.
// The data owner must supply Grapheme_Cluster_Break, Extended_Pictographic,
// and Indic_Conjunct_Break from the same Unicode database.

عام نوع صنف_فصل_عنقود =
    | عادي
    | إرجاع_عربة
    | سطر_جديد
    | تحكم
    | هانغول_بادئ
    | هانغول_وسط
    | هانغول_ختام
    | هانغول_مقطع_مفتوح
    | هانغول_مقطع_مغلق
    | امتداد
    | رابط_صفري
    | علامة_متباعدة
    | تقديم
    | مؤشر_إقليمي
;

عام نوع صنف_وصل_هندي =
    | لا_شيء
    | وصل
    | امتداد
    | صامت
;

عرف تحكم_عنقود(الصنف: صنف_فصل_عنقود): منطقي {
    طابق الصنف مع
    | صنف_فصل_عنقود.إرجاع_عربة -> { أرجع صواب; }
    | صنف_فصل_عنقود.سطر_جديد -> { أرجع صواب; }
    | صنف_فصل_عنقود.تحكم -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A true result means a grapheme boundary exists immediately before الموضع.
// Invalid property-array lengths or an out-of-bounds index return لا_شيء.
عام عرف حد_عنقود_موسع_مصنف(
    الأصناف: &متجه صنف_فصل_عنقود,
    تصويرية_موسعة: &متجه منطقي,
    وصل_هندي: &متجه صنف_وصل_هندي,
    الموضع: طبيعي
): اختياري منطقي {
    دع الطول_الكلي: طبيعي = الطول(*الأصناف) مثل طبيعي;
    إذا ((الطول(*تصويرية_موسعة) مثل طبيعي) != الطول_الكلي
        || (الطول(*وصل_هندي) مثل طبيعي) != الطول_الكلي
        || الموضع > الطول_الكلي) {
        أرجع اختياري.لا_شيء();
    };
    // GB1/GB2: the empty text has no grapheme boundaries.
    إذا (الطول_الكلي == 0) { أرجع اختياري.موجود(خطأ); };
    إذا (الموضع == 0 || الموضع == الطول_الكلي) {
        أرجع اختياري.موجود(صواب);
    };

    دع السابق: صنف_فصل_عنقود = (*الأصناف)[الموضع - 1];
    دع التالي: صنف_فصل_عنقود = (*الأصناف)[الموضع];

    // GB3, GB4, GB5: CR/LF and control boundaries.
    طابق السابق مع
    | صنف_فصل_عنقود.إرجاع_عربة -> {
        طابق التالي مع
        | صنف_فصل_عنقود.سطر_جديد -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | _ -> { };
    إذا (تحكم_عنقود(السابق) || تحكم_عنقود(التالي)) {
        أرجع اختياري.موجود(صواب);
    };

    // GB6, GB7, GB8: conjoining Hangul syllables.
    طابق السابق مع
    | صنف_فصل_عنقود.هانغول_بادئ -> {
        طابق التالي مع
        | صنف_فصل_عنقود.هانغول_بادئ -> { أرجع اختياري.موجود(خطأ); }
        | صنف_فصل_عنقود.هانغول_وسط -> { أرجع اختياري.موجود(خطأ); }
        | صنف_فصل_عنقود.هانغول_مقطع_مفتوح -> { أرجع اختياري.موجود(خطأ); }
        | صنف_فصل_عنقود.هانغول_مقطع_مغلق -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | صنف_فصل_عنقود.هانغول_وسط -> {
        طابق التالي مع
        | صنف_فصل_عنقود.هانغول_وسط -> { أرجع اختياري.موجود(خطأ); }
        | صنف_فصل_عنقود.هانغول_ختام -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | صنف_فصل_عنقود.هانغول_مقطع_مفتوح -> {
        طابق التالي مع
        | صنف_فصل_عنقود.هانغول_وسط -> { أرجع اختياري.موجود(خطأ); }
        | صنف_فصل_عنقود.هانغول_ختام -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | صنف_فصل_عنقود.هانغول_ختام -> {
        طابق التالي مع
        | صنف_فصل_عنقود.هانغول_ختام -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | صنف_فصل_عنقود.هانغول_مقطع_مغلق -> {
        طابق التالي مع
        | صنف_فصل_عنقود.هانغول_ختام -> { أرجع اختياري.موجود(خطأ); }
        | _ -> { };
    }
    | _ -> { };

    // GB9, GB9a, GB9b: Extend, ZWJ, SpacingMark and Prepend.
    طابق التالي مع
    | صنف_فصل_عنقود.امتداد -> { أرجع اختياري.موجود(خطأ); }
    | صنف_فصل_عنقود.رابط_صفري -> { أرجع اختياري.موجود(خطأ); }
    | صنف_فصل_عنقود.علامة_متباعدة -> { أرجع اختياري.موجود(خطأ); }
    | _ -> { };
    طابق السابق مع
    | صنف_فصل_عنقود.تقديم -> { أرجع اختياري.موجود(خطأ); }
    | _ -> { };

    // GB9c (revised in Unicode 18.0):
    // InCB=Linker InCB=Extend* × InCB=Consonant.
    طابق (*وصل_هندي)[الموضع] مع
    | صنف_وصل_هندي.صامت -> {
        دع البحث: متغير طبيعي = الموضع;
        دع تابع: متغير منطقي = صواب;
        طالما (البحث > 0 && تابع) {
            دع السابق_الهندي: صنف_وصل_هندي = (*وصل_هندي)[البحث - 1];
            طابق السابق_الهندي مع
            | صنف_وصل_هندي.امتداد -> { البحث := البحث - 1; }
            | صنف_وصل_هندي.وصل -> { أرجع اختياري.موجود(خطأ); }
            | _ -> { تابع := خطأ; };
        }
    }
    | _ -> { };

    // GB11: Extended_Pictographic Extend* ZWJ × Extended_Pictographic.
    إذا ((*تصويرية_موسعة)[الموضع]) {
        طابق السابق مع
        | صنف_فصل_عنقود.رابط_صفري -> {
            دع البحث: متغير طبيعي = الموضع - 1;
            دع تابع: متغير منطقي = صواب;
            طالما (البحث > 0 && تابع) {
                طابق (*الأصناف)[البحث - 1] مع
                | صنف_فصل_عنقود.امتداد -> { البحث := البحث - 1; }
                | _ -> { تابع := خطأ; };
            }
            إذا (البحث > 0 && (*تصويرية_موسعة)[البحث - 1]) {
                أرجع اختياري.موجود(خطأ);
            };
        }
        | _ -> { };
    };

    // GB12/GB13: odd count of preceding regional indicators.
    طابق السابق مع
    | صنف_فصل_عنقود.مؤشر_إقليمي -> {
        طابق التالي مع
        | صنف_فصل_عنقود.مؤشر_إقليمي -> {
            دع البحث: متغير طبيعي = الموضع;
            دع العدد: متغير طبيعي = 0;
            دع تابع: متغير منطقي = صواب;
            طالما (البحث > 0 && تابع) {
                طابق (*الأصناف)[البحث - 1] مع
                | صنف_فصل_عنقود.مؤشر_إقليمي -> {
                    العدد := العدد + 1;
                    البحث := البحث - 1;
                }
                | _ -> { تابع := خطأ; };
            }
            إذا ((العدد % 2) == 1) { أرجع اختياري.موجود(خطأ); };
        }
        | _ -> { };
    }
    | _ -> { };

    // GB999: break in every other position.
    أرجع اختياري.موجود(صواب);
}
