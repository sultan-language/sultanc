// Canonical combining-class reordering (UAX #15).
// The caller supplies canonical combining classes from the SAME versioned UCD
// as the code points. Neither the classes nor their source are guessed here.
// A class of zero is a starter and cannot be moved across by this algorithm.
// Equal nonzero classes retain their original order.
عام عرف رتب_دمج_يونيكود(
    القيم: &متغير متجه غ32,
    درجات_الدمج: &متغير متجه غ8
): منطقي {
    دع العدد: غير_موقع = الطول(*القيم) مثل غير_موقع;
    لو (العدد != (الطول(*درجات_الدمج) مثل غير_موقع)) {
        أرجع خطأ;
    };

    دع الفهرس: متغير غير_موقع = 1;
    بينما (الفهرس < العدد) {
        دع الموضع: متغير غير_موقع = الفهرس;
        بينما (
            (الموضع > 0)
            && ((*درجات_الدمج)[الموضع] != 0)
            && ((*درجات_الدمج)[الموضع - 1] > (*درجات_الدمج)[الموضع])
        ) {
            دع القيمة_السابقة: غ32 = (*القيم)[الموضع - 1];
            (*القيم)[الموضع - 1] := (*القيم)[الموضع];
            (*القيم)[الموضع] := القيمة_السابقة;
            دع الدرجة_السابقة: غ8 = (*درجات_الدمج)[الموضع - 1];
            (*درجات_الدمج)[الموضع - 1] := (*درجات_الدمج)[الموضع];
            (*درجات_الدمج)[الموضع] := الدرجة_السابقة;
            الموضع := الموضع - 1;
        }
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}
