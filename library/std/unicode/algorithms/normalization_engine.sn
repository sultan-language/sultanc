استورد unicode.algorithms.hangul;

// Unicode UAX #15 canonical composition of an ALREADY fully decomposed,
// canonically ordered sequence. No compatibility/canonical decomposition is
// attempted here. Non-Hangul pairs must come from the same versioned UCD,
// after applying Full_Composition_Exclusion (derived composition data).
// Composition pairs use one compact numeric table: (starter, combining,
// composite), sorted lexicographically by the first two scalar values.
// This is also the format used by unicode.data.normalization; there is no
// parallel record-based copy of the same Unicode information.
عرف ركب_مزدوجا_من_بيانات(
    الأزواج: &متجه غ32,
    الأول: غ32,
    الثاني: غ32
): اختيار غ32 {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = (الطول(*الأزواج) مثل غير_موقع) / 3;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع موضع: غير_موقع = الوسط * 3;
        دع القيمة_الأولى: غ32 = (*الأزواج)[موضع];
        دع القيمة_الثانية: غ32 = (*الأزواج)[موضع + 1];
        لو (القيمة_الأولى < الأول
            || (القيمة_الأولى == الأول && القيمة_الثانية < الثاني)) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    لو (البداية < ((الطول(*الأزواج) مثل غير_موقع) / 3)) {
        دع موضع: غير_موقع = البداية * 3;
        لو ((*الأزواج)[موضع] == الأول && (*الأزواج)[موضع + 1] == الثاني) {
            أرجع اختيار.بعض((*الأزواج)[موضع + 2]);
        };
    };
    أرجع اختيار.لا_شيء();
}

// Return لا_شيء on mismatched input, instead of silently assuming CCC=0.
// The caller must supply already decomposed scalars and their UCD CCC values.
عام عرف ركب_المفكك_قانونيا(
    الرموز: &متجه غ32,
    درجات_الدمج: &متجه غ8,
    الأزواج: &متجه غ32
): اختيار متجه غ32 {
    دع العدد: غير_موقع = الطول(*الرموز) مثل غير_موقع;
    لو (العدد != (الطول(*درجات_الدمج) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الناتج: متغير متجه غ32 = [];
    لو (العدد == 0) { أرجع اختيار.بعض(الناتج); };

    ألحق(الناتج, (*الرموز)[0]);
    دع موضع_البداية: متغير غير_موقع = 0;
    دع آخر_درجة: متغير غ8 = (*درجات_الدمج)[0];
    دع الموضع: متغير غير_موقع = 1;
    بينما (الموضع < العدد) {
        دع الرمز: غ32 = (*الرموز)[الموضع];
        دع الدرجة: غ8 = (*درجات_الدمج)[الموضع];
        دع تركيب: متغير اختيار غ32 = اختيار.لا_شيء();

        // UAX #15 blocked rule: a preceding CCC must be strictly smaller
        // than this CCC, except a previous starter (CCC=0).
        لو (آخر_درجة == 0 || آخر_درجة < الدرجة) {
            طابق ركب_مقطعي_هانغول((*الناتج)[موضع_البداية], الرمز) مع
            | اختيار.بعض(المركب) -> { تركيب := اختيار.بعض(المركب); }
            | اختيار.لا_شيء -> {
                تركيب := ركب_مزدوجا_من_بيانات(
                    الأزواج, (*الناتج)[موضع_البداية], الرمز
                );
            };
        };

        طابق تركيب مع
        | اختيار.بعض(المركب) -> {
            (*الناتج)[موضع_البداية] := المركب;
            // Last CCC is intentionally unchanged after composition.
        }
        | اختيار.لا_شيء -> {
            لو (الدرجة == 0) {
                موضع_البداية := الطول(الناتج) مثل غير_موقع;
            };
            ألحق(الناتج, الرمز);
            آخر_درجة := الدرجة;
        };
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(الناتج);
}
