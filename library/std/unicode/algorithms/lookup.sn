// Single sorted-table lookup owner for Unicode 18 data.
// Triples are inclusive (first, last, value); properties are sorted
// (property ID, first, last). No decoding, heap allocation or linear scan.
عام عرف قيمة_نطاق_مرتب(
    العناصر: &متجه غ32,
    القيمة: غ32,
    الافتراضي: غ32
): غ32 {
    دع نهاية: متغير غير_موقع = (الطول(*العناصر) مثل غير_موقع) / 3;
    دع بداية: متغير غير_موقع = 0;
    بينما (بداية < نهاية) {
        دع وسط: غير_موقع = بداية + (نهاية - بداية) / 2;
        دع موضع: غير_موقع = وسط * 3;
        لو (القيمة < (*العناصر)[موضع]) {
            نهاية := وسط;
        } وإلا لو (القيمة > (*العناصر)[موضع + 1]) {
            بداية := وسط + 1;
        } وإلا {
            أرجع (*العناصر)[موضع + 2];
        };
    }
    أرجع الافتراضي;
}

عام عرف خاصية_نطاق_مرتبة(
    العناصر: &متجه غ32,
    الخاصية: غ32,
    القيمة: غ32
): منطقي {
    دع بداية: متغير غير_موقع = 0;
    دع نهاية: متغير غير_موقع = (الطول(*العناصر) مثل غير_موقع) / 3;
    بينما (بداية < نهاية) {
        دع وسط: غير_موقع = بداية + (نهاية - بداية) / 2;
        دع موضع: غير_موقع = وسط * 3;
        دع معرف: غ32 = (*العناصر)[موضع];
        لو (الخاصية < معرف || (الخاصية == معرف && القيمة < (*العناصر)[موضع + 1])) {
            نهاية := وسط;
        } وإلا لو (الخاصية > معرف || القيمة > (*العناصر)[موضع + 2]) {
            بداية := وسط + 1;
        } وإلا {
            أرجع صواب;
        };
    }
    أرجع خطأ;
}

// Mapping keys are sorted; offsets and lengths index one shared scalar pool.
عام عرف تسلسل_تحويل_يونيكود(
    القيمة: غ32,
    المفاتيح: &متجه غ32,
    البدايات: &متجه غ32,
    الأطوال: &متجه غ32,
    القيم: &متجه غ32
): متجه غ32 {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*المفاتيح) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + (النهاية - البداية) / 2;
        لو ((*المفاتيح)[الوسط] < القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    دع الناتج: متغير متجه غ32 = [];
    لو (البداية < (الطول(*المفاتيح) مثل غير_موقع) && (*المفاتيح)[البداية] == القيمة) {
        دع موضع: متغير غير_موقع = (*البدايات)[البداية] مثل غير_موقع;
        دع النهاية_الفعلية: غير_موقع = موضع + ((*الأطوال)[البداية] مثل غير_موقع);
        بينما (موضع < النهاية_الفعلية) {
            ألحق(الناتج, (*القيم)[موضع]);
            موضع := موضع + 1;
        }
    } وإلا {
        ألحق(الناتج, القيمة);
    };
    أرجع الناتج;
}

// Simple mappings contain at most one mapped scalar. Read the shared numeric
// pool directly instead of constructing an allocation-backed result vector.
// Unknown keys preserve their input scalar, as required by simple casing.
عام عرف محرف_تحويل_بسيط_يونيكود(
    القيمة: غ32,
    المفاتيح: &متجه غ32,
    البدايات: &متجه غ32,
    الأطوال: &متجه غ32,
    القيم: &متجه غ32
): غ32 {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*المفاتيح) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + (النهاية - البداية) / 2;
        لو ((*المفاتيح)[الوسط] < القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    لو (البداية < (الطول(*المفاتيح) مثل غير_موقع)
        && (*المفاتيح)[البداية] == القيمة
        && (*الأطوال)[البداية] == 1) {
        أرجع (*القيم)[(*البدايات)[البداية] مثل غير_موقع];
    };
    أرجع القيمة;
}
