// Single sorted-table lookup owner for Unicode 18 data.
// Triples are inclusive (first, last, value); properties are sorted
// (property ID, first, last). No decoding, heap allocation or linear scan.
عام عرف قيمة_نطاق_مرتب(
    العناصر: &متجه ط32,
    القيمة: ط32,
    الافتراضي: ط32
): ط32 {
    دع نهاية: متغير طبيعي = (الطول(*العناصر) مثل طبيعي) / 3;
    دع بداية: متغير طبيعي = 0;
    طالما (بداية < نهاية) {
        دع وسط: طبيعي = بداية + (نهاية - بداية) / 2;
        دع موضع: طبيعي = وسط * 3;
        إذا (القيمة < (*العناصر)[موضع]) {
            نهاية := وسط;
        } وإلا إذا (القيمة > (*العناصر)[موضع + 1]) {
            بداية := وسط + 1;
        } وإلا {
            أرجع (*العناصر)[موضع + 2];
        };
    }
    أرجع الافتراضي;
}

عام عرف خاصية_نطاق_مرتبة(
    العناصر: &متجه ط32,
    الخاصية: ط32,
    القيمة: ط32
): منطقي {
    دع بداية: متغير طبيعي = 0;
    دع نهاية: متغير طبيعي = (الطول(*العناصر) مثل طبيعي) / 3;
    طالما (بداية < نهاية) {
        دع وسط: طبيعي = بداية + (نهاية - بداية) / 2;
        دع موضع: طبيعي = وسط * 3;
        دع معرف: ط32 = (*العناصر)[موضع];
        إذا (الخاصية < معرف || (الخاصية == معرف && القيمة < (*العناصر)[موضع + 1])) {
            نهاية := وسط;
        } وإلا إذا (الخاصية > معرف || القيمة > (*العناصر)[موضع + 2]) {
            بداية := وسط + 1;
        } وإلا {
            أرجع صواب;
        };
    }
    أرجع خطأ;
}

// Mapping keys are sorted; offsets and lengths index one shared scalar pool.
عام عرف تسلسل_تحويل_يونيكود(
    القيمة: ط32,
    المفاتيح: &متجه ط32,
    البدايات: &متجه ط32,
    الأطوال: &متجه ط32,
    القيم: &متجه ط32
): متجه ط32 {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*المفاتيح) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + (النهاية - البداية) / 2;
        إذا ((*المفاتيح)[الوسط] < القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    دع الناتج: متغير متجه ط32 = [];
    إذا (البداية < (الطول(*المفاتيح) مثل طبيعي) && (*المفاتيح)[البداية] == القيمة) {
        دع موضع: متغير طبيعي = (*البدايات)[البداية] مثل طبيعي;
        دع النهاية_الفعلية: طبيعي = موضع + ((*الأطوال)[البداية] مثل طبيعي);
        طالما (موضع < النهاية_الفعلية) {
            ألحق(الناتج, (*القيم)[موضع]);
            موضع := موضع + 1;
        }
    } وإلا {
        ألحق(الناتج, القيمة);
    };
    أرجع الناتج;
}

// Simple mappings contain at most one mapped scalar. Read the shared numeric
// pool directly instead of constructing an allocation-backed result vector.
// Unknown keys preserve their input scalar, as required by simple casing.
عام عرف محرف_تحويل_بسيط_يونيكود(
    القيمة: ط32,
    المفاتيح: &متجه ط32,
    البدايات: &متجه ط32,
    الأطوال: &متجه ط32,
    القيم: &متجه ط32
): ط32 {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*المفاتيح) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + (النهاية - البداية) / 2;
        إذا ((*المفاتيح)[الوسط] < القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    إذا (البداية < (الطول(*المفاتيح) مثل طبيعي)
        && (*المفاتيح)[البداية] == القيمة
        && (*الأطوال)[البداية] == 1) {
        أرجع (*القيم)[(*البدايات)[البداية] مثل طبيعي];
    };
    أرجع القيمة;
}
