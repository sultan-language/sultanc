استورد unicode.algorithms.lookup;
استورد unicode.data.properties;

// The numeric property identifiers are fixed by the pinned generator.
عرف خاصية_محرف_يونيكود(القيمة: ط32, المعرف: ط32): منطقي {
    أرجع خاصية_نطاق_مرتبة(&نطاقات_خواص_يونيكود, المعرف, القيمة);
}
عام عرف محرف_أبجدي_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 0); }
عام عرف محرف_رقمي_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 1); }
عام عرف محرف_كبير_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 2); }
عام عرف محرف_صغير_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 3); }
// White_Space is property ID 4 in the same versioned UCD table as the
// other binary properties. Do not maintain a second handwritten database.
عام عرف محرف_فراغ_يونيكود(القيمة: ط32): منطقي {
    أرجع خاصية_محرف_يونيكود(القيمة, 4);
}
عام عرف محرف_ذو_حالة_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 5); }
عام عرف محرف_متجاهل_للحالة_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 6); }
عام عرف محرف_امتداد_عنقود_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 7); }
عام عرف محرف_تجاهل_افتراضي_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 8); }
عام عرف بداية_معرف_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 9); }
عام عرف استمرار_معرف_يونيكود(القيمة: ط32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 10); }

// English names (declared with their Arabic declarations: an alias names
// a declaration of its own module).
عام مرادف is_unicode_alphabetic = محرف_أبجدي_يونيكود;
عام مرادف is_unicode_numeric = محرف_رقمي_يونيكود;
عام مرادف is_unicode_uppercase = محرف_كبير_يونيكود;
عام مرادف is_unicode_lowercase = محرف_صغير_يونيكود;
عام مرادف is_unicode_whitespace = محرف_فراغ_يونيكود;
