استورد unicode.algorithms.lookup;
استورد unicode.data.properties;

// The numeric property identifiers are fixed by the pinned generator.
عرف خاصية_محرف_يونيكود(القيمة: غ32, المعرف: غ32): منطقي {
    أرجع خاصية_نطاق_مرتبة(&نطاقات_خواص_يونيكود, المعرف, القيمة);
}
عام عرف محرف_أبجدي_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 0); }
عام عرف محرف_رقمي_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 1); }
عام عرف محرف_كبير_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 2); }
عام عرف محرف_صغير_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 3); }
// White_Space is property ID 4 in the same versioned UCD table as the
// other binary properties. Do not maintain a second handwritten database.
عام عرف محرف_فراغ_يونيكود(القيمة: غ32): منطقي {
    أرجع خاصية_محرف_يونيكود(القيمة, 4);
}
عام عرف محرف_ذو_حالة_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 5); }
عام عرف محرف_متجاهل_للحالة_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 6); }
عام عرف محرف_امتداد_عنقود_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 7); }
عام عرف محرف_تجاهل_افتراضي_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 8); }
عام عرف بداية_معرف_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 9); }
عام عرف استمرار_معرف_يونيكود(القيمة: غ32): منطقي { أرجع خاصية_محرف_يونيكود(القيمة, 10); }
