استورد unicode.data.segmentation;
استورد unicode.algorithms.lookup;
استورد unicode.algorithms.text_offsets;
استورد unicode.algorithms.segmentation_engine;

// Extended grapheme boundaries, Unicode 18.0 (UAX #29).
// Index is a Unicode scalar offset rather than a UTF-8 byte offset.
عام عرف حدود_عناقيد_يونيكود(الرموز: &متجه غ32): متجه غير_موقع {
    دع الأصناف: متغير متجه صنف_فصل_عنقود = [];
    دع التصويرية: متغير متجه منطقي = [];
    دع الهندي: متغير متجه صنف_وصل_هندي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: غ32 = (*الرموز)[ف];
        دع الفئة: غ32 = قيمة_نطاق_مرتب(&نطاقات_GraphemeBreakProperty, الرمز, 0);
        دع الفئة_العربية: صنف_فصل_عنقود;
        طابق الفئة مع
        | 1 -> { الفئة_العربية := صنف_فصل_عنقود.إرجاع_عربة(); }
        | 2 -> { الفئة_العربية := صنف_فصل_عنقود.سطر_جديد(); }
        | 3 -> { الفئة_العربية := صنف_فصل_عنقود.تحكم(); }
        | 4 -> { الفئة_العربية := صنف_فصل_عنقود.هانغول_بادئ(); }
        | 5 -> { الفئة_العربية := صنف_فصل_عنقود.هانغول_وسط(); }
        | 6 -> { الفئة_العربية := صنف_فصل_عنقود.هانغول_ختام(); }
        | 7 -> { الفئة_العربية := صنف_فصل_عنقود.هانغول_مقطع_مفتوح(); }
        | 8 -> { الفئة_العربية := صنف_فصل_عنقود.هانغول_مقطع_مغلق(); }
        | 9 -> { الفئة_العربية := صنف_فصل_عنقود.امتداد(); }
        | 10 -> { الفئة_العربية := صنف_فصل_عنقود.رابط_صفري(); }
        | 11 -> { الفئة_العربية := صنف_فصل_عنقود.علامة_متباعدة(); }
        | 12 -> { الفئة_العربية := صنف_فصل_عنقود.تقديم(); }
        | 13 -> { الفئة_العربية := صنف_فصل_عنقود.مؤشر_إقليمي(); }
        | _ -> { الفئة_العربية := صنف_فصل_عنقود.عادي(); };
        ألحق(الأصناف, الفئة_العربية);
        ألحق(التصويرية, قيمة_نطاق_مرتب(&نطاقات_تصويرية_موسعة, الرمز, 0) == 1);
        دع صنف_هندي: غ32 = قيمة_نطاق_مرتب(&نطاقات_وصل_هندي, الرمز, 0);
        طابق صنف_هندي مع
        | 1 -> { ألحق(الهندي, صنف_وصل_هندي.صامت()); }
        | 2 -> { ألحق(الهندي, صنف_وصل_هندي.امتداد()); }
        | 3 -> { ألحق(الهندي, صنف_وصل_هندي.وصل()); }
        | _ -> { ألحق(الهندي, صنف_وصل_هندي.لا_شيء()); };
        ف := ف + 1;
    }
    دع الحدود: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف <= (الطول(*الرموز) مثل غير_موقع)) {
        طابق حد_عنقود_موسع_مصنف(&الأصناف, &التصويرية, &الهندي, ف) مع
        | اختيار.بعض(النتيجة) -> { لو (النتيجة) { ألحق(الحدود, ف); }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الحدود;
}

عام عرف حدود_عناقيد_بايتات_يونيكود(النص: &نص): نتيجة متجه غير_موقع, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الحدود: متجه غير_موقع = حدود_عناقيد_يونيكود(&المراجع.القيم);
        أرجع نتيجة.نجح(حدود_بايتات_من_سلالم(&المراجع, &الحدود));
    };
}
