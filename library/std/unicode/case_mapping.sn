استورد unicode.algorithms.text_offsets;
استورد unicode.algorithms.lookup;
استورد unicode.data.case_mapping;
استورد unicode.properties;
استورد unicode.algorithms.case_context;

عام عرف إلى_حروف_كبيرة_يونيكود(القيمة: غ32): متجه غ32 {
    أرجع تسلسل_تحويل_يونيكود(القيمة, &تحويل_أحرف_كبيرة_مفاتيح,
        &تحويل_أحرف_كبيرة_بدايات, &تحويل_أحرف_كبيرة_أطوال, &تحويل_أحرف_كبيرة_قيم);
}
عام عرف إلى_حروف_صغيرة_يونيكود(القيمة: غ32): متجه غ32 {
    أرجع تسلسل_تحويل_يونيكود(القيمة, &تحويل_أحرف_صغيرة_مفاتيح,
        &تحويل_أحرف_صغيرة_بدايات, &تحويل_أحرف_صغيرة_أطوال, &تحويل_أحرف_صغيرة_قيم);
}
عام عرف إلى_حرف_كبير_يونيكود(القيمة: غ32): غ32 {
    أرجع محرف_تحويل_بسيط_يونيكود(القيمة, &تحويل_كبير_بسيط_مفاتيح,
        &تحويل_كبير_بسيط_بدايات, &تحويل_كبير_بسيط_أطوال, &تحويل_كبير_بسيط_قيم);
}
عام عرف إلى_حرف_صغير_يونيكود(القيمة: غ32): غ32 {
    أرجع محرف_تحويل_بسيط_يونيكود(القيمة, &تحويل_صغير_بسيط_مفاتيح,
        &تحويل_صغير_بسيط_بدايات, &تحويل_صغير_بسيط_أطوال, &تحويل_صغير_بسيط_قيم);
}

// Titlecase scalar mappings are distinct from uppercase for digraphs and
// other titlecase characters. Full-string titlecasing requires word context;
// these operations expose only the normative scalar mappings.
عام عرف إلى_حروف_عنوان_يونيكود(القيمة: غ32): متجه غ32 {
    أرجع تسلسل_تحويل_يونيكود(القيمة, &تحويل_أحرف_عنوان_مفاتيح,
        &تحويل_أحرف_عنوان_بدايات, &تحويل_أحرف_عنوان_أطوال, &تحويل_أحرف_عنوان_قيم);
}
عام عرف إلى_حرف_عنوان_يونيكود(القيمة: غ32): غ32 {
    أرجع محرف_تحويل_بسيط_يونيكود(القيمة, &تحويل_عنوان_بسيط_مفاتيح,
        &تحويل_عنوان_بسيط_بدايات, &تحويل_عنوان_بسيط_أطوال, &تحويل_عنوان_بسيط_قيم);
}

// Default full text casing: Final_Sigma context is evaluated across scalars;
// Turkic and Lithuanian locale-specific mappings are deliberately excluded.
عام عرف حروف_صغيرة_لنص_يونيكود(القيم: &متجه غ32): متجه غ32 {
    دع عدد_القيم: غير_موقع = الطول(*القيم) مثل غير_موقع;
    دع ذو_حالة: متغير متجه منطقي = [];
    دع متجاهل: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_القيم) {
        ألحق(ذو_حالة, محرف_ذو_حالة_يونيكود((*القيم)[ف]));
        ألحق(متجاهل, محرف_متجاهل_للحالة_يونيكود((*القيم)[ف]));
        ف := ف + 1;
    }
    دع الناتج: متغير متجه غ32 = [];
    ف := 0;
    بينما (ف < عدد_القيم) {
        دع الرمز: غ32 = (*القيم)[ف];
        دع نهاية_سيغما: متغير منطقي = خطأ;
        لو (الرمز == 0x03A3) {
            طابق سيغما_نهائية_في_نص(&ذو_حالة, &متجاهل, ف) مع
            | اختيار.بعض(النتيجة) -> { نهاية_سيغما := النتيجة; }
            | _ -> { };
        };
        لو (نهاية_سيغما) {
            ألحق(الناتج, 0x03C2);
        } وإلا {
            دع المطابقة: متجه غ32 = إلى_حروف_صغيرة_يونيكود(الرمز);
            دع ج: متغير غير_موقع = 0;
            بينما (ج < (الطول(المطابقة) مثل غير_موقع)) {
                ألحق(الناتج, المطابقة[ج]);
                ج := ج + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حروف_كبيرة_لنص_يونيكود(الرموز: &متجه غ32): متجه غ32 {
    دع الناتج: متغير متجه غ32 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        دع المطابقة: متجه غ32 = إلى_حروف_كبيرة_يونيكود((*الرموز)[ف]);
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(المطابقة) مثل غير_موقع)) {
            ألحق(الناتج, المطابقة[ج]);
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}
عام عرف حول_نصا_إلى_الكبيرة_يونيكود(النص: &نص): نتيجة نص, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الناتج: متجه غ32 = حروف_كبيرة_لنص_يونيكود(&المراجع.القيم);
        أرجع حول_سلالم_إلى_نص_يونيكود(&الناتج);
    };
}
عام عرف حول_نصا_إلى_الصغيرة_يونيكود(النص: &نص): نتيجة نص, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الناتج: متجه غ32 = حروف_صغيرة_لنص_يونيكود(&المراجع.القيم);
        أرجع حول_سلالم_إلى_نص_يونيكود(&الناتج);
    };
}
