استورد unicode.algorithms.text_offsets;
استورد unicode.algorithms.lookup;
استورد unicode.data.case_folding;

عام عرف طي_حالة_الأحرف_يونيكود(القيمة: غ32): متجه غ32 {
    أرجع تسلسل_تحويل_يونيكود(القيمة, &طي_حالة_كامل_مفاتيح,
        &طي_حالة_كامل_بدايات, &طي_حالة_كامل_أطوال, &طي_حالة_كامل_قيم);
}
عام عرف طي_حالة_بسيط_يونيكود(القيمة: غ32): غ32 {
    أرجع محرف_تحويل_بسيط_يونيكود(القيمة, &طي_حالة_بسيط_مفاتيح,
        &طي_حالة_بسيط_بدايات, &طي_حالة_بسيط_أطوال, &طي_حالة_بسيط_قيم);
}

عام عرف طي_حالة_نص_يونيكود(النص: &نص): نتيجة نص, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الناتج: متغير متجه غ32 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المراجع.القيم) مثل غير_موقع)) {
            دع المطابقة: متجه غ32 = طي_حالة_الأحرف_يونيكود(المراجع.القيم[ف]);
            دع ج: متغير غير_موقع = 0;
            بينما (ج < (الطول(المطابقة) مثل غير_موقع)) {
                ألحق(الناتج, المطابقة[ج]);
                ج := ج + 1;
            }
            ف := ف + 1;
        }
        أرجع حول_سلالم_إلى_نص_يونيكود(&الناتج);
    };
}
