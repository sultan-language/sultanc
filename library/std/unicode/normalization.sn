استورد unicode.scalar;
استورد unicode.data.normalization;
استورد unicode.algorithms.lookup;
استورد unicode.algorithms.hangul;
استورد unicode.algorithms.canonical_order;
استورد unicode.algorithms.normalization_engine;
استورد encoding.utf8;
استورد text.from_bytes;

// UAX #15: this is an explicit transformation, never an implicit string rule.
عام نوع صورة_تطبيع_يونيكود = | إن_إف_سي | إن_إف_دي | إن_إف_كي_سي | إن_إف_كي_دي;
عام نوع خطأ_تطبيع_يونيكود = | نقطة_غير_قياسية بنوع غير_موقع | يوتيف8_غير_صالح بنوع غير_موقع | أطوال_الدمج_غير_متطابقة;

عرف درجة_دمج_رمز_يونيكود(القيمة: غ32): غ8 {
    أرجع قيمة_نطاق_مرتب(&نطاقات_درجة_دمج_يونيكود, القيمة, 0) مثل غ8;
}

عرف فك_رمز_يونيكود(
    القيمة: غ32,
    توافق: منطقي,
    الناتج: &متغير متجه غ32
): فراغ {
    دع مقطع_هانغول: متجه غ32 = فك_مقطع_هانغول(القيمة);
    لو (الطول(مقطع_هانغول) > 0) {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(مقطع_هانغول) مثل غير_موقع)) {
            ألحق(*الناتج, مقطع_هانغول[ف]);
            ف := ف + 1;
        }
        أرجع;
    };
    // Consult compatibility mappings only in NFKC/NFKD. Fall back to
    // canonical decomposition if the scalar has no compatibility mapping.
    // This avoids allocating both mapping sequences for every input scalar.
    دع التفكيك: متغير متجه غ32 = [];
    لو (توافق) {
        التفكيك := تسلسل_تحويل_يونيكود(
            القيمة, &تفكيك_توافقي_مفاتيح, &تفكيك_توافقي_بدايات,
            &تفكيك_توافقي_أطوال, &تفكيك_توافقي_قيم);
    };
    لو (!توافق || (الطول(التفكيك) == 1 && التفكيك[0] == القيمة)) {
        التفكيك := تسلسل_تحويل_يونيكود(
            القيمة, &تفكيك_قانوني_مفاتيح, &تفكيك_قانوني_بدايات,
            &تفكيك_قانوني_أطوال, &تفكيك_قانوني_قيم);
    };
    لو ((الطول(التفكيك) == 1) && (التفكيك[0] == القيمة)) {
        ألحق(*الناتج, القيمة);
        أرجع;
    };
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(التفكيك) مثل غير_موقع)) {
        فك_رمز_يونيكود(التفكيك[الموضع], توافق, الناتج);
        الموضع := الموضع + 1;
    }
}

عام عرف طبع_سلالم_يونيكود(القيم: &متجه غ32, الصورة: صورة_تطبيع_يونيكود): نتيجة متجه غ32, خطأ_تطبيع_يونيكود {
    دع توافق: متغير منطقي = خطأ;
    دع تركيب: متغير منطقي = خطأ;
    طابق الصورة مع
    | صورة_تطبيع_يونيكود.إن_إف_سي -> { تركيب := صواب; }
    | صورة_تطبيع_يونيكود.إن_إف_دي -> { }
    | صورة_تطبيع_يونيكود.إن_إف_كي_سي -> { توافق := صواب; تركيب := صواب; }
    | صورة_تطبيع_يونيكود.إن_إف_كي_دي -> { توافق := صواب; };
    دع الناتج: متغير متجه غ32 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيم) مثل غير_موقع)) {
        دع القيمة: غ32 = (*القيم)[ف];
        لو (!قيمة_يونيكود_قياسية_صالحة(القيمة)) {
            أرجع نتيجة.خطأ(خطأ_تطبيع_يونيكود.نقطة_غير_قياسية(ف));
        };
        فك_رمز_يونيكود(القيمة, توافق, &متغير الناتج);
        ف := ف + 1;
    }
    دع الدرجات: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < (الطول(الناتج) مثل غير_موقع)) {
        ألحق(الدرجات, درجة_دمج_رمز_يونيكود(الناتج[ف]));
        ف := ف + 1;
    }
    رتب_دمج_يونيكود(&متغير الناتج, &متغير الدرجات);
    لو (!تركيب) { أرجع نتيجة.نجح(الناتج); };
    طابق ركب_المفكك_قانونيا(&الناتج, &الدرجات, &أزواج_تركيب_يونيكود) مع
    | اختيار.بعض(المركب) -> { أرجع نتيجة.نجح(المركب); }
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تطبيع_يونيكود.أطوال_الدمج_غير_متطابقة());
    };
}

// UTF-8 input/output: preserve byte and scalar offset distinction.
عام عرف طبع_نص_يونيكود(القيمة: &نص, الصورة: صورة_تطبيع_يونيكود): نتيجة نص, خطأ_تطبيع_يونيكود {
    دع الرموز: متغير متجه غ32 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(*القيمة) مثل غير_موقع)) {
        دع المحرف: فك_يوتيف8 = فك_محرف_يوتيف8(القيمة, الموضع);
        لو (!المحرف.صالح || المحرف.العرض == 0) {
            أرجع نتيجة.خطأ(خطأ_تطبيع_يونيكود.يوتيف8_غير_صالح(الموضع));
        };
        ألحق(الرموز, المحرف.القيمة);
        الموضع := الموضع + المحرف.العرض;
    }
    دع البايتات: متغير متجه غ8 = [];
    طابق طبع_سلالم_يونيكود(&الرموز, الصورة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المطبعة) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المطبعة) مثل غير_موقع)) {
            طابق ألحق_محرف_يوتيف8(البايتات, المطبعة[ف]) مع
            | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { البايتات := الناتج; }
            | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> {
                أرجع نتيجة.خطأ(خطأ_تطبيع_يونيكود.نقطة_غير_قياسية(ف));
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}
