استورد unicode.data.segmentation;
استورد unicode.algorithms.lookup;
استورد unicode.algorithms.text_offsets;

// UAX #29, Unicode 18.0 default word boundaries.
// The boundary indices refer to Unicode scalar offsets, NOT UTF-8 bytes.
عرف صنف_كلمة(القيمة: غ32): غ32 {
    أرجع قيمة_نطاق_مرتب(&نطاقات_WordBreakProperty, القيمة, 0);
}
عرف حرف_كلمة(القيمة: غ32): منطقي { أرجع القيمة == 8 || القيمة == 9; }
عرف وسيط_حرف_كلمة(القيمة: غ32): منطقي { أرجع القيمة == 13 || القيمة == 15 || القيمة == 16; }
عرف وسيط_رقم_كلمة(القيمة: غ32): منطقي { أرجع القيمة == 14 || القيمة == 15 || القيمة == 16; }
عرف امتداد_كلمة(القيمة: غ32): منطقي { أرجع القيمة == 4 || القيمة == 5 || القيمة == 6; }
عرف نهاية_سطر_كلمة(القيمة: غ32): منطقي { أرجع القيمة == 1 || القيمة == 2 || القيمة == 3; }
عرف حرف_أو_رقم_كلمة(القيمة: غ32): منطقي {
    أرجع حرف_كلمة(القيمة) || القيمة == 10 || القيمة == 11;
}

// Return the prior significant scalar index. Ignorable scalars are skipped
// only after the explicit WB3/WB4 checks in the caller.
عرف سابق_كلمة_مهم(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار غير_موقع {
    دع البحث: متغير غير_موقع = الموضع;
    بينما (البحث > 0) {
        البحث := البحث - 1;
        لو (!امتداد_كلمة(صنف_كلمة((*الرموز)[البحث]))) {
            أرجع اختيار.بعض(البحث);
        };
    }
    أرجع اختيار.لا_شيء();
}
عرف لاحق_كلمة_مهم(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار غير_موقع {
    دع البحث: متغير غير_موقع = الموضع;
    بينما (البحث < (الطول(*الرموز) مثل غير_موقع)) {
        لو (!امتداد_كلمة(صنف_كلمة((*الرموز)[البحث]))) {
            أرجع اختيار.بعض(البحث);
        };
        البحث := البحث + 1;
    }
    أرجع اختيار.لا_شيء();
}

// True signifies a break BEFORE الموضع. Implements WB1..WB999,
// including Hebrew quotes, numeric punctuation, emoji ZWJ and RI pairing.
عام عرف حد_كلمة_يونيكود(الرموز: &متجه غ32, الموضع: غير_موقع): اختيار منطقي {
    دع العدد: غير_موقع = الطول(*الرموز) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع اختيار.لا_شيء(); };
    // WB1/WB2: empty text does not have a boundary.
    لو (العدد == 0) { أرجع اختيار.بعض(خطأ); };
    لو (الموضع == 0 || الموضع == العدد) { أرجع اختيار.بعض(صواب); };
    دع السابق_الخام: غ32 = صنف_كلمة((*الرموز)[الموضع - 1]);
    دع التالي_الخام: غ32 = صنف_كلمة((*الرموز)[الموضع]);
    // WB3, WB3a, WB3b
    لو (السابق_الخام == 1 && التالي_الخام == 2) { أرجع اختيار.بعض(خطأ); };
    لو (نهاية_سطر_كلمة(السابق_الخام) || نهاية_سطر_كلمة(التالي_الخام)) {
        أرجع اختيار.بعض(صواب);
    };
    // WB3c: Format/Extend between ZWJ and Extended_Pictographic are
    // ignored under WB4. The ZWJ itself remains significant for WB3c.
    لو (قيمة_نطاق_مرتب(&نطاقات_تصويرية_موسعة, (*الرموز)[الموضع], 0) == 1) {
        دع البحث_الوصلي: متغير غير_موقع = الموضع;
        دع نبحث: متغير منطقي = صواب;
        بينما (البحث_الوصلي > 0 && نبحث) {
            دع الصنف: غ32 = صنف_كلمة((*الرموز)[البحث_الوصلي - 1]);
            لو (الصنف == 4 || الصنف == 5) {
                البحث_الوصلي := البحث_الوصلي - 1;
            } وإلا {
                لو (الصنف == 6) { أرجع اختيار.بعض(خطأ); };
                نبحث := خطأ;
            };
        }
    };
    // WB3d: immediate WSegSpace, before applying the ignored classes.
    لو (السابق_الخام == 7 && التالي_الخام == 7) { أرجع اختيار.بعض(خطأ); };
    // WB4: Extend, Format and ZWJ have no independent word boundary,
    // except that initial ignored runs stay distinct from the first base.
    لو (امتداد_كلمة(التالي_الخام)) { أرجع اختيار.بعض(خطأ); };
    دع السابق_الموضع: غير_موقع;
    طابق سابق_كلمة_مهم(الرموز, الموضع) مع
    | اختيار.بعض(الموجود) -> { السابق_الموضع := الموجود; }
    | _ -> { أرجع اختيار.بعض(صواب); };
    دع أ: غ32 = صنف_كلمة((*الرموز)[السابق_الموضع]);
    دع ب: غ32 = التالي_الخام;
    // WB3d also joins WSegSpace across ignored Extend/Format/ZWJ.
    لو (أ == 7 && ب == 7) { أرجع اختيار.بعض(خطأ); };
    دع أ_السابق: متغير غ32 = 0;
    دع ب_التالي: متغير غ32 = 0;
    طابق سابق_كلمة_مهم(الرموز, السابق_الموضع) مع
    | اختيار.بعض(ف) -> { أ_السابق := صنف_كلمة((*الرموز)[ف]); }
    | _ -> { };
    طابق لاحق_كلمة_مهم(الرموز, الموضع + 1) مع
    | اختيار.بعض(ف) -> { ب_التالي := صنف_كلمة((*الرموز)[ف]); }
    | _ -> { };
    // WB5: AHLetter × AHLetter.
    لو (حرف_كلمة(أ) && حرف_كلمة(ب)) { أرجع اختيار.بعض(خطأ); };
    // WB6..WB7, including MidNumLetQ.
    لو (حرف_كلمة(أ) && وسيط_حرف_كلمة(ب) && حرف_كلمة(ب_التالي)) {
        أرجع اختيار.بعض(خطأ);
    };
    لو (حرف_كلمة(أ_السابق) && وسيط_حرف_كلمة(أ) && حرف_كلمة(ب)) {
        أرجع اختيار.بعض(خطأ);
    };
    // WB7a, WB7b, WB7c
    لو (أ == 9 && ب == 16) { أرجع اختيار.بعض(خطأ); };
    لو (أ == 9 && ب == 17 && ب_التالي == 9) { أرجع اختيار.بعض(خطأ); };
    لو (أ_السابق == 9 && أ == 17 && ب == 9) { أرجع اختيار.بعض(خطأ); };
    // WB8..WB12
    لو (أ == 10 && ب == 10) { أرجع اختيار.بعض(خطأ); };
    لو ((حرف_كلمة(أ) && ب == 10) || (أ == 10 && حرف_كلمة(ب))) {
        أرجع اختيار.بعض(خطأ);
    };
    لو (أ == 10 && وسيط_رقم_كلمة(ب) && ب_التالي == 10) {
        أرجع اختيار.بعض(خطأ);
    };
    لو (أ_السابق == 10 && وسيط_رقم_كلمة(أ) && ب == 10) {
        أرجع اختيار.بعض(خطأ);
    };
    // WB13, WB13a, WB13b
    لو (أ == 11 && ب == 11) { أرجع اختيار.بعض(خطأ); };
    لو ((حرف_أو_رقم_كلمة(أ) || أ == 12) && ب == 12) {
        أرجع اختيار.بعض(خطأ);
    };
    لو (أ == 12 && حرف_أو_رقم_كلمة(ب)) { أرجع اختيار.بعض(خطأ); };
    // WB15/WB16: odd preceding count of significant Regional_Indicator.
    لو (أ == 18 && ب == 18) {
        دع عدد_المؤشرات: متغير غير_موقع = 0;
        دع البحث: متغير غير_موقع = الموضع;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            طابق سابق_كلمة_مهم(الرموز, البحث) مع
            | اختيار.بعض(ف) -> {
                لو (صنف_كلمة((*الرموز)[ف]) == 18) {
                    عدد_المؤشرات := عدد_المؤشرات + 1;
                    البحث := ف;
                } وإلا { مستمر := خطأ; };
            }
            | _ -> { مستمر := خطأ; };
        }
        لو (عدد_المؤشرات % 2 == 1) { أرجع اختيار.بعض(خطأ); };
    };
    أرجع اختيار.بعض(صواب);
}

عام عرف حدود_كلمات_يونيكود(الرموز: &متجه غ32): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع موضع: متغير غير_موقع = 0;
    بينما (موضع <= (الطول(*الرموز) مثل غير_موقع)) {
        طابق حد_كلمة_يونيكود(الرموز, موضع) مع
        | اختيار.بعض(النتيجة) -> { لو (النتيجة) { ألحق(الناتج, موضع); }; }
        | _ -> { };
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

عام عرف حدود_كلمات_بايتات_يونيكود(النص: &نص): نتيجة متجه غير_موقع, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        دع الحدود: متجه غير_موقع = حدود_كلمات_يونيكود(&المراجع.القيم);
        أرجع نتيجة.نجح(حدود_بايتات_من_سلالم(&المراجع, &الحدود));
    };
}
