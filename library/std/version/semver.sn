استورد text.from_bytes;
استورد text.number;

// Semantic Versioning 2.0.0 value. Build metadata does not participate in
// precedence; prerelease identifiers are compared according to SemVer rules.
عام نوع إصدار_دلالي = {
    الرئيسي: طبيعي,
    الثانوي: طبيعي,
    التصحيح: طبيعي,
    قبل_الإصدار: نص,
    البناء: نص
};

عام نوع صنف_خطأ_إصدار_دلالي =
    | فارغ
    | مكون_مفقود بنوع طبيعي
    | محرف_غير_صالح بنوع طبيعي
    | صفر_بادئ بنوع طبيعي
    | مكون_فارغ بنوع طبيعي
    | فائض بنوع طبيعي
;

نوع رقم_إصدار_مقروء = {
    القيمة: طبيعي,
    التالي: طبيعي
};

عرف رقم_أسكي_للإصدار(ب: ط8): منطقي {
    أرجع (ب >= 0x30) && (ب <= 0x39);
}

عرف محرف_معرف_إصدار(ب: ط8): منطقي {
    أرجع رقم_أسكي_للإصدار(ب)
        || ((ب >= 0x41) && (ب <= 0x5A))
        || ((ب >= 0x61) && (ب <= 0x7A))
        || (ب == 0x2D);
}

عرف اقرأ_رقم_إصدار(النص: &نص, البداية: طبيعي): نتيجة رقم_إصدار_مقروء, صنف_خطأ_إصدار_دلالي {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    لو ((البداية >= العدد) || !رقم_أسكي_للإصدار(المصدر[البداية])) {
        أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.مكون_مفقود(البداية));
    };
    دع ف: متغير طبيعي = البداية;
    طالما ((ف < العدد) && رقم_أسكي_للإصدار(المصدر[ف])) { ف := ف + 1; }
    دع طول_الرقم: طبيعي = ف - البداية;
    لو ((طول_الرقم > 1) && (المصدر[البداية] == 0x30)) {
        أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.صفر_بادئ(البداية));
    };
    دع القيمة: متغير طبيعي = 0;
    دع م: متغير طبيعي = البداية;
    دع الحد: طبيعي = 18446744073709551615;
    طالما (م < ف) {
        دع رقم8: ط8 = المصدر[م] - 0x30;
        دع الرقم: طبيعي = رقم8 مثل طبيعي;
        لو (القيمة > ((الحد - الرقم) / 10)) {
            أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.فائض(م));
        };
        القيمة := (القيمة * 10) + الرقم;
        م := م + 1;
    }
    دع الناتج: رقم_إصدار_مقروء = { القيمة: القيمة, التالي: ف };
    أرجع نتيجة.نجح(الناتج);
}

عرف تحقق_معرفات_إصدار(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    امنع_الصفر_البادئ: منطقي
): نتيجة منطقي, صنف_خطأ_إصدار_دلالي {
    لو (البداية >= النهاية) { أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.مكون_فارغ(البداية)); };
    دع المصدر: نص = *النص;
    دع بداية_المكون: متغير طبيعي = البداية;
    دع ف: متغير طبيعي = البداية;
    طالما (ف <= النهاية) {
        دع عند_النهاية: منطقي = ف == النهاية;
        دع عند_النقطة: متغير منطقي = خطأ;
        لو (!عند_النهاية) { عند_النقطة := المصدر[ف] == 0x2E; };
        لو (عند_النهاية || عند_النقطة) {
            لو (ف == بداية_المكون) {
                أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.مكون_فارغ(ف));
            };
            لو (امنع_الصفر_البادئ) {
                دع كلها_أرقام: متغير منطقي = صواب;
                دع ع: متغير طبيعي = بداية_المكون;
                طالما (ع < ف) {
                    لو (!رقم_أسكي_للإصدار(المصدر[ع])) { كلها_أرقام := خطأ; };
                    ع := ع + 1;
                }
                دع طول_المكون: طبيعي = ف - بداية_المكون;
                لو (كلها_أرقام && (طول_المكون > 1) && (المصدر[بداية_المكون] == 0x30)) {
                    أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.صفر_بادئ(بداية_المكون));
                };
            };
            بداية_المكون := ف + 1;
        } وإلا لو (!محرف_معرف_إصدار(المصدر[ف])) {
            أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.محرف_غير_صالح(ف));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف انسخ_نطاق_إصدار(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع المصدر: نص = *النص;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(البايتات, المصدر[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عام عرف حلل_إصدارا_دلاليا(النص: &نص): نتيجة إصدار_دلالي, صنف_خطأ_إصدار_دلالي {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    لو (العدد == 0) { أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.فارغ()); };

    دع الرئيسي: متغير طبيعي = 0;
    دع الثانوي: متغير طبيعي = 0;
    دع التصحيح: متغير طبيعي = 0;
    دع الموضع: متغير طبيعي = 0;

    طابق اقرأ_رقم_إصدار(&المصدر, الموضع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقروء) -> { الرئيسي := المقروء.القيمة; الموضع := المقروء.التالي; };
    لو ((الموضع >= العدد) || (المصدر[الموضع] != 0x2E)) {
        أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.مكون_مفقود(الموضع));
    };
    الموضع := الموضع + 1;

    طابق اقرأ_رقم_إصدار(&المصدر, الموضع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقروء) -> { الثانوي := المقروء.القيمة; الموضع := المقروء.التالي; };
    لو ((الموضع >= العدد) || (المصدر[الموضع] != 0x2E)) {
        أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.مكون_مفقود(الموضع));
    };
    الموضع := الموضع + 1;

    طابق اقرأ_رقم_إصدار(&المصدر, الموضع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقروء) -> { التصحيح := المقروء.القيمة; الموضع := المقروء.التالي; };

    دع قبل: متغير نص = «»;
    دع بناء: متغير نص = «»;
    لو ((الموضع < العدد) && (المصدر[الموضع] == 0x2D)) {
        دع بداية_قبل: طبيعي = الموضع + 1;
        دع نهاية_قبل: متغير طبيعي = بداية_قبل;
        طالما ((نهاية_قبل < العدد) && (المصدر[نهاية_قبل] != 0x2B)) { نهاية_قبل := نهاية_قبل + 1; }
        طابق تحقق_معرفات_إصدار(&المصدر, بداية_قبل, نهاية_قبل, صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        قبل := انسخ_نطاق_إصدار(&المصدر, بداية_قبل, نهاية_قبل);
        الموضع := نهاية_قبل;
    };

    لو ((الموضع < العدد) && (المصدر[الموضع] == 0x2B)) {
        دع بداية_البناء: طبيعي = الموضع + 1;
        طابق تحقق_معرفات_إصدار(&المصدر, بداية_البناء, العدد, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        بناء := انسخ_نطاق_إصدار(&المصدر, بداية_البناء, العدد);
        الموضع := العدد;
    };

    لو (الموضع != العدد) {
        أرجع نتيجة.خطأ(صنف_خطأ_إصدار_دلالي.محرف_غير_صالح(الموضع));
    };

    دع الناتج: إصدار_دلالي = {
        الرئيسي: الرئيسي,
        الثانوي: الثانوي,
        التصحيح: التصحيح,
        قبل_الإصدار: قبل,
        البناء: بناء
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف معرف_رقمي_إصدار(النص: &نص, البداية: طبيعي, النهاية: طبيعي): منطقي {
    دع المصدر: نص = *النص;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        لو (!رقم_أسكي_للإصدار(المصدر[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قارن_معرف_إصدار(
    أ: &نص, بداية_أ: طبيعي, نهاية_أ: طبيعي,
    ب: &نص, بداية_ب: طبيعي, نهاية_ب: طبيعي
): عدد {
    دع رقمي_أ: منطقي = معرف_رقمي_إصدار(أ, بداية_أ, نهاية_أ);
    دع رقمي_ب: منطقي = معرف_رقمي_إصدار(ب, بداية_ب, نهاية_ب);
    لو (رقمي_أ && !رقمي_ب) { أرجع -1; };
    لو (!رقمي_أ && رقمي_ب) { أرجع 1; };
    دع طول_أ: طبيعي = نهاية_أ - بداية_أ;
    دع طول_ب: طبيعي = نهاية_ب - بداية_ب;
    لو (رقمي_أ && رقمي_ب) {
        لو (طول_أ < طول_ب) { أرجع -1; };
        لو (طول_أ > طول_ب) { أرجع 1; };
    };
    دع نص_أ: نص = *أ;
    دع نص_ب: نص = *ب;
    دع الحد: متغير طبيعي = طول_أ;
    لو (طول_ب < الحد) { الحد := طول_ب; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        دع موضع_أ: طبيعي = بداية_أ + ف;
        دع موضع_ب: طبيعي = بداية_ب + ف;
        لو (نص_أ[موضع_أ] < نص_ب[موضع_ب]) { أرجع -1; };
        لو (نص_أ[موضع_أ] > نص_ب[موضع_ب]) { أرجع 1; };
        ف := ف + 1;
    }
    لو (طول_أ < طول_ب) { أرجع -1; };
    لو (طول_أ > طول_ب) { أرجع 1; };
    أرجع 0;
}

عرف قارن_قبل_الإصدار(أ: &نص, ب: &نص): عدد {
    دع نص_أ: نص = *أ;
    دع نص_ب: نص = *ب;
    دع طول_أ: طبيعي = الطول(نص_أ) مثل طبيعي;
    دع طول_ب: طبيعي = الطول(نص_ب) مثل طبيعي;
    لو ((طول_أ == 0) && (طول_ب == 0)) { أرجع 0; };
    لو (طول_أ == 0) { أرجع 1; };
    لو (طول_ب == 0) { أرجع -1; };

    دع بداية_أ: متغير طبيعي = 0;
    دع بداية_ب: متغير طبيعي = 0;
    طالما (صواب) {
        دع نهاية_أ: متغير طبيعي = بداية_أ;
        طالما ((نهاية_أ < طول_أ) && (نص_أ[نهاية_أ] != 0x2E)) { نهاية_أ := نهاية_أ + 1; }
        دع نهاية_ب: متغير طبيعي = بداية_ب;
        طالما ((نهاية_ب < طول_ب) && (نص_ب[نهاية_ب] != 0x2E)) { نهاية_ب := نهاية_ب + 1; }
        دع المقارنة: عدد = قارن_معرف_إصدار(&نص_أ, بداية_أ, نهاية_أ, &نص_ب, بداية_ب, نهاية_ب);
        لو (المقارنة != 0) { أرجع المقارنة; };
        دع انتهى_أ: منطقي = نهاية_أ == طول_أ;
        دع انتهى_ب: منطقي = نهاية_ب == طول_ب;
        لو (انتهى_أ && انتهى_ب) { أرجع 0; };
        لو (انتهى_أ) { أرجع -1; };
        لو (انتهى_ب) { أرجع 1; };
        بداية_أ := نهاية_أ + 1;
        بداية_ب := نهاية_ب + 1;
    }
    أرجع 0;
}

عام عرف قارن_إصدارين_دلاليين(أ: &إصدار_دلالي, ب: &إصدار_دلالي): عدد {
    دع س: إصدار_دلالي = *أ;
    دع ص: إصدار_دلالي = *ب;
    لو (س.الرئيسي < ص.الرئيسي) { أرجع -1; };
    لو (س.الرئيسي > ص.الرئيسي) { أرجع 1; };
    لو (س.الثانوي < ص.الثانوي) { أرجع -1; };
    لو (س.الثانوي > ص.الثانوي) { أرجع 1; };
    لو (س.التصحيح < ص.التصحيح) { أرجع -1; };
    لو (س.التصحيح > ص.التصحيح) { أرجع 1; };
    أرجع قارن_قبل_الإصدار(&س.قبل_الإصدار, &ص.قبل_الإصدار);
}

عام عرف إصداران_دلاليان_متكافئان(أ: &إصدار_دلالي, ب: &إصدار_دلالي): منطقي {
    أرجع قارن_إصدارين_دلاليين(أ, ب) == 0;
}

عام عرف نص_إصدار_دلالي(القيمة: &إصدار_دلالي): نص {
    دع إصدار: إصدار_دلالي = *القيمة;
    دع الرئيسي: نص = uint_to_text(إصدار.الرئيسي);
    دع الثانوي: نص = uint_to_text(إصدار.الثانوي);
    دع التصحيح: نص = uint_to_text(إصدار.التصحيح);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرئيسي) مثل طبيعي)) { ألحق(البايتات, الرئيسي[ف]); ف := ف + 1; }
    ألحق(البايتات, 0x2E);
    ف := 0;
    طالما (ف < (الطول(الثانوي) مثل طبيعي)) { ألحق(البايتات, الثانوي[ف]); ف := ف + 1; }
    ألحق(البايتات, 0x2E);
    ف := 0;
    طالما (ف < (الطول(التصحيح) مثل طبيعي)) { ألحق(البايتات, التصحيح[ف]); ف := ف + 1; }
    لو ((الطول(إصدار.قبل_الإصدار) مثل طبيعي) > 0) {
        ألحق(البايتات, 0x2D);
        ف := 0;
        طالما (ف < (الطول(إصدار.قبل_الإصدار) مثل طبيعي)) { ألحق(البايتات, إصدار.قبل_الإصدار[ف]); ف := ف + 1; }
    };
    لو ((الطول(إصدار.البناء) مثل طبيعي) > 0) {
        ألحق(البايتات, 0x2B);
        ف := 0;
        طالما (ف < (الطول(إصدار.البناء) مثل طبيعي)) { ألحق(البايتات, إصدار.البناء[ف]); ف := ف + 1; }
    };
    أرجع من_بايتات(&البايتات);
}

عام نوع semver = إصدار_دلالي;
عام نوع semver_error_kind = صنف_خطأ_إصدار_دلالي;
عام مرادف parse_semver = حلل_إصدارا_دلاليا;
عام مرادف compare_semver = قارن_إصدارين_دلاليين;
عام مرادف semver_precedence_equal = إصداران_دلاليان_متكافئان;
عام مرادف semver_to_text = نص_إصدار_دلالي;
