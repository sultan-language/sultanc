استورد chars.ascii;
استورد text.compare;
استورد text.from_bytes;

عام نوع نوع_وسائط = {
    النوع: نص,
    النوع_الفرعي: نص
};

عرف نوع_وسائط_جديد(النوع: نص, النوع_الفرعي: نص): نوع_وسائط {
    دع الناتج: نوع_وسائط = { النوع: النوع, النوع_الفرعي: النوع_الفرعي };
    أرجع الناتج;
}

عام عرف نوع_وسائط_افتراضي(): نوع_وسائط {
    أرجع نوع_وسائط_جديد(«application», «octet-stream»);
}

عام عرف نص_نوع_الوسائط(النوع: &نوع_وسائط): نص {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*النوع).النوع) مثل غير_موقع)) {
        ألحق(الناتج, (*النوع).النوع[ف]);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x2F);
    ف := 0;
    بينما (ف < (الطول((*النوع).النوع_الفرعي) مثل غير_موقع)) {
        ألحق(الناتج, (*النوع).النوع_الفرعي[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف امتداد_مقنن(الامتداد: &نص): نص {
    دع البداية: متغير غير_موقع = 0;
    لو (((الطول(*الامتداد) مثل غير_موقع) > 0) && ((*الامتداد)[0] == 0x2E)) {
        البداية := 1;
    };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < (الطول(*الامتداد) مثل غير_موقع)) {
        ألحق(الناتج, إلى_صغير_أسكي((*الامتداد)[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف يساوي_امتداد(الامتداد: &نص, المطلوب: نص): منطقي {
    دع الهدف: نص = المطلوب;
    أرجع نصان_متساويان(الامتداد, &الهدف);
}

عام عرف نوع_وسائط_من_امتداد(الامتداد: &نص): اختيار نوع_وسائط {
    دع ه: نص = امتداد_مقنن(الامتداد);

    لو (يساوي_امتداد(&ه, «html») || يساوي_امتداد(&ه, «htm»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «html»)); };
    لو (يساوي_امتداد(&ه, «css»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «css»)); };
    لو (يساوي_امتداد(&ه, «js») || يساوي_امتداد(&ه, «mjs»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «javascript»)); };
    لو (يساوي_امتداد(&ه, «txt») || يساوي_امتداد(&ه, «log»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «plain»)); };
    لو (يساوي_امتداد(&ه, «csv»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «csv»)); };
    لو (يساوي_امتداد(&ه, «md») || يساوي_امتداد(&ه, «markdown»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«text», «markdown»)); };

    لو (يساوي_امتداد(&ه, «json»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «json»)); };
    لو (يساوي_امتداد(&ه, «jsonld»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «ld+json»)); };
    لو (يساوي_امتداد(&ه, «xml»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «xml»)); };
    لو (يساوي_امتداد(&ه, «pdf»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «pdf»)); };
    لو (يساوي_امتداد(&ه, «wasm»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «wasm»)); };
    لو (يساوي_امتداد(&ه, «zip»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «zip»)); };
    لو (يساوي_امتداد(&ه, «gz») || يساوي_امتداد(&ه, «gzip»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «gzip»)); };
    لو (يساوي_امتداد(&ه, «tar»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «x-tar»)); };
    لو (يساوي_امتداد(&ه, «webmanifest»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«application», «manifest+json»)); };

    لو (يساوي_امتداد(&ه, «png»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «png»)); };
    لو (يساوي_امتداد(&ه, «jpg») || يساوي_امتداد(&ه, «jpeg»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «jpeg»)); };
    لو (يساوي_امتداد(&ه, «gif»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «gif»)); };
    لو (يساوي_امتداد(&ه, «webp»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «webp»)); };
    لو (يساوي_امتداد(&ه, «avif»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «avif»)); };
    لو (يساوي_امتداد(&ه, «svg»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «svg+xml»)); };
    لو (يساوي_امتداد(&ه, «ico»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«image», «vnd.microsoft.icon»)); };

    لو (يساوي_امتداد(&ه, «woff»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«font», «woff»)); };
    لو (يساوي_امتداد(&ه, «woff2»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«font», «woff2»)); };
    لو (يساوي_امتداد(&ه, «ttf»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«font», «ttf»)); };
    لو (يساوي_امتداد(&ه, «otf»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«font», «otf»)); };

    لو (يساوي_امتداد(&ه, «mp3»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«audio», «mpeg»)); };
    لو (يساوي_امتداد(&ه, «oga») || يساوي_امتداد(&ه, «ogg»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«audio», «ogg»)); };
    لو (يساوي_امتداد(&ه, «wav»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«audio», «wav»)); };
    لو (يساوي_امتداد(&ه, «mp4»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«video», «mp4»)); };
    لو (يساوي_امتداد(&ه, «webm»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«video», «webm»)); };
    لو (يساوي_امتداد(&ه, «ogv»)) { أرجع اختيار.بعض(نوع_وسائط_جديد(«video», «ogg»)); };

    أرجع اختيار.لا_شيء();
}

عرف امتداد_من_مسار(المسار: &نص): اختيار نص {
    دع العدد: غير_موقع = الطول(*المسار) مثل غير_موقع;
    لو (العدد == 0) { أرجع اختيار.لا_شيء(); };
    // Ignore URI query/fragment suffixes when this helper is used directly
    // with an HTTP request target rather than a filesystem-only path.
    دع النهاية: متغير غير_موقع = العدد;
    دع م: متغير غير_موقع = 0;
    بينما (م < العدد) {
        دع ب: غ8 = (*المسار)[م];
        لو ((ب == 0x3F) || (ب == 0x23)) { النهاية := م; م := العدد; }
        وإلا { م := م + 1; };
    }
    لو (النهاية == 0) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = النهاية;
    بينما (ف > 0) {
        ف := ف - 1;
        دع ب: غ8 = (*المسار)[ف];
        لو ((ب == 0x2F) || (ب == 0x5C)) { أرجع اختيار.لا_شيء(); };
        لو (ب == 0x2E) {
            لو ((ف + 1) >= النهاية) { أرجع اختيار.لا_شيء(); };
            دع الناتج: متغير متجه غ8 = [];
            دع موضع: متغير غير_موقع = ف + 1;
            بينما (موضع < النهاية) {
                ألحق(الناتج, (*المسار)[موضع]);
                موضع := موضع + 1;
            }
            أرجع اختيار.بعض(من_بايتات(&الناتج));
        };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف نوع_وسائط_من_مسار(المسار: &نص): اختيار نوع_وسائط {
    طابق امتداد_من_مسار(المسار) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الامتداد) -> { أرجع نوع_وسائط_من_امتداد(&الامتداد); };
}

عام عرف نوع_وسائط_لمسار_أو_افتراضي(المسار: &نص): نوع_وسائط {
    طابق نوع_وسائط_من_مسار(المسار) مع
    | اختيار.بعض(النوع) -> { أرجع النوع; }
    | اختيار.لا_شيء -> { أرجع نوع_وسائط_افتراضي(); };
}

عام نوع mime_type = نوع_وسائط;
عام مرادف default_mime_type = نوع_وسائط_افتراضي;
عام مرادف mime_type_text = نص_نوع_الوسائط;
عام مرادف mime_type_from_extension = نوع_وسائط_من_امتداد;
عام مرادف mime_type_from_path = نوع_وسائط_من_مسار;
عام مرادف mime_type_from_path_or_default = نوع_وسائط_لمسار_أو_افتراضي;
