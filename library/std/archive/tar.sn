استورد text.from_bytes;

عرف بايت_تار_عند(المصدر: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*المصدر)[الموضع]; }
عرف بايت_نص_تار_عند(النص: &نص, الموضع: غير_موقع): غ8 { أرجع (*النص)[الموضع]; }
عرف اكتب_بايت_تار(الوجهة: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غ8): فراغ { (*الوجهة)[الموضع] := القيمة; }

// POSIX ustar archive reader/writer. The writer emits 512-byte ustar records
// and the required two zero end records. The reader validates header checksums
// and bounds before materializing entry data. Filesystem extraction is
// intentionally outside this module.

عام نوع نوع_مدخل_تار =
    | ملف_عادي
    | دليل
    | رابط_رمزي
    | رابط_صلب
    | جهاز_محرف
    | جهاز_كتلة
    | فيفو
    | آخر بنوع غ8
;

عام نوع مدخل_تار = {
    المسار: نص,
    النوع: نوع_مدخل_تار,
    البيانات: متجه غ8,
    الرابط: نص,
    النمط: غير_موقع,
    معرف_المستخدم: غير_موقع,
    معرف_المجموعة: غير_موقع,
    وقت_التعديل: غير_موقع
};

عام نوع خطأ_تار =
    | نهاية_غير_متوقعة
    | ترويسة_غير_صالحة
    | مجموع_تحقق_غير_صالح
    | رقم_ثماني_غير_صالح
    | رقم_أكبر_من_الحقل
    | مسار_أطول_من_يوستار
    | رابط_أطول_من_يوستار
    | بيانات_مدخل_ناقصة
;

نوع تقسيم_مسار_تار = {
    بداية_الاسم: غير_موقع,
    طول_الاسم: غير_موقع,
    طول_البادئة: غير_موقع
};

عرف ابن_أصفار_تار(العدد: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, 0);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف كتلة_صفرية_تار(المصدر: &متجه غ8, البداية: غير_موقع): منطقي {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (البداية + 512 > العدد) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 512) {
        لو (بايت_تار_عند(المصدر, البداية + ف) != 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_حقل_نص_تار(
    الترويسة: &متغير متجه غ8,
    البداية: غير_موقع,
    العرض: غير_موقع,
    النص: &نص,
    بداية_النص: غير_موقع,
    طول_النص: غير_موقع
): منطقي {
    لو (طول_النص > العرض) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_النص) {
        اكتب_بايت_تار(الترويسة, البداية + ف, بايت_نص_تار_عند(النص, بداية_النص + ف));
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اكتب_ثمانيا_تار(
    الترويسة: &متغير متجه غ8,
    البداية: غير_موقع,
    العرض: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (العرض < 2) { أرجع خطأ; };
    دع الحالي: متغير غير_موقع = القيمة;
    دع الموضع: متغير غير_موقع = البداية + العرض - 1;
    اكتب_بايت_تار(الترويسة, الموضع, 0);
    دع ف: متغير غير_موقع = الموضع;
    بينما (ف > البداية) {
        ف := ف - 1;
        اكتب_بايت_تار(الترويسة, ف, (0x30 + (الحالي & 7)) مثل غ8);
        الحالي := الحالي >> 3;
    }
    أرجع الحالي == 0;
}

عرف اقرأ_ثمانيا_تار(
    المصدر: &متجه غ8,
    البداية: غير_موقع,
    العرض: غير_موقع
): نتيجة غير_موقع, خطأ_تار {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (البداية + العرض > العدد) { أرجع نتيجة.خطأ(خطأ_تار.نهاية_غير_متوقعة()); };
    لو ((العرض > 0) && ((بايت_تار_عند(المصدر, البداية) & 0x80) != 0)) {
        أرجع نتيجة.خطأ(خطأ_تار.رقم_ثماني_غير_صالح());
    };
    دع القيمة: متغير غير_موقع = 0;
    دع رأى_رقما: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العرض) {
        دع ب: غ8 = بايت_تار_عند(المصدر, البداية + ف);
        لو ((ب == 0) || (ب == 0x20)) {
            // Leading and trailing NUL/space are allowed by common ustar writers.
        } وإلا لو ((ب >= 0x30) && (ب <= 0x37)) {
            رأى_رقما := صواب;
            القيمة := (القيمة << 3) | ((ب - 0x30) مثل غير_موقع);
        } وإلا {
            أرجع نتيجة.خطأ(خطأ_تار.رقم_ثماني_غير_صالح());
        };
        ف := ف + 1;
    }
    لو (!رأى_رقما) { أرجع نتيجة.نجح(0); };
    أرجع نتيجة.نجح(القيمة);
}

عرف اقرأ_نص_حقل_تار(
    المصدر: &متجه غ8,
    البداية: غير_موقع,
    العرض: غير_موقع
): نتيجة نص, خطأ_تار {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (البداية + العرض > العدد) { أرجع نتيجة.خطأ(خطأ_تار.نهاية_غير_متوقعة()); };
    دع النهاية: متغير غير_موقع = البداية;
    بينما ((النهاية < البداية + العرض) && (بايت_تار_عند(المصدر, النهاية) != 0)) {
        النهاية := النهاية + 1;
    }
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        ألحق(البايتات, بايت_تار_عند(المصدر, ف));
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عرف اجمع_ترويسة_تار(المصدر: &متجه غ8, البداية: غير_موقع): غير_موقع {
    دع المجموع: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 512) {
        لو ((ف >= 148) && (ف < 156)) { المجموع := المجموع + 0x20; }
        وإلا { المجموع := المجموع + (بايت_تار_عند(المصدر, البداية + ف) مثل غير_موقع); };
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف قسم_مسار_يوستار(المسار: &نص): نتيجة تقسيم_مسار_تار, خطأ_تار {
    دع العدد: غير_موقع = الطول(*المسار) مثل غير_موقع;
    لو (العدد <= 100) {
        دع الناتج: تقسيم_مسار_تار = { بداية_الاسم: 0, طول_الاسم: العدد, طول_البادئة: 0 };
        أرجع نتيجة.نجح(الناتج);
    };
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 0) {
        ف := ف - 1;
        لو ((*المسار)[ف] == 0x2F) {
            دع طول_البادئة: غير_موقع = ف;
            دع طول_الاسم: غير_موقع = العدد - ف - 1;
            لو ((طول_البادئة <= 155) && (طول_الاسم > 0) && (طول_الاسم <= 100)) {
                دع الناتج: تقسيم_مسار_تار = {
                    بداية_الاسم: ف + 1,
                    طول_الاسم: طول_الاسم,
                    طول_البادئة: طول_البادئة
                };
                أرجع نتيجة.نجح(الناتج);
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_تار.مسار_أطول_من_يوستار());
}

عرف علم_نوع_تار(النوع: &نوع_مدخل_تار): غ8 {
    طابق *النوع مع
    | نوع_مدخل_تار.ملف_عادي -> { أرجع 0x30; }
    | نوع_مدخل_تار.دليل -> { أرجع 0x35; }
    | نوع_مدخل_تار.رابط_رمزي -> { أرجع 0x32; }
    | نوع_مدخل_تار.رابط_صلب -> { أرجع 0x31; }
    | نوع_مدخل_تار.جهاز_محرف -> { أرجع 0x33; }
    | نوع_مدخل_تار.جهاز_كتلة -> { أرجع 0x34; }
    | نوع_مدخل_تار.فيفو -> { أرجع 0x36; }
    | نوع_مدخل_تار.آخر(العلم) -> { أرجع العلم; };
}

عرف نوع_من_علم_تار(العلم: غ8): نوع_مدخل_تار {
    لو ((العلم == 0) || (العلم == 0x30)) { أرجع نوع_مدخل_تار.ملف_عادي(); };
    لو (العلم == 0x35) { أرجع نوع_مدخل_تار.دليل(); };
    لو (العلم == 0x32) { أرجع نوع_مدخل_تار.رابط_رمزي(); };
    لو (العلم == 0x31) { أرجع نوع_مدخل_تار.رابط_صلب(); };
    لو (العلم == 0x33) { أرجع نوع_مدخل_تار.جهاز_محرف(); };
    لو (العلم == 0x34) { أرجع نوع_مدخل_تار.جهاز_كتلة(); };
    لو (العلم == 0x36) { أرجع نوع_مدخل_تار.فيفو(); };
    أرجع نوع_مدخل_تار.آخر(العلم);
}

عرف نوع_يحمل_بيانات_تار(النوع: &نوع_مدخل_تار): منطقي {
    طابق *النوع مع
    | نوع_مدخل_تار.ملف_عادي -> { أرجع صواب; }
    | نوع_مدخل_تار.آخر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف أنشئ_مدخل_ملف_تار(المسار: نص, البيانات: متجه غ8): مدخل_تار {
    دع الناتج: مدخل_تار = {
        المسار: المسار,
        النوع: نوع_مدخل_تار.ملف_عادي(),
        البيانات: البيانات,
        الرابط: «»,
        النمط: 420,
        معرف_المستخدم: 0,
        معرف_المجموعة: 0,
        وقت_التعديل: 0
    };
    أرجع الناتج;
}

عام عرف أنشئ_مدخل_دليل_تار(المسار: نص): مدخل_تار {
    دع البيانات: متجه غ8 = [];
    دع الناتج: مدخل_تار = {
        المسار: المسار,
        النوع: نوع_مدخل_تار.دليل(),
        البيانات: البيانات,
        الرابط: «»,
        النمط: 493,
        معرف_المستخدم: 0,
        معرف_المجموعة: 0,
        وقت_التعديل: 0
    };
    أرجع الناتج;
}

عام عرف أنشئ_مدخل_رابط_رمزي_تار(المسار: نص, الهدف: نص): مدخل_تار {
    دع البيانات: متجه غ8 = [];
    دع الناتج: مدخل_تار = {
        المسار: المسار,
        النوع: نوع_مدخل_تار.رابط_رمزي(),
        البيانات: البيانات,
        الرابط: الهدف,
        النمط: 511,
        معرف_المستخدم: 0,
        معرف_المجموعة: 0,
        وقت_التعديل: 0
    };
    أرجع الناتج;
}

عرف ابن_ترويسة_تار(المدخل: &مدخل_تار): نتيجة متجه غ8, خطأ_تار {
    دع التقسيم: متغير تقسيم_مسار_تار = { بداية_الاسم: 0, طول_الاسم: 0, طول_البادئة: 0 };
    طابق قسم_مسار_يوستار(&(*المدخل).المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ق) -> { التقسيم := ق; };
    لو ((الطول((*المدخل).الرابط) مثل غير_موقع) > 100) {
        أرجع نتيجة.خطأ(خطأ_تار.رابط_أطول_من_يوستار());
    };

    دع الترويسة: متغير متجه غ8 = ابن_أصفار_تار(512);
    لو (!انسخ_حقل_نص_تار(&متغير الترويسة, 0, 100, &(*المدخل).المسار, التقسيم.بداية_الاسم, التقسيم.طول_الاسم)) {
        أرجع نتيجة.خطأ(خطأ_تار.مسار_أطول_من_يوستار());
    };
    لو (التقسيم.طول_البادئة > 0) {
        لو (!انسخ_حقل_نص_تار(&متغير الترويسة, 345, 155, &(*المدخل).المسار, 0, التقسيم.طول_البادئة)) {
            أرجع نتيجة.خطأ(خطأ_تار.مسار_أطول_من_يوستار());
        };
    };

    لو (!اكتب_ثمانيا_تار(&متغير الترويسة, 100, 8, (*المدخل).النمط)) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };
    لو (!اكتب_ثمانيا_تار(&متغير الترويسة, 108, 8, (*المدخل).معرف_المستخدم)) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };
    لو (!اكتب_ثمانيا_تار(&متغير الترويسة, 116, 8, (*المدخل).معرف_المجموعة)) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };
    دع الحجم: متغير غير_موقع = 0;
    لو (نوع_يحمل_بيانات_تار(&(*المدخل).النوع)) { الحجم := الطول((*المدخل).البيانات) مثل غير_موقع; };
    لو (!اكتب_ثمانيا_تار(&متغير الترويسة, 124, 12, الحجم)) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };
    لو (!اكتب_ثمانيا_تار(&متغير الترويسة, 136, 12, (*المدخل).وقت_التعديل)) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };

    دع ف: متغير غير_موقع = 148;
    بينما (ف < 156) { الترويسة[ف] := 0x20; ف := ف + 1; }
    الترويسة[156] := علم_نوع_تار(&(*المدخل).النوع);
    لو (!انسخ_حقل_نص_تار(
        &متغير الترويسة, 157, 100, &(*المدخل).الرابط, 0, الطول((*المدخل).الرابط) مثل غير_موقع
    )) { أرجع نتيجة.خطأ(خطأ_تار.رابط_أطول_من_يوستار()); };

    دع السحر: نص = «ustar»;
    انسخ_حقل_نص_تار(&متغير الترويسة, 257, 5, &السحر, 0, 5);
    الترويسة[262] := 0;
    الترويسة[263] := 0x30;
    الترويسة[264] := 0x30;

    دع المجموع: غير_موقع = اجمع_ترويسة_تار(&الترويسة, 0);
    دع قيمة_المجموع: متغير غير_موقع = المجموع;
    ف := 153;
    بينما (ف >= 148) {
        الترويسة[ف] := (0x30 + (قيمة_المجموع & 7)) مثل غ8;
        قيمة_المجموع := قيمة_المجموع >> 3;
        لو (ف == 148) { ف := 147; } وإلا { ف := ف - 1; };
    }
    لو (قيمة_المجموع != 0) { أرجع نتيجة.خطأ(خطأ_تار.رقم_أكبر_من_الحقل()); };
    الترويسة[154] := 0;
    الترويسة[155] := 0x20;
    أرجع نتيجة.نجح(الترويسة);
}

عام عرف سلسل_أرشيف_تار(المداخل: &متجه مدخل_تار): نتيجة متجه غ8, خطأ_تار {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المداخل) مثل غير_موقع)) {
        دع الترويسة: متغير متجه غ8 = [];
        طابق ابن_ترويسة_تار(&(*المداخل)[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { الترويسة := ق; };
        دع ت: متغير غير_موقع = 0;
        بينما (ت < 512) { ألحق(الناتج, الترويسة[ت]); ت := ت + 1; }

        لو (نوع_يحمل_بيانات_تار(&(*المداخل)[ف].النوع)) {
            ت := 0;
            بينما (ت < (الطول((*المداخل)[ف].البيانات) مثل غير_موقع)) {
                ألحق(الناتج, (*المداخل)[ف].البيانات[ت]);
                ت := ت + 1;
            }
            دع الباقي: غير_موقع = (512 - ((الطول((*المداخل)[ف].البيانات) مثل غير_موقع) % 512)) % 512;
            ت := 0;
            بينما (ت < الباقي) { ألحق(الناتج, 0); ت := ت + 1; }
        };
        ف := ف + 1;
    }
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 1024) { ألحق(الناتج, 0); ت := ت + 1; }
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_مسار_تار(المصدر: &متجه غ8, البداية: غير_موقع, يوستار: منطقي): نتيجة نص, خطأ_تار {
    دع الاسم: متغير نص = «»;
    طابق اقرأ_نص_حقل_تار(المصدر, البداية, 100) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ق) -> { الاسم := ق; };
    لو (!يوستار) { أرجع نتيجة.نجح(الاسم); };
    دع البادئة: متغير نص = «»;
    طابق اقرأ_نص_حقل_تار(المصدر, البداية + 345, 155) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ق) -> { البادئة := ق; };
    لو (الطول(البادئة) == 0) { أرجع نتيجة.نجح(الاسم); };
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(البادئة) مثل غير_موقع)) { ألحق(البايتات, البادئة[ف]); ف := ف + 1; }
    ألحق(البايتات, 0x2F);
    ف := 0;
    بينما (ف < (الطول(الاسم) مثل غير_موقع)) { ألحق(البايتات, الاسم[ف]); ف := ف + 1; }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام عرف حلل_أرشيف_تار(المصدر: &متجه غ8): نتيجة متجه مدخل_تار, خطأ_تار {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    دع المداخل: متغير متجه مدخل_تار = [];

    بينما (الموضع < العدد) {
        لو (الموضع + 512 > العدد) { أرجع نتيجة.خطأ(خطأ_تار.نهاية_غير_متوقعة()); };
        لو (كتلة_صفرية_تار(المصدر, الموضع)) {
            لو ((الموضع + 1024 <= العدد) && !كتلة_صفرية_تار(المصدر, الموضع + 512)) {
                أرجع نتيجة.خطأ(خطأ_تار.ترويسة_غير_صالحة());
            };
            أرجع نتيجة.نجح(المداخل);
        };

        دع المجموع_المطلوب: متغير غير_موقع = 0;
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 148, 8) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { المجموع_المطلوب := ق; };
        دع المجموع_الفعلي: غير_موقع = اجمع_ترويسة_تار(المصدر, الموضع);
        لو (المجموع_الفعلي != المجموع_المطلوب) {
            أرجع نتيجة.خطأ(خطأ_تار.مجموع_تحقق_غير_صالح());
        };

        دع يوستار: منطقي = (بايت_تار_عند(المصدر, الموضع + 257) == 0x75)
            && (بايت_تار_عند(المصدر, الموضع + 258) == 0x73)
            && (بايت_تار_عند(المصدر, الموضع + 259) == 0x74)
            && (بايت_تار_عند(المصدر, الموضع + 260) == 0x61)
            && (بايت_تار_عند(المصدر, الموضع + 261) == 0x72);
        دع المسار: متغير نص = «»;
        طابق اقرأ_مسار_تار(المصدر, الموضع, يوستار) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { المسار := ق; };
        دع الرابط: متغير نص = «»;
        طابق اقرأ_نص_حقل_تار(المصدر, الموضع + 157, 100) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ق) -> { الرابط := ق; };

        دع النمط: متغير غير_موقع = 0;
        دع المستخدم: متغير غير_موقع = 0;
        دع المجموعة: متغير غير_موقع = 0;
        دع الحجم: متغير غير_موقع = 0;
        دع الوقت: متغير غير_موقع = 0;
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 100, 8) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { النمط := ق; };
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 108, 8) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المستخدم := ق; };
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 116, 8) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المجموعة := ق; };
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 124, 12) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { الحجم := ق; };
        طابق اقرأ_ثمانيا_تار(المصدر, الموضع + 136, 12) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { الوقت := ق; };

        دع النوع: نوع_مدخل_تار = نوع_من_علم_تار(بايت_تار_عند(المصدر, الموضع + 156));
        دع بداية_البيانات: غير_موقع = الموضع + 512;
        لو ((الحجم > العدد) || (بداية_البيانات > العدد) || (الحجم > (العدد - بداية_البيانات))) {
            أرجع نتيجة.خطأ(خطأ_تار.بيانات_مدخل_ناقصة());
        };
        دع البيانات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الحجم) {
            ألحق(البيانات, بايت_تار_عند(المصدر, بداية_البيانات + ف));
            ف := ف + 1;
        }
        دع المدخل: مدخل_تار = {
            المسار: المسار,
            النوع: النوع,
            البيانات: البيانات,
            الرابط: الرابط,
            النمط: النمط,
            معرف_المستخدم: المستخدم,
            معرف_المجموعة: المجموعة,
            وقت_التعديل: الوقت
        };
        ألحق(المداخل, المدخل);
        دع المحاذاة: غير_موقع = (512 - (الحجم % 512)) % 512;
        لو (بداية_البيانات + الحجم + المحاذاة > العدد) {
            أرجع نتيجة.خطأ(خطأ_تار.بيانات_مدخل_ناقصة());
        };
        الموضع := بداية_البيانات + الحجم + المحاذاة;
    }

    أرجع نتيجة.خطأ(خطأ_تار.نهاية_غير_متوقعة());
}

عام نوع tar_entry_kind = نوع_مدخل_تار;
عام نوع tar_entry = مدخل_تار;
عام نوع tar_error = خطأ_تار;
عام مرادف new_tar_file = أنشئ_مدخل_ملف_تار;
عام مرادف new_tar_directory = أنشئ_مدخل_دليل_تار;
عام مرادف new_tar_symlink = أنشئ_مدخل_رابط_رمزي_تار;
عام مرادف tar_encode = سلسل_أرشيف_تار;
عام مرادف tar_decode = حلل_أرشيف_تار;
