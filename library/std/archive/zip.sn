استورد bytes.range;
استورد checksum.checksum;
استورد compression.deflate;
استورد encoding.binary;
استورد math.integer;
استورد text.from_bytes;

عرف بايت_زيب_عند(المصدر: &متجه ط8, الموضع: طبيعي): ط8 { أرجع (*المصدر)[الموضع]; }

// The upper bound is exclusive. Subtract before adding any archive offset.
عرف متاح_ضمن_حد_زيب(الموضع: طبيعي, العدد: طبيعي, النهاية: طبيعي): منطقي {
    إذا (الموضع > النهاية) { أرجع خطأ; };
    أرجع العدد <= (النهاية - الموضع);
}

// ZIP32 reader/writer for UTF-8 file entries. It supports stored and raw
// DEFLATE payloads, validates CRC/sizes, and rejects encryption, ZIP64 and
// streaming data-descriptor forms explicitly instead of truncating them.
عام نوع طريقة_ضغط_زيب =
    | بدون_ضغط
    | ديفليت
;

عام نوع مدخل_زيب = {
    الاسم: نص,
    البيانات: متجه ط8,
    الطريقة: طريقة_ضغط_زيب
};

عام نوع خطأ_زيب =
    | صيغة_غير_صالحة
    | غير_مدعوم
    | تجاوز_زيب32
    | تجاوز_حد_الإخراج
    | سي_ار_سي_غير_صالح
    | ديفليت_غير_صالح
;

نوع سجل_مركزي_زيب = {
    الاسم: نص,
    سي_ار_سي: ط32,
    حجم_مضغوط: ط32,
    حجم_أصلي: ط32,
    الطريقة: ط16,
    إزاحة_محلية: ط32
};

عرف بايتات_اسم_زيب(الاسم: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف ألحق_بايتات_زيب(الناتج: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(*الناتج, بايت_زيب_عند(المصدر, ف)); ف := ف + 1; }
}

عرف ط32_من_طبيعي_زيب(القيمة: طبيعي): اختياري ط32 {
    إذا (القيمة > 0xFFFFFFFF) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(القيمة مثل ط32);
}

عرف ط16_من_طبيعي_زيب(القيمة: طبيعي): اختياري ط16 {
    إذا (القيمة > 0xFFFF) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(القيمة مثل ط16);
}

عام عرف أنشئ_مدخل_ملف_زيب(الاسم: نص, البيانات: متجه ط8, اضغط: منطقي): مدخل_زيب {
    دع الطريقة: متغير طريقة_ضغط_زيب = طريقة_ضغط_زيب.بدون_ضغط();
    إذا (اضغط) { الطريقة := طريقة_ضغط_زيب.ديفليت(); };
    دع الناتج: مدخل_زيب = { الاسم: الاسم, البيانات: البيانات, الطريقة: الطريقة };
    أرجع الناتج;
}

عام عرف سلسل_أرشيف_زيب(المداخل: &متجه مدخل_زيب): نتيجة متجه ط8, خطأ_زيب {
    إذا ((الطول(*المداخل) مثل طبيعي) > 0xFFFF) { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
    دع الناتج: متغير متجه ط8 = [];
    دع المركزية: متغير متجه سجل_مركزي_زيب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المداخل) مثل طبيعي)) {
        دع الاسم: متجه ط8 = بايتات_اسم_زيب(&(*المداخل)[ف].الاسم);
        دع طول_الاسم: متغير ط16 = 0;
        طابق ط16_من_طبيعي_زيب(الطول(الاسم) مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); }
        | اختياري.موجود(قيمة) -> { طول_الاسم := قيمة; };
        دع البيانات: متجه ط8 = (*المداخل)[ف].البيانات;
        دع المضغوط: متغير متجه ط8 = البيانات;
        دع الطريقة: متغير ط16 = 0;
        طابق (*المداخل)[ف].الطريقة مع
        | طريقة_ضغط_زيب.بدون_ضغط -> { الطريقة := 0; }
        | طريقة_ضغط_زيب.ديفليت -> { الطريقة := 8; المضغوط := اضغط_ديفليت(&البيانات); };
        دع حجم_أصلي: متغير ط32 = 0; دع حجم_مضغوط: متغير ط32 = 0; دع الإزاحة: متغير ط32 = 0;
        طابق ط32_من_طبيعي_زيب(الطول(البيانات) مثل طبيعي) مع | اختياري.موجود(ق) -> { حجم_أصلي := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        طابق ط32_من_طبيعي_زيب(الطول(المضغوط) مثل طبيعي) مع | اختياري.موجود(ق) -> { حجم_مضغوط := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        طابق ط32_من_طبيعي_زيب(الطول(الناتج) مثل طبيعي) مع | اختياري.موجود(ق) -> { الإزاحة := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        دع سي_ار_سي: ط32 = احسب_سي_ار_سي32(&البيانات);

        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x04034B50);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20); // version needed
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x0800); // UTF-8 names
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, الطريقة);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, سي_ار_سي);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_مضغوط);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_أصلي);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, طول_الاسم);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        ألحق_بايتات_زيب(&متغير الناتج, &الاسم);
        ألحق_بايتات_زيب(&متغير الناتج, &المضغوط);

        دع السجل: سجل_مركزي_زيب = { الاسم: (*المداخل)[ف].الاسم, سي_ار_سي: سي_ار_سي, حجم_مضغوط: حجم_مضغوط, حجم_أصلي: حجم_أصلي, الطريقة: الطريقة, إزاحة_محلية: الإزاحة };
        ألحق(المركزية, السجل);
        ف := ف + 1;
    }
    دع بداية_المركزية: متغير ط32 = 0;
    طابق ط32_من_طبيعي_زيب(الطول(الناتج) مثل طبيعي) مع | اختياري.موجود(ق) -> { بداية_المركزية := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
    ف := 0;
    طالما (ف < (الطول(المركزية) مثل طبيعي)) {
        دع الاسم: متجه ط8 = بايتات_اسم_زيب(&المركزية[ف].الاسم);
        دع طول_الاسم: ط16 = الطول(الاسم) مثل ط16;
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x02014B50);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x0800);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].الطريقة);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].سي_ار_سي);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].حجم_مضغوط);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].حجم_أصلي);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, طول_الاسم);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].إزاحة_محلية);
        ألحق_بايتات_زيب(&متغير الناتج, &الاسم);
        ف := ف + 1;
    }
    دع نهاية_المركزية: طبيعي = الطول(الناتج) مثل طبيعي;
    دع حجم_المركزية: متغير ط32 = 0;
    طابق ط32_من_طبيعي_زيب(نهاية_المركزية - (بداية_المركزية مثل طبيعي)) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); }
    | اختياري.موجود(قيمة) -> { حجم_المركزية := قيمة; };
    دع عدد_المداخل: ط16 = الطول(المركزية) مثل ط16;
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x06054B50);
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, عدد_المداخل); اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, عدد_المداخل);
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_المركزية);
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, بداية_المركزية);
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابحث_نهاية_الدليل_المركزي_لزيب(المصدر: &متجه ط8): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    إذا (العدد < 22) { أرجع اختياري.لا_شيء(); };
    دع أدنى: متغير طبيعي = 0;
    إذا (العدد > 65557) { أدنى := العدد - 65557; };
    دع ف: متغير طبيعي = العدد - 22;
    طالما (صواب) {
        إذا ((بايت_زيب_عند(المصدر, ف) == 0x50) && (بايت_زيب_عند(المصدر, ف + 1) == 0x4B) && (بايت_زيب_عند(المصدر, ف + 2) == 0x05) && (بايت_زيب_عند(المصدر, ف + 3) == 0x06)) { أرجع اختياري.موجود(ف); };
        إذا (ف == أدنى) { أرجع اختياري.لا_شيء(); };
        ف := ف - 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف قيمة_ط16_زيب(المصدر: &متجه ط8, الموضع: طبيعي): اختياري ط16 { أرجع اقرأ_ط16_بالبايت_الأقل_أهمية_أولا(المصدر, الموضع); }
عرف قيمة_ط32_زيب(المصدر: &متجه ط8, الموضع: طبيعي): اختياري ط32 { أرجع اقرأ_ط32_بالبايت_الأقل_أهمية_أولا(المصدر, الموضع); }

عام عرف حلل_أرشيف_زيب_بحد(
    المصدر: &متجه ط8,
    أقصى_حجم_مدخل: طبيعي,
    أقصى_إجمالي: طبيعي
): نتيجة متجه مدخل_زيب, خطأ_زيب {
    دع موضع_نهاية_الدليل_المركزي: متغير طبيعي = 0;
    طابق ابحث_نهاية_الدليل_المركزي_لزيب(المصدر) مع | اختياري.موجود(ق) -> { موضع_نهاية_الدليل_المركزي := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
    // The fixed EOCD record must be available before accessing any of its fields.
    إذا (!متاح_في_البايتات(المصدر, موضع_نهاية_الدليل_المركزي, 22)) {
        أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
    };
    دع عدد_القرص: متغير ط16 = 0; دع قرص_المركزية: متغير ط16 = 0; دع عدد_المداخل: متغير ط16 = 0; دع عدد_كلي: متغير ط16 = 0;
    دع حجم_المركزية: متغير ط32 = 0; دع إزاحة_المركزية: متغير ط32 = 0; دع طول_التعليق: متغير ط16 = 0;
    طابق قيمة_ط16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 4) مع | اختياري.موجود(ق)->{عدد_القرص:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 6) مع | اختياري.موجود(ق)->{قرص_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 8) مع | اختياري.موجود(ق)->{عدد_المداخل:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 10) مع | اختياري.موجود(ق)->{عدد_كلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط32_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 12) مع | اختياري.موجود(ق)->{حجم_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط32_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 16) مع | اختياري.موجود(ق)->{إزاحة_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_ط16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 20) مع | اختياري.موجود(ق)->{طول_التعليق:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    إذا ((عدد_القرص != 0) || (قرص_المركزية != 0) || (عدد_المداخل != عدد_كلي)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
    إذا ((عدد_كلي == 0xFFFF) || (حجم_المركزية == 0xFFFFFFFF) || (إزاحة_المركزية == 0xFFFFFFFF)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
    دع بداية_التعليق: طبيعي = موضع_نهاية_الدليل_المركزي + 22;
    إذا (!متاح_في_البايتات(المصدر, بداية_التعليق, طول_التعليق مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
    };
    دع بداية_المركزية: طبيعي = إزاحة_المركزية مثل طبيعي;
    إذا (!متاح_ضمن_حد_زيب(بداية_المركزية, حجم_المركزية مثل طبيعي, موضع_نهاية_الدليل_المركزي)) {
        أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
    };
    دع نهاية_المركزية: طبيعي = بداية_المركزية + (حجم_المركزية مثل طبيعي);

    دع الناتج: متغير متجه مدخل_زيب = [];
    دع إجمالي: متغير طبيعي = 0;
    دع الموضع: متغير طبيعي = بداية_المركزية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (عدد_كلي مثل طبيعي)) {
        إذا (!متاح_ضمن_حد_زيب(الموضع, 46, نهاية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع التوقيع: متغير ط32 = 0; طابق قيمة_ط32_زيب(المصدر, الموضع) مع | اختياري.موجود(ق)->{التوقيع:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        إذا (التوقيع != 0x02014B50) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع الأعلام: متغير ط16=0; دع الطريقة: متغير ط16=0; دع سي_ار_سي: متغير ط32=0; دع حجم_مضغوط: متغير ط32=0; دع حجم_أصلي: متغير ط32=0;
        دع طول_الاسم: متغير ط16=0; دع طول_الزائد: متغير ط16=0; دع طول_تعليق: متغير ط16=0; دع إزاحة_محلية: متغير ط32=0;
        طابق قيمة_ط16_زيب(المصدر, الموضع+8) مع | اختياري.موجود(ق)->{الأعلام:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر, الموضع+10) مع | اختياري.موجود(ق)->{الطريقة:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر, الموضع+16) مع | اختياري.موجود(ق)->{سي_ار_سي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر, الموضع+20) مع | اختياري.موجود(ق)->{حجم_مضغوط:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر, الموضع+24) مع | اختياري.موجود(ق)->{حجم_أصلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر, الموضع+28) مع | اختياري.موجود(ق)->{طول_الاسم:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر, الموضع+30) مع | اختياري.موجود(ق)->{طول_الزائد:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر, الموضع+32) مع | اختياري.موجود(ق)->{طول_تعليق:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر, الموضع+42) مع | اختياري.موجود(ق)->{إزاحة_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        دع قرص_البداية: متغير ط16 = 0; طابق قيمة_ط16_زيب(المصدر, الموضع+34) مع | اختياري.موجود(ق)->{قرص_البداية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        إذا ((حجم_مضغوط == 0xFFFFFFFF) || (حجم_أصلي == 0xFFFFFFFF) || (إزاحة_محلية == 0xFFFFFFFF) || (قرص_البداية == 0xFFFF)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        إذا (قرص_البداية != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        إذا ((الأعلام & 1) != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        إذا ((الأعلام & 8) != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        إذا ((الطريقة != 0) && (الطريقة != 8)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        إذا ((أقصى_حجم_مدخل > 0) && ((حجم_أصلي مثل طبيعي) > أقصى_حجم_مدخل)) {
            أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_حد_الإخراج());
        };
        دع إجمالي_جديد: متغير طبيعي = 0;
        طابق جمع_طبيعي_متحقق(إجمالي, حجم_أصلي مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_حد_الإخراج()); }
        | اختياري.موجود(قيمة) -> { إجمالي_جديد := قيمة; };
        إذا ((أقصى_إجمالي > 0) && (إجمالي_جديد > أقصى_إجمالي)) {
            أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_حد_الإخراج());
        };
        // Keep variable fields within the declared central-directory extent.
        دع بداية_الاسم: طبيعي = الموضع + 46;
        إذا (!متاح_ضمن_حد_زيب(بداية_الاسم, طول_الاسم مثل طبيعي, نهاية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع بداية_الزائد: طبيعي = بداية_الاسم + (طول_الاسم مثل طبيعي);
        إذا (!متاح_ضمن_حد_زيب(بداية_الزائد, طول_الزائد مثل طبيعي, نهاية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع بداية_تعليق_السجل: طبيعي = بداية_الزائد + (طول_الزائد مثل طبيعي);
        إذا (!متاح_ضمن_حد_زيب(بداية_تعليق_السجل, طول_تعليق مثل طبيعي, نهاية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع نهاية_السجل: طبيعي = بداية_تعليق_السجل + (طول_تعليق مثل طبيعي);
        دع اسم_بايتات: متغير متجه ط8=[]; دع ك: متغير طبيعي=0; طالما (ك < (طول_الاسم مثل طبيعي)) {
            دع موضع_بايت_الاسم: طبيعي = بداية_الاسم + ك;
            ألحق(اسم_بايتات, بايت_زيب_عند(المصدر, موضع_بايت_الاسم));
            ك := ك + 1;
        }
        دع الاسم: نص = من_بايتات(&اسم_بايتات);

        دع محلي: طبيعي = إزاحة_محلية مثل طبيعي;
        إذا (!متاح_ضمن_حد_زيب(محلي, 30, بداية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع توقيع_محلي: متغير ط32=0; طابق قيمة_ط32_زيب(المصدر,محلي) مع | اختياري.موجود(ق)->{توقيع_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        إذا (توقيع_محلي != 0x04034B50) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع أعلام_محلية: متغير ط16=0; دع طريقة_محلية: متغير ط16=0; دع سي_ار_سي_محلي: متغير ط32=0; دع مضغوط_محلي: متغير ط32=0; دع أصلي_محلي: متغير ط32=0;
        دع طول_اسم_محلي: متغير ط16=0; دع زائد_محلي: متغير ط16=0;
        طابق قيمة_ط16_زيب(المصدر,محلي+6) مع | اختياري.موجود(ق)->{أعلام_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر,محلي+8) مع | اختياري.موجود(ق)->{طريقة_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر,محلي+14) مع | اختياري.موجود(ق)->{سي_ار_سي_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر,محلي+18) مع | اختياري.موجود(ق)->{مضغوط_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط32_زيب(المصدر,محلي+22) مع | اختياري.موجود(ق)->{أصلي_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر,محلي+26) مع | اختياري.موجود(ق)->{طول_اسم_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_ط16_زيب(المصدر,محلي+28) مع | اختياري.موجود(ق)->{زائد_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        إذا ((أعلام_محلية != الأعلام) || (طريقة_محلية != الطريقة) || (سي_ار_سي_محلي != سي_ار_سي) || (مضغوط_محلي != حجم_مضغوط) || (أصلي_محلي != حجم_أصلي) || (طول_اسم_محلي != طول_الاسم)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع بداية_الاسم_المحلي: طبيعي = محلي + 30;
        إذا (!متاح_ضمن_حد_زيب(بداية_الاسم_المحلي, طول_اسم_محلي مثل طبيعي, بداية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع بداية_الزائد_المحلي: طبيعي = بداية_الاسم_المحلي + (طول_اسم_محلي مثل طبيعي);
        إذا (!متاح_ضمن_حد_زيب(بداية_الزائد_المحلي, زائد_محلي مثل طبيعي, بداية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع بداية_المضغوط: طبيعي = بداية_الزائد_المحلي + (زائد_محلي مثل طبيعي);
        إذا (!متاح_ضمن_حد_زيب(بداية_المضغوط, حجم_مضغوط مثل طبيعي, بداية_المركزية)) {
            أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
        };
        دع نهاية_المضغوط: طبيعي = بداية_المضغوط + (حجم_مضغوط مثل طبيعي);
        دع ك_اسم: متغير طبيعي = 0;
        طالما (ك_اسم < (طول_الاسم مثل طبيعي)) {
            إذا (بايت_زيب_عند(المصدر, بداية_الاسم_المحلي + ك_اسم) != اسم_بايتات[ك_اسم]) {
                أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());
            };
            ك_اسم := ك_اسم + 1;
        }
        دع مضغوط: متغير متجه ط8 = [];
        ك := بداية_المضغوط;
        طالما (ك < نهاية_المضغوط) {
            ألحق(مضغوط, بايت_زيب_عند(المصدر, ك));
            ك := ك + 1;
        }
        دع البيانات: متغير متجه ط8=[]; دع طريقة_العنصر: متغير طريقة_ضغط_زيب=طريقة_ضغط_زيب.بدون_ضغط();
        إذا (الطريقة == 0) { البيانات := مضغوط; }
        وإلا {
            طريقة_العنصر := طريقة_ضغط_زيب.ديفليت();
            طابق فك_ضغط_ديفليت_بحد(&مضغوط, حجم_أصلي مثل طبيعي) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_زيب.ديفليت_غير_صالح()); }
            | نتيجة.نجح(قيمة) -> { البيانات := قيمة; };
        };
        إذا ((الطول(البيانات) مثل طبيعي) != (حجم_أصلي مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        إذا (احسب_سي_ار_سي32(&البيانات) != سي_ار_سي) { أرجع نتيجة.خطأ(خطأ_زيب.سي_ار_سي_غير_صالح()); };
        دع المدخل: مدخل_زيب={الاسم:الاسم,البيانات:البيانات,الطريقة:طريقة_العنصر}; ألحق(الناتج,المدخل);
        إجمالي := إجمالي_جديد;
        الموضع := نهاية_السجل;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_أرشيف_زيب(المصدر: &متجه ط8): نتيجة متجه مدخل_زيب, خطأ_زيب {
    أرجع حلل_أرشيف_زيب_بحد(المصدر, 0, 0);
}

عام نوع zip_method = طريقة_ضغط_زيب;
عام نوع zip_entry = مدخل_زيب;
عام نوع zip_error = خطأ_زيب;
عام مرادف new_zip_file = أنشئ_مدخل_ملف_زيب;
عام مرادف zip_encode = سلسل_أرشيف_زيب;
عام مرادف zip_decode = حلل_أرشيف_زيب;
عام مرادف zip_decode_limited = حلل_أرشيف_زيب_بحد;
