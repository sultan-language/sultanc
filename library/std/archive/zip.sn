استورد checksum.checksum;
استورد compression.deflate;
استورد encoding.binary;
استورد text.from_bytes;

عرف بايت_زيب_عند(المصدر: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*المصدر)[الموضع]; }

// ZIP32 reader/writer for UTF-8 file entries. It supports stored and raw
// DEFLATE payloads, validates CRC/sizes, and rejects encryption, ZIP64 and
// streaming data-descriptor forms explicitly instead of truncating them.
عام نوع طريقة_ضغط_زيب =
    | بدون_ضغط
    | ديفليت
;

عام نوع مدخل_زيب = {
    الاسم: نص,
    البيانات: متجه غ8,
    الطريقة: طريقة_ضغط_زيب
};

عام نوع خطأ_زيب =
    | صيغة_غير_صالحة
    | غير_مدعوم
    | تجاوز_زيب32
    | تجاوز_حد_الإخراج
    | سي_ار_سي_غير_صالح
    | ديفليت_غير_صالح
;

نوع سجل_مركزي_زيب = {
    الاسم: نص,
    سي_ار_سي: غ32,
    حجم_مضغوط: غ32,
    حجم_أصلي: غ32,
    الطريقة: غ16,
    إزاحة_محلية: غ32
};

عرف بايتات_اسم_زيب(الاسم: &نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف ألحق_بايتات_زيب(الناتج: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) { ألحق(*الناتج, بايت_زيب_عند(المصدر, ف)); ف := ف + 1; }
}

عرف غ32_من_غير_موقع_زيب(القيمة: غير_موقع): اختيار غ32 {
    لو (القيمة > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة مثل غ32);
}

عرف غ16_من_غير_موقع_زيب(القيمة: غير_موقع): اختيار غ16 {
    لو (القيمة > 0xFFFF) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة مثل غ16);
}

عام عرف أنشئ_مدخل_ملف_زيب(الاسم: نص, البيانات: متجه غ8, اضغط: منطقي): مدخل_زيب {
    دع الطريقة: متغير طريقة_ضغط_زيب = طريقة_ضغط_زيب.بدون_ضغط();
    لو (اضغط) { الطريقة := طريقة_ضغط_زيب.ديفليت(); };
    دع الناتج: مدخل_زيب = { الاسم: الاسم, البيانات: البيانات, الطريقة: الطريقة };
    أرجع الناتج;
}

عام عرف سلسل_أرشيف_زيب(المداخل: &متجه مدخل_زيب): نتيجة متجه غ8, خطأ_زيب {
    لو ((الطول(*المداخل) مثل غير_موقع) > 0xFFFF) { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
    دع الناتج: متغير متجه غ8 = [];
    دع المركزية: متغير متجه سجل_مركزي_زيب = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المداخل) مثل غير_موقع)) {
        دع الاسم: متجه غ8 = بايتات_اسم_زيب(&(*المداخل)[ف].الاسم);
        دع طول_الاسم: متغير غ16 = 0;
        طابق غ16_من_غير_موقع_زيب(الطول(الاسم) مثل غير_موقع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); }
        | اختيار.بعض(قيمة) -> { طول_الاسم := قيمة; };
        دع البيانات: متجه غ8 = (*المداخل)[ف].البيانات;
        دع المضغوط: متغير متجه غ8 = البيانات;
        دع الطريقة: متغير غ16 = 0;
        طابق (*المداخل)[ف].الطريقة مع
        | طريقة_ضغط_زيب.بدون_ضغط -> { الطريقة := 0; }
        | طريقة_ضغط_زيب.ديفليت -> { الطريقة := 8; المضغوط := اضغط_ديفليت(&البيانات); };
        دع حجم_أصلي: متغير غ32 = 0; دع حجم_مضغوط: متغير غ32 = 0; دع الإزاحة: متغير غ32 = 0;
        طابق غ32_من_غير_موقع_زيب(الطول(البيانات) مثل غير_موقع) مع | اختيار.بعض(ق) -> { حجم_أصلي := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        طابق غ32_من_غير_موقع_زيب(الطول(المضغوط) مثل غير_موقع) مع | اختيار.بعض(ق) -> { حجم_مضغوط := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        طابق غ32_من_غير_موقع_زيب(الطول(الناتج) مثل غير_موقع) مع | اختيار.بعض(ق) -> { الإزاحة := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
        دع سي_ار_سي: غ32 = احسب_سي_ار_سي32(&البيانات);

        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x04034B50);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20); // version needed
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x0800); // UTF-8 names
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, الطريقة);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, سي_ار_سي);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_مضغوط);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_أصلي);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, طول_الاسم);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        ألحق_بايتات_زيب(&متغير الناتج, &الاسم);
        ألحق_بايتات_زيب(&متغير الناتج, &المضغوط);

        دع السجل: سجل_مركزي_زيب = { الاسم: (*المداخل)[ف].الاسم, سي_ار_سي: سي_ار_سي, حجم_مضغوط: حجم_مضغوط, حجم_أصلي: حجم_أصلي, الطريقة: الطريقة, إزاحة_محلية: الإزاحة };
        ألحق(المركزية, السجل);
        ف := ف + 1;
    }
    دع بداية_المركزية: متغير غ32 = 0;
    طابق غ32_من_غير_موقع_زيب(الطول(الناتج) مثل غير_موقع) مع | اختيار.بعض(ق) -> { بداية_المركزية := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_زيب32()); };
    ف := 0;
    بينما (ف < (الطول(المركزية) مثل غير_موقع)) {
        دع الاسم: متجه غ8 = بايتات_اسم_زيب(&المركزية[ف].الاسم);
        دع طول_الاسم: غ16 = الطول(الاسم) مثل غ16;
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x02014B50);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 20);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x0800);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].الطريقة);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].سي_ار_سي);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].حجم_مضغوط);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].حجم_أصلي);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, طول_الاسم);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
        اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, المركزية[ف].إزاحة_محلية);
        ألحق_بايتات_زيب(&متغير الناتج, &الاسم);
        ف := ف + 1;
    }
    دع نهاية_المركزية: غير_موقع = الطول(الناتج) مثل غير_موقع;
    دع حجم_المركزية: غ32 = (نهاية_المركزية - (بداية_المركزية مثل غير_موقع)) مثل غ32;
    دع عدد_المداخل: غ16 = الطول(المركزية) مثل غ16;
    اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0x06054B50);
    اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
    اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, عدد_المداخل); اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, عدد_المداخل);
    اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, حجم_المركزية);
    اكتب_غ32_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, بداية_المركزية);
    اكتب_غ16_بالبايت_الأقل_أهمية_أولا(&متغير الناتج, 0);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابحث_نهاية_الدليل_المركزي_لزيب(المصدر: &متجه غ8): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (العدد < 22) { أرجع اختيار.لا_شيء(); };
    دع أدنى: متغير غير_موقع = 0;
    لو (العدد > 65557) { أدنى := العدد - 65557; };
    دع ف: متغير غير_موقع = العدد - 22;
    بينما (صواب) {
        لو ((بايت_زيب_عند(المصدر, ف) == 0x50) && (بايت_زيب_عند(المصدر, ف + 1) == 0x4B) && (بايت_زيب_عند(المصدر, ف + 2) == 0x05) && (بايت_زيب_عند(المصدر, ف + 3) == 0x06)) { أرجع اختيار.بعض(ف); };
        لو (ف == أدنى) { أرجع اختيار.لا_شيء(); };
        ف := ف - 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف قيمة_غ16_زيب(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غ16 { أرجع اقرأ_غ16_بالبايت_الأقل_أهمية_أولا(المصدر, الموضع); }
عرف قيمة_غ32_زيب(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غ32 { أرجع اقرأ_غ32_بالبايت_الأقل_أهمية_أولا(المصدر, الموضع); }

عام عرف حلل_أرشيف_زيب_بحد(
    المصدر: &متجه غ8,
    أقصى_حجم_مدخل: غير_موقع,
    أقصى_إجمالي: غير_موقع
): نتيجة متجه مدخل_زيب, خطأ_زيب {
    دع موضع_نهاية_الدليل_المركزي: متغير غير_موقع = 0;
    طابق ابحث_نهاية_الدليل_المركزي_لزيب(المصدر) مع | اختيار.بعض(ق) -> { موضع_نهاية_الدليل_المركزي := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
    دع عدد_القرص: متغير غ16 = 0; دع قرص_المركزية: متغير غ16 = 0; دع عدد_المداخل: متغير غ16 = 0; دع عدد_كلي: متغير غ16 = 0;
    دع حجم_المركزية: متغير غ32 = 0; دع إزاحة_المركزية: متغير غ32 = 0; دع طول_التعليق: متغير غ16 = 0;
    طابق قيمة_غ16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 4) مع | اختيار.بعض(ق)->{عدد_القرص:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 6) مع | اختيار.بعض(ق)->{قرص_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 8) مع | اختيار.بعض(ق)->{عدد_المداخل:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 10) مع | اختيار.بعض(ق)->{عدد_كلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ32_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 12) مع | اختيار.بعض(ق)->{حجم_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ32_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 16) مع | اختيار.بعض(ق)->{إزاحة_المركزية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    طابق قيمة_غ16_زيب(المصدر, موضع_نهاية_الدليل_المركزي + 20) مع | اختيار.بعض(ق)->{طول_التعليق:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
    لو ((عدد_القرص != 0) || (قرص_المركزية != 0) || (عدد_المداخل != عدد_كلي)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
    لو ((عدد_كلي == 0xFFFF) || (حجم_المركزية == 0xFFFFFFFF) || (إزاحة_المركزية == 0xFFFFFFFF)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
    لو ((موضع_نهاية_الدليل_المركزي + 22 + (طول_التعليق مثل غير_موقع)) > (الطول(*المصدر) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
    لو (((إزاحة_المركزية مثل غير_موقع) + (حجم_المركزية مثل غير_موقع)) > موضع_نهاية_الدليل_المركزي) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };

    دع الناتج: متغير متجه مدخل_زيب = [];
    دع إجمالي: متغير غير_موقع = 0;
    دع الموضع: متغير غير_موقع = إزاحة_المركزية مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (عدد_كلي مثل غير_موقع)) {
        دع التوقيع: متغير غ32 = 0; طابق قيمة_غ32_زيب(المصدر, الموضع) مع | اختيار.بعض(ق)->{التوقيع:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        لو (التوقيع != 0x02014B50) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع الأعلام: متغير غ16=0; دع الطريقة: متغير غ16=0; دع سي_ار_سي: متغير غ32=0; دع حجم_مضغوط: متغير غ32=0; دع حجم_أصلي: متغير غ32=0;
        دع طول_الاسم: متغير غ16=0; دع طول_الزائد: متغير غ16=0; دع طول_تعليق: متغير غ16=0; دع إزاحة_محلية: متغير غ32=0;
        طابق قيمة_غ16_زيب(المصدر, الموضع+8) مع | اختيار.بعض(ق)->{الأعلام:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر, الموضع+10) مع | اختيار.بعض(ق)->{الطريقة:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر, الموضع+16) مع | اختيار.بعض(ق)->{سي_ار_سي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر, الموضع+20) مع | اختيار.بعض(ق)->{حجم_مضغوط:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر, الموضع+24) مع | اختيار.بعض(ق)->{حجم_أصلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر, الموضع+28) مع | اختيار.بعض(ق)->{طول_الاسم:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر, الموضع+30) مع | اختيار.بعض(ق)->{طول_الزائد:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر, الموضع+32) مع | اختيار.بعض(ق)->{طول_تعليق:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر, الموضع+42) مع | اختيار.بعض(ق)->{إزاحة_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        دع قرص_البداية: متغير غ16 = 0; طابق قيمة_غ16_زيب(المصدر, الموضع+34) مع | اختيار.بعض(ق)->{قرص_البداية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        لو ((حجم_مضغوط == 0xFFFFFFFF) || (حجم_أصلي == 0xFFFFFFFF) || (إزاحة_محلية == 0xFFFFFFFF) || (قرص_البداية == 0xFFFF)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        لو (قرص_البداية != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        لو ((الأعلام & 1) != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        لو ((الأعلام & 8) != 0) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        لو ((الطريقة != 0) && (الطريقة != 8)) { أرجع نتيجة.خطأ(خطأ_زيب.غير_مدعوم()); };
        لو (((أقصى_حجم_مدخل > 0) && ((حجم_أصلي مثل غير_موقع) > أقصى_حجم_مدخل)) || ((أقصى_إجمالي > 0) && (إجمالي + (حجم_أصلي مثل غير_موقع) > أقصى_إجمالي))) { أرجع نتيجة.خطأ(خطأ_زيب.تجاوز_حد_الإخراج()); };
        دع بداية_الاسم: غير_موقع = الموضع + 46;
        دع نهاية_السجل: غير_موقع = بداية_الاسم + (طول_الاسم مثل غير_موقع) + (طول_الزائد مثل غير_موقع) + (طول_تعليق مثل غير_موقع);
        لو (نهاية_السجل > (الطول(*المصدر) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع اسم_بايتات: متغير متجه غ8=[]; دع ك: متغير غير_موقع=0; بينما (ك < (طول_الاسم مثل غير_موقع)) {
            دع موضع_بايت_الاسم: غير_موقع = بداية_الاسم + ك;
            ألحق(اسم_بايتات, بايت_زيب_عند(المصدر, موضع_بايت_الاسم));
            ك := ك + 1;
        }
        دع الاسم: نص = من_بايتات(&اسم_بايتات);

        دع محلي: غير_موقع = إزاحة_محلية مثل غير_موقع;
        دع توقيع_محلي: متغير غ32=0; طابق قيمة_غ32_زيب(المصدر,محلي) مع | اختيار.بعض(ق)->{توقيع_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        لو (توقيع_محلي != 0x04034B50) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع أعلام_محلية: متغير غ16=0; دع طريقة_محلية: متغير غ16=0; دع سي_ار_سي_محلي: متغير غ32=0; دع مضغوط_محلي: متغير غ32=0; دع أصلي_محلي: متغير غ32=0;
        دع طول_اسم_محلي: متغير غ16=0; دع زائد_محلي: متغير غ16=0;
        طابق قيمة_غ16_زيب(المصدر,محلي+6) مع | اختيار.بعض(ق)->{أعلام_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر,محلي+8) مع | اختيار.بعض(ق)->{طريقة_محلية:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر,محلي+14) مع | اختيار.بعض(ق)->{سي_ار_سي_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر,محلي+18) مع | اختيار.بعض(ق)->{مضغوط_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ32_زيب(المصدر,محلي+22) مع | اختيار.بعض(ق)->{أصلي_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر,محلي+26) مع | اختيار.بعض(ق)->{طول_اسم_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        طابق قيمة_غ16_زيب(المصدر,محلي+28) مع | اختيار.بعض(ق)->{زائد_محلي:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة());};
        لو ((أعلام_محلية != الأعلام) || (طريقة_محلية != الطريقة) || (سي_ار_سي_محلي != سي_ار_سي) || (مضغوط_محلي != حجم_مضغوط) || (أصلي_محلي != حجم_أصلي) || (طول_اسم_محلي != طول_الاسم)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع بداية_المضغوط: غير_موقع = محلي + 30 + (طول_اسم_محلي مثل غير_موقع) + (زائد_محلي مثل غير_موقع);
        لو (بداية_المضغوط > (الطول(*المصدر) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع ك_اسم: متغير غير_موقع = 0;
        بينما (ك_اسم < (طول_الاسم مثل غير_موقع)) { لو (بايت_زيب_عند(المصدر, محلي + 30 + ك_اسم) != اسم_بايتات[ك_اسم]) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); }; ك_اسم := ك_اسم + 1; }
        دع نهاية_المضغوط: غير_موقع = بداية_المضغوط + (حجم_مضغوط مثل غير_موقع);
        لو (نهاية_المضغوط > (الطول(*المصدر) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        دع مضغوط: متغير متجه غ8 = [];
        ك := بداية_المضغوط;
        بينما (ك < نهاية_المضغوط) {
            ألحق(مضغوط, بايت_زيب_عند(المصدر, ك));
            ك := ك + 1;
        }
        دع البيانات: متغير متجه غ8=[]; دع طريقة_العنصر: متغير طريقة_ضغط_زيب=طريقة_ضغط_زيب.بدون_ضغط();
        لو (الطريقة == 0) { البيانات := مضغوط; }
        وإلا {
            طريقة_العنصر := طريقة_ضغط_زيب.ديفليت();
            طابق فك_ضغط_ديفليت_بحد(&مضغوط, حجم_أصلي مثل غير_موقع) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_زيب.ديفليت_غير_صالح()); }
            | نتيجة.نجح(قيمة) -> { البيانات := قيمة; };
        };
        لو ((الطول(البيانات) مثل غير_موقع) != (حجم_أصلي مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_زيب.صيغة_غير_صالحة()); };
        لو (احسب_سي_ار_سي32(&البيانات) != سي_ار_سي) { أرجع نتيجة.خطأ(خطأ_زيب.سي_ار_سي_غير_صالح()); };
        دع المدخل: مدخل_زيب={الاسم:الاسم,البيانات:البيانات,الطريقة:طريقة_العنصر}; ألحق(الناتج,المدخل);
        إجمالي := إجمالي + (حجم_أصلي مثل غير_موقع);
        الموضع := نهاية_السجل;
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_أرشيف_زيب(المصدر: &متجه غ8): نتيجة متجه مدخل_زيب, خطأ_زيب {
    أرجع حلل_أرشيف_زيب_بحد(المصدر, 0, 0);
}

عام نوع zip_method = طريقة_ضغط_زيب;
عام نوع zip_entry = مدخل_زيب;
عام نوع zip_error = خطأ_زيب;
عام مرادف new_zip_file = أنشئ_مدخل_ملف_زيب;
عام مرادف zip_encode = سلسل_أرشيف_زيب;
عام مرادف zip_decode = حلل_أرشيف_زيب;
عام مرادف zip_decode_limited = حلل_أرشيف_زيب_بحد;
