// Generic System V/BSD Unix ar container header decoding. Archive symbol
// selection, thin member resolution and object/link policy stay with consumers.
عام نوع حقيقة_عضو_حاوية_أرشيف = {
    موضع_الرأس: طبيعي,
    موضع_المحتوى: طبيعي,
    الحجم: طبيعي,
    موضع_الرأس_التالي: طبيعي
};

عام عرف ضمن_حدود_حاوية_أرشيف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع حجم_الأرشيف: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > حجم_الأرشيف) {
        أرجع خطأ;
    };
    أرجع الحجم <= (حجم_الأرشيف - الموضع);
}

عام عرف اقرأ_بايت_حاوية_أرشيف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام عرف تحقق_توقيع_حاوية_أرشيف(البايتات: &متجه ط8): منطقي {
    إذا (!ضمن_حدود_حاوية_أرشيف(البايتات, 0, 8)) {
        أرجع خطأ;
    };
    أرجع اقرأ_بايت_حاوية_أرشيف(البايتات, 0) == 0x21
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 1) == 0x3C
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 2) == 0x61
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 3) == 0x72
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 4) == 0x63
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 5) == 0x68
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 6) == 0x3E
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 7) == 0x0A;
}

عام عرف تحقق_توقيع_حاوية_أرشيف_رفيع(البايتات: &متجه ط8): منطقي {
    إذا (!ضمن_حدود_حاوية_أرشيف(البايتات, 0, 8)) {
        أرجع خطأ;
    };
    أرجع اقرأ_بايت_حاوية_أرشيف(البايتات, 0) == 0x21
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 1) == 0x3C
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 2) == 0x74
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 3) == 0x68
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 4) == 0x69
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 5) == 0x6E
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 6) == 0x3E
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 7) == 0x0A;
}

عام عرف تحقق_أي_توقيع_حاوية_أرشيف(البايتات: &متجه ط8): منطقي {
    أرجع تحقق_توقيع_حاوية_أرشيف(البايتات)
        || تحقق_توقيع_حاوية_أرشيف_رفيع(البايتات);
}

عام عرف اقرأ_عدد_عشري_من_حقل_أرشيف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): اختياري طبيعي {
    إذا (!ضمن_حدود_حاوية_أرشيف(البايتات, الموضع, الحجم)) {
        أرجع اختياري.لا_شيء();
    };
    دع القيمة: متغير طبيعي = 0;
    دع وجد_رقما: متغير منطقي = خطأ;
    دع وصل_إلى_فراغ: متغير منطقي = خطأ;
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < الحجم) {
        دع البايت: ط8 = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + فهرس_البايت);
        إذا (البايت == 0x20) {
            وصل_إلى_فراغ := صواب;
        } وإلا {
            إذا (وصل_إلى_فراغ || البايت < 0x30 || البايت > 0x39) {
                أرجع اختياري.لا_شيء();
            };
            وجد_رقما := صواب;
            القيمة := القيمة * 10 + ((البايت - 0x30) مثل طبيعي);
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    إذا (!وجد_رقما) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_رأس_عضو_حاوية_أرشيف(
    البايتات: &متجه ط8,
    موضع_الرأس: طبيعي
): اختياري حقيقة_عضو_حاوية_أرشيف {
    إذا (!ضمن_حدود_حاوية_أرشيف(البايتات, موضع_الرأس, 60)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 58) != 0x60
        || اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 59) != 0x0A) {
        أرجع اختياري.لا_شيء();
    };
    دع حجم_المحتوى: طبيعي;
    طابق اقرأ_عدد_عشري_من_حقل_أرشيف(
        البايتات,
        موضع_الرأس + 48,
        10
    ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحجم) -> { حجم_المحتوى := الحجم; };
    دع موضع_المحتوى: طبيعي = موضع_الرأس + 60;
    دع الحقيقة: حقيقة_عضو_حاوية_أرشيف = {
        موضع_الرأس: موضع_الرأس,
        موضع_المحتوى: موضع_المحتوى,
        الحجم: حجم_المحتوى,
        موضع_الرأس_التالي: موضع_المحتوى
    };
    أرجع اختياري.موجود(الحقيقة);
}

عام عرف اقرأ_حقيقة_عضو_حاوية_أرشيف(
    البايتات: &متجه ط8,
    موضع_الرأس: طبيعي
): اختياري حقيقة_عضو_حاوية_أرشيف {
    إذا (!ضمن_حدود_حاوية_أرشيف(البايتات, موضع_الرأس, 60)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 58) != 0x60
        || اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 59) != 0x0A) {
        أرجع اختياري.لا_شيء();
    };
    دع حجم_المحتوى: طبيعي;
    طابق اقرأ_عدد_عشري_من_حقل_أرشيف(
        البايتات,
        موضع_الرأس + 48,
        10
    ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحجم) -> { حجم_المحتوى := الحجم; };
    دع موضع_المحتوى: طبيعي = موضع_الرأس + 60;
    إذا (!ضمن_حدود_حاوية_أرشيف(
        البايتات,
        موضع_المحتوى,
        حجم_المحتوى
    )) {
        أرجع اختياري.لا_شيء();
    };
    دع الموضع_بعد_المحتوى: طبيعي = موضع_المحتوى + حجم_المحتوى;
    دع الحقيقة: حقيقة_عضو_حاوية_أرشيف = {
        موضع_الرأس: موضع_الرأس,
        موضع_المحتوى: موضع_المحتوى,
        الحجم: حجم_المحتوى,
        موضع_الرأس_التالي:
            الموضع_بعد_المحتوى + (الموضع_بعد_المحتوى % 2)
    };
    أرجع اختياري.موجود(الحقيقة);
}

// English spellings point to the same generic ar declarations.
عام مرادف ar_member_header = حقيقة_عضو_حاوية_أرشيف;
عام مرادف ar_magic_valid = تحقق_توقيع_حاوية_أرشيف;
عام مرادف ar_thin_magic_valid = تحقق_توقيع_حاوية_أرشيف_رفيع;
عام مرادف ar_read_member_header = اقرأ_حقيقة_عضو_حاوية_أرشيف;
عام مرادف ar_read_thin_header = اقرأ_رأس_عضو_حاوية_أرشيف;
