استورد chars.ascii;
استورد text.from_bytes;

عام نوع خطأ_سداسي =
    | طول_فردي
    | محرف_غير_صالح بنوع غير_موقع
;

عرف رقم_سداسي_إلى_بايت(القيمة: غير_موقع, كبير: منطقي): غ8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل غ8; };
    لو (كبير) { أرجع (0x41 + (القيمة - 10)) مثل غ8; };
    أرجع (0x61 + (القيمة - 10)) مثل غ8;
}

عام عرف رمز_سداسي(البايتات: &متجه غ8): نص {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع القيمة: غير_موقع = المصدر[ف] مثل غير_موقع;
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة >> 4, خطأ));
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة & 0x0F, خطأ));
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف رمز_سداسي_كبير(البايتات: &متجه غ8): نص {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع القيمة: غير_موقع = المصدر[ف] مثل غير_موقع;
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة >> 4, صواب));
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة & 0x0F, صواب));
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف فك_سداسي(النص: &نص): نتيجة متجه غ8, خطأ_سداسي {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو ((العدد % 2) != 0) { أرجع نتيجة.خطأ(خطأ_سداسي.طول_فردي()); };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع المصدر: نص = *النص;
        دع العالي: عدد = قيمة_سداسية(المصدر[ف]);
        لو (العالي < 0) { أرجع نتيجة.خطأ(خطأ_سداسي.محرف_غير_صالح(ف)); };
        دع موضع_المنخفض: غير_موقع = ف + 1;
        دع المنخفض: عدد = قيمة_سداسية(المصدر[موضع_المنخفض]);
        لو (المنخفض < 0) { أرجع نتيجة.خطأ(خطأ_سداسي.محرف_غير_صالح(موضع_المنخفض)); };
        ألحق(الناتج, (((العالي مثل غير_موقع) << 4) | (المنخفض مثل غير_موقع)) مثل غ8);
        ف := ف + 2;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام مرادف hex_error = خطأ_سداسي;
عام مرادف hex_encode = رمز_سداسي;
عام مرادف hex_encode_upper = رمز_سداسي_كبير;
عام مرادف hex_decode = فك_سداسي;
عام مرادف hex_error.odd_length = خطأ_سداسي.طول_فردي;
عام مرادف hex_error.invalid_character = خطأ_سداسي.محرف_غير_صالح;
