استورد chars.ascii;
استورد text.from_bytes;

عام نوع خطأ_سداسي =
    | طول_فردي
    | محرف_غير_صالح بنوع طبيعي
;

عرف رقم_سداسي_إلى_بايت(القيمة: طبيعي, كبير: منطقي): ط8 {
    إذا (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    إذا (كبير) { أرجع (0x41 + (القيمة - 10)) مثل ط8; };
    أرجع (0x61 + (القيمة - 10)) مثل ط8;
}

عام عرف رمز_سداسي(البايتات: &متجه ط8): نص {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع القيمة: طبيعي = المصدر[ف] مثل طبيعي;
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة >> 4, خطأ));
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة & 0x0F, خطأ));
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف رمز_سداسي_كبير(البايتات: &متجه ط8): نص {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع القيمة: طبيعي = المصدر[ف] مثل طبيعي;
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة >> 4, صواب));
        ألحق(الناتج, رقم_سداسي_إلى_بايت(القيمة & 0x0F, صواب));
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف فك_سداسي(النص: &نص): نتيجة متجه ط8, خطأ_سداسي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا ((العدد % 2) != 0) { أرجع نتيجة.خطأ(خطأ_سداسي.طول_فردي()); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع المصدر: نص = *النص;
        دع العالي: عدد = قيمة_سداسية(المصدر[ف]);
        إذا (العالي < 0) { أرجع نتيجة.خطأ(خطأ_سداسي.محرف_غير_صالح(ف)); };
        دع موضع_المنخفض: طبيعي = ف + 1;
        دع المنخفض: عدد = قيمة_سداسية(المصدر[موضع_المنخفض]);
        إذا (المنخفض < 0) { أرجع نتيجة.خطأ(خطأ_سداسي.محرف_غير_صالح(موضع_المنخفض)); };
        ألحق(الناتج, (((العالي مثل طبيعي) << 4) | (المنخفض مثل طبيعي)) مثل ط8);
        ف := ف + 2;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام مرادف hex_error = خطأ_سداسي;
عام مرادف hex_encode = رمز_سداسي;
عام مرادف hex_encode_upper = رمز_سداسي_كبير;
عام مرادف hex_decode = فك_سداسي;
عام مرادف hex_error.odd_length = خطأ_سداسي.طول_فردي;
عام مرادف hex_error.invalid_character = خطأ_سداسي.محرف_غير_صالح;
