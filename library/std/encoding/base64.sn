استورد text.from_bytes;

عام نوع خطأ_قاعدة64 =
    | طول_غير_صالح
    | محرف_غير_صالح بنوع غير_موقع
    | حشو_غير_صالح بنوع غير_موقع
;

عرف محرف_قاعدة64(القيمة: غير_موقع): غ8 {
    لو (القيمة < 26) { أرجع (0x41 + القيمة) مثل غ8; };
    لو (القيمة < 52) { أرجع (0x61 + القيمة - 26) مثل غ8; };
    لو (القيمة < 62) { أرجع (0x30 + القيمة - 52) مثل غ8; };
    لو (القيمة == 62) { أرجع 0x2B; };
    أرجع 0x2F;
}

عرف قيمة_قاعدة64(البايت: غ8): عدد {
    لو ((البايت >= 0x41) && (البايت <= 0x5A)) { أرجع (البايت - 0x41) مثل عدد; };
    لو ((البايت >= 0x61) && (البايت <= 0x7A)) { أرجع ((البايت - 0x61) + 26) مثل عدد; };
    لو ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع ((البايت - 0x30) + 52) مثل عدد; };
    لو (البايت == 0x2B) { أرجع 62; };
    لو (البايت == 0x2F) { أرجع 63; };
    أرجع -1;
}

عام عرف رمز_قاعدة64(البايتات: &متجه غ8): نص {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما ((ف + 3) <= العدد) {
        دع ف1: غير_موقع = ف + 1;
        دع ف2: غير_موقع = ف + 2;
        دع أ: غير_موقع = المصدر[ف] مثل غير_موقع;
        دع ب: غير_موقع = المصدر[ف1] مثل غير_موقع;
        دع ج: غير_موقع = المصدر[ف2] مثل غير_موقع;
        دع القيمة: متغير غير_موقع = أ << 16;
        القيمة := القيمة | (ب << 8);
        القيمة := القيمة | ج;
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 6) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64(القيمة & 0x3F));
        ف := ف + 3;
    }
    دع الباقي: غير_موقع = العدد - ف;
    لو (الباقي == 1) {
        دع أ: غير_موقع = المصدر[ف] مثل غير_موقع;
        دع القيمة: غير_موقع = أ << 16;
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق(الناتج, 0x3D);
        ألحق(الناتج, 0x3D);
    } وإلا لو (الباقي == 2) {
        دع ف1: غير_موقع = ف + 1;
        دع أ: غير_موقع = المصدر[ف] مثل غير_موقع;
        دع ب: غير_موقع = المصدر[ف1] مثل غير_موقع;
        دع القيمة: متغير غير_موقع = أ << 16;
        القيمة := القيمة | (ب << 8);
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 6) & 0x3F));
        ألحق(الناتج, 0x3D);
    };
    أرجع من_بايتات(&الناتج);
}

عرف قيمة_قاعدة64_أو_خطأ(المصدر: &نص, الموضع: غير_موقع): نتيجة غير_موقع, خطأ_قاعدة64 {
    دع النص: نص = *المصدر;
    دع القيمة: عدد = قيمة_قاعدة64(النص[الموضع]);
    لو (القيمة < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة64.محرف_غير_صالح(الموضع)); };
    أرجع نتيجة.نجح(القيمة مثل غير_موقع);
}

عام عرف فك_قاعدة64(النص: &نص): نتيجة متجه غ8, خطأ_قاعدة64 {
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو ((العدد % 4) != 0) { أرجع نتيجة.خطأ(خطأ_قاعدة64.طول_غير_صالح()); };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ف1: غير_موقع = ف + 1;
        دع ف2: غير_موقع = ف + 2;
        دع ف3: غير_موقع = ف + 3;
        دع ف4: غير_موقع = ف + 4;
        دع الأخير: منطقي = ف4 == العدد;
        لو ((المصدر[ف] == 0x3D) || (المصدر[ف1] == 0x3D)) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف));
        };
        دع أ: غير_موقع;
        دع ب: غير_موقع;
        طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أ := القيمة; };
        طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف1) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ب := القيمة; };

        دع الثالث_حشو: منطقي = المصدر[ف2] == 0x3D;
        دع الرابع_حشو: منطقي = المصدر[ف3] == 0x3D;
        لو ((الثالث_حشو || الرابع_حشو) && !الأخير) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2));
        };
        لو (الثالث_حشو && !الرابع_حشو) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2));
        };

        دع ج: متغير غير_موقع = 0;
        دع د: متغير غير_موقع = 0;
        لو (!الثالث_حشو) {
            طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف2) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { ج := القيمة; };
        };
        لو (!الرابع_حشو) {
            طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف3) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { د := القيمة; };
        };

        دع القيمة: متغير غير_موقع = أ << 18;
        القيمة := القيمة | (ب << 12);
        القيمة := القيمة | (ج << 6);
        القيمة := القيمة | د;
        ألحق(الناتج, ((القيمة >> 16) & 0xFF) مثل غ8);
        لو (!الثالث_حشو) { ألحق(الناتج, ((القيمة >> 8) & 0xFF) مثل غ8); };
        لو (!الرابع_حشو) { ألحق(الناتج, (القيمة & 0xFF) مثل غ8); };

        // الحشو القانوني يجب أن يحمل بتات صفرية في الجزء غير المستخدم.
        لو (الثالث_حشو && ((ب & 0x0F) != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف1)); };
        لو (الرابع_حشو && !الثالث_حشو && ((ج & 0x03) != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2)); };
        ف := ف + 4;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام مرادف base64_error = خطأ_قاعدة64;
عام مرادف base64_encode = رمز_قاعدة64;
عام مرادف base64_decode = فك_قاعدة64;
عام مرادف base64_error.invalid_length = خطأ_قاعدة64.طول_غير_صالح;
عام مرادف base64_error.invalid_character = خطأ_قاعدة64.محرف_غير_صالح;
عام مرادف base64_error.invalid_padding = خطأ_قاعدة64.حشو_غير_صالح;

// RFC 4648 base64url. Encoding omits padding; decoding accepts canonical
// padded or unpadded base64url and rejects the ordinary '+'/'/' alphabet.
عام عرف رمز_قاعدة64_عنوانية(البايتات: &متجه غ8): نص {
    دع العادي: نص = رمز_قاعدة64(البايتات);
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(العادي) مثل غير_موقع)) {
        دع ب: غ8 = العادي[ف];
        لو (ب == 0x3D) { ف := الطول(العادي) مثل غير_موقع; }
        وإلا {
            لو (ب == 0x2B) { ألحق(الناتج, 0x2D); }
            وإلا لو (ب == 0x2F) { ألحق(الناتج, 0x5F); }
            وإلا { ألحق(الناتج, ب); };
            ف := ف + 1;
        };
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف فك_قاعدة64_عنوانية(النص: &نص): نتيجة متجه غ8, خطأ_قاعدة64 {
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع الباقي: غير_موقع = العدد % 4;
    لو (الباقي == 1) { أرجع نتيجة.خطأ(خطأ_قاعدة64.طول_غير_صالح()); };
    دع العادي_بايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ب: غ8 = المصدر[ف];
        لو ((ب == 0x2B) || (ب == 0x2F)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.محرف_غير_صالح(ف)); };
        لو (ب == 0x2D) { ألحق(العادي_بايتات, 0x2B); }
        وإلا لو (ب == 0x5F) { ألحق(العادي_بايتات, 0x2F); }
        وإلا { ألحق(العادي_بايتات, ب); };
        ف := ف + 1;
    }
    لو (الباقي == 2) { ألحق(العادي_بايتات, 0x3D); ألحق(العادي_بايتات, 0x3D); }
    وإلا لو (الباقي == 3) { ألحق(العادي_بايتات, 0x3D); };
    دع العادي: نص = من_بايتات(&العادي_بايتات);
    أرجع فك_قاعدة64(&العادي);
}

عام مرادف base64url_encode = رمز_قاعدة64_عنوانية;
عام مرادف base64url_decode = فك_قاعدة64_عنوانية;
