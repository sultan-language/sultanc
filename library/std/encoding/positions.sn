استورد encoding.utf8;

عام نوع خطأ_موضع_يونيكود =
    | يوتيف8_غير_صالح بنوع غير_موقع
    | إزاحة_خارج_النطاق
    | ليست_حد_محرف
    | عمود_يوتيف16_داخل_زوج_بديل
;

عام نوع فهرس_سطور = {
    البدايات: متجه غير_موقع,
    طول_النص: غير_موقع
};

عام نوع موضع_نصي_يوتيف16 = {
    السطر: غير_موقع,
    العمود: غير_موقع
};

عام عرف تحقق_يوتيف8(النص: &نص): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع ف: متغير غير_موقع = 0;
    دع المحارف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف));
        };
        ف := ف + المفكوك.العرض;
        المحارف := المحارف + 1;
    }
    أرجع نتيجة.نجح(المحارف);
}

عام عرف إزاحة_بايت_إلى_موضع_محرف(النص: &نص, الإزاحة: غير_موقع): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (الإزاحة > العدد) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    دع ف: متغير غير_موقع = 0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (ف < الإزاحة) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        لو ((ف + المفكوك.العرض) > الإزاحة) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف()); };
        ف := ف + المفكوك.العرض;
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(الموضع);
}

عام عرف موضع_محرف_إلى_إزاحة_بايت(النص: &نص, الموضع: غير_موقع): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع ف: متغير غير_موقع = 0;
    دع الحالي: متغير غير_موقع = 0;
    بينما ((ف < (الطول(القيمة) مثل غير_موقع)) && (الحالي < الموضع)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        ف := ف + المفكوك.العرض;
        الحالي := الحالي + 1;
    }
    لو (الحالي != الموضع) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    أرجع نتيجة.نجح(ف);
}

عام عرف ابن_فهرس_السطور(النص: &نص): فهرس_سطور {
    دع القيمة: نص = *النص;
    دع البدايات: متغير متجه غير_موقع = [];
    ألحق(البدايات, 0);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (القيمة[ف] == 10) { ألحق(البدايات, ف + 1); };
        ف := ف + 1;
    }
    دع طول_النص: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع الناتج: فهرس_سطور = { البدايات: البدايات, طول_النص: طول_النص };
    أرجع الناتج;
}

عام عرف بداية_السطر(الفهرس: &فهرس_سطور, السطر: غير_موقع): اختيار غير_موقع {
    دع القيمة: فهرس_سطور = *الفهرس;
    لو (السطر >= (الطول(القيمة.البدايات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة.البدايات[السطر]);
}

عام عرف سطر_الإزاحة(الفهرس: &فهرس_سطور, الإزاحة: غير_موقع): اختيار غير_موقع {
    دع القيمة: فهرس_سطور = *الفهرس;
    لو (الإزاحة > القيمة.طول_النص) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = الطول(القيمة.البدايات) مثل غير_موقع;
    لو (العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = العدد;
    بينما ((البداية + 1) < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو (القيمة.البدايات[الوسط] <= الإزاحة) {
            البداية := الوسط;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختيار.بعض(البداية);
}

عام عرف إزاحة_بايت_إلى_عمود_يوتيف16(
    النص: &نص,
    بداية: غير_موقع,
    الإزاحة: غير_موقع
): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو ((بداية > الإزاحة) || (الإزاحة > العدد)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    دع ف: متغير غير_موقع = بداية;
    دع العمود: متغير غير_موقع = 0;
    بينما (ف < الإزاحة) {
        لو (القيمة[ف] == 10) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        لو ((ف + المفكوك.العرض) > الإزاحة) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف()); };
        لو (المفكوك.القيمة > 0xFFFF) { العمود := العمود + 2; } وإلا { العمود := العمود + 1; };
        ف := ف + المفكوك.العرض;
    }
    أرجع نتيجة.نجح(العمود);
}

عام عرف عمود_يوتيف16_إلى_إزاحة_بايت(
    النص: &نص,
    بداية: غير_موقع,
    العمود: غير_موقع
): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (بداية > العدد) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    دع ف: متغير غير_موقع = بداية;
    دع الحالي: متغير غير_موقع = 0;
    بينما ((ف < العدد) && (الحالي < العمود) && (القيمة[ف] != 10)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        دع العرض16: متغير غير_موقع = 1;
        لو (المفكوك.القيمة > 0xFFFF) { العرض16 := 2; };
        لو ((الحالي + العرض16) > العمود) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.عمود_يوتيف16_داخل_زوج_بديل()); };
        الحالي := الحالي + العرض16;
        ف := ف + المفكوك.العرض;
    }
    لو (الحالي != العمود) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    أرجع نتيجة.نجح(ف);
}


عام عرف إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الإزاحة: غير_موقع
): نتيجة موضع_نصي_يوتيف16, خطأ_موضع_يونيكود {
    دع السطر: متغير غير_موقع = 0;
    طابق سطر_الإزاحة(الفهرس, الإزاحة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختيار.بعض(القيمة) -> { السطر := القيمة; };
    دع البداية: متغير غير_موقع = 0;
    طابق بداية_السطر(الفهرس, السطر) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختيار.بعض(القيمة) -> { البداية := القيمة; };
    طابق إزاحة_بايت_إلى_عمود_يوتيف16(النص, البداية, الإزاحة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العمود) -> {
        دع الموضع: موضع_نصي_يوتيف16 = { السطر: السطر, العمود: العمود };
        أرجع نتيجة.نجح(الموضع);
    };
}

عام عرف موضع_نصي_يوتيف16_إلى_إزاحة_بايت(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الموضع: &موضع_نصي_يوتيف16
): نتيجة غير_موقع, خطأ_موضع_يونيكود {
    دع القيمة: موضع_نصي_يوتيف16 = *الموضع;
    طابق بداية_السطر(الفهرس, القيمة.السطر) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختيار.بعض(البداية) -> {
        أرجع عمود_يوتيف16_إلى_إزاحة_بايت(النص, البداية, القيمة.العمود);
    };
}

عام مرادف unicode_position_error = خطأ_موضع_يونيكود;
عام مرادف line_index = فهرس_سطور;
عام مرادف utf16_text_position = موضع_نصي_يوتيف16;
عام مرادف utf8_byte_offset_to_utf16_position = إزاحة_بايت_إلى_موضع_نصي_يوتيف16;
عام مرادف utf16_position_to_utf8_byte_offset = موضع_نصي_يوتيف16_إلى_إزاحة_بايت;
عام مرادف validate_utf8 = تحقق_يوتيف8;
عام مرادف utf8_byte_offset_to_codepoint_index = إزاحة_بايت_إلى_موضع_محرف;
عام مرادف utf8_codepoint_index_to_byte_offset = موضع_محرف_إلى_إزاحة_بايت;
عام مرادف build_line_index = ابن_فهرس_السطور;
عام مرادف line_start = بداية_السطر;
عام مرادف line_for_offset = سطر_الإزاحة;
عام مرادف utf8_byte_offset_to_utf16_column = إزاحة_بايت_إلى_عمود_يوتيف16;
عام مرادف utf16_column_to_utf8_byte_offset = عمود_يوتيف16_إلى_إزاحة_بايت;
عام مرادف unicode_position_error.invalid_utf8 = خطأ_موضع_يونيكود.يوتيف8_غير_صالح;
عام مرادف unicode_position_error.out_of_range = خطأ_موضع_يونيكود.إزاحة_خارج_النطاق;
عام مرادف unicode_position_error.not_character_boundary = خطأ_موضع_يونيكود.ليست_حد_محرف;
عام مرادف unicode_position_error.utf16_inside_surrogate_pair = خطأ_موضع_يونيكود.عمود_يوتيف16_داخل_زوج_بديل;
