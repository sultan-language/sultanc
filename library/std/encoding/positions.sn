استورد encoding.utf8;

عام نوع خطأ_موضع_يونيكود =
    | يوتيف8_غير_صالح بنوع طبيعي
    | إزاحة_خارج_النطاق
    | ليست_حد_محرف
    | عمود_يوتيف16_داخل_زوج_بديل
;

عام نوع فهرس_سطور = {
    البدايات: متجه طبيعي,
    طول_النص: طبيعي
};

عام نوع موضع_نصي_يوتيف16 = {
    السطر: طبيعي,
    العمود: طبيعي
};

عام عرف تحقق_يوتيف8(النص: &نص): نتيجة طبيعي, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = 0;
    دع المحارف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف));
        };
        ف := ف + المفكوك.العرض;
        المحارف := المحارف + 1;
    }
    أرجع نتيجة.نجح(المحارف);
}

عام عرف إزاحة_بايت_إلى_موضع_محرف(النص: &نص, الإزاحة: طبيعي): نتيجة طبيعي, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا (الإزاحة > العدد) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    دع ف: متغير طبيعي = 0;
    دع الموضع: متغير طبيعي = 0;
    طالما (ف < الإزاحة) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        إذا ((ف + المفكوك.العرض) > الإزاحة) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف()); };
        ف := ف + المفكوك.العرض;
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(الموضع);
}

عام عرف موضع_محرف_إلى_إزاحة_بايت(النص: &نص, الموضع: طبيعي): نتيجة طبيعي, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = 0;
    دع الحالي: متغير طبيعي = 0;
    طالما ((ف < (الطول(القيمة) مثل طبيعي)) && (الحالي < الموضع)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        ف := ف + المفكوك.العرض;
        الحالي := الحالي + 1;
    }
    إذا (الحالي != الموضع) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    أرجع نتيجة.نجح(ف);
}

// The one line-break rule (LSP's, as compiler diagnostics and the lexer
// use it): "\n", "\r\n" and a lone "\r" each end a line; "\r\n" is one
// break, the next line starting after its "\n".
عام عرف هل_نهاية_سطر_عند(النص: &نص, الموضع: طبيعي): منطقي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (الموضع >= العدد) { أرجع خطأ; };
    دع البايت: ط8 = (*النص)[الموضع];
    إذا (البايت == 10) { أرجع صواب; };
    إذا (البايت != 13) { أرجع خطأ; };
    // CR ends a line unless an LF follows: then the LF ends it.
    أرجع (الموضع + 1 >= العدد) || ((*النص)[الموضع + 1] != 10);
}

عام عرف ابن_فهرس_السطور(النص: &نص): فهرس_سطور {
    دع البدايات: متغير متجه طبيعي = [];
    ألحق(البدايات, 0);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        إذا (هل_نهاية_سطر_عند(النص, ف)) { ألحق(البدايات, ف + 1); };
        ف := ف + 1;
    }
    دع طول_النص: طبيعي = الطول(*النص) مثل طبيعي;
    دع الناتج: فهرس_سطور = { البدايات: البدايات, طول_النص: طول_النص };
    أرجع الناتج;
}

عام عرف بداية_السطر(الفهرس: &فهرس_سطور, السطر: طبيعي): اختياري طبيعي {
    دع القيمة: فهرس_سطور = *الفهرس;
    إذا (السطر >= (الطول(القيمة.البدايات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(القيمة.البدايات[السطر]);
}

عام عرف سطر_الإزاحة(الفهرس: &فهرس_سطور, الإزاحة: طبيعي): اختياري طبيعي {
    دع القيمة: فهرس_سطور = *الفهرس;
    إذا (الإزاحة > القيمة.طول_النص) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = الطول(القيمة.البدايات) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = العدد;
    طالما ((البداية + 1) < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا (القيمة.البدايات[الوسط] <= الإزاحة) {
            البداية := الوسط;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختياري.موجود(البداية);
}

عام عرف إزاحة_بايت_إلى_عمود_يوتيف16(
    النص: &نص,
    بداية: طبيعي,
    الإزاحة: طبيعي
): نتيجة طبيعي, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا ((بداية > الإزاحة) || (الإزاحة > العدد)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    إذا ((بداية < العدد) && بايت_استمرار_يوتيف8(القيمة[بداية])) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف());
    };
    دع ف: متغير طبيعي = بداية;
    دع العمود: متغير طبيعي = 0;
    طالما (ف < الإزاحة) {
        إذا (القيمة[ف] == 10) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        إذا ((ف + المفكوك.العرض) > الإزاحة) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف()); };
        إذا (المفكوك.القيمة > 0xFFFF) { العمود := العمود + 2; } وإلا { العمود := العمود + 1; };
        ف := ف + المفكوك.العرض;
    }
    أرجع نتيجة.نجح(العمود);
}

عام عرف عمود_يوتيف16_إلى_إزاحة_بايت(
    النص: &نص,
    بداية: طبيعي,
    العمود: طبيعي
): نتيجة طبيعي, خطأ_موضع_يونيكود {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا (بداية > العدد) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    إذا ((بداية < العدد) && بايت_استمرار_يوتيف8(القيمة[بداية])) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.ليست_حد_محرف());
    };
    دع ف: متغير طبيعي = بداية;
    دع الحالي: متغير طبيعي = 0;
    طالما ((ف < العدد) && (الحالي < العمود) && (القيمة[ف] != 10)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, ف);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.يوتيف8_غير_صالح(ف)); };
        دع العرض16: متغير طبيعي = 1;
        إذا (المفكوك.القيمة > 0xFFFF) { العرض16 := 2; };
        إذا ((الحالي + العرض16) > العمود) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.عمود_يوتيف16_داخل_زوج_بديل()); };
        الحالي := الحالي + العرض16;
        ف := ف + المفكوك.العرض;
    }
    إذا (الحالي != العمود) { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); };
    أرجع نتيجة.نجح(ف);
}


عام عرف إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): نتيجة موضع_نصي_يوتيف16, خطأ_موضع_يونيكود {
    إذا ((*الفهرس).طول_النص != (الطول(*النص) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق());
    };
    دع السطر: متغير طبيعي = 0;
    طابق سطر_الإزاحة(الفهرس, الإزاحة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(القيمة) -> { السطر := القيمة; };
    دع البداية: متغير طبيعي = 0;
    طابق بداية_السطر(الفهرس, السطر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(القيمة) -> { البداية := القيمة; };
    طابق إزاحة_بايت_إلى_عمود_يوتيف16(النص, البداية, الإزاحة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العمود) -> {
        دع الموضع: موضع_نصي_يوتيف16 = { السطر: السطر, العمود: العمود };
        أرجع نتيجة.نجح(الموضع);
    };
}

عام عرف موضع_نصي_يوتيف16_إلى_إزاحة_بايت(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الموضع: &موضع_نصي_يوتيف16
): نتيجة طبيعي, خطأ_موضع_يونيكود {
    إذا ((*الفهرس).طول_النص != (الطول(*النص) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق());
    };
    دع القيمة: موضع_نصي_يوتيف16 = *الموضع;
    طابق بداية_السطر(الفهرس, القيمة.السطر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(البداية) -> {
        أرجع عمود_يوتيف16_إلى_إزاحة_بايت(النص, البداية, القيمة.العمود);
    };
}

عام مرادف unicode_position_error = خطأ_موضع_يونيكود;
عام مرادف line_index = فهرس_سطور;
عام مرادف utf16_text_position = موضع_نصي_يوتيف16;
عام مرادف utf8_byte_offset_to_utf16_position = إزاحة_بايت_إلى_موضع_نصي_يوتيف16;
عام مرادف utf16_position_to_utf8_byte_offset = موضع_نصي_يوتيف16_إلى_إزاحة_بايت;
عام مرادف validate_utf8 = تحقق_يوتيف8;
عام مرادف utf8_byte_offset_to_codepoint_index = إزاحة_بايت_إلى_موضع_محرف;
عام مرادف utf8_codepoint_index_to_byte_offset = موضع_محرف_إلى_إزاحة_بايت;
عام مرادف build_line_index = ابن_فهرس_السطور;
عام مرادف line_start = بداية_السطر;
عام مرادف line_for_offset = سطر_الإزاحة;
عام مرادف utf8_byte_offset_to_utf16_column = إزاحة_بايت_إلى_عمود_يوتيف16;
عام مرادف utf16_column_to_utf8_byte_offset = عمود_يوتيف16_إلى_إزاحة_بايت;
عام مرادف unicode_position_error.invalid_utf8 = خطأ_موضع_يونيكود.يوتيف8_غير_صالح;
عام مرادف unicode_position_error.out_of_range = خطأ_موضع_يونيكود.إزاحة_خارج_النطاق;
عام مرادف unicode_position_error.not_character_boundary = خطأ_موضع_يونيكود.ليست_حد_محرف;
عام مرادف unicode_position_error.utf16_inside_surrogate_pair = خطأ_موضع_يونيكود.عمود_يوتيف16_داخل_زوج_بديل;
