استورد encoding.utf8;
استورد text.from_bytes;

عام نوع خطأ_يوتيف16 =
    | يوتيف8_غير_صالح بنوع طبيعي
    | بديل_عال_بلا_منخفض بنوع طبيعي
    | بديل_منخفض_بلا_عال بنوع طبيعي
;

عام عرف نص_إلى_يوتيف16(النص: &نص): نتيجة متجه ط16, خطأ_يوتيف16 {
    دع الوحدات: متغير متجه ط16 = [];
    دع الموضع: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            أرجع نتيجة.خطأ(خطأ_يوتيف16.يوتيف8_غير_صالح(الموضع));
        };
        دع القيمة: طبيعي = المفكوك.القيمة مثل طبيعي;
        إذا (القيمة <= 0xFFFF) {
            ألحق(الوحدات, القيمة مثل ط16);
        } وإلا {
            دع المعدل: طبيعي = القيمة - 0x10000;
            ألحق(الوحدات, (0xD800 + (المعدل >> 10)) مثل ط16);
            ألحق(الوحدات, (0xDC00 + (المعدل & 0x3FF)) مثل ط16);
        };
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع نتيجة.نجح(الوحدات);
}

عرف ألحق_سلم_يوتيف16(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة <= 0x7F) {
        ألحق(*البايتات, القيمة مثل ط8);
    } وإلا إذا (القيمة <= 0x7FF) {
        ألحق(*البايتات, (0xC0 | (القيمة >> 6)) مثل ط8);
        ألحق(*البايتات, (0x80 | (القيمة & 0x3F)) مثل ط8);
    } وإلا إذا (القيمة <= 0xFFFF) {
        ألحق(*البايتات, (0xE0 | (القيمة >> 12)) مثل ط8);
        ألحق(*البايتات, (0x80 | ((القيمة >> 6) & 0x3F)) مثل ط8);
        ألحق(*البايتات, (0x80 | (القيمة & 0x3F)) مثل ط8);
    } وإلا {
        ألحق(*البايتات, (0xF0 | (القيمة >> 18)) مثل ط8);
        ألحق(*البايتات, (0x80 | ((القيمة >> 12) & 0x3F)) مثل ط8);
        ألحق(*البايتات, (0x80 | ((القيمة >> 6) & 0x3F)) مثل ط8);
        ألحق(*البايتات, (0x80 | (القيمة & 0x3F)) مثل ط8);
    };
}

عام عرف يوتيف16_إلى_نص(الوحدات: &متجه ط16): نتيجة نص, خطأ_يوتيف16 {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الوحدات) مثل طبيعي;
    طالما (ف < العدد) {
        دع الوحدة: طبيعي = (*الوحدات)[ف] مثل طبيعي;
        إذا ((الوحدة >= 0xD800) && (الوحدة <= 0xDBFF)) {
            دع التالي: طبيعي = ف + 1;
            إذا (التالي >= العدد) {
                أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_عال_بلا_منخفض(ف));
            };
            دع المنخفض: طبيعي = (*الوحدات)[التالي] مثل طبيعي;
            إذا ((المنخفض < 0xDC00) || (المنخفض > 0xDFFF)) {
                أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_عال_بلا_منخفض(ف));
            };
            دع القيمة: طبيعي = 0x10000 + (((الوحدة - 0xD800) << 10) | (المنخفض - 0xDC00));
            ألحق_سلم_يوتيف16(&متغير البايتات, القيمة);
            ف := ف + 2;
        } وإلا إذا ((الوحدة >= 0xDC00) && (الوحدة <= 0xDFFF)) {
            أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_منخفض_بلا_عال(ف));
        } وإلا {
            ألحق_سلم_يوتيف16(&متغير البايتات, الوحدة);
            ف := ف + 1;
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام مرادف utf16_error = خطأ_يوتيف16;
عام مرادف text_to_utf16 = نص_إلى_يوتيف16;
عام مرادف utf16_to_text = يوتيف16_إلى_نص;
عام مرادف utf16_error.invalid_utf8 = خطأ_يوتيف16.يوتيف8_غير_صالح;
عام مرادف utf16_error.unpaired_high_surrogate = خطأ_يوتيف16.بديل_عال_بلا_منخفض;
عام مرادف utf16_error.unpaired_low_surrogate = خطأ_يوتيف16.بديل_منخفض_بلا_عال;
