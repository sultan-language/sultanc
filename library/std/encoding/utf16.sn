استورد encoding.utf8;
استورد text.from_bytes;

عام نوع خطأ_يوتيف16 =
    | يوتيف8_غير_صالح بنوع غير_موقع
    | بديل_عال_بلا_منخفض بنوع غير_موقع
    | بديل_منخفض_بلا_عال بنوع غير_موقع
;

عام عرف نص_إلى_يوتيف16(النص: &نص): نتيجة متجه غ16, خطأ_يوتيف16 {
    دع الوحدات: متغير متجه غ16 = [];
    دع الموضع: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    بينما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            أرجع نتيجة.خطأ(خطأ_يوتيف16.يوتيف8_غير_صالح(الموضع));
        };
        دع القيمة: غير_موقع = المفكوك.القيمة مثل غير_موقع;
        لو (القيمة <= 0xFFFF) {
            ألحق(الوحدات, القيمة مثل غ16);
        } وإلا {
            دع المعدل: غير_موقع = القيمة - 0x10000;
            ألحق(الوحدات, (0xD800 + (المعدل >> 10)) مثل غ16);
            ألحق(الوحدات, (0xDC00 + (المعدل & 0x3FF)) مثل غ16);
        };
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع نتيجة.نجح(الوحدات);
}

عرف ألحق_سلم_يوتيف16(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الناتج: متغير متجه غ8 = *البايتات;
    لو (القيمة <= 0x7F) {
        ألحق(الناتج, القيمة مثل غ8);
    } وإلا لو (القيمة <= 0x7FF) {
        ألحق(الناتج, (0xC0 | (القيمة >> 6)) مثل غ8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
    } وإلا لو (القيمة <= 0xFFFF) {
        ألحق(الناتج, (0xE0 | (القيمة >> 12)) مثل غ8);
        ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل غ8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
    } وإلا {
        ألحق(الناتج, (0xF0 | (القيمة >> 18)) مثل غ8);
        ألحق(الناتج, (0x80 | ((القيمة >> 12) & 0x3F)) مثل غ8);
        ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل غ8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
    };
    *البايتات := الناتج;
}

عام عرف يوتيف16_إلى_نص(الوحدات: &متجه غ16): نتيجة نص, خطأ_يوتيف16 {
    دع المصدر: متجه غ16 = *الوحدات;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    بينما (ف < العدد) {
        دع الوحدة: غير_موقع = المصدر[ف] مثل غير_موقع;
        لو ((الوحدة >= 0xD800) && (الوحدة <= 0xDBFF)) {
            دع التالي: غير_موقع = ف + 1;
            لو (التالي >= العدد) {
                أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_عال_بلا_منخفض(ف));
            };
            دع المنخفض: غير_موقع = المصدر[التالي] مثل غير_موقع;
            لو ((المنخفض < 0xDC00) || (المنخفض > 0xDFFF)) {
                أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_عال_بلا_منخفض(ف));
            };
            دع القيمة: غير_موقع = 0x10000 + (((الوحدة - 0xD800) << 10) | (المنخفض - 0xDC00));
            ألحق_سلم_يوتيف16(&متغير البايتات, القيمة);
            ف := ف + 2;
        } وإلا لو ((الوحدة >= 0xDC00) && (الوحدة <= 0xDFFF)) {
            أرجع نتيجة.خطأ(خطأ_يوتيف16.بديل_منخفض_بلا_عال(ف));
        } وإلا {
            ألحق_سلم_يوتيف16(&متغير البايتات, الوحدة);
            ف := ف + 1;
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام مرادف utf16_error = خطأ_يوتيف16;
عام مرادف text_to_utf16 = نص_إلى_يوتيف16;
عام مرادف utf16_to_text = يوتيف16_إلى_نص;
عام مرادف utf16_error.invalid_utf8 = خطأ_يوتيف16.يوتيف8_غير_صالح;
عام مرادف utf16_error.unpaired_high_surrogate = خطأ_يوتيف16.بديل_عال_بلا_منخفض;
عام مرادف utf16_error.unpaired_low_surrogate = خطأ_يوتيف16.بديل_منخفض_بلا_عال;
