// Strict ASN.1 DER reading (ITU-T X.690 sections 8 and 10) for certificates,
// keys and signatures. Elements are offsets into the caller's bytes, so
// parsing does not copy. Only DER is accepted: definite minimal lengths, no
// high tag numbers, minimal INTEGER encodings, BOOLEAN as 0x00/0xFF and
// BIT STRING unused-bit counts below 8. Anything else is rejected; BER input
// is accepted only through the explicit normalizer at the end of this file.

استورد chars.ascii;
استورد text.from_bytes;
استورد time.calendar;

عام نوع عنصر_دي_إي_آر = {
    الوسم: طبيعي,
    الرأس: طبيعي,
    البداية: طبيعي,
    الطول: طبيعي,
    النهاية: طبيعي
};

// Universal and context-specific tags used by X.509, PKCS#1/#8/#12 and SEC 1.
عام عرف وسم_عدد_صحيح_دي_إي_آر(): طبيعي { أرجع 0x02; }
عام عرف وسم_سلسلة_بتات_دي_إي_آر(): طبيعي { أرجع 0x03; }
عام عرف وسم_سلسلة_ثمانيات_دي_إي_آر(): طبيعي { أرجع 0x04; }
عام عرف وسم_فارغ_دي_إي_آر(): طبيعي { أرجع 0x05; }
عام عرف وسم_معرف_كائن_دي_إي_آر(): طبيعي { أرجع 0x06; }
عام عرف وسم_منطقي_دي_إي_آر(): طبيعي { أرجع 0x01; }
عام عرف وسم_وقت_عالمي_دي_إي_آر(): طبيعي { أرجع 0x17; }
عام عرف وسم_وقت_معمم_دي_إي_آر(): طبيعي { أرجع 0x18; }
عام عرف وسم_تسلسل_دي_إي_آر(): طبيعي { أرجع 0x30; }
عام عرف وسم_مجموعة_دي_إي_آر(): طبيعي { أرجع 0x31; }
// [n] EXPLICIT/constructed and [n] IMPLICIT/primitive context tags.
عام عرف وسم_سياق_مركب_دي_إي_آر(الرقم: طبيعي): طبيعي { أرجع 0xA0 | الرقم; }
عام عرف وسم_سياق_بسيط_دي_إي_آر(الرقم: طبيعي): طبيعي { أرجع 0x80 | الرقم; }

// Reads one element starting at الموضع that must end at or before الحد.
عام عرف اقرأ_عنصر_دي_إي_آر(المصدر: &متجه ط8, الموضع: طبيعي, الحد: طبيعي): اختياري عنصر_دي_إي_آر {
    إذا (الحد > (الطول(*المصدر) مثل طبيعي) || الموضع + 2 > الحد) { أرجع اختياري.لا_شيء(); };
    دع الوسم: طبيعي = (*المصدر)[الموضع] مثل طبيعي;
    إذا ((الوسم & 0x1F) == 0x1F) { أرجع اختياري.لا_شيء(); };
    دع الأول: طبيعي = (*المصدر)[الموضع + 1] مثل طبيعي;
    دع الطول_الفعلي: متغير طبيعي = 0;
    دع البداية: متغير طبيعي = الموضع + 2;
    إذا (الأول < 0x80) {
        الطول_الفعلي := الأول;
    } وإلا {
        دع العدد: طبيعي = الأول & 0x7F;
        // 0x80 (indefinite length) is BER only; lengths above 2^32 are refused.
        إذا (العدد == 0 || العدد > 4) { أرجع اختياري.لا_شيء(); };
        إذا (البداية + العدد > الحد) { أرجع اختياري.لا_شيء(); };
        إذا ((*المصدر)[البداية] == 0) { أرجع اختياري.لا_شيء(); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            الطول_الفعلي := (الطول_الفعلي << 8) | ((*المصدر)[البداية + ف] مثل طبيعي);
            ف := ف + 1;
        }
        إذا (الطول_الفعلي < 0x80) { أرجع اختياري.لا_شيء(); };
        البداية := البداية + العدد;
    };
    إذا (الطول_الفعلي > الحد - البداية) { أرجع اختياري.لا_شيء(); };
    دع العنصر: عنصر_دي_إي_آر = {
        الوسم: الوسم,
        الرأس: الموضع,
        البداية: البداية,
        الطول: الطول_الفعلي,
        النهاية: البداية + الطول_الفعلي
    };
    أرجع اختياري.موجود(العنصر);
}

// The single element that exactly fills the whole input.
عام عرف اقرأ_جذر_دي_إي_آر(المصدر: &متجه ط8): اختياري عنصر_دي_إي_آر {
    دع الحجم: طبيعي = الطول(*المصدر) مثل طبيعي;
    طابق اقرأ_عنصر_دي_إي_آر(المصدر, 0, الحجم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العنصر) -> {
        إذا (العنصر.النهاية != الحجم) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(العنصر);
    };
}

// The children of a constructed element; they must fill it exactly.
عام عرف أبناء_دي_إي_آر(المصدر: &متجه ط8, الأب: &عنصر_دي_إي_آر): اختياري متجه عنصر_دي_إي_آر {
    إذا (((*الأب).الوسم & 0x20) == 0) { أرجع اختياري.لا_شيء(); };
    دع الأبناء: متغير متجه عنصر_دي_إي_آر = [];
    دع الموضع: متغير طبيعي = (*الأب).البداية;
    طالما (الموضع < (*الأب).النهاية) {
        طابق اقرأ_عنصر_دي_إي_آر(المصدر, الموضع, (*الأب).النهاية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الابن) -> {
            الموضع := الابن.النهاية;
            ألحق(الأبناء, الابن);
        };
    }
    أرجع اختياري.موجود(الأبناء);
}

// Children of a constructed element with the expected tag.
عام عرف أبناء_بوسم_دي_إي_آر(المصدر: &متجه ط8, الأب: &عنصر_دي_إي_آر, الوسم: طبيعي): اختياري متجه عنصر_دي_إي_آر {
    إذا ((*الأب).الوسم != الوسم) { أرجع اختياري.لا_شيء(); };
    أرجع أبناء_دي_إي_آر(المصدر, الأب);
}

عام عرف محتوى_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = (*العنصر).البداية;
    طالما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The complete encoding (tag, length and content) of an element.
عام عرف ترميز_كامل_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = (*العنصر).الرأس;
    طالما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A non-negative INTEGER as its big-endian magnitude without sign padding.
عام عرف عدد_صحيح_موجب_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري متجه ط8 {
    إذا ((*العنصر).الوسم != 0x02 || (*العنصر).الطول == 0) { أرجع اختياري.لا_شيء(); };
    دع ب: طبيعي = (*العنصر).البداية;
    دع الأول: طبيعي = (*المصدر)[ب] مثل طبيعي;
    إذا (الأول >= 0x80) { أرجع اختياري.لا_شيء(); };
    إذا ((*العنصر).الطول > 1 && الأول == 0 && ((*المصدر)[ب + 1] مثل طبيعي) < 0x80) {
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = ب;
    إذا (الأول == 0 && (*العنصر).الطول > 1) { ف := ب + 1; };
    طالما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// A small non-negative INTEGER (versions, path lengths, iteration counts).
عام عرف عدد_صغير_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري طبيعي {
    طابق عدد_صحيح_موجب_دي_إي_آر(المصدر, العنصر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(البايتات) -> {
        إذا ((الطول(البايتات) مثل طبيعي) > 4) { أرجع اختياري.لا_شيء(); };
        دع القيمة: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البايتات) مثل طبيعي)) {
            القيمة := (القيمة << 8) | (البايتات[ف] مثل طبيعي);
            ف := ف + 1;
        }
        أرجع اختياري.موجود(القيمة);
    };
}

عام عرف منطقي_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري منطقي {
    إذا ((*العنصر).الوسم != 0x01 || (*العنصر).الطول != 1) { أرجع اختياري.لا_شيء(); };
    دع ب: ط8 = (*المصدر)[(*العنصر).البداية];
    إذا (ب == 0) { أرجع اختياري.موجود(خطأ); };
    إذا (ب == 0xFF) { أرجع اختياري.موجود(صواب); };
    أرجع اختياري.لا_شيء();
}

// BIT STRING content whose unused-bit count is zero (keys, signatures).
عام عرف سلسلة_بتات_كاملة_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري متجه ط8 {
    إذا ((*العنصر).الوسم != 0x03 || (*العنصر).الطول == 0) { أرجع اختياري.لا_شيء(); };
    إذا ((*المصدر)[(*العنصر).البداية] != 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = (*العنصر).البداية + 1;
    طالما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// BIT STRING as named bits (KeyUsage): bit n of the result is bit n of the
// string, counted from the most significant bit of the first content byte.
عام عرف بتات_مسماة_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري طبيعي {
    إذا ((*العنصر).الوسم != 0x03 || (*العنصر).الطول == 0) { أرجع اختياري.لا_شيء(); };
    دع غير_المستخدمة: طبيعي = (*المصدر)[(*العنصر).البداية] مثل طبيعي;
    إذا (غير_المستخدمة > 7) { أرجع اختياري.لا_شيء(); };
    إذا ((*العنصر).الطول == 1 && غير_المستخدمة != 0) { أرجع اختياري.لا_شيء(); };
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < (*العنصر).الطول && ف < 7) {
        دع البايت: طبيعي = (*المصدر)[(*العنصر).البداية + 1 + ف] مثل طبيعي;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            إذا (((البايت >> (7 - ب)) & 1) == 1) {
                القيمة := القيمة | (1 << (ف * 8 + ب));
            };
            ب := ب + 1;
        }
        ف := ف + 1;
    }
    أرجع اختياري.موجود(القيمة);
}

عام عرف محتوى_يساوي_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر, المتوقع: &متجه ط8): منطقي {
    إذا ((*العنصر).الطول != (الطول(*المتوقع) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*العنصر).الطول) {
        إذا ((*المصدر)[(*العنصر).البداية + ف] != (*المتوقع)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// An OBJECT IDENTIFIER element whose content equals the given encoding.
عام عرف معرف_كائن_يساوي_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر, المتوقع: &متجه ط8): منطقي {
    إذا ((*العنصر).الوسم != 0x06) { أرجع خطأ; };
    أرجع محتوى_يساوي_دي_إي_آر(المصدر, العنصر, المتوقع);
}

عرف رقمان_دي_إي_آر(المصدر: &متجه ط8, الموضع: طبيعي): اختياري طبيعي {
    دع أ: ط8 = (*المصدر)[الموضع];
    دع ب: ط8 = (*المصدر)[الموضع + 1];
    إذا (!رقم_عشري(أ) || !رقم_عشري(ب)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((قيمة_رقم_أسكي(أ) مثل طبيعي) * 10 + (قيمة_رقم_أسكي(ب) مثل طبيعي));
}

عرف بايت_حرفي_دي_إي_آر(النص: نص): ط8 {
    طابق بايت_نص(النص) مع
    | اختياري.موجود(ب) -> { أرجع ب; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// UTCTime (YYMMDDHHMMSSZ, RFC 5280 4.1.2.5.1) or GeneralizedTime
// (YYYYMMDDHHMMSSZ, 4.1.2.5.2) as seconds since the Unix epoch.
عام عرف وقت_دي_إي_آر(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري عدد {
    دع ب: طبيعي = (*العنصر).البداية;
    دع السنة: متغير عدد = 0;
    دع الموضع: متغير طبيعي = ب;
    إذا ((*العنصر).الوسم == 0x17) {
        إذا ((*العنصر).الطول != 13) { أرجع اختياري.لا_شيء(); };
        طابق رقمان_دي_إي_آر(المصدر, ب) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ق) -> {
            إذا (ق >= 50) { السنة := 1900 + (ق مثل عدد); } وإلا { السنة := 2000 + (ق مثل عدد); };
        };
        الموضع := ب + 2;
    } وإلا إذا ((*العنصر).الوسم == 0x18) {
        إذا ((*العنصر).الطول != 15) { أرجع اختياري.لا_شيء(); };
        طابق رقمان_دي_إي_آر(المصدر, ب) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ق) -> { السنة := (ق مثل عدد) * 100; };
        طابق رقمان_دي_إي_آر(المصدر, ب + 2) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ق) -> { السنة := السنة + (ق مثل عدد); };
        الموضع := ب + 4;
    } وإلا {
        أرجع اختياري.لا_شيء();
    };
    إذا ((*المصدر)[(*العنصر).النهاية - 1] != بايت_حرفي_دي_إي_آر(«Z»)) { أرجع اختياري.لا_شيء(); };
    دع الأجزاء: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) {
        طابق رقمان_دي_إي_آر(المصدر, الموضع + ف * 2) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ق) -> { ألحق(الأجزاء, ق); };
        ف := ف + 1;
    }
    إذا (الأجزاء[2] > 23 || الأجزاء[3] > 59 || الأجزاء[4] > 59) { أرجع اختياري.لا_شيء(); };
    طابق أنشئ_تاريخا_تقويميا(السنة, الأجزاء[0], الأجزاء[1]) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التاريخ) -> {
        طابق أيام_يونكس_من_التاريخ(&التاريخ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الأيام) -> {
            دع الثواني: عدد = (الأجزاء[2] مثل عدد) * 3600 + (الأجزاء[3] مثل عدد) * 60 + (الأجزاء[4] مثل عدد);
            أرجع اختياري.موجود(الأيام * 86400 + الثواني);
        };
    };
}

عام مرادف der_element = عنصر_دي_إي_آر;
عام مرادف der_read_element = اقرأ_عنصر_دي_إي_آر;
عام مرادف der_read_root = اقرأ_جذر_دي_إي_آر;
عام مرادف der_children = أبناء_دي_إي_آر;
عام مرادف der_content = محتوى_دي_إي_آر;
عام مرادف der_unsigned_integer = عدد_صحيح_موجب_دي_إي_آر;
عام مرادف der_small_integer = عدد_صغير_دي_إي_آر;
عام مرادف der_boolean = منطقي_دي_إي_آر;
عام مرادف der_bit_string = سلسلة_بتات_كاملة_دي_إي_آر;
عام مرادف der_time = وقت_دي_إي_آر;

// The DER content of an OBJECT IDENTIFIER written in dotted decimal
// («1.2.840.113549.1.1.11»), so identifiers stay readable in source.
// Malformed text yields an empty vector, which matches no element.
عام عرف معرف_كائن_من_نص(النص: نص): متجه ط8 {
    دع فارغ: متجه ط8 = [];
    دع نقطة: ط8 = بايت_حرفي_دي_إي_آر(«.»);
    دع الأجزاء: متغير متجه طبيعي = [];
    دع الحالي: متغير طبيعي = 0;
    دع أرقام: متغير طبيعي = 0;
    دع الحجم: طبيعي = الطول(النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        دع ب: ط8 = النص[ف];
        إذا (ب == نقطة) {
            إذا (أرقام == 0) { أرجع فارغ; };
            ألحق(الأجزاء, الحالي);
            الحالي := 0;
            أرقام := 0;
        } وإلا إذا (رقم_عشري(ب)) {
            إذا (الحالي > 429496729) { أرجع فارغ; };
            الحالي := الحالي * 10 + (قيمة_رقم_أسكي(ب) مثل طبيعي);
            أرقام := أرقام + 1;
        } وإلا {
            أرجع فارغ;
        };
        ف := ف + 1;
    }
    إذا (أرقام == 0) { أرجع فارغ; };
    ألحق(الأجزاء, الحالي);
    إذا ((الطول(الأجزاء) مثل طبيعي) < 2 || الأجزاء[0] > 2 || (الأجزاء[0] < 2 && الأجزاء[1] > 39)) { أرجع فارغ; };
    دع القيم: متغير متجه طبيعي = [الأجزاء[0] * 40 + الأجزاء[1]];
    ف := 2;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        ألحق(القيم, الأجزاء[ف]);
        ف := ف + 1;
    }
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع القيمة: طبيعي = القيم[ف];
        // Base-128 digits, most significant first, continuation bit on all but the last.
        دع الأرقام: متغير متجه طبيعي = [القيمة & 0x7F];
        دع الباقي: متغير طبيعي = القيمة >> 7;
        طالما (الباقي != 0) {
            ألحق(الأرقام, الباقي & 0x7F);
            الباقي := الباقي >> 7;
        }
        دع م: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
        طالما (م > 0) {
            م := م - 1;
            إذا (م > 0) {
                ألحق(الناتج, (الأرقام[م] | 0x80) مثل ط8);
            } وإلا {
                ألحق(الناتج, الأرقام[م] مثل ط8);
            };
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف der_oid_from_text = معرف_كائن_من_نص;

// Encodes one element with a definite minimal length (X.690 10.1).
عام عرف رمز_عنصر_دي_إي_آر(الوسم: طبيعي, المحتوى: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, الوسم مثل ط8);
    دع الحجم: طبيعي = الطول(*المحتوى) مثل طبيعي;
    إذا (الحجم < 0x80) {
        ألحق(الناتج, الحجم مثل ط8);
    } وإلا {
        دع البايتات: متغير متجه طبيعي = [];
        دع الباقي: متغير طبيعي = الحجم;
        طالما (الباقي != 0) {
            ألحق(البايتات, الباقي & 0xFF);
            الباقي := الباقي >> 8;
        }
        دع العدد: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق(الناتج, (0x80 | العدد) مثل ط8);
        دع ف: متغير طبيعي = العدد;
        طالما (ف > 0) {
            ف := ف - 1;
            ألحق(الناتج, البايتات[ف] مثل ط8);
        }
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        ألحق(الناتج, (*المحتوى)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف der_encode_element = رمز_عنصر_دي_إي_آر;

// ---- BER to DER normalization (X.690 8.1.3.6, 8.7.3, 10.1, 10.2) ---------
// PKCS#12 files written by Windows and Java use BER: indefinite lengths and
// constructed OCTET STRINGs made of segments. Normalization rewrites every
// length in the minimal definite form and joins the segments of a universal
// constructed OCTET STRING into one primitive string. Context-specific
// constructed elements are kept constructed: whether they are an IMPLICIT
// string is known only to the schema, which must join their segments itself.
// High tag numbers are refused; nesting is limited to 64 levels.

نوع عنصر_محول_بي_إي_آر = {
    الترميز: متجه ط8,
    // The tag, and for a primitive element its content (to join segments).
    الوسم: طبيعي,
    المحتوى: متجه ط8,
    النهاية: طبيعي
};

عرف ترميز_طول_دي_إي_آر(الهدف: &متغير متجه ط8, الوسم: طبيعي, المحتوى: &متجه ط8): فراغ {
    دع المرمز: متجه ط8 = رمز_عنصر_دي_إي_آر(الوسم, المحتوى);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرمز) مثل طبيعي)) {
        ألحق(*الهدف, المرمز[ف]);
        ف := ف + 1;
    }
}

عرف حول_عنصر_بي_إي_آر(المصدر: &متجه ط8, الموضع: طبيعي, الحد: طبيعي, العمق: طبيعي): اختياري عنصر_محول_بي_إي_آر {
    إذا (العمق > 64 || الموضع + 2 > الحد) { أرجع اختياري.لا_شيء(); };
    دع الوسم: طبيعي = (*المصدر)[الموضع] مثل طبيعي;
    إذا ((الوسم & 0x1F) == 0x1F || الوسم == 0) { أرجع اختياري.لا_شيء(); };
    دع مركب: منطقي = (الوسم & 0x20) != 0;
    دع الأول: طبيعي = (*المصدر)[الموضع + 1] مثل طبيعي;
    دع البداية: متغير طبيعي = الموضع + 2;
    دع غير_محدد: منطقي = الأول == 0x80;
    دع النهاية_المحددة: متغير طبيعي = الحد;
    إذا (!غير_محدد) {
        دع الطول_الفعلي: متغير طبيعي = 0;
        إذا (الأول < 0x80) {
            الطول_الفعلي := الأول;
        } وإلا {
            دع العدد: طبيعي = الأول & 0x7F;
            إذا (العدد > 4 || البداية + العدد > الحد) { أرجع اختياري.لا_شيء(); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                الطول_الفعلي := (الطول_الفعلي << 8) | ((*المصدر)[البداية + ف] مثل طبيعي);
                ف := ف + 1;
            }
            البداية := البداية + العدد;
        };
        إذا (الطول_الفعلي > الحد - البداية) { أرجع اختياري.لا_شيء(); };
        النهاية_المحددة := البداية + الطول_الفعلي;
    };
    إذا (!مركب) {
        إذا (غير_محدد) { أرجع اختياري.لا_شيء(); };
        دع المحتوى: متجه ط8 = شريحة_بايتات_دي_إي_آر(المصدر, البداية, النهاية_المحددة);
        دع الترميز: متغير متجه ط8 = [];
        ترميز_طول_دي_إي_آر(&متغير الترميز, الوسم, &المحتوى);
        دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: الوسم, المحتوى: المحتوى, النهاية: النهاية_المحددة };
        أرجع اختياري.موجود(الناتج);
    };
    // Constructed: convert the children until the end or the end-of-contents.
    دع الأبناء: متغير متجه ط8 = [];
    دع المقاطع: متغير متجه ط8 = [];
    دع كلها_مقاطع: متغير منطقي = صواب;
    دع الموضع_الحالي: متغير طبيعي = البداية;
    دع انتهى: متغير منطقي = خطأ;
    طالما (!انتهى) {
        إذا (غير_محدد) {
            إذا (الموضع_الحالي + 2 > الحد) { أرجع اختياري.لا_شيء(); };
            إذا ((*المصدر)[الموضع_الحالي] == 0 && (*المصدر)[الموضع_الحالي + 1] == 0) {
                الموضع_الحالي := الموضع_الحالي + 2;
                انتهى := صواب;
            };
        } وإلا إذا (الموضع_الحالي >= النهاية_المحددة) {
            انتهى := صواب;
        };
        إذا (!انتهى) {
            طابق حول_عنصر_بي_إي_آر(المصدر, الموضع_الحالي, النهاية_المحددة, العمق + 1) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الابن) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الابن.الترميز) مثل طبيعي)) {
                    ألحق(الأبناء, الابن.الترميز[ف]);
                    ف := ف + 1;
                }
                إذا (الابن.الوسم == 0x04) {
                    ف := 0;
                    طالما (ف < (الطول(الابن.المحتوى) مثل طبيعي)) {
                        ألحق(المقاطع, الابن.المحتوى[ف]);
                        ف := ف + 1;
                    }
                } وإلا {
                    كلها_مقاطع := خطأ;
                };
                الموضع_الحالي := الابن.النهاية;
            };
        };
    }
    دع الترميز: متغير متجه ط8 = [];
    إذا (الوسم == 0x24) {
        // A constructed OCTET STRING: its segments joined (8.7.3).
        إذا (!كلها_مقاطع) { أرجع اختياري.لا_شيء(); };
        ترميز_طول_دي_إي_آر(&متغير الترميز, 0x04, &المقاطع);
        دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: 0x04, المحتوى: المقاطع, النهاية: الموضع_الحالي };
        أرجع اختياري.موجود(الناتج);
    };
    ترميز_طول_دي_إي_آر(&متغير الترميز, الوسم, &الأبناء);
    دع لا_محتوى: متجه ط8 = [];
    دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: الوسم, المحتوى: لا_محتوى, النهاية: الموضع_الحالي };
    أرجع اختياري.موجود(الناتج);
}

عرف شريحة_بايتات_دي_إي_آر(المصدر: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The DER form of one BER element filling the whole input; none when the
// input is not valid BER.
عام عرف حول_بي_إي_آر_إلى_دي_إي_آر(المصدر: &متجه ط8): اختياري متجه ط8 {
    دع الحجم: طبيعي = الطول(*المصدر) مثل طبيعي;
    طابق حول_عنصر_بي_إي_آر(المصدر, 0, الحجم, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود({ الترميز: الترميز, الوسم: _, المحتوى: _, النهاية: النهاية }) -> {
        إذا (النهاية != الحجم) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الترميز);
    };
}

عام مرادف der_from_ber = حول_بي_إي_آر_إلى_دي_إي_آر;
