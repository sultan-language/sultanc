// Strict ASN.1 DER reading (ITU-T X.690 sections 8 and 10) for certificates,
// keys and signatures. Elements are offsets into the caller's bytes, so
// parsing does not copy. Only DER is accepted: definite minimal lengths, no
// high tag numbers, minimal INTEGER encodings, BOOLEAN as 0x00/0xFF and
// BIT STRING unused-bit counts below 8. Anything else is rejected; BER input
// is accepted only through the explicit normalizer at the end of this file.

استورد chars.ascii;
استورد text.from_bytes;
استورد time.calendar;

عام نوع عنصر_دي_إي_آر = {
    الوسم: غير_موقع,
    الرأس: غير_موقع,
    البداية: غير_موقع,
    الطول: غير_موقع,
    النهاية: غير_موقع
};

// Universal and context-specific tags used by X.509, PKCS#1/#8/#12 and SEC 1.
عام عرف وسم_عدد_صحيح_دي_إي_آر(): غير_موقع { أرجع 0x02; }
عام عرف وسم_سلسلة_بتات_دي_إي_آر(): غير_موقع { أرجع 0x03; }
عام عرف وسم_سلسلة_ثمانيات_دي_إي_آر(): غير_موقع { أرجع 0x04; }
عام عرف وسم_فارغ_دي_إي_آر(): غير_موقع { أرجع 0x05; }
عام عرف وسم_معرف_كائن_دي_إي_آر(): غير_موقع { أرجع 0x06; }
عام عرف وسم_منطقي_دي_إي_آر(): غير_موقع { أرجع 0x01; }
عام عرف وسم_وقت_عالمي_دي_إي_آر(): غير_موقع { أرجع 0x17; }
عام عرف وسم_وقت_معمم_دي_إي_آر(): غير_موقع { أرجع 0x18; }
عام عرف وسم_تسلسل_دي_إي_آر(): غير_موقع { أرجع 0x30; }
عام عرف وسم_مجموعة_دي_إي_آر(): غير_موقع { أرجع 0x31; }
// [n] EXPLICIT/constructed and [n] IMPLICIT/primitive context tags.
عام عرف وسم_سياق_مركب_دي_إي_آر(الرقم: غير_موقع): غير_موقع { أرجع 0xA0 | الرقم; }
عام عرف وسم_سياق_بسيط_دي_إي_آر(الرقم: غير_موقع): غير_موقع { أرجع 0x80 | الرقم; }

// Reads one element starting at الموضع that must end at or before الحد.
عام عرف اقرأ_عنصر_دي_إي_آر(المصدر: &متجه غ8, الموضع: غير_موقع, الحد: غير_موقع): اختيار عنصر_دي_إي_آر {
    لو (الحد > (الطول(*المصدر) مثل غير_موقع) || الموضع + 2 > الحد) { أرجع اختيار.لا_شيء(); };
    دع الوسم: غير_موقع = (*المصدر)[الموضع] مثل غير_موقع;
    لو ((الوسم & 0x1F) == 0x1F) { أرجع اختيار.لا_شيء(); };
    دع الأول: غير_موقع = (*المصدر)[الموضع + 1] مثل غير_موقع;
    دع الطول_الفعلي: متغير غير_موقع = 0;
    دع البداية: متغير غير_موقع = الموضع + 2;
    لو (الأول < 0x80) {
        الطول_الفعلي := الأول;
    } وإلا {
        دع العدد: غير_موقع = الأول & 0x7F;
        // 0x80 (indefinite length) is BER only; lengths above 2^32 are refused.
        لو (العدد == 0 || العدد > 4) { أرجع اختيار.لا_شيء(); };
        لو (البداية + العدد > الحد) { أرجع اختيار.لا_شيء(); };
        لو ((*المصدر)[البداية] == 0) { أرجع اختيار.لا_شيء(); };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            الطول_الفعلي := (الطول_الفعلي << 8) | ((*المصدر)[البداية + ف] مثل غير_موقع);
            ف := ف + 1;
        }
        لو (الطول_الفعلي < 0x80) { أرجع اختيار.لا_شيء(); };
        البداية := البداية + العدد;
    };
    لو (الطول_الفعلي > الحد - البداية) { أرجع اختيار.لا_شيء(); };
    دع العنصر: عنصر_دي_إي_آر = {
        الوسم: الوسم,
        الرأس: الموضع,
        البداية: البداية,
        الطول: الطول_الفعلي,
        النهاية: البداية + الطول_الفعلي
    };
    أرجع اختيار.بعض(العنصر);
}

// The single element that exactly fills the whole input.
عام عرف اقرأ_جذر_دي_إي_آر(المصدر: &متجه غ8): اختيار عنصر_دي_إي_آر {
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    طابق اقرأ_عنصر_دي_إي_آر(المصدر, 0, الحجم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(العنصر) -> {
        لو (العنصر.النهاية != الحجم) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(العنصر);
    };
}

// The children of a constructed element; they must fill it exactly.
عام عرف أبناء_دي_إي_آر(المصدر: &متجه غ8, الأب: &عنصر_دي_إي_آر): اختيار متجه عنصر_دي_إي_آر {
    لو (((*الأب).الوسم & 0x20) == 0) { أرجع اختيار.لا_شيء(); };
    دع الأبناء: متغير متجه عنصر_دي_إي_آر = [];
    دع الموضع: متغير غير_موقع = (*الأب).البداية;
    بينما (الموضع < (*الأب).النهاية) {
        طابق اقرأ_عنصر_دي_إي_آر(المصدر, الموضع, (*الأب).النهاية) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الابن) -> {
            الموضع := الابن.النهاية;
            ألحق(الأبناء, الابن);
        };
    }
    أرجع اختيار.بعض(الأبناء);
}

// Children of a constructed element with the expected tag.
عام عرف أبناء_بوسم_دي_إي_آر(المصدر: &متجه غ8, الأب: &عنصر_دي_إي_آر, الوسم: غير_موقع): اختيار متجه عنصر_دي_إي_آر {
    لو ((*الأب).الوسم != الوسم) { أرجع اختيار.لا_شيء(); };
    أرجع أبناء_دي_إي_آر(المصدر, الأب);
}

عام عرف محتوى_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = (*العنصر).البداية;
    بينما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The complete encoding (tag, length and content) of an element.
عام عرف ترميز_كامل_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = (*العنصر).الرأس;
    بينما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A non-negative INTEGER as its big-endian magnitude without sign padding.
عام عرف عدد_صحيح_موجب_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار متجه غ8 {
    لو ((*العنصر).الوسم != 0x02 || (*العنصر).الطول == 0) { أرجع اختيار.لا_شيء(); };
    دع ب: غير_موقع = (*العنصر).البداية;
    دع الأول: غير_موقع = (*المصدر)[ب] مثل غير_موقع;
    لو (الأول >= 0x80) { أرجع اختيار.لا_شيء(); };
    لو ((*العنصر).الطول > 1 && الأول == 0 && ((*المصدر)[ب + 1] مثل غير_موقع) < 0x80) {
        أرجع اختيار.لا_شيء();
    };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = ب;
    لو (الأول == 0 && (*العنصر).الطول > 1) { ف := ب + 1; };
    بينما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// A small non-negative INTEGER (versions, path lengths, iteration counts).
عام عرف عدد_صغير_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار غير_موقع {
    طابق عدد_صحيح_موجب_دي_إي_آر(المصدر, العنصر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(البايتات) -> {
        لو ((الطول(البايتات) مثل غير_موقع) > 4) { أرجع اختيار.لا_شيء(); };
        دع القيمة: متغير غير_موقع = 0;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
            القيمة := (القيمة << 8) | (البايتات[ف] مثل غير_موقع);
            ف := ف + 1;
        }
        أرجع اختيار.بعض(القيمة);
    };
}

عام عرف منطقي_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار منطقي {
    لو ((*العنصر).الوسم != 0x01 || (*العنصر).الطول != 1) { أرجع اختيار.لا_شيء(); };
    دع ب: غ8 = (*المصدر)[(*العنصر).البداية];
    لو (ب == 0) { أرجع اختيار.بعض(خطأ); };
    لو (ب == 0xFF) { أرجع اختيار.بعض(صواب); };
    أرجع اختيار.لا_شيء();
}

// BIT STRING content whose unused-bit count is zero (keys, signatures).
عام عرف سلسلة_بتات_كاملة_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار متجه غ8 {
    لو ((*العنصر).الوسم != 0x03 || (*العنصر).الطول == 0) { أرجع اختيار.لا_شيء(); };
    لو ((*المصدر)[(*العنصر).البداية] != 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = (*العنصر).البداية + 1;
    بينما (ف < (*العنصر).النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// BIT STRING as named bits (KeyUsage): bit n of the result is bit n of the
// string, counted from the most significant bit of the first content byte.
عام عرف بتات_مسماة_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار غير_موقع {
    لو ((*العنصر).الوسم != 0x03 || (*العنصر).الطول == 0) { أرجع اختيار.لا_شيء(); };
    دع غير_المستخدمة: غير_موقع = (*المصدر)[(*العنصر).البداية] مثل غير_موقع;
    لو (غير_المستخدمة > 7) { أرجع اختيار.لا_شيء(); };
    لو ((*العنصر).الطول == 1 && غير_المستخدمة != 0) { أرجع اختيار.لا_شيء(); };
    دع القيمة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف + 1 < (*العنصر).الطول && ف < 7) {
        دع البايت: غير_موقع = (*المصدر)[(*العنصر).البداية + 1 + ف] مثل غير_موقع;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < 8) {
            لو (((البايت >> (7 - ب)) & 1) == 1) {
                القيمة := القيمة | (1 << (ف * 8 + ب));
            };
            ب := ب + 1;
        }
        ف := ف + 1;
    }
    أرجع اختيار.بعض(القيمة);
}

عام عرف محتوى_يساوي_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر, المتوقع: &متجه غ8): منطقي {
    لو ((*العنصر).الطول != (الطول(*المتوقع) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*العنصر).الطول) {
        لو ((*المصدر)[(*العنصر).البداية + ف] != (*المتوقع)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// An OBJECT IDENTIFIER element whose content equals the given encoding.
عام عرف معرف_كائن_يساوي_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر, المتوقع: &متجه غ8): منطقي {
    لو ((*العنصر).الوسم != 0x06) { أرجع خطأ; };
    أرجع محتوى_يساوي_دي_إي_آر(المصدر, العنصر, المتوقع);
}

عرف رقمان_دي_إي_آر(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غير_موقع {
    دع أ: غ8 = (*المصدر)[الموضع];
    دع ب: غ8 = (*المصدر)[الموضع + 1];
    لو (!رقم_عشري(أ) || !رقم_عشري(ب)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((قيمة_رقم_أسكي(أ) مثل غير_موقع) * 10 + (قيمة_رقم_أسكي(ب) مثل غير_موقع));
}

عرف بايت_حرفي_دي_إي_آر(النص: نص): غ8 {
    طابق بايت_نص(النص) مع
    | اختيار.بعض(ب) -> { أرجع ب; }
    | اختيار.لا_شيء -> { أرجع 0; };
}

// UTCTime (YYMMDDHHMMSSZ, RFC 5280 4.1.2.5.1) or GeneralizedTime
// (YYYYMMDDHHMMSSZ, 4.1.2.5.2) as seconds since the Unix epoch.
عام عرف وقت_دي_إي_آر(المصدر: &متجه غ8, العنصر: &عنصر_دي_إي_آر): اختيار عدد {
    دع ب: غير_موقع = (*العنصر).البداية;
    دع السنة: متغير عدد = 0;
    دع الموضع: متغير غير_موقع = ب;
    لو ((*العنصر).الوسم == 0x17) {
        لو ((*العنصر).الطول != 13) { أرجع اختيار.لا_شيء(); };
        طابق رقمان_دي_إي_آر(المصدر, ب) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ق) -> {
            لو (ق >= 50) { السنة := 1900 + (ق مثل عدد); } وإلا { السنة := 2000 + (ق مثل عدد); };
        };
        الموضع := ب + 2;
    } وإلا لو ((*العنصر).الوسم == 0x18) {
        لو ((*العنصر).الطول != 15) { أرجع اختيار.لا_شيء(); };
        طابق رقمان_دي_إي_آر(المصدر, ب) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ق) -> { السنة := (ق مثل عدد) * 100; };
        طابق رقمان_دي_إي_آر(المصدر, ب + 2) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ق) -> { السنة := السنة + (ق مثل عدد); };
        الموضع := ب + 4;
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    لو ((*المصدر)[(*العنصر).النهاية - 1] != بايت_حرفي_دي_إي_آر(«Z»)) { أرجع اختيار.لا_شيء(); };
    دع الأجزاء: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 5) {
        طابق رقمان_دي_إي_آر(المصدر, الموضع + ف * 2) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ق) -> { ألحق(الأجزاء, ق); };
        ف := ف + 1;
    }
    لو (الأجزاء[2] > 23 || الأجزاء[3] > 59 || الأجزاء[4] > 59) { أرجع اختيار.لا_شيء(); };
    طابق أنشئ_تاريخا_تقويميا(السنة, الأجزاء[0], الأجزاء[1]) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التاريخ) -> {
        طابق أيام_يونكس_من_التاريخ(&التاريخ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الأيام) -> {
            دع الثواني: عدد = (الأجزاء[2] مثل عدد) * 3600 + (الأجزاء[3] مثل عدد) * 60 + (الأجزاء[4] مثل عدد);
            أرجع اختيار.بعض(الأيام * 86400 + الثواني);
        };
    };
}

عام مرادف der_element = عنصر_دي_إي_آر;
عام مرادف der_read_element = اقرأ_عنصر_دي_إي_آر;
عام مرادف der_read_root = اقرأ_جذر_دي_إي_آر;
عام مرادف der_children = أبناء_دي_إي_آر;
عام مرادف der_content = محتوى_دي_إي_آر;
عام مرادف der_unsigned_integer = عدد_صحيح_موجب_دي_إي_آر;
عام مرادف der_small_integer = عدد_صغير_دي_إي_آر;
عام مرادف der_boolean = منطقي_دي_إي_آر;
عام مرادف der_bit_string = سلسلة_بتات_كاملة_دي_إي_آر;
عام مرادف der_time = وقت_دي_إي_آر;

// The DER content of an OBJECT IDENTIFIER written in dotted decimal
// («1.2.840.113549.1.1.11»), so identifiers stay readable in source.
// Malformed text yields an empty vector, which matches no element.
عام عرف معرف_كائن_من_نص(النص: نص): متجه غ8 {
    دع فارغ: متجه غ8 = [];
    دع نقطة: غ8 = بايت_حرفي_دي_إي_آر(«.»);
    دع الأجزاء: متغير متجه غير_موقع = [];
    دع الحالي: متغير غير_موقع = 0;
    دع أرقام: متغير غير_موقع = 0;
    دع الحجم: غير_موقع = الطول(النص) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع ب: غ8 = النص[ف];
        لو (ب == نقطة) {
            لو (أرقام == 0) { أرجع فارغ; };
            ألحق(الأجزاء, الحالي);
            الحالي := 0;
            أرقام := 0;
        } وإلا لو (رقم_عشري(ب)) {
            لو (الحالي > 429496729) { أرجع فارغ; };
            الحالي := الحالي * 10 + (قيمة_رقم_أسكي(ب) مثل غير_موقع);
            أرقام := أرقام + 1;
        } وإلا {
            أرجع فارغ;
        };
        ف := ف + 1;
    }
    لو (أرقام == 0) { أرجع فارغ; };
    ألحق(الأجزاء, الحالي);
    لو ((الطول(الأجزاء) مثل غير_موقع) < 2 || الأجزاء[0] > 2 || (الأجزاء[0] < 2 && الأجزاء[1] > 39)) { أرجع فارغ; };
    دع القيم: متغير متجه غير_موقع = [الأجزاء[0] * 40 + الأجزاء[1]];
    ف := 2;
    بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
        ألحق(القيم, الأجزاء[ف]);
        ف := ف + 1;
    }
    دع الناتج: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع القيمة: غير_موقع = القيم[ف];
        // Base-128 digits, most significant first, continuation bit on all but the last.
        دع الأرقام: متغير متجه غير_موقع = [القيمة & 0x7F];
        دع الباقي: متغير غير_موقع = القيمة >> 7;
        بينما (الباقي != 0) {
            ألحق(الأرقام, الباقي & 0x7F);
            الباقي := الباقي >> 7;
        }
        دع م: متغير غير_موقع = الطول(الأرقام) مثل غير_موقع;
        بينما (م > 0) {
            م := م - 1;
            لو (م > 0) {
                ألحق(الناتج, (الأرقام[م] | 0x80) مثل غ8);
            } وإلا {
                ألحق(الناتج, الأرقام[م] مثل غ8);
            };
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف der_oid_from_text = معرف_كائن_من_نص;

// Encodes one element with a definite minimal length (X.690 10.1).
عام عرف رمز_عنصر_دي_إي_آر(الوسم: غير_موقع, المحتوى: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    ألحق(الناتج, الوسم مثل غ8);
    دع الحجم: غير_موقع = الطول(*المحتوى) مثل غير_موقع;
    لو (الحجم < 0x80) {
        ألحق(الناتج, الحجم مثل غ8);
    } وإلا {
        دع البايتات: متغير متجه غير_موقع = [];
        دع الباقي: متغير غير_موقع = الحجم;
        بينما (الباقي != 0) {
            ألحق(البايتات, الباقي & 0xFF);
            الباقي := الباقي >> 8;
        }
        دع العدد: غير_موقع = الطول(البايتات) مثل غير_موقع;
        ألحق(الناتج, (0x80 | العدد) مثل غ8);
        دع ف: متغير غير_موقع = العدد;
        بينما (ف > 0) {
            ف := ف - 1;
            ألحق(الناتج, البايتات[ف] مثل غ8);
        }
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        ألحق(الناتج, (*المحتوى)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف der_encode_element = رمز_عنصر_دي_إي_آر;

// ---- BER to DER normalization (X.690 8.1.3.6, 8.7.3, 10.1, 10.2) ---------
// PKCS#12 files written by Windows and Java use BER: indefinite lengths and
// constructed OCTET STRINGs made of segments. Normalization rewrites every
// length in the minimal definite form and joins the segments of a universal
// constructed OCTET STRING into one primitive string. Context-specific
// constructed elements are kept constructed: whether they are an IMPLICIT
// string is known only to the schema, which must join their segments itself.
// High tag numbers are refused; nesting is limited to 64 levels.

نوع عنصر_محول_بي_إي_آر = {
    الترميز: متجه غ8,
    // The tag, and for a primitive element its content (to join segments).
    الوسم: غير_موقع,
    المحتوى: متجه غ8,
    النهاية: غير_موقع
};

عرف ترميز_طول_دي_إي_آر(الهدف: &متغير متجه غ8, الوسم: غير_موقع, المحتوى: &متجه غ8): فراغ {
    دع المرمز: متجه غ8 = رمز_عنصر_دي_إي_آر(الوسم, المحتوى);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المرمز) مثل غير_موقع)) {
        ألحق(*الهدف, المرمز[ف]);
        ف := ف + 1;
    }
}

عرف حول_عنصر_بي_إي_آر(المصدر: &متجه غ8, الموضع: غير_موقع, الحد: غير_موقع, العمق: غير_موقع): اختيار عنصر_محول_بي_إي_آر {
    لو (العمق > 64 || الموضع + 2 > الحد) { أرجع اختيار.لا_شيء(); };
    دع الوسم: غير_موقع = (*المصدر)[الموضع] مثل غير_موقع;
    لو ((الوسم & 0x1F) == 0x1F || الوسم == 0) { أرجع اختيار.لا_شيء(); };
    دع مركب: منطقي = (الوسم & 0x20) != 0;
    دع الأول: غير_موقع = (*المصدر)[الموضع + 1] مثل غير_موقع;
    دع البداية: متغير غير_موقع = الموضع + 2;
    دع غير_محدد: منطقي = الأول == 0x80;
    دع النهاية_المحددة: متغير غير_موقع = الحد;
    لو (!غير_محدد) {
        دع الطول_الفعلي: متغير غير_موقع = 0;
        لو (الأول < 0x80) {
            الطول_الفعلي := الأول;
        } وإلا {
            دع العدد: غير_موقع = الأول & 0x7F;
            لو (العدد > 4 || البداية + العدد > الحد) { أرجع اختيار.لا_شيء(); };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < العدد) {
                الطول_الفعلي := (الطول_الفعلي << 8) | ((*المصدر)[البداية + ف] مثل غير_موقع);
                ف := ف + 1;
            }
            البداية := البداية + العدد;
        };
        لو (الطول_الفعلي > الحد - البداية) { أرجع اختيار.لا_شيء(); };
        النهاية_المحددة := البداية + الطول_الفعلي;
    };
    لو (!مركب) {
        لو (غير_محدد) { أرجع اختيار.لا_شيء(); };
        دع المحتوى: متجه غ8 = شريحة_بايتات_دي_إي_آر(المصدر, البداية, النهاية_المحددة);
        دع الترميز: متغير متجه غ8 = [];
        ترميز_طول_دي_إي_آر(&متغير الترميز, الوسم, &المحتوى);
        دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: الوسم, المحتوى: المحتوى, النهاية: النهاية_المحددة };
        أرجع اختيار.بعض(الناتج);
    };
    // Constructed: convert the children until the end or the end-of-contents.
    دع الأبناء: متغير متجه غ8 = [];
    دع المقاطع: متغير متجه غ8 = [];
    دع كلها_مقاطع: متغير منطقي = صواب;
    دع الموضع_الحالي: متغير غير_موقع = البداية;
    دع انتهى: متغير منطقي = خطأ;
    بينما (!انتهى) {
        لو (غير_محدد) {
            لو (الموضع_الحالي + 2 > الحد) { أرجع اختيار.لا_شيء(); };
            لو ((*المصدر)[الموضع_الحالي] == 0 && (*المصدر)[الموضع_الحالي + 1] == 0) {
                الموضع_الحالي := الموضع_الحالي + 2;
                انتهى := صواب;
            };
        } وإلا لو (الموضع_الحالي >= النهاية_المحددة) {
            انتهى := صواب;
        };
        لو (!انتهى) {
            طابق حول_عنصر_بي_إي_آر(المصدر, الموضع_الحالي, النهاية_المحددة, العمق + 1) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(الابن) -> {
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الابن.الترميز) مثل غير_موقع)) {
                    ألحق(الأبناء, الابن.الترميز[ف]);
                    ف := ف + 1;
                }
                لو (الابن.الوسم == 0x04) {
                    ف := 0;
                    بينما (ف < (الطول(الابن.المحتوى) مثل غير_موقع)) {
                        ألحق(المقاطع, الابن.المحتوى[ف]);
                        ف := ف + 1;
                    }
                } وإلا {
                    كلها_مقاطع := خطأ;
                };
                الموضع_الحالي := الابن.النهاية;
            };
        };
    }
    دع الترميز: متغير متجه غ8 = [];
    لو (الوسم == 0x24) {
        // A constructed OCTET STRING: its segments joined (8.7.3).
        لو (!كلها_مقاطع) { أرجع اختيار.لا_شيء(); };
        ترميز_طول_دي_إي_آر(&متغير الترميز, 0x04, &المقاطع);
        دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: 0x04, المحتوى: المقاطع, النهاية: الموضع_الحالي };
        أرجع اختيار.بعض(الناتج);
    };
    ترميز_طول_دي_إي_آر(&متغير الترميز, الوسم, &الأبناء);
    دع لا_محتوى: متجه غ8 = [];
    دع الناتج: عنصر_محول_بي_إي_آر = { الترميز: الترميز, الوسم: الوسم, المحتوى: لا_محتوى, النهاية: الموضع_الحالي };
    أرجع اختيار.بعض(الناتج);
}

عرف شريحة_بايتات_دي_إي_آر(المصدر: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The DER form of one BER element filling the whole input; none when the
// input is not valid BER.
عام عرف حول_بي_إي_آر_إلى_دي_إي_آر(المصدر: &متجه غ8): اختيار متجه غ8 {
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    طابق حول_عنصر_بي_إي_آر(المصدر, 0, الحجم, 0) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(العنصر) -> {
        لو (العنصر.النهاية != الحجم) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(*(&العنصر.الترميز));
    };
}

عام مرادف der_from_ber = حول_بي_إي_آر_إلى_دي_إي_آر;
