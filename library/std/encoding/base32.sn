استورد text.from_bytes;

عام نوع خطأ_قاعدة32 =
    | طول_غير_صالح
    | محرف_غير_صالح بنوع غير_موقع
    | حشو_غير_صالح بنوع غير_موقع
;

عرف محرف_قاعدة32(القيمة: غير_موقع): غ8 {
    لو (القيمة < 26) { أرجع (0x41 + القيمة) مثل غ8; };
    أرجع (0x32 + (القيمة - 26)) مثل غ8;
}

عرف قيمة_قاعدة32(البايت: غ8): عدد {
    لو ((البايت >= 0x41) && (البايت <= 0x5A)) { أرجع (البايت - 0x41) مثل عدد; };
    لو ((البايت >= 0x32) && (البايت <= 0x37)) { أرجع ((البايت - 0x32) + 26) مثل عدد; };
    أرجع -1;
}

عام عرف رمز_قاعدة32(البايتات: &متجه غ8): نص {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع المخزن: متغير غير_موقع = 0;
    دع البتات: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        المخزن := (المخزن << 8) | (المصدر[ف] مثل غير_موقع);
        البتات := البتات + 8;
        بينما (البتات >= 5) {
            البتات := البتات - 5;
            دع المزاح: غير_موقع = المخزن >> البتات;
            دع الرمز: غير_موقع = المزاح & 31;
            ألحق(الناتج, محرف_قاعدة32(الرمز));
            لو (البتات == 0) { المخزن := 0; }
            وإلا { المخزن := المخزن & ((1 << البتات) - 1); };
        }
        ف := ف + 1;
    }
    لو (البتات > 0) {
        دع مقدار_اليسار: غير_موقع = 5 - البتات;
        دع المزاح: غير_موقع = المخزن << مقدار_اليسار;
        دع الرمز: غير_موقع = المزاح & 31;
        ألحق(الناتج, محرف_قاعدة32(الرمز));
    };
    بينما (((الطول(الناتج) مثل غير_موقع) % 8) != 0) { ألحق(الناتج, 0x3D); }
    أرجع من_بايتات(&الناتج);
}

عرف حشو_قاعدة32_متوقع(عدد_الرموز: غير_موقع): اختيار غير_موقع {
    دع الباقي: غير_موقع = عدد_الرموز % 8;
    لو (الباقي == 0) { أرجع اختيار.بعض(0); };
    لو (الباقي == 2) { أرجع اختيار.بعض(6); };
    لو (الباقي == 4) { أرجع اختيار.بعض(4); };
    لو (الباقي == 5) { أرجع اختيار.بعض(3); };
    لو (الباقي == 7) { أرجع اختيار.بعض(1); };
    أرجع اختيار.لا_شيء();
}

عام عرف فك_قاعدة32(النص: &نص): نتيجة متجه غ8, خطأ_قاعدة32 {
    دع المصدر: نص = *النص;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    لو ((العدد % 8) != 0) { أرجع نتيجة.خطأ(خطأ_قاعدة32.طول_غير_صالح()); };
    دع بداية_الحشو: متغير غير_موقع = العدد;
    دع استمر_الحشو: متغير منطقي = صواب;
    بينما ((بداية_الحشو > 0) && استمر_الحشو) {
        دع السابق: غير_موقع = بداية_الحشو - 1;
        لو (المصدر[السابق] == 0x3D) { بداية_الحشو := السابق; } وإلا { استمر_الحشو := خطأ; };
    }
    دع عدد_الحشو: غير_موقع = العدد - بداية_الحشو;
    دع المتوقع: متغير غير_موقع = 0;
    طابق حشو_قاعدة32_متوقع(بداية_الحشو) مع
    | اختيار.بعض(قيمة) -> { المتوقع := قيمة; }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };
    لو (عدد_الحشو != المتوقع) { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };

    دع الناتج: متغير متجه غ8 = [];
    دع المخزن: متغير غير_موقع = 0;
    دع البتات: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < بداية_الحشو) {
        دع القيمة: عدد = قيمة_قاعدة32(المصدر[ف]);
        لو (القيمة < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة32.محرف_غير_صالح(ف)); };
        المخزن := (المخزن << 5) | (القيمة مثل غير_موقع);
        البتات := البتات + 5;
        بينما (البتات >= 8) {
            البتات := البتات - 8;
            دع المزاح: غير_موقع = المخزن >> البتات;
            دع المقنع: غير_موقع = المزاح & 0xFF;
            دع البايت: غ8 = المقنع مثل غ8;
            ألحق(الناتج, البايت);
            لو (البتات == 0) { المخزن := 0; }
            وإلا { المخزن := المخزن & ((1 << البتات) - 1); };
        }
        ف := ف + 1;
    }
    لو ((البتات > 0) && (المخزن != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };
    أرجع نتيجة.نجح(الناتج);
}

عام نوع base32_error = خطأ_قاعدة32;
عام مرادف base32_encode = رمز_قاعدة32;
عام مرادف base32_decode = فك_قاعدة32;
