استورد text.from_bytes;

عام نوع خطأ_قاعدة32 =
    | طول_غير_صالح
    | محرف_غير_صالح بنوع طبيعي
    | حشو_غير_صالح بنوع طبيعي
;

عرف محرف_قاعدة32(القيمة: طبيعي): ط8 {
    لو (القيمة < 26) { أرجع (0x41 + القيمة) مثل ط8; };
    أرجع (0x32 + (القيمة - 26)) مثل ط8;
}

عرف قيمة_قاعدة32(البايت: ط8): عدد {
    لو ((البايت >= 0x41) && (البايت <= 0x5A)) { أرجع (البايت - 0x41) مثل عدد; };
    لو ((البايت >= 0x32) && (البايت <= 0x37)) { أرجع ((البايت - 0x32) + 26) مثل عدد; };
    أرجع -1;
}

عام عرف رمز_قاعدة32(البايتات: &متجه ط8): نص {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع المخزن: متغير طبيعي = 0;
    دع البتات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        المخزن := (المخزن << 8) | (المصدر[ف] مثل طبيعي);
        البتات := البتات + 8;
        طالما (البتات >= 5) {
            البتات := البتات - 5;
            دع المزاح: طبيعي = المخزن >> البتات;
            دع الرمز: طبيعي = المزاح & 31;
            ألحق(الناتج, محرف_قاعدة32(الرمز));
            لو (البتات == 0) { المخزن := 0; }
            وإلا { المخزن := المخزن & ((1 << البتات) - 1); };
        }
        ف := ف + 1;
    }
    لو (البتات > 0) {
        دع مقدار_اليسار: طبيعي = 5 - البتات;
        دع المزاح: طبيعي = المخزن << مقدار_اليسار;
        دع الرمز: طبيعي = المزاح & 31;
        ألحق(الناتج, محرف_قاعدة32(الرمز));
    };
    طالما (((الطول(الناتج) مثل طبيعي) % 8) != 0) { ألحق(الناتج, 0x3D); }
    أرجع من_بايتات(&الناتج);
}

عرف حشو_قاعدة32_متوقع(عدد_الرموز: طبيعي): اختياري طبيعي {
    دع الباقي: طبيعي = عدد_الرموز % 8;
    لو (الباقي == 0) { أرجع اختياري.موجود(0); };
    لو (الباقي == 2) { أرجع اختياري.موجود(6); };
    لو (الباقي == 4) { أرجع اختياري.موجود(4); };
    لو (الباقي == 5) { أرجع اختياري.موجود(3); };
    لو (الباقي == 7) { أرجع اختياري.موجود(1); };
    أرجع اختياري.لا_شيء();
}

عام عرف فك_قاعدة32(النص: &نص): نتيجة متجه ط8, خطأ_قاعدة32 {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    لو ((العدد % 8) != 0) { أرجع نتيجة.خطأ(خطأ_قاعدة32.طول_غير_صالح()); };
    دع بداية_الحشو: متغير طبيعي = العدد;
    دع استمر_الحشو: متغير منطقي = صواب;
    طالما ((بداية_الحشو > 0) && استمر_الحشو) {
        دع السابق: طبيعي = بداية_الحشو - 1;
        لو (المصدر[السابق] == 0x3D) { بداية_الحشو := السابق; } وإلا { استمر_الحشو := خطأ; };
    }
    دع عدد_الحشو: طبيعي = العدد - بداية_الحشو;
    دع المتوقع: متغير طبيعي = 0;
    طابق حشو_قاعدة32_متوقع(بداية_الحشو) مع
    | اختياري.موجود(قيمة) -> { المتوقع := قيمة; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };
    لو (عدد_الحشو != المتوقع) { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };

    دع الناتج: متغير متجه ط8 = [];
    دع المخزن: متغير طبيعي = 0;
    دع البتات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < بداية_الحشو) {
        دع القيمة: عدد = قيمة_قاعدة32(المصدر[ف]);
        لو (القيمة < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة32.محرف_غير_صالح(ف)); };
        المخزن := (المخزن << 5) | (القيمة مثل طبيعي);
        البتات := البتات + 5;
        طالما (البتات >= 8) {
            البتات := البتات - 8;
            دع المزاح: طبيعي = المخزن >> البتات;
            دع المقنع: طبيعي = المزاح & 0xFF;
            دع البايت: ط8 = المقنع مثل ط8;
            ألحق(الناتج, البايت);
            لو (البتات == 0) { المخزن := 0; }
            وإلا { المخزن := المخزن & ((1 << البتات) - 1); };
        }
        ف := ف + 1;
    }
    لو ((البتات > 0) && (المخزن != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة32.حشو_غير_صالح(بداية_الحشو)); };
    أرجع نتيجة.نجح(الناتج);
}

عام نوع base32_error = خطأ_قاعدة32;
عام مرادف base32_encode = رمز_قاعدة32;
عام مرادف base32_decode = فك_قاعدة32;
