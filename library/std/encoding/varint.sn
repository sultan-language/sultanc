// Unsigned LEB128 / varint codec for compact binary protocols.
عام نوع خطأ_فارنت =
    | مبتور
    | فائض
;

عام عرف رمز_فارنت(القيمة: غ64): متجه غ8 {
    دع الباقي: متغير غ64 = القيمة;
    دع الناتج: متغير متجه غ8 = [];
    بينما (الباقي >= 0x80) {
        دع منخفض: غ64 = الباقي & 0x7F;
        دع مع_استمرار: غ64 = منخفض | 0x80;
        دع البايت: غ8 = مع_استمرار مثل غ8;
        ألحق(الناتج, البايت);
        الباقي := الباقي >> 7;
    }
    دع الأخير64: غ64 = الباقي & 0x7F;
    دع الأخير: غ8 = الأخير64 مثل غ8;
    ألحق(الناتج, الأخير);
    أرجع الناتج;
}

عام عرف فك_فارنت_من(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    المستهلك: &متغير غير_موقع
): نتيجة غ64, خطأ_فارنت {
    دع المصدر: متجه غ8 = *البايتات;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    *المستهلك := 0;
    لو (البداية >= العدد) { أرجع نتيجة.خطأ(خطأ_فارنت.مبتور()); };

    دع القيمة: متغير غ64 = 0;
    دع العامل: متغير غ64 = 1;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 10) {
        دع الموضع: غير_موقع = البداية + ف;
        لو (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_فارنت.مبتور()); };
        دع البايت: غ8 = المصدر[الموضع];
        دع حمولة8: غ8 = البايت & 0x7F;
        دع الحمولة: غ64 = حمولة8 مثل غ64;
        لو ((ف == 9) && (الحمولة > 1)) { أرجع نتيجة.خطأ(خطأ_فارنت.فائض()); };
        القيمة := القيمة + (الحمولة * العامل);
        لو ((البايت & 0x80) == 0) {
            *المستهلك := ف + 1;
            أرجع نتيجة.نجح(القيمة);
        };
        العامل := العامل * 128;
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
}

عام عرف فك_فارنت(البايتات: &متجه غ8): نتيجة غ64, خطأ_فارنت {
    دع المستهلك: متغير غير_موقع = 0;
    طابق فك_فارنت_من(البايتات, 0, &متغير المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        لو (المستهلك != (الطول(*البايتات) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
        };
        أرجع نتيجة.نجح(القيمة);
    };
}

عام مرادف varint_error = خطأ_فارنت;
عام مرادف varint_encode = رمز_فارنت;
عام مرادف varint_decode_from = فك_فارنت_من;
عام مرادف varint_decode = فك_فارنت;
عام مرادف varint_error.truncated = خطأ_فارنت.مبتور;
عام مرادف varint_error.overflow = خطأ_فارنت.فائض;

// Signed values use ZigZag mapping, then the same unsigned LEB128 wire form.
عام عرف زيغزاغ_رمز_موقع(القيمة: عدد): غ64 {
    لو (القيمة >= 0) {
        دع موجب: غير_موقع = القيمة مثل غير_موقع;
        أرجع (موجب * 2) مثل غ64;
    };
    // -(value + 1) avoids overflow for the minimum signed value.
    دع المقدار: عدد = 0 - (القيمة + 1);
    دع موجب: غير_موقع = المقدار مثل غير_موقع;
    أرجع ((موجب * 2) + 1) مثل غ64;
}

عام عرف زيغزاغ_فك_موقع(القيمة: غ64): عدد {
    دع الخام: غير_موقع = القيمة مثل غير_موقع;
    دع النصف: غير_موقع = الخام >> 1;
    لو ((الخام & 1) == 0) { أرجع النصف مثل عدد; };
    أرجع 0 - (النصف مثل عدد) - 1;
}

عام عرف رمز_فارنت_موقع(القيمة: عدد): متجه غ8 {
    دع المرمز: غ64 = زيغزاغ_رمز_موقع(القيمة);
    أرجع رمز_فارنت(المرمز);
}

عام عرف فك_فارنت_موقع_من(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    المستهلك: &متغير غير_موقع
): نتيجة عدد, خطأ_فارنت {
    طابق فك_فارنت_من(البايتات, البداية, المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(زيغزاغ_فك_موقع(القيمة)); };
}

عام عرف فك_فارنت_موقع(البايتات: &متجه غ8): نتيجة عدد, خطأ_فارنت {
    دع المستهلك: متغير غير_موقع = 0;
    طابق فك_فارنت_موقع_من(البايتات, 0, &متغير المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        لو (المستهلك != (الطول(*البايتات) مثل غير_موقع)) {
            أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
        };
        أرجع نتيجة.نجح(القيمة);
    };
}

عام مرادف zigzag_encode_i64 = زيغزاغ_رمز_موقع;
عام مرادف zigzag_decode_i64 = زيغزاغ_فك_موقع;
عام مرادف signed_varint_encode = رمز_فارنت_موقع;
عام مرادف signed_varint_decode_from = فك_فارنت_موقع_من;
عام مرادف signed_varint_decode = فك_فارنت_موقع;
