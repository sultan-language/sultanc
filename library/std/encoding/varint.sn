// Unsigned LEB128 / varint codec for compact binary protocols.
عام نوع خطأ_فارنت =
    | مبتور
    | فائض
;

عام عرف رمز_فارنت(القيمة: ط64): متجه ط8 {
    دع الباقي: متغير ط64 = القيمة;
    دع الناتج: متغير متجه ط8 = [];
    طالما (الباقي >= 0x80) {
        دع منخفض: ط64 = الباقي & 0x7F;
        دع مع_استمرار: ط64 = منخفض | 0x80;
        دع البايت: ط8 = مع_استمرار مثل ط8;
        ألحق(الناتج, البايت);
        الباقي := الباقي >> 7;
    }
    دع الأخير64: ط64 = الباقي & 0x7F;
    دع الأخير: ط8 = الأخير64 مثل ط8;
    ألحق(الناتج, الأخير);
    أرجع الناتج;
}

عام عرف فك_فارنت_من(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    المستهلك: &متغير طبيعي
): نتيجة ط64, خطأ_فارنت {
    دع المصدر: متجه ط8 = *البايتات;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    *المستهلك := 0;
    إذا (البداية >= العدد) { أرجع نتيجة.خطأ(خطأ_فارنت.مبتور()); };

    دع القيمة: متغير ط64 = 0;
    دع العامل: متغير ط64 = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 10) {
        إذا (ف >= (العدد - البداية)) { أرجع نتيجة.خطأ(خطأ_فارنت.مبتور()); };
        دع الموضع: طبيعي = البداية + ف;
        دع البايت: ط8 = المصدر[الموضع];
        دع حمولة8: ط8 = البايت & 0x7F;
        دع الحمولة: ط64 = حمولة8 مثل ط64;
        إذا ((ف == 9) && (الحمولة > 1)) { أرجع نتيجة.خطأ(خطأ_فارنت.فائض()); };
        القيمة := القيمة + (الحمولة * العامل);
        إذا ((البايت & 0x80) == 0) {
            *المستهلك := ف + 1;
            أرجع نتيجة.نجح(القيمة);
        };
        إذا (ف == 9) { أرجع نتيجة.خطأ(خطأ_فارنت.فائض()); };
        العامل := العامل * 128;
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
}

عام عرف فك_فارنت(البايتات: &متجه ط8): نتيجة ط64, خطأ_فارنت {
    دع المستهلك: متغير طبيعي = 0;
    طابق فك_فارنت_من(البايتات, 0, &متغير المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        إذا (المستهلك != (الطول(*البايتات) مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
        };
        أرجع نتيجة.نجح(القيمة);
    };
}

عام مرادف varint_error = خطأ_فارنت;
عام مرادف varint_encode = رمز_فارنت;
عام مرادف varint_decode_from = فك_فارنت_من;
عام مرادف varint_decode = فك_فارنت;
عام مرادف varint_error.truncated = خطأ_فارنت.مبتور;
عام مرادف varint_error.overflow = خطأ_فارنت.فائض;

// Signed values use ZigZag mapping, then the same unsigned LEB128 wire form.
عام عرف زيغزاغ_رمز_موقع(القيمة: عدد): ط64 {
    إذا (القيمة >= 0) {
        دع موجب: طبيعي = القيمة مثل طبيعي;
        أرجع (موجب * 2) مثل ط64;
    };
    // -(value + 1) avoids overflow for the minimum signed value.
    دع المقدار: عدد = 0 - (القيمة + 1);
    دع موجب: طبيعي = المقدار مثل طبيعي;
    أرجع ((موجب * 2) + 1) مثل ط64;
}

عام عرف زيغزاغ_فك_موقع(القيمة: ط64): عدد {
    دع الخام: طبيعي = القيمة مثل طبيعي;
    دع النصف: طبيعي = الخام >> 1;
    إذا ((الخام & 1) == 0) { أرجع النصف مثل عدد; };
    أرجع 0 - (النصف مثل عدد) - 1;
}

عام عرف رمز_فارنت_موقع(القيمة: عدد): متجه ط8 {
    دع المرمز: ط64 = زيغزاغ_رمز_موقع(القيمة);
    أرجع رمز_فارنت(المرمز);
}

عام عرف فك_فارنت_موقع_من(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    المستهلك: &متغير طبيعي
): نتيجة عدد, خطأ_فارنت {
    طابق فك_فارنت_من(البايتات, البداية, المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(زيغزاغ_فك_موقع(القيمة)); };
}

عام عرف فك_فارنت_موقع(البايتات: &متجه ط8): نتيجة عدد, خطأ_فارنت {
    دع المستهلك: متغير طبيعي = 0;
    طابق فك_فارنت_موقع_من(البايتات, 0, &متغير المستهلك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        إذا (المستهلك != (الطول(*البايتات) مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
        };
        أرجع نتيجة.نجح(القيمة);
    };
}

عام مرادف zigzag_encode_i64 = زيغزاغ_رمز_موقع;
عام مرادف zigzag_decode_i64 = زيغزاغ_فك_موقع;
عام مرادف signed_varint_encode = رمز_فارنت_موقع;
عام مرادف signed_varint_decode_from = فك_فارنت_موقع_من;
عام مرادف signed_varint_decode = فك_فارنت_موقع;

// ---- LEB128 helpers for object formats (DWARF, WebAssembly, Mach-O) ----
//
// The same unsigned wire form as رمز_فارنت, appended to a buffer, plus the
// two's-complement signed form (SLEB128: DWARF sdata, WebAssembly s32/s64
// immediates, Mach-O binds), which is not ZigZag. Integer arithmetic traps
// on overflow, so the bit work stays inside uint: no group is shifted past
// bit 63.

// Appends القيمة as unsigned LEB128 (one to ten bytes).
عام عرف ألحق_ليب128(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    طالما (الباقي >= 0x80) {
        ألحق(*الناتج, ((الباقي & 0x7F) | 0x80) مثل ط8);
        الباقي := الباقي >> 7;
    }
    ألحق(*الناتج, الباقي مثل ط8);
}

// The bytes ألحق_ليب128 writes for القيمة.
عام عرف حجم_ليب128(القيمة: طبيعي): طبيعي {
    دع الباقي: متغير طبيعي = القيمة >> 7;
    دع الحجم: متغير طبيعي = 1;
    طالما (الباقي > 0) { الحجم := الحجم + 1; الباقي := الباقي >> 7; }
    أرجع الحجم;
}

// Appends القيمة as signed (two's-complement) LEB128: the shortest form
// whose last group's bit 6 is the sign.
عام عرف ألحق_ليب128_موقعا(الناتج: &متغير متجه ط8, القيمة: عدد): فراغ {
    دع الباقي: متغير عدد = القيمة;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        // The remainder toward -infinity: 0..127, and an exact division.
        دع الجزء_الموقع: متغير عدد = الباقي % 128;
        إذا (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: طبيعي = الجزء_الموقع مثل طبيعي;
        الباقي := (الباقي - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        إذا ((الباقي == 0 && !بت_الإشارة) || (الباقي == -1 && بت_الإشارة)) {
            ألحق(*الناتج, الجزء مثل ط8);
            مستمر := خطأ;
        } وإلا {
            ألحق(*الناتج, (الجزء | 0x80) مثل ط8);
        };
    }
}

// Reads a signed LEB128 value at البداية; المستهلك is the bytes it took.
// مبتور when the input ends inside it; فائض when it does not fit 64 bits
// (a tenth group other than the sign extension of bit 63, or an eleventh).
عام عرف فك_ليب128_موقع_من(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    المستهلك: &متغير طبيعي
): نتيجة عدد, خطأ_فارنت {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    *المستهلك := 0;
    دع البتات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 10) {
        إذا (البداية >= العدد || ف >= (العدد - البداية)) { أرجع نتيجة.خطأ(خطأ_فارنت.مبتور()); };
        دع البايت: طبيعي = (*البايتات)[البداية + ف] مثل طبيعي;
        دع الحمولة: طبيعي = البايت & 0x7F;
        دع الأخير: منطقي = (البايت & 0x80) == 0;
        إذا (ف == 9) {
            // Bit 63 and its sign extension: 0x00 or 0x7F, and nothing after.
            إذا (!الأخير || (الحمولة != 0 && الحمولة != 0x7F)) { أرجع نتيجة.خطأ(خطأ_فارنت.فائض()); };
            إذا (الحمولة == 0x7F) { البتات := البتات | (1 << 63); };
            *المستهلك := 10;
            أرجع نتيجة.نجح(البتات مثل عدد);
        };
        البتات := البتات | (الحمولة << (ف * 7));
        إذا (الأخير) {
            دع الإزاحة: طبيعي = (ف + 1) * 7;
            إذا ((الحمولة & 0x40) != 0) {
                // Sign-extend above bit الإزاحة - 1.
                دع الكل: طبيعي = ~((0 مثل طبيعي));
                البتات := البتات | (الكل - ((1 << الإزاحة) - 1));
            };
            *المستهلك := ف + 1;
            أرجع نتيجة.نجح(البتات مثل عدد);
        };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_فارنت.فائض());
}

// The العرض bytes (1..10) of القيمة's unsigned LEB128 form padded with
// continuation bytes, the fixed-width fields WebAssembly relocations patch
// in place. None when العرض is outside 1..10 or القيمة needs more than
// 7 * العرض bits.
عرف بايتات_ليب128_مبطنة(القيمة: طبيعي, العرض: طبيعي): اختياري متجه ط8 {
    إذا (العرض == 0 || العرض > 10) { أرجع اختياري.لا_شيء(); };
    إذا (العرض < 10 && (القيمة >> (العرض * 7)) != 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع الجزء: طبيعي = الباقي & 0x7F;
        الباقي := الباقي >> 7;
        إذا (ف + 1 < العرض) { ألحق(الناتج, (الجزء | 0x80) مثل ط8); }
        وإلا { ألحق(الناتج, الجزء مثل ط8); };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// The same for a signed value over العرض bytes (1..9): القيمة's two's
// complement in 7 * العرض bits, so it must lie in -2^(7w-1) .. 2^(7w-1) - 1.
عرف بايتات_ليب128_موقع_مبطنة(القيمة: عدد, العرض: طبيعي): اختياري متجه ط8 {
    إذا (العرض == 0 || العرض > 9) { أرجع اختياري.لا_شيء(); };
    دع النصف: طبيعي = 1 << ((العرض * 7) - 1);
    دع البتات: متغير طبيعي = 0;
    إذا (القيمة >= 0) {
        إذا ((القيمة مثل طبيعي) >= النصف) { أرجع اختياري.لا_شيء(); };
        البتات := القيمة مثل طبيعي;
    } وإلا {
        // -القيمة cannot overflow: |القيمة| <= 2^62 once the range holds.
        إذا (القيمة < -((النصف مثل عدد))) { أرجع اختياري.لا_شيء(); };
        البتات := (النصف * 2) - ((0 - القيمة) مثل طبيعي);
    };
    أرجع بايتات_ليب128_مبطنة(البتات, العرض);
}

عرف اكتب_بايتات_ليب128_عند(البايتات: &متغير متجه ط8, الموضع: طبيعي, المرمز: &متجه ط8): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع العرض: طبيعي = الطول(*المرمز) مثل طبيعي;
    إذا (الموضع > العدد || العرض > العدد - الموضع) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) { (*البايتات)[الموضع + ف] := (*المرمز)[ف]; ف := ف + 1; }
    أرجع صواب;
}

عرف ألحق_بايتات_ليب128(الناتج: &متغير متجه ط8, المرمز: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرمز) مثل طبيعي)) { ألحق(*الناتج, (*المرمز)[ف]); ف := ف + 1; }
}

// Appends the padded form; false (nothing appended) when it does not fit.
عام عرف ألحق_ليب128_مبطنا(الناتج: &متغير متجه ط8, القيمة: طبيعي, العرض: طبيعي): منطقي {
    طابق بايتات_ليب128_مبطنة(القيمة, العرض) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز) -> { ألحق_بايتات_ليب128(الناتج, &المرمز); أرجع صواب; };
}

عام عرف ألحق_ليب128_موقعا_مبطنا(الناتج: &متغير متجه ط8, القيمة: عدد, العرض: طبيعي): منطقي {
    طابق بايتات_ليب128_موقع_مبطنة(القيمة, العرض) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز) -> { ألحق_بايتات_ليب128(الناتج, &المرمز); أرجع صواب; };
}

// Overwrites العرض bytes at الموضع with the padded form (patching a
// relocated field); false, nothing written, when it does not fit the value
// or the buffer.
عام عرف اكتب_ليب128_مبطنا_عند(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي, العرض: طبيعي): منطقي {
    طابق بايتات_ليب128_مبطنة(القيمة, العرض) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز) -> { أرجع اكتب_بايتات_ليب128_عند(البايتات, الموضع, &المرمز); };
}

عام عرف اكتب_ليب128_موقعا_مبطنا_عند(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: عدد, العرض: طبيعي): منطقي {
    طابق بايتات_ليب128_موقع_مبطنة(القيمة, العرض) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز) -> { أرجع اكتب_بايتات_ليب128_عند(البايتات, الموضع, &المرمز); };
}

عام مرادف uleb128_append = ألحق_ليب128;
عام مرادف uleb128_size = حجم_ليب128;
عام مرادف uleb128_decode_from = فك_فارنت_من;
عام مرادف sleb128_append = ألحق_ليب128_موقعا;
عام مرادف sleb128_decode_from = فك_ليب128_موقع_من;
عام مرادف uleb128_append_padded = ألحق_ليب128_مبطنا;
عام مرادف sleb128_append_padded = ألحق_ليب128_موقعا_مبطنا;
عام مرادف uleb128_write_padded_at = اكتب_ليب128_مبطنا_عند;
عام مرادف sleb128_write_padded_at = اكتب_ليب128_موقعا_مبطنا_عند;
