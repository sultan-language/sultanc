// PEM textual encoding (RFC 7468): BEGIN/END labelled base64 blocks, as used
// by CA bundles, certificates and keys. Whitespace inside a block is ignored;
// a block with mismatched labels or invalid base64 is skipped, and the caller
// decides whether that is acceptable (a CA bundle may contain other blocks).

استورد bytes.compare;
استورد chars.ascii;
استورد encoding.base64;
استورد text.from_bytes;

عام نوع كتلة_بي_إي_إم = {
    الوصف: متجه ط8,
    البيانات: متجه ط8
};

// All well-formed blocks in order.
عام عرف فك_بي_إي_إم(المصدر: &متجه ط8): متجه كتلة_بي_إي_إم {
    دع الكتل: متغير متجه كتلة_بي_إي_إم = [];
    دع بداية_العلامة: متجه ط8 = بايتات_من_نص(«-----BEGIN »);
    دع نهاية_العلامة: متجه ط8 = بايتات_من_نص(«-----END »);
    دع الشرطات: متجه ط8 = بايتات_من_نص(«-----»);
    دع الحجم: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم) {
        دع بداية: طبيعي;
        طابق ابحث_بايتات_من(المصدر, &بداية_العلامة, الموضع) مع
        | اختياري.لا_شيء -> { اخرج_من_حلقة; }
        | اختياري.موجود(م) -> { بداية := م; };
        دع بداية_الوصف: طبيعي = بداية + (الطول(بداية_العلامة) مثل طبيعي);
        دع نهاية_الوصف: طبيعي;
        طابق ابحث_بايتات_من(المصدر, &الشرطات, بداية_الوصف) مع
        | اختياري.لا_شيء -> { اخرج_من_حلقة; }
        | اختياري.موجود(م) -> { نهاية_الوصف := م; };
        دع الوصف: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = بداية_الوصف;
        طالما (ف < نهاية_الوصف) {
            ألحق(الوصف, (*المصدر)[ف]);
            ف := ف + 1;
        }
        دع بداية_الجسم: طبيعي = نهاية_الوصف + (الطول(الشرطات) مثل طبيعي);
        // The matching END line carries the same label.
        دع علامة_الختام: متغير متجه ط8 = [];
        ف := 0;
        طالما (ف < (الطول(نهاية_العلامة) مثل طبيعي)) { ألحق(علامة_الختام, نهاية_العلامة[ف]); ف := ف + 1; }
        ف := 0;
        طالما (ف < (الطول(الوصف) مثل طبيعي)) { ألحق(علامة_الختام, الوصف[ف]); ف := ف + 1; }
        ف := 0;
        طالما (ف < (الطول(الشرطات) مثل طبيعي)) { ألحق(علامة_الختام, الشرطات[ف]); ف := ف + 1; }
        دع نهاية_الجسم: طبيعي;
        طابق ابحث_بايتات_من(المصدر, &علامة_الختام, بداية_الجسم) مع
        | اختياري.لا_شيء -> { اخرج_من_حلقة; }
        | اختياري.موجود(م) -> { نهاية_الجسم := م; };
        دع الجسم: متغير متجه ط8 = [];
        ف := بداية_الجسم;
        طالما (ف < نهاية_الجسم) {
            دع ب: ط8 = (*المصدر)[ف];
            إذا (!فاصل_أسكي(ب)) { ألحق(الجسم, ب); };
            ف := ف + 1;
        }
        دع نص_الجسم: نص = من_بايتات(&الجسم);
        طابق فك_قاعدة64(&نص_الجسم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(البيانات) -> {
            دع الكتلة: كتلة_بي_إي_إم = { الوصف: الوصف, البيانات: البيانات };
            ألحق(الكتل, الكتلة);
        };
        الموضع := نهاية_الجسم + (الطول(علامة_الختام) مثل طبيعي);
    }
    أرجع الكتل;
}

// The DER contents of every block with the given label.
عام عرف كتل_بي_إي_إم_بوصف(المصدر: &متجه ط8, الوصف: نص): متجه متجه ط8 {
    دع المطلوب: متجه ط8 = بايتات_من_نص(الوصف);
    دع الكتل: متغير متجه كتلة_بي_إي_إم = فك_بي_إي_إم(المصدر);
    دع الناتج: متغير متجه متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكتل) مثل طبيعي)) {
        إذا (متجها_بايتات_متساويان(&الكتل[ف].الوصف, &المطلوب)) {
            // The decoded blocks are owned here: take each matching payload.
            دع البيانات: متغير متجه ط8 = [];
            بدّل(الكتل[ف].البيانات, البيانات);
            ألحق(الناتج, البيانات);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف pem_block = كتلة_بي_إي_إم;
عام مرادف pem_decode = فك_بي_إي_إم;
عام مرادف pem_blocks_with_label = كتل_بي_إي_إم_بوصف;
