// PEM textual encoding (RFC 7468): BEGIN/END labelled base64 blocks, as used
// by CA bundles, certificates and keys. Whitespace inside a block is ignored;
// a block with mismatched labels or invalid base64 is skipped, and the caller
// decides whether that is acceptable (a CA bundle may contain other blocks).

استورد bytes.compare;
استورد chars.ascii;
استورد encoding.base64;
استورد text.from_bytes;

عام نوع كتلة_بي_إي_إم = {
    الوصف: متجه غ8,
    البيانات: متجه غ8
};

// All well-formed blocks in order.
عام عرف فك_بي_إي_إم(المصدر: &متجه غ8): متجه كتلة_بي_إي_إم {
    دع الكتل: متغير متجه كتلة_بي_إي_إم = [];
    دع بداية_العلامة: متجه غ8 = بايتات_من_نص(«-----BEGIN »);
    دع نهاية_العلامة: متجه غ8 = بايتات_من_نص(«-----END »);
    دع الشرطات: متجه غ8 = بايتات_من_نص(«-----»);
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < الحجم) {
        دع بداية: غير_موقع;
        طابق ابحث_بايتات_من(المصدر, &بداية_العلامة, الموضع) مع
        | اختيار.لا_شيء -> { اخرج_من_حلقة; }
        | اختيار.بعض(م) -> { بداية := م; };
        دع بداية_الوصف: غير_موقع = بداية + (الطول(بداية_العلامة) مثل غير_موقع);
        دع نهاية_الوصف: غير_موقع;
        طابق ابحث_بايتات_من(المصدر, &الشرطات, بداية_الوصف) مع
        | اختيار.لا_شيء -> { اخرج_من_حلقة; }
        | اختيار.بعض(م) -> { نهاية_الوصف := م; };
        دع الوصف: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = بداية_الوصف;
        بينما (ف < نهاية_الوصف) {
            ألحق(الوصف, (*المصدر)[ف]);
            ف := ف + 1;
        }
        دع بداية_الجسم: غير_موقع = نهاية_الوصف + (الطول(الشرطات) مثل غير_موقع);
        // The matching END line carries the same label.
        دع علامة_الختام: متغير متجه غ8 = [];
        ف := 0;
        بينما (ف < (الطول(نهاية_العلامة) مثل غير_موقع)) { ألحق(علامة_الختام, نهاية_العلامة[ف]); ف := ف + 1; }
        ف := 0;
        بينما (ف < (الطول(الوصف) مثل غير_موقع)) { ألحق(علامة_الختام, الوصف[ف]); ف := ف + 1; }
        ف := 0;
        بينما (ف < (الطول(الشرطات) مثل غير_موقع)) { ألحق(علامة_الختام, الشرطات[ف]); ف := ف + 1; }
        دع نهاية_الجسم: غير_موقع;
        طابق ابحث_بايتات_من(المصدر, &علامة_الختام, بداية_الجسم) مع
        | اختيار.لا_شيء -> { اخرج_من_حلقة; }
        | اختيار.بعض(م) -> { نهاية_الجسم := م; };
        دع الجسم: متغير متجه غ8 = [];
        ف := بداية_الجسم;
        بينما (ف < نهاية_الجسم) {
            دع ب: غ8 = (*المصدر)[ف];
            لو (!فاصل_أسكي(ب)) { ألحق(الجسم, ب); };
            ف := ف + 1;
        }
        دع نص_الجسم: نص = من_بايتات(&الجسم);
        طابق فك_قاعدة64(&نص_الجسم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(البيانات) -> {
            دع الكتلة: كتلة_بي_إي_إم = { الوصف: الوصف, البيانات: البيانات };
            ألحق(الكتل, الكتلة);
        };
        الموضع := نهاية_الجسم + (الطول(علامة_الختام) مثل غير_موقع);
    }
    أرجع الكتل;
}

// The DER contents of every block with the given label.
عام عرف كتل_بي_إي_إم_بوصف(المصدر: &متجه غ8, الوصف: نص): متجه متجه غ8 {
    دع المطلوب: متجه غ8 = بايتات_من_نص(الوصف);
    دع الكتل: متجه كتلة_بي_إي_إم = فك_بي_إي_إم(المصدر);
    دع الناتج: متغير متجه متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الكتل) مثل غير_موقع)) {
        لو (متجها_بايتات_متساويان(&الكتل[ف].الوصف, &المطلوب)) {
            دع البيانات: &متجه غ8 = &الكتل[ف].البيانات;
            ألحق(الناتج, *البيانات);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف pem_block = كتلة_بي_إي_إم;
عام مرادف pem_decode = فك_بي_إي_إم;
عام مرادف pem_blocks_with_label = كتل_بي_إي_إم_بوصف;
