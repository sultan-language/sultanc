استورد bytes.range;
استورد text.range;

// ترميز UTF-8 عام يعمل على النص مباشرة ولا يعتمد على تمثيل source في المصرّف.
عام نوع فك_يوتيف8 = {
    صالح: منطقي,
    القيمة: غ32,
    العرض: غير_موقع
};

// تصنيف بايت الاستمرار حقيقة ميكانيكية واحدة داخل stdlib.
عام عرف بايت_استمرار_يوتيف8(البايت: غ8): منطقي {
    أرجع (البايت & 0xC0) == 0x80;
}

// سياسة واحدة لصلاحية Unicode scalar تستعملها القراءة والترميز والlexer.
عام عرف صالح_كسلم_يونيكود(القيمة: غ32): منطقي {
    أرجع (القيمة <= 0x10FFFF) && !((القيمة >= 0xD800) && (القيمة <= 0xDFFF));
}

عام نوع نتيجة_ترميز_يوتيف8 =
    | مشفر بنوع متجه غ8
    | قيمة_غير_صالحة
;

عرف نتيجة_فك(
    صالح: منطقي,
    القيمة: غ32,
    العرض: غير_موقع
): فك_يوتيف8 {
    دع الناتج: فك_يوتيف8 = {
        صالح: صالح,
        القيمة: القيمة,
        العرض: العرض
    };
    أرجع الناتج;
}

نوع نافذة_فك_يوتيف8 = {
    المتاح: غير_موقع,
    الأول: غ8,
    الثاني: غ8,
    الثالث: غ8,
    الرابع: غ8
};

عرف نافذة_فك_فارغة(): نافذة_فك_يوتيف8 {
    دع النافذة: نافذة_فك_يوتيف8 = {
        المتاح: 0,
        الأول: 0,
        الثاني: 0,
        الثالث: 0,
        الرابع: 0
    };
    أرجع النافذة;
}

عرف بايت_من_نافذة_فك_يوتيف8(
    النافذة: &نافذة_فك_يوتيف8,
    الفهرس: غير_موقع
): غ8 {
    دع القيمة: نافذة_فك_يوتيف8 = *النافذة;
    لو (الفهرس == 0) {
        أرجع القيمة.الأول;
    };
    لو (الفهرس == 1) {
        أرجع القيمة.الثاني;
    };
    لو (الفهرس == 2) {
        أرجع القيمة.الثالث;
    };
    لو (الفهرس == 3) {
        أرجع القيمة.الرابع;
    };
    أرجع 0;
}

عرف فك_نافذة_يوتيف8(النافذة: &نافذة_فك_يوتيف8): فك_يوتيف8 {
    دع المدخل: نافذة_فك_يوتيف8 = *النافذة;
    لو (المدخل.المتاح == 0) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };

    دع الأول: غ8 = المدخل.الأول;
    لو (الأول <= 0x7F) {
        أرجع نتيجة_فك(صواب, الأول, 1);
    };

    دع العرض: متغير غير_موقع = 0;
    دع القيمة: متغير غ32 = 0;
    لو ((الأول >= 0xC2) && (الأول <= 0xDF)) {
        العرض := 2;
        القيمة := (الأول مثل غ32) & 0x1F;
    }
    وإلا {
        لو ((الأول >= 0xE0) && (الأول <= 0xEF)) {
            العرض := 3;
            القيمة := (الأول مثل غ32) & 0x0F;
        }
        وإلا {
            لو ((الأول >= 0xF0) && (الأول <= 0xF4)) {
                العرض := 4;
                القيمة := (الأول مثل غ32) & 7;
            }
            وإلا {
                أرجع نتيجة_فك(خطأ, 0, 0);
            };
        };
    };

    لو (العرض > المدخل.المتاح) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };

    دع الفهرس: متغير غير_موقع = 1;
    بينما (الفهرس < العرض) {
        دع البايت: غ8 = بايت_من_نافذة_فك_يوتيف8(النافذة, الفهرس);
        لو (!بايت_استمرار_يوتيف8(البايت)) {
            أرجع نتيجة_فك(خطأ, 0, 0);
        };
        القيمة := (القيمة << 6) | ((البايت مثل غ32) & 0x3F);
        الفهرس := الفهرس + 1;
    }

    لو ((العرض == 2) && (القيمة < 0x80)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو ((العرض == 3) && (القيمة < 0x800)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو ((العرض == 4) && (القيمة < 0x10000)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو (!صالح_كسلم_يونيكود(القيمة)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    أرجع نتيجة_فك(صواب, القيمة, العرض);
}

عرف نافذة_فك_من_بايتات(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): نافذة_فك_يوتيف8 {
    دع النافذة: متغير نافذة_فك_يوتيف8 = نافذة_فك_فارغة();
    دع القيمة: متجه غ8 = *البايتات;

    لو (!متاح_في_البايتات(البايتات, الموضع, 1)) {
        أرجع النافذة;
    };
    النافذة.الأول := القيمة[الموضع];
    النافذة.المتاح := 1;

    لو (!متاح_في_البايتات(البايتات, الموضع, 2)) {
        أرجع النافذة;
    };
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    النافذة.الثاني := القيمة[الموضع_الثاني];
    النافذة.المتاح := 2;

    لو (!متاح_في_البايتات(البايتات, الموضع, 3)) {
        أرجع النافذة;
    };
    دع الموضع_الثالث: غير_موقع = الموضع + 2;
    النافذة.الثالث := القيمة[الموضع_الثالث];
    النافذة.المتاح := 3;

    لو (!متاح_في_البايتات(البايتات, الموضع, 4)) {
        أرجع النافذة;
    };
    دع الموضع_الرابع: غير_موقع = الموضع + 3;
    النافذة.الرابع := القيمة[الموضع_الرابع];
    النافذة.المتاح := 4;
    أرجع النافذة;
}

عرف نافذة_فك_من_نص(النص: &نص, الموضع: غير_موقع): نافذة_فك_يوتيف8 {
    دع النافذة: متغير نافذة_فك_يوتيف8 = نافذة_فك_فارغة();
    دع القيمة: نص = *النص;

    لو (!متاح_في_النص(النص, الموضع, 1)) {
        أرجع النافذة;
    };
    النافذة.الأول := القيمة[الموضع];
    النافذة.المتاح := 1;

    لو (!متاح_في_النص(النص, الموضع, 2)) {
        أرجع النافذة;
    };
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    النافذة.الثاني := القيمة[الموضع_الثاني];
    النافذة.المتاح := 2;

    لو (!متاح_في_النص(النص, الموضع, 3)) {
        أرجع النافذة;
    };
    دع الموضع_الثالث: غير_موقع = الموضع + 2;
    النافذة.الثالث := القيمة[الموضع_الثالث];
    النافذة.المتاح := 3;

    لو (!متاح_في_النص(النص, الموضع, 4)) {
        أرجع النافذة;
    };
    دع الموضع_الرابع: غير_موقع = الموضع + 3;
    النافذة.الرابع := القيمة[الموضع_الرابع];
    النافذة.المتاح := 4;
    أرجع النافذة;
}

عام عرف فك_محرف_يوتيف8_من_بايتات(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): فك_يوتيف8 {
    دع النافذة: نافذة_فك_يوتيف8 = نافذة_فك_من_بايتات(البايتات, الموضع);
    أرجع فك_نافذة_يوتيف8(&النافذة);
}

عام عرف فك_محرف_يوتيف8(النص: &نص, الموضع: غير_موقع): فك_يوتيف8 {
    دع النافذة: نافذة_فك_يوتيف8 = نافذة_فك_من_نص(النص, الموضع);
    أرجع فك_نافذة_يوتيف8(&النافذة);
}

عام عرف ألحق_محرف_يوتيف8(البايتات: متجه غ8, القيمة: غ32): نتيجة_ترميز_يوتيف8 {
    دع الناتج: متغير متجه غ8 = البايتات;
    لو (!صالح_كسلم_يونيكود(القيمة)) {
        أرجع نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة();
    };
    لو (القيمة <= 0x7F) {
        ألحق(الناتج, القيمة مثل غ8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    لو (القيمة <= 0x7FF) {
        ألحق(الناتج, (0xC0 | (القيمة >> 6)) مثل غ8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    لو (القيمة <= 0xFFFF) {
        ألحق(الناتج, (0xE0 | (القيمة >> 12)) مثل غ8);
        ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل غ8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    ألحق(الناتج, (0xF0 | (القيمة >> 18)) مثل غ8);
    ألحق(الناتج, (0x80 | ((القيمة >> 12) & 0x3F)) مثل غ8);
    ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل غ8);
    ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل غ8);
    أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
}
// مكرر محارف UTF-8 يحتفظ بموضع البايت ويعيد السلم والعرض دون نسخ النص.
عام نوع مكرر_محارف_يوتيف8 = {
    النص: نص,
    الموضع: غير_موقع
};

عام نوع خطوة_مكرر_محارف_يوتيف8 =
    | نهاية
    | محرف بنوع (غ32, غير_موقع, غير_موقع)
    | يوتيف8_غير_صالح بنوع غير_موقع
;

عام عرف أنشئ_مكرر_محارف_يوتيف8(النص: &نص): مكرر_محارف_يوتيف8 {
    دع القيمة: نص = *النص;
    دع المكرر: مكرر_محارف_يوتيف8 = { النص: القيمة, الموضع: 0 };
    أرجع المكرر;
}

عام عرف التالي_في_مكرر_محارف_يوتيف8(
    المكرر: &متغير مكرر_محارف_يوتيف8
): خطوة_مكرر_محارف_يوتيف8 {
    دع الحالة: متغير مكرر_محارف_يوتيف8 = *المكرر;
    دع العدد: غير_موقع = الطول(الحالة.النص) مثل غير_موقع;
    لو (الحالة.الموضع >= العدد) {
        أرجع خطوة_مكرر_محارف_يوتيف8.نهاية();
    };
    دع البداية: غير_موقع = الحالة.الموضع;
    دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&الحالة.النص, البداية);
    لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
        أرجع خطوة_مكرر_محارف_يوتيف8.يوتيف8_غير_صالح(البداية);
    };
    الحالة.الموضع := البداية + المفكوك.العرض;
    *المكرر := الحالة;
    أرجع خطوة_مكرر_محارف_يوتيف8.محرف(المفكوك.القيمة, البداية, المفكوك.العرض);
}

// الأسماء العامة الإنجليزية ترتبط بالتصريحات والرموز التابعة العربية نفسها.
عام مرادف utf8_decode_result = فك_يوتيف8;
عام مرادف is_utf8_continuation_byte = بايت_استمرار_يوتيف8;
عام مرادف is_unicode_scalar_value = صالح_كسلم_يونيكود;
عام مرادف utf8_encode_result = نتيجة_ترميز_يوتيف8;
عام مرادف decode_utf8_char_from_bytes = فك_محرف_يوتيف8_من_بايتات;
عام مرادف decode_utf8_char = فك_محرف_يوتيف8;
عام مرادف append_utf8_char = ألحق_محرف_يوتيف8;

عام مرادف utf8_encode_result.encoded = نتيجة_ترميز_يوتيف8.مشفر;
عام مرادف utf8_encode_result.invalid_value = نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة;

عام مرادف utf8_codepoint_iterator = مكرر_محارف_يوتيف8;
عام مرادف utf8_iterator_step = خطوة_مكرر_محارف_يوتيف8;
عام مرادف new_utf8_codepoint_iterator = أنشئ_مكرر_محارف_يوتيف8;
عام مرادف utf8_next = التالي_في_مكرر_محارف_يوتيف8;
عام مرادف utf8_iterator_step.end = خطوة_مكرر_محارف_يوتيف8.نهاية;
عام مرادف utf8_iterator_step.codepoint = خطوة_مكرر_محارف_يوتيف8.محرف;
عام مرادف utf8_iterator_step.invalid_utf8 = خطوة_مكرر_محارف_يوتيف8.يوتيف8_غير_صالح;
