استورد text.from_bytes;
استورد unicode.scalar;
استورد bytes.range;
استورد text.range;

// ترميز UTF-8 عام يعمل على النص مباشرة ولا يعتمد على تمثيل source في المصرّف.
عام نوع فك_يوتيف8 = {
    صالح: منطقي,
    القيمة: ط32,
    العرض: طبيعي
};

// تصنيف بايت الاستمرار حقيقة ميكانيكية واحدة داخل stdlib.
عام عرف بايت_استمرار_يوتيف8(البايت: ط8): منطقي {
    أرجع (البايت & 0xC0) == 0x80;
}

// Preserve the compiler lexer and UTF-8 decoder ABI. Unicode scalar
// validity itself has one canonical implementation in std.unicode.scalar.
عام عرف صالح_كسلم_يونيكود(القيمة: ط32): منطقي {
    أرجع قيمة_يونيكود_قياسية_صالحة(القيمة);
}

عام نوع نتيجة_ترميز_يوتيف8 =
    | مشفر بنوع متجه ط8
    | قيمة_غير_صالحة
;

عرف نتيجة_فك(
    صالح: منطقي,
    القيمة: ط32,
    العرض: طبيعي
): فك_يوتيف8 {
    دع الناتج: فك_يوتيف8 = {
        صالح: صالح,
        القيمة: القيمة,
        العرض: العرض
    };
    أرجع الناتج;
}

// Decodes one scalar from up to four bytes, of which المتاح are present
// (المتاح >= 1). Callers read the bytes once with a single bound check.
// Previously each decode built a four-byte window record through four
// availability checks and read it back through an index helper, which was the
// largest lexer cost of a compiler self-build; the accepted and rejected
// sequences are unchanged.
عرف فك_بايتات_يوتيف8(
    الأول: ط8,
    الثاني: ط8,
    الثالث: ط8,
    الرابع: ط8,
    المتاح: طبيعي
): فك_يوتيف8 {
    لو (الأول <= 0x7F) {
        أرجع نتيجة_فك(صواب, الأول, 1);
    };
    دع العرض: متغير طبيعي = 0;
    دع القيمة: متغير ط32 = 0;
    لو ((الأول >= 0xC2) && (الأول <= 0xDF)) {
        العرض := 2;
        القيمة := (الأول مثل ط32) & 0x1F;
    } وإلا لو ((الأول >= 0xE0) && (الأول <= 0xEF)) {
        العرض := 3;
        القيمة := (الأول مثل ط32) & 0x0F;
    } وإلا لو ((الأول >= 0xF0) && (الأول <= 0xF4)) {
        العرض := 4;
        القيمة := (الأول مثل ط32) & 7;
    } وإلا {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو (العرض > المتاح) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو (!بايت_استمرار_يوتيف8(الثاني)) { أرجع نتيجة_فك(خطأ, 0, 0); };
    القيمة := (القيمة << 6) | ((الثاني مثل ط32) & 0x3F);
    لو (العرض >= 3) {
        لو (!بايت_استمرار_يوتيف8(الثالث)) { أرجع نتيجة_فك(خطأ, 0, 0); };
        القيمة := (القيمة << 6) | ((الثالث مثل ط32) & 0x3F);
    };
    لو (العرض == 4) {
        لو (!بايت_استمرار_يوتيف8(الرابع)) { أرجع نتيجة_فك(خطأ, 0, 0); };
        القيمة := (القيمة << 6) | ((الرابع مثل ط32) & 0x3F);
    };
    لو ((العرض == 2) && (القيمة < 0x80)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو ((العرض == 3) && (القيمة < 0x800)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو ((العرض == 4) && (القيمة < 0x10000)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    لو (!صالح_كسلم_يونيكود(القيمة)) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    أرجع نتيجة_فك(صواب, القيمة, العرض);
}

عام عرف فك_محرف_يوتيف8_من_بايتات(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): فك_يوتيف8 {
    دع الطول_الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو (الموضع >= الطول_الكلي) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    دع الأول: ط8 = (*البايتات)[الموضع];
    لو (الأول <= 0x7F) {
        أرجع نتيجة_فك(صواب, الأول, 1);
    };
    دع المتاح: متغير طبيعي = الطول_الكلي - الموضع;
    لو (المتاح > 4) { المتاح := 4; };
    دع الثاني: متغير ط8 = 0;
    دع الثالث: متغير ط8 = 0;
    دع الرابع: متغير ط8 = 0;
    لو (المتاح >= 2) { الثاني := (*البايتات)[الموضع + 1]; };
    لو (المتاح >= 3) { الثالث := (*البايتات)[الموضع + 2]; };
    لو (المتاح >= 4) { الرابع := (*البايتات)[الموضع + 3]; };
    أرجع فك_بايتات_يوتيف8(الأول, الثاني, الثالث, الرابع, المتاح);
}

عام عرف فك_محرف_يوتيف8(النص: &نص, الموضع: طبيعي): فك_يوتيف8 {
    دع الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    لو (الموضع >= الطول_الكلي) {
        أرجع نتيجة_فك(خطأ, 0, 0);
    };
    دع الأول: ط8 = (*النص)[الموضع];
    لو (الأول <= 0x7F) {
        أرجع نتيجة_فك(صواب, الأول, 1);
    };
    دع المتاح: متغير طبيعي = الطول_الكلي - الموضع;
    لو (المتاح > 4) { المتاح := 4; };
    دع الثاني: متغير ط8 = 0;
    دع الثالث: متغير ط8 = 0;
    دع الرابع: متغير ط8 = 0;
    لو (المتاح >= 2) { الثاني := (*النص)[الموضع + 1]; };
    لو (المتاح >= 3) { الثالث := (*النص)[الموضع + 2]; };
    لو (المتاح >= 4) { الرابع := (*النص)[الموضع + 3]; };
    أرجع فك_بايتات_يوتيف8(الأول, الثاني, الثالث, الرابع, المتاح);
}

عام عرف ألحق_محرف_يوتيف8(البايتات: متجه ط8, القيمة: ط32): نتيجة_ترميز_يوتيف8 {
    دع الناتج: متغير متجه ط8 = البايتات;
    لو (!صالح_كسلم_يونيكود(القيمة)) {
        أرجع نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة();
    };
    لو (القيمة <= 0x7F) {
        ألحق(الناتج, القيمة مثل ط8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    لو (القيمة <= 0x7FF) {
        ألحق(الناتج, (0xC0 | (القيمة >> 6)) مثل ط8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل ط8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    لو (القيمة <= 0xFFFF) {
        ألحق(الناتج, (0xE0 | (القيمة >> 12)) مثل ط8);
        ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل ط8);
        ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل ط8);
        أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
    };
    ألحق(الناتج, (0xF0 | (القيمة >> 18)) مثل ط8);
    ألحق(الناتج, (0x80 | ((القيمة >> 12) & 0x3F)) مثل ط8);
    ألحق(الناتج, (0x80 | ((القيمة >> 6) & 0x3F)) مثل ط8);
    ألحق(الناتج, (0x80 | (القيمة & 0x3F)) مثل ط8);
    أرجع نتيجة_ترميز_يوتيف8.مشفر(الناتج);
}
// مكرر محارف UTF-8 يحتفظ بموضع البايت ويعيد السلم والعرض دون نسخ النص.
عام نوع مكرر_محارف_يوتيف8 = {
    النص: نص,
    الموضع: طبيعي
};

عام نوع خطوة_مكرر_محارف_يوتيف8 =
    | نهاية
    | محرف بنوع (ط32, طبيعي, طبيعي)
    | يوتيف8_غير_صالح بنوع طبيعي
;

عام عرف أنشئ_مكرر_محارف_يوتيف8(النص: &نص): مكرر_محارف_يوتيف8 {
    // The iterator owns an independent copy of the text it walks.
    دع المكرر: مكرر_محارف_يوتيف8 = { النص: انسخ_نص(النص), الموضع: 0 };
    أرجع المكرر;
}

عام عرف التالي_في_مكرر_محارف_يوتيف8(
    المكرر: &متغير مكرر_محارف_يوتيف8
): خطوة_مكرر_محارف_يوتيف8 {
    دع العدد: طبيعي = الطول((*المكرر).النص) مثل طبيعي;
    لو ((*المكرر).الموضع >= العدد) {
        أرجع خطوة_مكرر_محارف_يوتيف8.نهاية();
    };
    دع البداية: طبيعي = (*المكرر).الموضع;
    دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&(*المكرر).النص, البداية);
    لو (!المفكوك.صالح || (المفكوك.العرض == 0)) {
        // Invalid byte sequences must advance the iterator. Rust separates
        // strict UTF-8 validation from lossy decoding for this reason.
        (*المكرر).الموضع := البداية + 1;
        أرجع خطوة_مكرر_محارف_يوتيف8.يوتيف8_غير_صالح(البداية);
    };
    (*المكرر).الموضع := البداية + المفكوك.العرض;
    أرجع خطوة_مكرر_محارف_يوتيف8.محرف(المفكوك.القيمة, البداية, المفكوك.العرض);
}

// الأسماء العامة الإنجليزية ترتبط بالتصريحات والرموز التابعة العربية نفسها.
عام مرادف utf8_decode_result = فك_يوتيف8;
عام مرادف is_utf8_continuation_byte = بايت_استمرار_يوتيف8;
عام مرادف is_unicode_scalar_value = صالح_كسلم_يونيكود;
عام مرادف utf8_encode_result = نتيجة_ترميز_يوتيف8;
عام مرادف decode_utf8_char_from_bytes = فك_محرف_يوتيف8_من_بايتات;
عام مرادف decode_utf8_char = فك_محرف_يوتيف8;
عام مرادف append_utf8_char = ألحق_محرف_يوتيف8;

عام مرادف utf8_encode_result.encoded = نتيجة_ترميز_يوتيف8.مشفر;
عام مرادف utf8_encode_result.invalid_value = نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة;

عام مرادف utf8_codepoint_iterator = مكرر_محارف_يوتيف8;
عام مرادف utf8_iterator_step = خطوة_مكرر_محارف_يوتيف8;
عام مرادف new_utf8_codepoint_iterator = أنشئ_مكرر_محارف_يوتيف8;
عام مرادف utf8_next = التالي_في_مكرر_محارف_يوتيف8;
عام مرادف utf8_iterator_step.end = خطوة_مكرر_محارف_يوتيف8.نهاية;
عام مرادف utf8_iterator_step.codepoint = خطوة_مكرر_محارف_يوتيف8.محرف;
عام مرادف utf8_iterator_step.invalid_utf8 = خطوة_مكرر_محارف_يوتيف8.يوتيف8_غير_صالح;
