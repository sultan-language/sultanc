// Writes at an offset (patching a header or a relocation in place): the
// value's bytes replace those at الموضع. False, and nothing written, when
// الموضع + width runs past the end; the vector never grows.
عرف اكتب_بايتات_ثنائية_عند(
    البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: ط64, العرض: طبيعي, الأكثر_أولا: منطقي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد || العرض > العدد - الموضع) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع الرتبة: متغير طبيعي = ف;
        إذا (الأكثر_أولا) { الرتبة := العرض - 1 - ف; };
        (*البايتات)[الموضع + ف] := ((القيمة >> ((الرتبة * 8) مثل ط64)) & 0xFF) مثل ط8;
        ف := ف + 1;
    }
    أرجع صواب;
}
عام عرف اكتب_ط16_بالبايت_الأقل_أهمية_أولا_عند(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: ط16): منطقي { أرجع اكتب_بايتات_ثنائية_عند(البايتات, الموضع, القيمة مثل ط64, 2, خطأ); }
عام عرف اكتب_ط16_بالبايت_الأكثر_أهمية_أولا_عند(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: ط16): منطقي { أرجع اكتب_بايتات_ثنائية_عند(البايتات, الموضع, القيمة مثل ط64, 2, صواب); }
