استورد bytes.range;

// Bounds-checked fixed-width integer encoding with explicit endianness.
عرف بايت_ثنائي_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 { أرجع (*البايتات)[الموضع]; }

عام عرف اقرأ_ط16_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط16 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 2)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((بايت_ثنائي_عند(البايتات, الموضع) مثل ط16) | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل ط16) << 8));
}
عام عرف اقرأ_ط16_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط16 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 2)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((((بايت_ثنائي_عند(البايتات, الموضع) مثل ط16) << 8) | (بايت_ثنائي_عند(البايتات, الموضع + 1) مثل ط16)));
}
عام عرف اقرأ_ط32_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط32 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 4)) { أرجع اختياري.لا_شيء(); };
    دع القيمة: ط32 = (بايت_ثنائي_عند(البايتات, الموضع) مثل ط32)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل ط32) << 8)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 2) مثل ط32) << 16)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 3) مثل ط32) << 24);
    أرجع اختياري.موجود(القيمة);
}
عام عرف اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط32 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 4)) { أرجع اختياري.لا_شيء(); };
    دع القيمة: ط32 = ((بايت_ثنائي_عند(البايتات, الموضع) مثل ط32) << 24)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل ط32) << 16)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 2) مثل ط32) << 8)
        | (بايت_ثنائي_عند(البايتات, الموضع + 3) مثل ط32);
    أرجع اختياري.موجود(القيمة);
}
عام عرف اقرأ_ط64_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط64 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 8)) { أرجع اختياري.لا_شيء(); };
    دع القيمة: متغير ط64 = 0; دع ف: متغير طبيعي = 0;
    طالما (ف < 8) { القيمة := القيمة | ((بايت_ثنائي_عند(البايتات, الموضع + ف) مثل ط64) << (ف * 8)); ف := ف + 1; }
    أرجع اختياري.موجود(القيمة);
}
عام عرف اقرأ_ط64_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه ط8, الموضع: طبيعي): اختياري ط64 {
    إذا (!متاح_في_البايتات(البايتات, الموضع, 8)) { أرجع اختياري.لا_شيء(); };
    دع القيمة: متغير ط64 = 0; دع ف: متغير طبيعي = 0;
    طالما (ف < 8) { القيمة := (القيمة << 8) | (بايت_ثنائي_عند(البايتات, الموضع + ف) مثل ط64); ف := ف + 1; }
    أرجع اختياري.موجود(القيمة);
}

عرف عدد_موقع_من_ط64(القيمة: ط64, البتات: طبيعي): عدد {
    دع القناع: متغير ط64 = ~(0 مثل ط64);
    إذا (البتات < 64) { القناع := ((1 مثل ط64) << البتات) - 1; };
    دع المقنع: ط64 = القيمة & القناع; دع الإشارة: ط64 = (1 مثل ط64) << (البتات - 1);
    إذا ((المقنع & الإشارة) == 0) { أرجع المقنع مثل عدد; };
    دع المقدار: ط64 = ((~المقنع) & القناع) + 1;
    إذا ((البتات == 64) && (المقدار == ((9223372036854775807 مثل ط64) + 1))) { أرجع (0 - 9223372036854775807) - 1; };
    أرجع 0 - (المقدار مثل عدد);
}
عام عرف اقرأ_ع16_بالبايت_الأقل_أهمية_أولا(ب: &متجه ط8, م: طبيعي): اختياري عدد { طابق اقرأ_ط16_بالبايت_الأقل_أهمية_أولا(ب, م) مع | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); } | اختياري.موجود(ق) -> { أرجع اختياري.موجود(عدد_موقع_من_ط64(ق مثل ط64,16)); }; }
عام عرف اقرأ_ع16_بالبايت_الأكثر_أهمية_أولا(ب: &متجه ط8, م: طبيعي): اختياري عدد { طابق اقرأ_ط16_بالبايت_الأكثر_أهمية_أولا(ب, م) مع | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); } | اختياري.موجود(ق) -> { أرجع اختياري.موجود(عدد_موقع_من_ط64(ق مثل ط64,16)); }; }
