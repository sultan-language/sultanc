عام عرف اكتب_غ16_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه غ8, القيمة: غ16): فراغ { ألحق(*الناتج,(القيمة & 0xFF) مثل غ8); ألحق(*الناتج,((القيمة>>8)&0xFF) مثل غ8); }
عام عرف اكتب_غ16_بالبايت_الأكثر_أهمية_أولا(الناتج: &متغير متجه غ8, القيمة: غ16): فراغ { ألحق(*الناتج,((القيمة>>8)&0xFF) مثل غ8); ألحق(*الناتج,(القيمة & 0xFF) مثل غ8); }
عام عرف اكتب_غ32_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه غ8, القيمة: غ32): فراغ { دع ف: متغير غير_موقع=0; بينما (ف<4) { ألحق(*الناتج,((القيمة>>(ف*8))&0xFF) مثل غ8); ف:=ف+1; } }
عام عرف اكتب_غ32_بالبايت_الأكثر_أهمية_أولا(الناتج: &متغير متجه غ8, القيمة: غ32): فراغ { دع ف: متغير غير_موقع=4; بينما (ف>0) { ف:=ف-1; ألحق(*الناتج,((القيمة>>(ف*8))&0xFF) مثل غ8); } }
عام عرف اكتب_غ64_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه غ8, القيمة: غ64): فراغ { دع ف: متغير غير_موقع=0; بينما (ف<8) { ألحق(*الناتج,((القيمة>>(ف*8))&0xFF) مثل غ8); ف:=ف+1; } }
