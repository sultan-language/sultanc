عام عرف اقرأ_ع32_بالبايت_الأكثر_أهمية_أولا(ب: &متجه ط8, م: طبيعي): اختياري عدد { طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا(ب, م) مع | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); } | اختياري.موجود(ق) -> { أرجع اختياري.موجود(عدد_موقع_من_ط64(ق مثل ط64,32)); }; }
عام عرف اقرأ_ع64_بالبايت_الأقل_أهمية_أولا(ب: &متجه ط8, م: طبيعي): اختياري عدد { طابق اقرأ_ط64_بالبايت_الأقل_أهمية_أولا(ب, م) مع | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); } | اختياري.موجود(ق) -> { أرجع اختياري.موجود(عدد_موقع_من_ط64(ق,64)); }; }
عام عرف اقرأ_ع64_بالبايت_الأكثر_أهمية_أولا(ب: &متجه ط8, م: طبيعي): اختياري عدد { طابق اقرأ_ط64_بالبايت_الأكثر_أهمية_أولا(ب, م) مع | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); } | اختياري.موجود(ق) -> { أرجع اختياري.موجود(عدد_موقع_من_ط64(ق,64)); }; }

عام عرف اكتب_ط16_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط16): فراغ { ألحق(*الناتج,(القيمة & 0xFF) مثل ط8); ألحق(*الناتج,((القيمة>>8)&0xFF) مثل ط8); }
عام عرف اكتب_ط16_بالبايت_الأكثر_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط16): فراغ { ألحق(*الناتج,((القيمة>>8)&0xFF) مثل ط8); ألحق(*الناتج,(القيمة & 0xFF) مثل ط8); }
عام عرف اكتب_ط32_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط32): فراغ { دع ف: متغير طبيعي=0; طالما (ف<4) { ألحق(*الناتج,((القيمة>>((ف*8) مثل ط32))&0xFF) مثل ط8); ف:=ف+1; } }
عام عرف اكتب_ط32_بالبايت_الأكثر_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط32): فراغ { دع ف: متغير طبيعي=4; طالما (ف>0) { ف:=ف-1; ألحق(*الناتج,((القيمة>>((ف*8) مثل ط32))&0xFF) مثل ط8); } }
عام عرف اكتب_ط64_بالبايت_الأقل_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط64): فراغ { دع ف: متغير طبيعي=0; طالما (ف<8) { ألحق(*الناتج,((القيمة>>((ف*8) مثل ط64))&0xFF) مثل ط8); ف:=ف+1; } }
عام عرف اكتب_ط64_بالبايت_الأكثر_أهمية_أولا(الناتج: &متغير متجه ط8, القيمة: ط64): فراغ { دع ف: متغير طبيعي=8; طالما (ف>0) { ف:=ف-1; ألحق(*الناتج,((القيمة>>((ف*8) مثل ط64))&0xFF) مثل ط8); } }
عرف خام_عدد_موقع(القيمة: عدد, البتات: طبيعي): اختياري ط64 {
    إذا ((البتات != 16) && (البتات != 32) && (البتات != 64)) { أرجع اختياري.لا_شيء(); };
    إذا ((البتات == 16) && ((القيمة < -32768) || (القيمة > 32767))) { أرجع اختياري.لا_شيء(); };
    إذا ((البتات == 32) && ((القيمة < -2147483648) || (القيمة > 2147483647))) { أرجع اختياري.لا_شيء(); };
    دع الخام: متغير ط64 = 0;
    إذا (القيمة >= 0) { الخام := القيمة مثل ط64; }
    وإلا إذا (القيمة == ((0 - 9223372036854775807) - 1)) { الخام := (9223372036854775807 مثل ط64) + 1; }
    وإلا {
        دع المقدار: ط64 = (0 - القيمة) مثل ط64;
        الخام := (~المقدار) + 1;
    };
    إذا (البتات == 16) { الخام := الخام & 0xFFFF; };
    إذا (البتات == 32) { الخام := الخام & 0xFFFFFFFF; };
    أرجع اختياري.موجود(الخام);
}
عام عرف اكتب_ع16_بالبايت_الأقل_أهمية_أولا(ن: &متغير متجه ط8, ق: عدد): منطقي { طابق خام_عدد_موقع(ق,16) مع | اختياري.لا_شيء -> { أرجع خطأ; } | اختياري.موجود(خ) -> { اكتب_ط16_بالبايت_الأقل_أهمية_أولا(ن,خ مثل ط16); أرجع صواب; }; }
