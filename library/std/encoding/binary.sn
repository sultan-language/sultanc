عرف خام_عدد_موقع(القيمة: عدد, البتات: غير_موقع): اختيار غ64 {
    لو ((البتات != 16) && (البتات != 32) && (البتات != 64)) { أرجع اختيار.لا_شيء(); };
    لو ((البتات == 16) && ((القيمة < -32768) || (القيمة > 32767))) { أرجع اختيار.لا_شيء(); };
    لو ((البتات == 32) && ((القيمة < -2147483648) || (القيمة > 2147483647))) { أرجع اختيار.لا_شيء(); };
    دع الخام: متغير غ64 = 0;
    لو (القيمة >= 0) { الخام := القيمة مثل غ64; }
    وإلا لو (القيمة == ((0 - 9223372036854775807) - 1)) { الخام := (9223372036854775807 مثل غ64) + 1; }
    وإلا {
        دع المقدار: غ64 = (0 - القيمة) مثل غ64;
        الخام := (~المقدار) + 1;
    };
    لو (البتات == 16) { الخام := الخام & 0xFFFF; };
    لو (البتات == 32) { الخام := الخام & 0xFFFFFFFF; };
    أرجع اختيار.بعض(الخام);
}
