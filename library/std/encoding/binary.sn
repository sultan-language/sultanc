// Bounds-checked fixed-width integer encoding with explicit endianness.
عرف بايت_ثنائي_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*البايتات)[الموضع]; }

عرف مدى_صالح(البايتات: &متجه غ8, الموضع: غير_موقع, العدد: غير_موقع): منطقي {
    دع الكلي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الكلي) { أرجع خطأ; };
    أرجع العدد <= (الكلي - الموضع);
}

عام عرف اقرأ_غ16_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ16 {
    لو (!مدى_صالح(البايتات, الموضع, 2)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((بايت_ثنائي_عند(البايتات, الموضع) مثل غ16) | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل غ16) << 8));
}
عام عرف اقرأ_غ16_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ16 {
    لو (!مدى_صالح(البايتات, الموضع, 2)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((((بايت_ثنائي_عند(البايتات, الموضع) مثل غ16) << 8) | (بايت_ثنائي_عند(البايتات, الموضع + 1) مثل غ16)));
}
عام عرف اقرأ_غ32_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ32 {
    لو (!مدى_صالح(البايتات, الموضع, 4)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: غ32 = (بايت_ثنائي_عند(البايتات, الموضع) مثل غ32)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل غ32) << 8)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 2) مثل غ32) << 16)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 3) مثل غ32) << 24);
    أرجع اختيار.بعض(القيمة);
}
عام عرف اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ32 {
    لو (!مدى_صالح(البايتات, الموضع, 4)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: غ32 = ((بايت_ثنائي_عند(البايتات, الموضع) مثل غ32) << 24)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 1) مثل غ32) << 16)
        | ((بايت_ثنائي_عند(البايتات, الموضع + 2) مثل غ32) << 8)
        | (بايت_ثنائي_عند(البايتات, الموضع + 3) مثل غ32);
    أرجع اختيار.بعض(القيمة);
}
عام عرف اقرأ_غ64_بالبايت_الأقل_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ64 {
    لو (!مدى_صالح(البايتات, الموضع, 8)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: متغير غ64 = 0; دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) { القيمة := القيمة | ((بايت_ثنائي_عند(البايتات, الموضع + ف) مثل غ64) << (ف * 8)); ف := ف + 1; }
    أرجع اختيار.بعض(القيمة);
}
عام عرف اقرأ_غ64_بالبايت_الأكثر_أهمية_أولا(البايتات: &متجه غ8, الموضع: غير_موقع): اختيار غ64 {
    لو (!مدى_صالح(البايتات, الموضع, 8)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: متغير غ64 = 0; دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) { القيمة := (القيمة << 8) | (بايت_ثنائي_عند(البايتات, الموضع + ف) مثل غ64); ف := ف + 1; }
    أرجع اختيار.بعض(القيمة);
}

عرف عدد_موقع_من_غ64(القيمة: غ64, البتات: غير_موقع): عدد {
    دع القناع: متغير غ64 = ~(0 مثل غ64);
    لو (البتات < 64) { القناع := ((1 مثل غ64) << البتات) - 1; };
    دع المقنع: غ64 = القيمة & القناع; دع الإشارة: غ64 = (1 مثل غ64) << (البتات - 1);
    لو ((المقنع & الإشارة) == 0) { أرجع المقنع مثل عدد; };
    دع المقدار: غ64 = ((~المقنع) & القناع) + 1;
    لو ((البتات == 64) && (المقدار == ((9223372036854775807 مثل غ64) + 1))) { أرجع (0 - 9223372036854775807) - 1; };
    أرجع 0 - (المقدار مثل عدد);
}
عام عرف اقرأ_ع16_بالبايت_الأقل_أهمية_أولا(ب: &متجه غ8, م: غير_موقع): اختيار عدد { طابق اقرأ_غ16_بالبايت_الأقل_أهمية_أولا(ب, م) مع | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); } | اختيار.بعض(ق) -> { أرجع اختيار.بعض(عدد_موقع_من_غ64(ق مثل غ64,16)); }; }
