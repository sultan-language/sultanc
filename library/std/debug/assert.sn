استورد text.from_bytes;
استورد process.exit;
استورد process.failure;

// Assertions remain active in all build modes. The condition is evaluated once.
// A failed assertion stops the program like إنهيار (std.process.panic): the
// iSpeak frame "the program stopped" with the reason "an assertion failed",
// in the program's language, on standard error, then status 1; owned values
// are not dropped.
عام عرف تأكد(الشرط: منطقي): فراغ {
    إذا (!الشرط) {
        دع بلا_رسالة: نص = «»;
        اطبع_فشل_تشغيل(2, &بلا_رسالة);
        اخرج(1);
    };
}

// An optional message, evaluated by the caller before the call, printed
// under the frame.
عام عرف تأكد_برسالة(الشرط: منطقي, الرسالة: &نص): فراغ {
    إذا (!الشرط) {
        اطبع_فشل_تشغيل(2, الرسالة);
        اخرج(1);
    };
}

عام مرادف assert = تأكد;
عام مرادف assert_with_message = تأكد_برسالة;
