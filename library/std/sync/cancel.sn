// Cooperative cancellation, as Go's context.Context and .NET's
// CancellationToken: a token is a shared flag plus an optional deadline on
// the monotonic clock. Work that may run long checks هل_ألغي_الرمز at its
// own safe points (between rows, chunks, retries) and stops; nothing is
// interrupted from outside. Copies made with استنسخ_رمز_إلغاء share the
// flag, so cancelling one cancels all; a child may carry an earlier deadline.
استورد sync.arc;
استورد sync.atomic;
استورد time.time;

عام نوع رمز_إلغاء = {
    العلم: مشترك<ذرة_ط32>,
    // Monotonic nanoseconds (time.time وقت_رتيب_نانو); 0 is no deadline.
    المهلة: عدد
};
عام مرادف cancel_token = رمز_إلغاء;

عرف الآن_رتيبا_إلغاء(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(الآن) -> { أرجع الآن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عام عرف أنشئ_رمز_إلغاء(): رمز_إلغاء {
    دع العلم: مشترك<ذرة_ط32> = أنشئ_مشترك(أنشئ_ذرة_ط32(0 مثل ط32));
    دع الرمز: رمز_إلغاء = { العلم: العلم, المهلة: 0 };
    أرجع الرمز;
}
عام مرادف cancel_token_new = أنشئ_رمز_إلغاء;

// A token whose deadline is المللي milliseconds from now.
عام عرف رمز_إلغاء_بمهلة(المللي: عدد): رمز_إلغاء {
    دع العلم: مشترك<ذرة_ط32> = أنشئ_مشترك(أنشئ_ذرة_ط32(0 مثل ط32));
    دع الرمز: رمز_إلغاء = { العلم: العلم, المهلة: الآن_رتيبا_إلغاء() + المللي * 1000000 };
    أرجع الرمز;
}
عام مرادف cancel_token_with_timeout = رمز_إلغاء_بمهلة;

// A token at an absolute monotonic deadline (nanoseconds; 0 none).
عام عرف رمز_إلغاء_حتى(المهلة_النانوية: عدد): رمز_إلغاء {
    دع العلم: مشترك<ذرة_ط32> = أنشئ_مشترك(أنشئ_ذرة_ط32(0 مثل ط32));
    دع الرمز: رمز_إلغاء = { العلم: العلم, المهلة: المهلة_النانوية };
    أرجع الرمز;
}
عام مرادف cancel_token_until = رمز_إلغاء_حتى;

// A copy sharing the flag and the deadline.
عام عرف استنسخ_رمز_إلغاء(الرمز: &رمز_إلغاء): رمز_إلغاء {
    دع الناتج: رمز_إلغاء = { العلم: استنسخ_مشترك(&(*الرمز).العلم), المهلة: (*الرمز).المهلة };
    أرجع الناتج;
}
عام مرادف cancel_token_clone = استنسخ_رمز_إلغاء;

// A copy sharing the flag whose deadline is the earlier of the parent's and
// المللي milliseconds from now (المللي 0 keeps the parent's).
عام عرف رمز_إلغاء_فرعي(الأب: &رمز_إلغاء, المللي: عدد): رمز_إلغاء {
    دع المهلة: متغير عدد = (*الأب).المهلة;
    إذا (المللي > 0) {
        دع الجديدة: عدد = الآن_رتيبا_إلغاء() + المللي * 1000000;
        إذا (المهلة == 0 || الجديدة < المهلة) { المهلة := الجديدة; };
    };
    دع الناتج: رمز_إلغاء = { العلم: استنسخ_مشترك(&(*الأب).العلم), المهلة: المهلة };
    أرجع الناتج;
}
عام مرادف cancel_token_child = رمز_إلغاء_فرعي;

عام عرف ألغ_الرمز(الرمز: &رمز_إلغاء): فراغ {
    اخزن_ط32(اقرأ_مشترك(&(*الرمز).العلم), 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
}
عام مرادف cancel = ألغ_الرمز;

// Cancelled explicitly, or past its deadline.
عام عرف هل_ألغي_الرمز(الرمز: &رمز_إلغاء): منطقي {
    إذا (احمل_ط32(اقرأ_مشترك(&(*الرمز).العلم), ترتيب_ذاكرة.اكتساب()) != (0 مثل ط32)) { أرجع صواب; };
    أرجع (*الرمز).المهلة != 0 && الآن_رتيبا_إلغاء() >= (*الرمز).المهلة;
}
عام مرادف is_cancelled = هل_ألغي_الرمز;

// Milliseconds left before the deadline (0 once passed); none without one.
عام عرف المتبقي_للرمز_بالمللي(الرمز: &رمز_إلغاء): اختياري عدد {
    إذا ((*الرمز).المهلة == 0) { أرجع اختياري.لا_شيء(); };
    دع الباقي: عدد = (*الرمز).المهلة - الآن_رتيبا_إلغاء();
    إذا (الباقي <= 0) { أرجع اختياري.موجود(0); };
    أرجع اختياري.موجود(الباقي / 1000000);
}
عام مرادف cancel_token_remaining_ms = المتبقي_للرمز_بالمللي;
