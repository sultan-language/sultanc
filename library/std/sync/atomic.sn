// Atomic integers (docs/CONCURRENCY.md). The compiler's atomic intrinsics
// (بدائي_ذري_*) operate on the integer a reference refers to, like Rust's
// std::sync::atomic: they read and write through a *shared* reference, which
// is the one sound point of interior mutability, so N threads sharing an
// `&ذرة_ط64` (through an Arc) may all fetch-add it. Every backend lowers them
// to the architecture's atomic instructions at sequentially-consistent
// strength; the interpreter, which runs one thread, performs them plainly.
//
// Memory orderings follow Rust's Ordering (and C/C++11). The backends treat
// every ordering as SeqCst, which is always sound; the order a caller asks
// for is recorded and honoured on targets whose weaker forms differ once the
// backends relax them.

مرادف احمل_ذري_بدائي = بدائي_ذري_حمل;
مرادف اخزن_ذري_بدائي = بدائي_ذري_خزن;
مرادف بدّل_ذري_بدائي = بدائي_ذري_تبديل;
مرادف قارن_وبدّل_ذري_بدائي = بدائي_ذري_قارن_وبدل;
مرادف اجلب_اجمع_ذري_بدائي = بدائي_ذري_جلب_جمع;
مرادف اجلب_و_ذري_بدائي = بدائي_ذري_جلب_و;
مرادف اجلب_أو_ذري_بدائي = بدائي_ذري_جلب_أو;
مرادف اجلب_أو_حصري_ذري_بدائي = بدائي_ذري_جلب_أو_حصري;
مرادف سياج_ذري_بدائي = بدائي_سياج_ذاكرة;

// Rust's Ordering. The code is the value the intrinsic takes.
عام نوع ترتيب_ذاكرة =
    | مسترخ
    | إطلاق
    | اكتساب
    | اكتساب_وإطلاق
    | تسلسلي
;
عام مرادف memory_ordering = ترتيب_ذاكرة;
عام مرادف memory_ordering.relaxed = ترتيب_ذاكرة.مسترخ;
عام مرادف memory_ordering.release = ترتيب_ذاكرة.إطلاق;
عام مرادف memory_ordering.acquire = ترتيب_ذاكرة.اكتساب;
عام مرادف memory_ordering.acq_rel = ترتيب_ذاكرة.اكتساب_وإطلاق;
عام مرادف memory_ordering.seq_cst = ترتيب_ذاكرة.تسلسلي;

عام عرف رمز_ترتيب(الترتيب: ترتيب_ذاكرة): ط32 {
    طابق الترتيب مع
    | ترتيب_ذاكرة.مسترخ -> { أرجع 0; }
    | ترتيب_ذاكرة.إطلاق -> { أرجع 1; }
    | ترتيب_ذاكرة.اكتساب -> { أرجع 2; }
    | ترتيب_ذاكرة.اكتساب_وإطلاق -> { أرجع 3; }
    | ترتيب_ذاكرة.تسلسلي -> { أرجع 4; };
}

عام عرف سياج_ذاكرة(الترتيب: ترتيب_ذاكرة): فراغ {
    سياج_ذري_بدائي(رمز_ترتيب(الترتيب));
}
عام مرادف atomic_fence = سياج_ذاكرة;

// ----- 64-bit atomic -----
عام نوع ذرة_ط64 = { القيمة: ط64 };
عام مرادف atomic_u64 = ذرة_ط64;

عام عرف أنشئ_ذرة_ط64(القيمة: ط64): ذرة_ط64 { دع الناتج: ذرة_ط64 = { القيمة: القيمة }; أرجع الناتج; }
عام مرادف atomic_u64_new = أنشئ_ذرة_ط64;

عام عرف احمل_ط64(الذرة: &ذرة_ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع احمل_ذري_بدائي(&(*الذرة).القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اخزن_ط64(الذرة: &ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): فراغ {
    اخزن_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف بدّل_ط64(الذرة: &ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع بدّل_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اجمع_واجلب_ط64(الذرة: &ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع اجلب_اجمع_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف و_واجلب_ط64(الذرة: &ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع اجلب_و_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف أو_واجلب_ط64(الذرة: &ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع اجلب_أو_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
// Compare-and-exchange: returns the old value (equal to المتوقع on success).
عام عرف قارن_وبدّل_ط64(الذرة: &ذرة_ط64, المتوقع: ط64, الجديد: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    أرجع قارن_وبدّل_ذري_بدائي(&(*الذرة).القيمة, المتوقع, الجديد, رمز_ترتيب(الترتيب), 2);
}
عام مرادف atomic_u64_load = احمل_ط64;
عام مرادف atomic_u64_store = اخزن_ط64;
عام مرادف atomic_u64_swap = بدّل_ط64;
عام مرادف atomic_u64_fetch_add = اجمع_واجلب_ط64;
عام مرادف atomic_u64_fetch_and = و_واجلب_ط64;
عام مرادف atomic_u64_fetch_or = أو_واجلب_ط64;
عام مرادف atomic_u64_compare_exchange = قارن_وبدّل_ط64;

// ----- 32-bit atomic -----
عام نوع ذرة_ط32 = { القيمة: ط32 };
عام مرادف atomic_u32 = ذرة_ط32;
عام عرف أنشئ_ذرة_ط32(القيمة: ط32): ذرة_ط32 { دع الناتج: ذرة_ط32 = { القيمة: القيمة }; أرجع الناتج; }
عام مرادف atomic_u32_new = أنشئ_ذرة_ط32;
عام عرف احمل_ط32(الذرة: &ذرة_ط32, الترتيب: ترتيب_ذاكرة): ط32 {
    أرجع احمل_ذري_بدائي(&(*الذرة).القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اخزن_ط32(الذرة: &ذرة_ط32, القيمة: ط32, الترتيب: ترتيب_ذاكرة): فراغ {
    اخزن_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف بدّل_ط32(الذرة: &ذرة_ط32, القيمة: ط32, الترتيب: ترتيب_ذاكرة): ط32 {
    أرجع بدّل_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اجمع_واجلب_ط32(الذرة: &ذرة_ط32, القيمة: ط32, الترتيب: ترتيب_ذاكرة): ط32 {
    أرجع اجلب_اجمع_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف قارن_وبدّل_ط32(الذرة: &ذرة_ط32, المتوقع: ط32, الجديد: ط32, الترتيب: ترتيب_ذاكرة): ط32 {
    أرجع قارن_وبدّل_ذري_بدائي(&(*الذرة).القيمة, المتوقع, الجديد, رمز_ترتيب(الترتيب), 2);
}
عام مرادف atomic_u32_load = احمل_ط32;
عام مرادف atomic_u32_store = اخزن_ط32;
عام مرادف atomic_u32_swap = بدّل_ط32;
عام مرادف atomic_u32_fetch_add = اجمع_واجلب_ط32;
عام مرادف atomic_u32_compare_exchange = قارن_وبدّل_ط32;

// ----- pointer-width atomic (Rust's AtomicUsize) -----
عام نوع ذرة_طبيعي = { القيمة: طبيعي };
عام مرادف atomic_usize = ذرة_طبيعي;
عام عرف أنشئ_ذرة_طبيعي(القيمة: طبيعي): ذرة_طبيعي { دع الناتج: ذرة_طبيعي = { القيمة: القيمة }; أرجع الناتج; }
عام مرادف atomic_usize_new = أنشئ_ذرة_طبيعي;
عام عرف احمل_طبيعي(الذرة: &ذرة_طبيعي, الترتيب: ترتيب_ذاكرة): طبيعي {
    أرجع احمل_ذري_بدائي(&(*الذرة).القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اخزن_طبيعي(الذرة: &ذرة_طبيعي, القيمة: طبيعي, الترتيب: ترتيب_ذاكرة): فراغ {
    اخزن_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف اجمع_واجلب_طبيعي(الذرة: &ذرة_طبيعي, القيمة: طبيعي, الترتيب: ترتيب_ذاكرة): طبيعي {
    أرجع اجلب_اجمع_ذري_بدائي(&(*الذرة).القيمة, القيمة, رمز_ترتيب(الترتيب));
}
عام عرف قارن_وبدّل_طبيعي(الذرة: &ذرة_طبيعي, المتوقع: طبيعي, الجديد: طبيعي, الترتيب: ترتيب_ذاكرة): طبيعي {
    أرجع قارن_وبدّل_ذري_بدائي(&(*الذرة).القيمة, المتوقع, الجديد, رمز_ترتيب(الترتيب), 2);
}
عام مرادف atomic_usize_load = احمل_طبيعي;
عام مرادف atomic_usize_store = اخزن_طبيعي;
عام مرادف atomic_usize_fetch_add = اجمع_واجلب_طبيعي;
عام مرادف atomic_usize_compare_exchange = قارن_وبدّل_طبيعي;

// Atomics through a raw pointer to the shared cell (docs/CONCURRENCY.md): the
// field access `(*م).القيمة` is a place at the pointed address, so the atomic
// acts on the shared cell itself, not a copy. These are the forms a thread
// uses on a cell shared through a leaked pointer (std.sync.share). The caller
// supplies the pointer inside `غير_آمن`.
عام عرف احمل_مؤشر_ط64(م: *متغير ذرة_ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    دع الناتج: ط64;
    غير_آمن { الناتج := احمل_ذري_بدائي(&(*م).القيمة, رمز_ترتيب(الترتيب)); }
    أرجع الناتج;
}
عام عرف اخزن_مؤشر_ط64(م: *متغير ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): فراغ {
    غير_آمن { اخزن_ذري_بدائي(&(*م).القيمة, القيمة, رمز_ترتيب(الترتيب)); }
}
عام عرف اجلب_اجمع_مؤشر_ط64(م: *متغير ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    دع الناتج: ط64;
    غير_آمن { الناتج := اجلب_اجمع_ذري_بدائي(&(*م).القيمة, القيمة, رمز_ترتيب(الترتيب)); }
    أرجع الناتج;
}
عام عرف بدّل_مؤشر_ط64(م: *متغير ذرة_ط64, القيمة: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    دع الناتج: ط64;
    غير_آمن { الناتج := بدّل_ذري_بدائي(&(*م).القيمة, القيمة, رمز_ترتيب(الترتيب)); }
    أرجع الناتج;
}
عام عرف قارن_وبدّل_مؤشر_ط64(م: *متغير ذرة_ط64, المتوقع: ط64, الجديد: ط64, الترتيب: ترتيب_ذاكرة): ط64 {
    دع الناتج: ط64;
    غير_آمن { الناتج := قارن_وبدّل_ذري_بدائي(&(*م).القيمة, المتوقع, الجديد, رمز_ترتيب(الترتيب), 2); }
    أرجع الناتج;
}
