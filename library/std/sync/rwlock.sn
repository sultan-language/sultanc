// Reader-writer lock (docs/en/reference/concurrency.md, "RwLock"), after Rust's
// std::sync::RwLock, in the simple form of one 32-bit futex word:
//
//   0            unlocked
//   1 .. 2^30    that many readers hold it
//   0xFFFFFFFF   one writer holds it
//
// Readers increment the count with a compare-exchange while no writer holds
// it; a writer moves 0 -> 0xFFFFFFFF. A thread that cannot take the lock
// sleeps on the word until it changes (std.os.wait_address); the last reader
// and the writer wake every sleeper when they release it. Unlike Rust's
// futex RwLock (std/src/sys/sync/rwlock/futex.rs) there is no writer
// preference: a steady stream of readers can delay a writer. Like Mutex,
// the value is reached only inside a closure that runs with the lock held,
// and nothing is poisoned (a panic ends the process).
استورد sync.atomic;
استورد sync.arc;
استورد os.wait_address;

عام نوع قفل_قراءة_كتابة<ق> = {
    الحالة: ذرة_ط32,
    القيمة: مشترك<ق>,
    منع_النسخ: متجه ط8
};
عام مرادف rwlock = قفل_قراءة_كتابة;

عرف كاتب_قفل_قراءة_كتابة(): ط32 { أرجع 4294967295; }

// Rust's RwLock::new.
عام عرف أنشئ_قفل_قراءة_كتابة<ق>(القيمة: ق): قفل_قراءة_كتابة<ق> {
    دع العلامة: متجه ط8 = [];
    دع الناتج: قفل_قراءة_كتابة<ق> = {
        الحالة: أنشئ_ذرة_ط32(0 مثل ط32), القيمة: أنشئ_مشترك(القيمة), منع_النسخ: العلامة
    };
    أرجع الناتج;
}
عام مرادف rwlock_new = أنشئ_قفل_قراءة_كتابة;

عرف اقفل_للقراءة(الحالة: &ذرة_ط32): فراغ {
    طالما (صواب) {
        دع الحالية: ط32 = احمل_ط32(الحالة, ترتيب_ذاكرة.مسترخ());
        إذا (الحالية != كاتب_قفل_قراءة_كتابة() && الحالية < (1073741824 مثل ط32)) {
            إذا (قارن_وبدّل_ط32(الحالة, الحالية, الحالية + 1, ترتيب_ذاكرة.اكتساب()) == الحالية) { أرجع; };
        } وإلا {
            دع تجاهل: منطقي = انتظر_عند_العنوان(الحالة, الحالية, اختياري.لا_شيء());
        };
    }
}

عرف افتح_القراءة(الحالة: &ذرة_ط32): فراغ {
    // fetch_sub(1): add 2^32 - 1.
    دع السابقة: ط32 = اجمع_واجلب_ط32(الحالة, 4294967295 مثل ط32, ترتيب_ذاكرة.إطلاق());
    إذا (السابقة == (1 مثل ط32)) { أيقظ_الكل_عند_العنوان(الحالة); };
}

عرف اقفل_للكتابة(الحالة: &ذرة_ط32): فراغ {
    طالما (صواب) {
        دع الحالية: ط32 = قارن_وبدّل_ط32(الحالة, 0 مثل ط32, كاتب_قفل_قراءة_كتابة(), ترتيب_ذاكرة.اكتساب());
        إذا (الحالية == (0 مثل ط32)) { أرجع; };
        دع تجاهل: منطقي = انتظر_عند_العنوان(الحالة, الحالية, اختياري.لا_شيء());
    }
}

عرف افتح_الكتابة(الحالة: &ذرة_ط32): فراغ {
    اخزن_ط32(الحالة, 0 مثل ط32, ترتيب_ذاكرة.إطلاق());
    أيقظ_الكل_عند_العنوان(الحالة);
}

عرف اقرأ_بالمؤشر<ق, ن>(المؤشر: *متغير ق, العمل: دالة(&ق): ن): ن {
    غير_آمن { أرجع العمل(&(*المؤشر)); }
}

عرف اكتب_بالمؤشر<ق, ن>(المؤشر: *متغير ق, العمل: دالة(&متغير ق): ن): ن {
    غير_آمن { أرجع العمل(&متغير (*المؤشر)); }
}

// Rust's RwLock::read: run العمل with shared access; other readers may run
// at the same time.
عام عرف نفذ_مع_قراءة<ق, ن>(القفل: &قفل_قراءة_كتابة<ق>, العمل: دالة(&ق): ن): ن {
    اقفل_للقراءة(&(*القفل).الحالة);
    دع الناتج: ن = اقرأ_بالمؤشر(مؤشر_مشترك(&(*القفل).القيمة), العمل);
    افتح_القراءة(&(*القفل).الحالة);
    أرجع الناتج;
}
عام مرادف with_read = نفذ_مع_قراءة;

// Rust's RwLock::write: run العمل with exclusive, mutable access.
عام عرف نفذ_مع_كتابة<ق, ن>(القفل: &قفل_قراءة_كتابة<ق>, العمل: دالة(&متغير ق): ن): ن {
    اقفل_للكتابة(&(*القفل).الحالة);
    دع الناتج: ن = اكتب_بالمؤشر(مؤشر_مشترك(&(*القفل).القيمة), العمل);
    افتح_الكتابة(&(*القفل).الحالة);
    أرجع الناتج;
}
عام مرادف with_write = نفذ_مع_كتابة;
