// Channels (docs/en/reference/concurrency.md, "Channels"), after Rust's std::sync::mpsc:
// `قناة` / channel is unbounded, `قناة_متزامنة` / sync_channel(bound) holds
// at most `bound` messages and makes a sender wait while it is full. Many
// senders (copied explicitly with استنسخ_مرسل, Rust's Sender::clone), one
// receiver; messages arrive in the order they were sent.
//
// The shared state is one heap record behind an Arc: a FIFO of two vectors
// (sent values are appended to the inbox; the receiver pops the outbox and
// refills it from the inbox, so every value is moved, never copied), guarded
// by the three-state lock of std.sync.mutex, plus two futex sequence words
// (std.os.wait_address): "a value is available" and "a slot is free".
//
// Disconnection, as in Rust: `استقبل` / recv fails once every sender is gone
// and the queue is empty; `أرسل` / send fails (handing the value back) once
// the receiver is gone. SultanC runs no user code when a value is dropped, so
// the channel counts its ends with two shared tokens, an Arc each held by the
// shared state and by every sender (resp. the receiver): the live senders are
// the token's strong count minus the state's own. Dropping an end by giving
// it to أسقط_مرسل / أسقط_مستلم wakes the other side at once; an end dropped
// implicitly (a thread that finishes, a scope that ends) is noticed by a
// waiting thread within a few milliseconds, as it re-checks the counts
// between bounded sleeps (1 ms, doubling to 32 ms).
//
// Ends are not copyable (Rust's Receiver is not Clone; a Sender is cloned
// explicitly), so a spawned closure moves the end it captures.
استورد sync.atomic;
استورد sync.arc;
استورد sync.mutex;
استورد os.wait_address;
استورد time.duration;

نوع داخل_قناة<ق> = {
    القفل: ذرة_ط32,
    الوارد: متجه ق,
    الصادر: متجه ق,
    العدد: طبيعي,
    // The bound of a sync_channel; 0 for an unbounded channel.
    الحد: طبيعي,
    // Bumped on every send (the receiver sleeps on it) and on every
    // receive (a sender of a full bounded channel sleeps on it).
    متاح: ذرة_ط32,
    مساحة: ذرة_ط32,
    رمز_المرسلين: مشترك<منطقي>,
    رمز_المستلم: مشترك<منطقي>
};

عام نوع مرسل<ق> = {
    الداخل: مشترك<داخل_قناة<ق>>,
    الرمز: مشترك<منطقي>,
    منع_النسخ: متجه ط8
};
عام مرادف sender = مرسل;
عام مرادف sync_sender = مرسل;

عام نوع مستلم<ق> = {
    الداخل: مشترك<داخل_قناة<ق>>,
    الرمز: مشترك<منطقي>,
    منع_النسخ: متجه ط8
};
عام مرادف receiver = مستلم;

// Both ends of a new channel (Rust returns them as a pair); take them apart
// with a pattern: `طابق قناة() مع | { المرسل: م, المستلم: س } -> { … }`.
عام نوع طرفا_قناة<ق> = { المرسل: مرسل<ق>, المستلم: مستلم<ق> };
عام مرادف channel_ends = طرفا_قناة;

// Rust's TryRecvError, RecvTimeoutError, RecvError and TrySendError.
عام نوع خطأ_محاولة_استقبال =
    | فارغة
    | منقطعة
;
عام مرادف try_recv_error = خطأ_محاولة_استقبال;
عام مرادف try_recv_error.empty = خطأ_محاولة_استقبال.فارغة;
عام مرادف try_recv_error.disconnected = خطأ_محاولة_استقبال.منقطعة;
عام نوع خطأ_استقبال_بمهلة =
    | انتهت_المهلة
    | منقطعة
;
عام مرادف recv_timeout_error = خطأ_استقبال_بمهلة;
عام مرادف recv_timeout_error.timeout = خطأ_استقبال_بمهلة.انتهت_المهلة;
عام مرادف recv_timeout_error.disconnected = خطأ_استقبال_بمهلة.منقطعة;
عام نوع خطأ_استقبال =
    | منقطعة
;
عام مرادف recv_error = خطأ_استقبال;
عام مرادف recv_error.disconnected = خطأ_استقبال.منقطعة;
عام نوع خطأ_محاولة_إرسال<ق> =
    | ممتلئة بنوع ق
    | منقطعة بنوع ق
;
عام مرادف try_send_error = خطأ_محاولة_إرسال;
عام مرادف try_send_error.full = خطأ_محاولة_إرسال.ممتلئة;
عام مرادف try_send_error.disconnected = خطأ_محاولة_إرسال.منقطعة;

عرف علامة_قناة(): متجه ط8 { دع العلامة: متجه ط8 = []; أرجع العلامة; }

عرف أنشئ_مستلم_بحد<ق>(الحد: طبيعي): مستلم<ق> {
    دع الوارد: متجه ق = [];
    دع الصادر: متجه ق = [];
    دع رمز_المرسلين: مشترك<منطقي> = أنشئ_مشترك(صواب);
    دع رمز_المستلم: مشترك<منطقي> = أنشئ_مشترك(صواب);
    دع الداخل: داخل_قناة<ق> = {
        القفل: أنشئ_ذرة_ط32(0 مثل ط32), الوارد: الوارد, الصادر: الصادر, العدد: 0, الحد: الحد,
        متاح: أنشئ_ذرة_ط32(0 مثل ط32), مساحة: أنشئ_ذرة_ط32(0 مثل ط32),
        رمز_المرسلين: رمز_المرسلين, رمز_المستلم: رمز_المستلم
    };
    دع الناتج: مستلم<ق> = { الداخل: أنشئ_مشترك(الداخل), الرمز: رمز_المستلم, منع_النسخ: علامة_قناة() };
    أرجع الناتج;
}

// A new receiver alone (std's split of channel() for code that does not
// destructure the pair); its senders come from مرسل_لمستلم.
عام عرف مستلم_قناة<ق>(): مستلم<ق> { أرجع أنشئ_مستلم_بحد(0); }
عام مرادف channel_receiver = مستلم_قناة;

// A receiver of a sync_channel(bound) alone. A bound of 0 holds one value
// (Rust's rendezvous channel, bound 0, is not implemented as such).
عام عرف مستلم_قناة_متزامنة<ق>(الحد: طبيعي): مستلم<ق> {
    دع الحد_الفعلي: متغير طبيعي = الحد;
    إذا (الحد_الفعلي == 0) { الحد_الفعلي := 1; };
    أرجع أنشئ_مستلم_بحد(الحد_الفعلي);
}
عام مرادف sync_channel_receiver = مستلم_قناة_متزامنة;

// A new sender of the channel المستلم receives from.
عام عرف مرسل_لمستلم<ق>(المستلم: &مستلم<ق>): مرسل<ق> {
    دع المرجع: &داخل_قناة<ق> = اقرأ_مشترك(&(*المستلم).الداخل);
    دع الرمز: مشترك<منطقي> = (*المرجع).رمز_المرسلين;
    دع الناتج: مرسل<ق> = { الداخل: (*المستلم).الداخل, الرمز: الرمز, منع_النسخ: علامة_قناة() };
    أرجع الناتج;
}
عام مرادف sender_for = مرسل_لمستلم;

// Rust's mpsc::channel.
عام عرف قناة<ق>(): طرفا_قناة<ق> {
    دع المستلم: مستلم<ق> = مستلم_قناة();
    دع المرسل: مرسل<ق> = مرسل_لمستلم(&المستلم);
    دع الناتج: طرفا_قناة<ق> = { المرسل: المرسل, المستلم: المستلم };
    أرجع الناتج;
}
عام مرادف channel = قناة;

// Rust's mpsc::sync_channel.
عام عرف قناة_متزامنة<ق>(الحد: طبيعي): طرفا_قناة<ق> {
    دع المستلم: مستلم<ق> = مستلم_قناة_متزامنة(الحد);
    دع المرسل: مرسل<ق> = مرسل_لمستلم(&المستلم);
    دع الناتج: طرفا_قناة<ق> = { المرسل: المرسل, المستلم: المستلم };
    أرجع الناتج;
}
عام مرادف sync_channel = قناة_متزامنة;

// Rust's Sender::clone.
عام عرف استنسخ_مرسل<ق>(المرسل: &مرسل<ق>): مرسل<ق> {
    دع الناتج: مرسل<ق> = { الداخل: (*المرسل).الداخل, الرمز: (*المرسل).الرمز, منع_النسخ: علامة_قناة() };
    أرجع الناتج;
}
عام مرادف sender_clone = استنسخ_مرسل;

// The shared state, borrowed mutably; every use holds القفل or touches only
// the atomics.
عرف داخل_قناة_من<ق>(المشترك: &مشترك<داخل_قناة<ق>>): &متغير داخل_قناة<ق> {
    دع المؤشر: *متغير داخل_قناة<ق> = مؤشر_مشترك(المشترك);
    غير_آمن { أرجع &متغير (*المؤشر); }
}

عرف مرسلون_أحياء<ق>(الداخل: &داخل_قناة<ق>): طبيعي {
    أرجع عدد_مراجع_مشترك(&(*الداخل).رمز_المرسلين) - 1;
}

عرف مستلم_حي<ق>(الداخل: &داخل_قناة<ق>): منطقي {
    أرجع عدد_مراجع_مشترك(&(*الداخل).رمز_المستلم) > 1;
}

// The next bounded sleep while a waiting thread watches for a dropped end.
عرف المهلة_التالية(المهلة: عدد): عدد {
    إذا (المهلة >= 32000000) { أرجع 32000000; };
    أرجع المهلة * 2;
}

// Take the oldest value (the caller holds القفل and العدد > 0).
عرف خذ_الأقدم<ق>(الداخل: &متغير داخل_قناة<ق>): اختياري ق {
    إذا (الطول((*الداخل).الصادر) == 0) {
        طالما (الطول((*الداخل).الوارد) > 0) {
            طابق أزل_الأخير((*الداخل).الوارد) مع
            | اختياري.موجود(القيمة) -> { ألحق((*الداخل).الصادر, القيمة); }
            | اختياري.لا_شيء -> { };
        }
    };
    أرجع أزل_الأخير((*الداخل).الصادر);
}

// Rust's Sender::send: wait for room in a bounded channel, then queue the
// value. The value comes back as the error when the receiver is gone.
عام عرف أرسل<ق>(المرسل: &مرسل<ق>, القيمة: ق): نتيجة منطقي, ق {
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&(*المرسل).الداخل);
    دع المهلة: متغير عدد = 1000000;
    طالما (صواب) {
        إذا (!مستلم_حي(الداخل)) { أرجع نتيجة.خطأ(القيمة); };
        اقفل_ذريا(&(*الداخل).القفل);
        إذا ((*الداخل).الحد == 0 || (*الداخل).العدد < (*الداخل).الحد) { اخرج_من_حلقة; };
        دع التسلسل: ط32 = احمل_ط32(&(*الداخل).مساحة, ترتيب_ذاكرة.اكتساب());
        افتح_قفل_ذري(&(*الداخل).القفل);
        دع تجاهل: منطقي = انتظر_عند_العنوان(&(*الداخل).مساحة, التسلسل, اختياري.موجود(المهلة));
        المهلة := المهلة_التالية(المهلة);
    }
    ألحق((*الداخل).الوارد, القيمة);
    (*الداخل).العدد := (*الداخل).العدد + 1;
    افتح_قفل_ذري(&(*الداخل).القفل);
    دع تجاهل_التسلسل: ط32 = اجمع_واجلب_ط32(&(*الداخل).متاح, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
    أيقظ_واحدا_عند_العنوان(&(*الداخل).متاح);
    أرجع نتيجة.نجح(صواب);
}
عام مرادف send = أرسل;

// Rust's SyncSender::try_send: queue the value only if there is room now.
عام عرف حاول_الإرسال<ق>(المرسل: &مرسل<ق>, القيمة: ق): نتيجة منطقي, خطأ_محاولة_إرسال<ق> {
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&(*المرسل).الداخل);
    إذا (!مستلم_حي(الداخل)) { أرجع نتيجة.خطأ(خطأ_محاولة_إرسال.منقطعة(القيمة)); };
    اقفل_ذريا(&(*الداخل).القفل);
    إذا ((*الداخل).الحد != 0 && (*الداخل).العدد >= (*الداخل).الحد) {
        افتح_قفل_ذري(&(*الداخل).القفل);
        أرجع نتيجة.خطأ(خطأ_محاولة_إرسال.ممتلئة(القيمة));
    };
    ألحق((*الداخل).الوارد, القيمة);
    (*الداخل).العدد := (*الداخل).العدد + 1;
    افتح_قفل_ذري(&(*الداخل).القفل);
    دع تجاهل_التسلسل: ط32 = اجمع_واجلب_ط32(&(*الداخل).متاح, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
    أيقظ_واحدا_عند_العنوان(&(*الداخل).متاح);
    أرجع نتيجة.نجح(صواب);
}
عام مرادف try_send = حاول_الإرسال;

// One receive attempt: the value, or none with "every sender is gone".
عرف حاول_خذ<ق>(الداخل: &متغير داخل_قناة<ق>): اختياري ق {
    اقفل_ذريا(&(*الداخل).القفل);
    إذا ((*الداخل).العدد == 0) {
        افتح_قفل_ذري(&(*الداخل).القفل);
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: اختياري ق = خذ_الأقدم(الداخل);
    (*الداخل).العدد := (*الداخل).العدد - 1;
    افتح_قفل_ذري(&(*الداخل).القفل);
    إذا ((*الداخل).الحد != 0) {
        دع تجاهل: ط32 = اجمع_واجلب_ط32(&(*الداخل).مساحة, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
        أيقظ_واحدا_عند_العنوان(&(*الداخل).مساحة);
    };
    أرجع الناتج;
}

// Receive with an optional deadline (nanoseconds from now): the value, or
// none when the deadline passed (منقطعة صواب when every sender is gone).
عرف استقبل_داخلي<ق>(المستلم: &مستلم<ق>, الحد_الأقصى: اختياري عدد, منقطعة: &متغير منطقي): اختياري ق {
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&(*المستلم).الداخل);
    دع المهلة: متغير عدد = 1000000;
    دع المتبقي: متغير عدد = 0;
    طابق الحد_الأقصى مع
    | اختياري.موجود(الحد) -> { المتبقي := الحد; }
    | اختياري.لا_شيء -> { };
    طالما (صواب) {
        دع التسلسل: ط32 = احمل_ط32(&(*الداخل).متاح, ترتيب_ذاكرة.اكتساب());
        طابق حاول_خذ(الداخل) مع
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> { };
        // Every send happened before its sender was dropped, so once no
        // sender is left, one last look at the queue is final.
        إذا (مرسلون_أحياء(الداخل) == 0) {
            طابق حاول_خذ(الداخل) مع
            | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            *منقطعة := صواب;
            أرجع اختياري.لا_شيء();
        };
        دع النوم: متغير عدد = المهلة;
        طابق الحد_الأقصى مع
        | اختياري.موجود(_) -> {
            إذا (المتبقي <= 0) { أرجع اختياري.لا_شيء(); };
            إذا (النوم > المتبقي) { النوم := المتبقي; };
            المتبقي := المتبقي - النوم;
        }
        | اختياري.لا_شيء -> { };
        دع تجاهل: منطقي = انتظر_عند_العنوان(&(*الداخل).متاح, التسلسل, اختياري.موجود(النوم));
        المهلة := المهلة_التالية(المهلة);
    }
    أرجع اختياري.لا_شيء();
}

// Rust's Receiver::recv: wait for a value; fails once every sender is gone
// and nothing is left to receive.
عام عرف استقبل<ق>(المستلم: &مستلم<ق>): نتيجة ق, خطأ_استقبال {
    دع منقطعة: متغير منطقي = خطأ;
    طابق استقبل_داخلي(المستلم, اختياري.لا_شيء(), &متغير منقطعة) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استقبال.منقطعة()); };
}
عام مرادف recv = استقبل;

// Rust's Receiver::recv_timeout.
عام عرف استقبل_بمهلة<ق>(المستلم: &مستلم<ق>, المهلة: مدة): نتيجة ق, خطأ_استقبال_بمهلة {
    دع منقطعة: متغير منطقي = خطأ;
    طابق استقبل_داخلي(المستلم, اختياري.موجود(المهلة.النانوثواني), &متغير منقطعة) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
    | اختياري.لا_شيء -> {
        إذا (منقطعة) { أرجع نتيجة.خطأ(خطأ_استقبال_بمهلة.منقطعة()); };
        أرجع نتيجة.خطأ(خطأ_استقبال_بمهلة.انتهت_المهلة());
    };
}
عام مرادف recv_timeout = استقبل_بمهلة;

// Rust's Receiver::try_recv: a value if one is queued now.
عام عرف حاول_الاستقبال<ق>(المستلم: &مستلم<ق>): نتيجة ق, خطأ_محاولة_استقبال {
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&(*المستلم).الداخل);
    طابق حاول_خذ(الداخل) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
    | اختياري.لا_شيء -> { };
    إذا (مرسلون_أحياء(الداخل) == 0) {
        طابق حاول_خذ(الداخل) مع
        | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
        | اختياري.لا_شيء -> { };
        أرجع نتيجة.خطأ(خطأ_محاولة_استقبال.منقطعة());
    };
    أرجع نتيجة.خطأ(خطأ_محاولة_استقبال.فارغة());
}
عام مرادف try_recv = حاول_الاستقبال;

// Drop the end (moved in here) and wake the other side, which re-checks
// the counts at once (Rust's `drop(tx)` / `drop(rx)`).
عرف اترك_مرسل<ق>(المرسل: مرسل<ق>): فراغ { }
عرف اترك_مستلم<ق>(المستلم: مستلم<ق>): فراغ { }

عام عرف أسقط_مرسل<ق>(المرسل: مرسل<ق>): فراغ {
    دع المشترك: مشترك<داخل_قناة<ق>> = المرسل.الداخل;
    اترك_مرسل(المرسل);
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&المشترك);
    دع تجاهل: ط32 = اجمع_واجلب_ط32(&(*الداخل).متاح, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
    أيقظ_الكل_عند_العنوان(&(*الداخل).متاح);
}
عام مرادف drop_sender = أسقط_مرسل;

عام عرف أسقط_مستلم<ق>(المستلم: مستلم<ق>): فراغ {
    دع المشترك: مشترك<داخل_قناة<ق>> = المستلم.الداخل;
    اترك_مستلم(المستلم);
    دع الداخل: &متغير داخل_قناة<ق> = داخل_قناة_من(&المشترك);
    دع تجاهل: ط32 = اجمع_واجلب_ط32(&(*الداخل).مساحة, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
    أيقظ_الكل_عند_العنوان(&(*الداخل).مساحة);
}
عام مرادف drop_receiver = أسقط_مستلم;
