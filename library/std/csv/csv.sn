استورد text.from_bytes;

// RFC 4180-style CSV document. Records and fields preserve source order.
عام نوع سجل_سي_اس_في = {
    الحقول: متجه نص
};

عام نوع مستند_سي_اس_في = {
    السجلات: متجه سجل_سي_اس_في
};


عرف انسخ_نص_سي_اس_في(القيمة: &نص): نص {
    أرجع انسخ_نص(القيمة);
}

عرف انسخ_سجل_سي_اس_في(القيمة: &سجل_سي_اس_في): سجل_سي_اس_في {
    دع المصدر: سجل_سي_اس_في = *القيمة;
    دع الحقول: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر.الحقول) مثل طبيعي)) {
        ألحق(الحقول, انسخ_نص_سي_اس_في(&المصدر.الحقول[ف]));
        ف := ف + 1;
    }
    دع الناتج: سجل_سي_اس_في = { الحقول: الحقول };
    أرجع الناتج;
}

عام نوع صنف_خطأ_سي_اس_في =
    | اقتباس_غير_مغلق بنوع طبيعي
    | اقتباس_في_حقل_غير_مقتبس بنوع طبيعي
    | محرف_بعد_اقتباس بنوع طبيعي
    | عودة_سطر_مفردة بنوع طبيعي
;

عرف أختم_حقل_سي_اس_في(السجل: &متغير متجه نص, الحقل: &متغير متجه ط8): فراغ {
    // Take the field's bytes, leaving it empty for the next field.
    دع البايتات: متغير متجه ط8 = [];
    بدّل((*الحقل), البايتات);
    ألحق(*السجل, البايتات مثل نص);
}

عرف أختم_سجل_سي_اس_في(السجلات: &متغير متجه سجل_سي_اس_في, الحقول: &متغير متجه نص): فراغ {
    دع قيم: متغير متجه نص = [];
    بدّل((*الحقول), قيم);
    دع السجل: سجل_سي_اس_في = { الحقول: قيم };
    ألحق(*السجلات, السجل);
}

عام عرف حلل_سي_اس_في(النص: &نص): نتيجة مستند_سي_اس_في, صنف_خطأ_سي_اس_في {
    دع المصدر: نص = *النص;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    دع السجلات: متغير متجه سجل_سي_اس_في = [];
    دع الحقول: متغير متجه نص = [];
    دع الحقل: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    دع داخل_اقتباس: متغير منطقي = خطأ;
    دع بعد_اقتباس: متغير منطقي = خطأ;
    دع بدأ_الحقل: متغير منطقي = خطأ;
    دع لديه_بيانات: متغير منطقي = خطأ;

    طالما (ف < العدد) {
        دع ب: ط8 = المصدر[ف];
        لو (داخل_اقتباس) {
            لو (ب == 0x22) {
                دع التالي: طبيعي = ف + 1;
                لو ((التالي < العدد) && (المصدر[التالي] == 0x22)) {
                    ألحق(الحقل, 0x22);
                    ف := ف + 2;
                    لديه_بيانات := صواب;
                } وإلا {
                    داخل_اقتباس := خطأ;
                    بعد_اقتباس := صواب;
                    ف := ف + 1;
                };
            } وإلا {
                ألحق(الحقل, ب);
                ف := ف + 1;
                لديه_بيانات := صواب;
            };
        } وإلا لو (بعد_اقتباس) {
            لو (ب == 0x2C) {
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                بعد_اقتباس := خطأ;
                بدأ_الحقل := خطأ;
                ف := ف + 1;
            } وإلا لو (ب == 0x0A) {
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
                بعد_اقتباس := خطأ;
                بدأ_الحقل := خطأ;
                ف := ف + 1;
            } وإلا لو (ب == 0x0D) {
                دع التالي: طبيعي = ف + 1;
                لو ((التالي >= العدد) || (المصدر[التالي] != 0x0A)) {
                    أرجع نتيجة.خطأ(صنف_خطأ_سي_اس_في.عودة_سطر_مفردة(ف));
                };
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
                بعد_اقتباس := خطأ;
                بدأ_الحقل := خطأ;
                ف := ف + 2;
            } وإلا {
                أرجع نتيجة.خطأ(صنف_خطأ_سي_اس_في.محرف_بعد_اقتباس(ف));
            };
        } وإلا {
            لو (ب == 0x22) {
                لو (بدأ_الحقل || ((الطول(الحقل) مثل طبيعي) > 0)) {
                    أرجع نتيجة.خطأ(صنف_خطأ_سي_اس_في.اقتباس_في_حقل_غير_مقتبس(ف));
                };
                داخل_اقتباس := صواب;
                بدأ_الحقل := صواب;
                لديه_بيانات := صواب;
                ف := ف + 1;
            } وإلا لو (ب == 0x2C) {
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                بدأ_الحقل := خطأ;
                لديه_بيانات := صواب;
                ف := ف + 1;
            } وإلا لو (ب == 0x0A) {
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
                بدأ_الحقل := خطأ;
                لديه_بيانات := صواب;
                ف := ف + 1;
            } وإلا لو (ب == 0x0D) {
                دع التالي: طبيعي = ف + 1;
                لو ((التالي >= العدد) || (المصدر[التالي] != 0x0A)) {
                    أرجع نتيجة.خطأ(صنف_خطأ_سي_اس_في.عودة_سطر_مفردة(ف));
                };
                أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
                أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
                بدأ_الحقل := خطأ;
                لديه_بيانات := صواب;
                ف := ف + 2;
            } وإلا {
                ألحق(الحقل, ب);
                بدأ_الحقل := صواب;
                لديه_بيانات := صواب;
                ف := ف + 1;
            };
        };
    }

    لو (داخل_اقتباس) { أرجع نتيجة.خطأ(صنف_خطأ_سي_اس_في.اقتباس_غير_مغلق(العدد)); };
    لو (بعد_اقتباس || بدأ_الحقل || ((الطول(الحقل) مثل طبيعي) > 0) || ((الطول(الحقول) مثل طبيعي) > 0)) {
        أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
        أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
    } وإلا لو (لديه_بيانات && ((الطول(السجلات) مثل طبيعي) == 0)) {
        أختم_حقل_سي_اس_في(&متغير الحقول, &متغير الحقل);
        أختم_سجل_سي_اس_في(&متغير السجلات, &متغير الحقول);
    };
    دع الناتج: مستند_سي_اس_في = { السجلات: السجلات };
    أرجع نتيجة.نجح(الناتج);
}

عرف يحتاج_اقتباس_سي_اس_في(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        دع ب: ط8 = النص[ف];
        لو ((ب == 0x2C) || (ب == 0x22) || (ب == 0x0D) || (ب == 0x0A)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_حقل_سي_اس_في(الناتج: &متغير متجه ط8, القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع مقتبس: منطقي = يحتاج_اقتباس_سي_اس_في(&النص);
    لو (مقتبس) { ألحق(*الناتج, 0x22); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        دع ب: ط8 = النص[ف];
        لو (مقتبس && (ب == 0x22)) { ألحق_بايتات_نص(الناتج, «\"\"»); }
        وإلا { ألحق(*الناتج, ب); };
        ف := ف + 1;
    }
    لو (مقتبس) { ألحق(*الناتج, 0x22); };
}

عام عرف سلسل_سي_اس_في(المستند: &مستند_سي_اس_في): نص {
    دع القيمة: مستند_سي_اس_في = *المستند;
    دع الناتج: متغير متجه ط8 = [];
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(القيمة.السجلات) مثل طبيعي)) {
        لو (ر > 0) { ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A); };
        دع السجل: سجل_سي_اس_في = انسخ_سجل_سي_اس_في(&القيمة.السجلات[ر]);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(السجل.الحقول) مثل طبيعي)) {
            لو (ف > 0) { ألحق(الناتج, 0x2C); };
            ألحق_حقل_سي_اس_في(&متغير الناتج, &السجل.الحقول[ف]);
            ف := ف + 1;
        }
        ر := ر + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف عدد_سجلات_سي_اس_في(المستند: &مستند_سي_اس_في): طبيعي {
    دع القيمة: مستند_سي_اس_في = *المستند;
    أرجع الطول(القيمة.السجلات) مثل طبيعي;
}

عام عرف سجل_سي_اس_في_عند(المستند: &مستند_سي_اس_في, الموضع: طبيعي): اختياري سجل_سي_اس_في {
    دع القيمة: مستند_سي_اس_في = *المستند;
    لو (الموضع >= (الطول(القيمة.السجلات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_سجل_سي_اس_في(&القيمة.السجلات[الموضع]));
}

عام عرف عدد_حقول_سي_اس_في(السجل: &سجل_سي_اس_في): طبيعي {
    دع القيمة: سجل_سي_اس_في = *السجل;
    أرجع الطول(القيمة.الحقول) مثل طبيعي;
}

عام عرف حقل_سي_اس_في_عند(السجل: &سجل_سي_اس_في, الموضع: طبيعي): اختياري نص {
    دع القيمة: سجل_سي_اس_في = *السجل;
    لو (الموضع >= (الطول(القيمة.الحقول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_نص_سي_اس_في(&القيمة.الحقول[الموضع]));
}

عام نوع csv_record = سجل_سي_اس_في;
عام نوع csv_document = مستند_سي_اس_في;
عام نوع csv_error_kind = صنف_خطأ_سي_اس_في;
عام مرادف parse_csv = حلل_سي_اس_في;
عام مرادف stringify_csv = سلسل_سي_اس_في;
عام مرادف csv_record_count = عدد_سجلات_سي_اس_في;
عام مرادف csv_record_at = سجل_سي_اس_في_عند;
عام مرادف csv_field_count = عدد_حقول_سي_اس_في;
عام مرادف csv_field_at = حقل_سي_اس_في_عند;
