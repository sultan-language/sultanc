// The root file of std.process: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). An import may
// use either name; both name one module.

module argument { ar: وسيطة };
module argument_count { ar: عدد_الوسائط };
module arguments { ar: الوسائط };
module child { ar: عملية_ابن };
module cli { ar: سطر_أوامر };
module command { ar: أمر };
module exit { ar: اخرج };
module failure { ar: فشل };
module id { ar: معرف_العملية };
module panic_handler { ar: معالج_الانهيار };

// Re-exported: these children are modules and folders of alloc and core, at the same
// paths (docs/en/reference/std-layers.md). One file, one module.
module failure_text = core.process.failure_text { ar: نص_الفشل };
module panic = core.process.panic { ar: انهيار };
