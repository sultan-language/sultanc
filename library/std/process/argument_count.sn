استورد os.arguments;
عرف اقرأ_عدد_الوسائط_من_التشغيل(): عدد {
    طابق عدد_وسائط_النظام() مع
    | نتيجة.خطأ(_) -> { أرجع 0; }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}

عام عرف عدد_الوسائط(): طبيعي {
    دع العدد: عدد = اقرأ_عدد_الوسائط_من_التشغيل();
    إذا (العدد <= 0) { أرجع 0; };
    أرجع العدد مثل طبيعي;
}

عام مرادف argument_count = عدد_الوسائط;
