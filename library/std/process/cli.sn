استورد text.from_bytes;
استورد process.arguments;
استورد text.compare;
استورد text.substring;

عام نوع خيار_سطر_أوامر = {
    الاسم: نص,
    القيمة: اختياري نص,
    قصير: منطقي
};

عام نوع سطر_أوامر = {
    البرنامج: اختياري نص,
    الخيارات: متجه خيار_سطر_أوامر,
    الموضعية: متجه نص
};

عرف انسخ_نص_سطر_أوامر(القيمة: &نص): نص { أرجع انسخ_نص(القيمة); }

عرف يساوي_سطر_أوامر(القيمة: &نص, ثابت: نص): منطقي {
    دع المطلوب: نص = ثابت;
    أرجع نصان_متساويان(القيمة, &المطلوب);
}

عرف أول_مساواة_سطر_أوامر(القيمة: &نص, البداية: طبيعي): اختياري طبيعي {
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = البداية;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    طالما (ف < العدد) {
        لو (النص[ف] == 0x3D) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_خيار_سطر_أوامر(الخيارات: &متغير متجه خيار_سطر_أوامر, الرمز: &نص, بداية_الاسم: طبيعي, قصير: منطقي): فراغ {
    دع النص: نص = *الرمز;
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع نهاية_الاسم: متغير طبيعي = العدد;
    دع القيمة: متغير اختياري نص = اختياري.لا_شيء();
    طابق أول_مساواة_سطر_أوامر(&النص, بداية_الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المساواة) -> {
        نهاية_الاسم := المساواة;
        طابق مقطع_نص(&النص, المساواة + 1, العدد - المساواة - 1) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المحتوى) -> { القيمة := اختياري.موجود(المحتوى); };
    };
    طابق مقطع_نص(&النص, بداية_الاسم, نهاية_الاسم - بداية_الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاسم) -> {
        لو (الطول(الاسم) > 0) {
            دع الخيار: خيار_سطر_أوامر = { الاسم: الاسم, القيمة: القيمة, قصير: قصير };
            ألحق(*الخيارات, الخيار);
        };
    };
}

عام عرف حلل_وسائط_سطر_أوامر(القيم: &متجه نص): سطر_أوامر {
    دع المصدر: متجه نص = *القيم;
    دع البرنامج: متغير اختياري نص = اختياري.لا_شيء();
    دع الخيارات: متغير متجه خيار_سطر_أوامر = [];
    دع الموضعية: متغير متجه نص = [];
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    لو (العدد > 0) { البرنامج := اختياري.موجود(انسخ_نص_سطر_أوامر(&المصدر[0])); ف := 1; };
    دع بعد_الفاصل: متغير منطقي = خطأ;
    طالما (ف < العدد) {
        دع الرمز: نص = انسخ_نص_سطر_أوامر(&المصدر[ف]);
        لو (!بعد_الفاصل && يساوي_سطر_أوامر(&الرمز, «--»)) {
            بعد_الفاصل := صواب;
        } وإلا لو (!بعد_الفاصل && (الطول(الرمز) > 2) && (الرمز[0] == 0x2D) && (الرمز[1] == 0x2D)) {
            أضف_خيار_سطر_أوامر(&متغير الخيارات, &الرمز, 2, خطأ);
        } وإلا لو (!بعد_الفاصل && (الطول(الرمز) > 1) && (الرمز[0] == 0x2D)) {
            أضف_خيار_سطر_أوامر(&متغير الخيارات, &الرمز, 1, صواب);
        } وإلا {
            ألحق(الموضعية, الرمز);
        };
        ف := ف + 1;
    }
    دع الناتج: سطر_أوامر = { البرنامج: البرنامج, الخيارات: الخيارات, الموضعية: الموضعية };
    أرجع الناتج;
}

عام عرف حلل_سطر_أوامر(): سطر_أوامر {
    دع القيم: متجه نص = الوسائط();
    أرجع حلل_وسائط_سطر_أوامر(&القيم);
}

عام عرف خيار_سطر_أوامر_موجود(السطر: &سطر_أوامر, الاسم: &نص): منطقي {
    دع الحالة: سطر_أوامر = *السطر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.الخيارات) مثل طبيعي)) {
        لو (نصان_متساويان(&الحالة.الخيارات[ف].الاسم, الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف قيمة_خيار_سطر_أوامر(السطر: &سطر_أوامر, الاسم: &نص): اختياري نص {
    دع الحالة: سطر_أوامر = *السطر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.الخيارات) مثل طبيعي)) {
        لو (نصان_متساويان(&الحالة.الخيارات[ف].الاسم, الاسم)) {
            طابق الحالة.الخيارات[ف].القيمة مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(انسخ_نص_سطر_أوامر(&القيمة)); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام مرادف cli_option = خيار_سطر_أوامر;
عام مرادف cli_arguments = سطر_أوامر;
عام مرادف parse_cli_arguments = حلل_وسائط_سطر_أوامر;
عام مرادف parse_cli = حلل_سطر_أوامر;
عام مرادف cli_has_option = خيار_سطر_أوامر_موجود;
عام مرادف cli_option_value = قيمة_خيار_سطر_أوامر;

عام عرف برنامج_سطر_أوامر(السطر: &سطر_أوامر): اختياري نص {
    دع الحالة: سطر_أوامر = *السطر;
    طابق الحالة.البرنامج مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(انسخ_نص_سطر_أوامر(&القيمة)); };
}

عام عرف عدد_خيارات_سطر_أوامر(السطر: &سطر_أوامر): طبيعي {
    دع الحالة: سطر_أوامر = *السطر;
    أرجع الطول(الحالة.الخيارات) مثل طبيعي;
}

عام عرف عدد_موضعيات_سطر_أوامر(السطر: &سطر_أوامر): طبيعي {
    دع الحالة: سطر_أوامر = *السطر;
    أرجع الطول(الحالة.الموضعية) مثل طبيعي;
}

عام عرف موضعية_سطر_أوامر(السطر: &سطر_أوامر, الموضع: طبيعي): اختياري نص {
    دع الحالة: سطر_أوامر = *السطر;
    لو (الموضع >= (الطول(الحالة.الموضعية) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_نص_سطر_أوامر(&الحالة.الموضعية[الموضع]));
}

عام مرادف cli_program = برنامج_سطر_أوامر;
عام مرادف cli_option_count = عدد_خيارات_سطر_أوامر;
عام مرادف cli_positional_count = عدد_موضعيات_سطر_أوامر;
عام مرادف cli_positional_at = موضعية_سطر_أوامر;
