استورد process.arguments;
استورد text.compare;
استورد text.substring;

عام نوع خيار_سطر_أوامر = {
    الاسم: نص,
    القيمة: اختيار نص,
    قصير: منطقي
};

عام نوع سطر_أوامر = {
    البرنامج: اختيار نص,
    الخيارات: متجه خيار_سطر_أوامر,
    الموضعية: متجه نص
};

عرف انسخ_نص_سطر_أوامر(القيمة: &نص): نص { دع النسخة: نص = *القيمة; أرجع النسخة; }

عرف يساوي_سطر_أوامر(القيمة: &نص, ثابت: نص): منطقي {
    دع المطلوب: نص = ثابت;
    أرجع نصان_متساويان(القيمة, &المطلوب);
}

عرف أول_مساواة_سطر_أوامر(القيمة: &نص, البداية: غير_موقع): اختيار غير_موقع {
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = البداية;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    بينما (ف < العدد) {
        لو (النص[ف] == 0x3D) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_خيار_سطر_أوامر(الخيارات: &متغير متجه خيار_سطر_أوامر, الرمز: &نص, بداية_الاسم: غير_موقع, قصير: منطقي): فراغ {
    دع النص: نص = *الرمز;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع نهاية_الاسم: متغير غير_موقع = العدد;
    دع القيمة: متغير اختيار نص = اختيار.لا_شيء();
    طابق أول_مساواة_سطر_أوامر(&النص, بداية_الاسم) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المساواة) -> {
        نهاية_الاسم := المساواة;
        طابق مقطع_نص(&النص, المساواة + 1, العدد - المساواة - 1) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المحتوى) -> { القيمة := اختيار.بعض(المحتوى); };
    };
    طابق مقطع_نص(&النص, بداية_الاسم, نهاية_الاسم - بداية_الاسم) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الاسم) -> {
        لو (الطول(الاسم) > 0) {
            دع الخيار: خيار_سطر_أوامر = { الاسم: الاسم, القيمة: القيمة, قصير: قصير };
            دع الحالية: متغير متجه خيار_سطر_أوامر = *الخيارات;
            ألحق(الحالية, الخيار);
            *الخيارات := الحالية;
        };
    };
}

عام عرف حلل_وسائط_سطر_أوامر(القيم: &متجه نص): سطر_أوامر {
    دع المصدر: متجه نص = *القيم;
    دع البرنامج: متغير اختيار نص = اختيار.لا_شيء();
    دع الخيارات: متغير متجه خيار_سطر_أوامر = [];
    دع الموضعية: متغير متجه نص = [];
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    لو (العدد > 0) { البرنامج := اختيار.بعض(انسخ_نص_سطر_أوامر(&المصدر[0])); ف := 1; };
    دع بعد_الفاصل: متغير منطقي = خطأ;
    بينما (ف < العدد) {
        دع الرمز: نص = انسخ_نص_سطر_أوامر(&المصدر[ف]);
        لو (!بعد_الفاصل && يساوي_سطر_أوامر(&الرمز, «--»)) {
            بعد_الفاصل := صواب;
        } وإلا لو (!بعد_الفاصل && (الطول(الرمز) > 2) && (الرمز[0] == 0x2D) && (الرمز[1] == 0x2D)) {
            أضف_خيار_سطر_أوامر(&متغير الخيارات, &الرمز, 2, خطأ);
        } وإلا لو (!بعد_الفاصل && (الطول(الرمز) > 1) && (الرمز[0] == 0x2D)) {
            أضف_خيار_سطر_أوامر(&متغير الخيارات, &الرمز, 1, صواب);
        } وإلا {
            ألحق(الموضعية, الرمز);
        };
        ف := ف + 1;
    }
    دع الناتج: سطر_أوامر = { البرنامج: البرنامج, الخيارات: الخيارات, الموضعية: الموضعية };
    أرجع الناتج;
}

عام عرف حلل_سطر_أوامر(): سطر_أوامر {
    دع القيم: متجه نص = الوسائط();
    أرجع حلل_وسائط_سطر_أوامر(&القيم);
}

عام عرف خيار_سطر_أوامر_موجود(السطر: &سطر_أوامر, الاسم: &نص): منطقي {
    دع الحالة: سطر_أوامر = *السطر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الخيارات) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.الخيارات[ف].الاسم, الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف قيمة_خيار_سطر_أوامر(السطر: &سطر_أوامر, الاسم: &نص): اختيار نص {
    دع الحالة: سطر_أوامر = *السطر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الخيارات) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.الخيارات[ف].الاسم, الاسم)) {
            طابق الحالة.الخيارات[ف].القيمة مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام مرادف cli_option = خيار_سطر_أوامر;
عام مرادف cli_arguments = سطر_أوامر;
عام مرادف parse_cli_arguments = حلل_وسائط_سطر_أوامر;
عام مرادف parse_cli = حلل_سطر_أوامر;
عام مرادف cli_has_option = خيار_سطر_أوامر_موجود;
عام مرادف cli_option_value = قيمة_خيار_سطر_أوامر;

عام عرف برنامج_سطر_أوامر(السطر: &سطر_أوامر): اختيار نص {
    دع الحالة: سطر_أوامر = *السطر;
    طابق الحالة.البرنامج مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); };
}

عام عرف عدد_خيارات_سطر_أوامر(السطر: &سطر_أوامر): غير_موقع {
    دع الحالة: سطر_أوامر = *السطر;
    أرجع الطول(الحالة.الخيارات) مثل غير_موقع;
}

عام عرف عدد_موضعيات_سطر_أوامر(السطر: &سطر_أوامر): غير_موقع {
    دع الحالة: سطر_أوامر = *السطر;
    أرجع الطول(الحالة.الموضعية) مثل غير_موقع;
}

عام عرف موضعية_سطر_أوامر(السطر: &سطر_أوامر, الموضع: غير_موقع): اختيار نص {
    دع الحالة: سطر_أوامر = *السطر;
    لو (الموضع >= (الطول(الحالة.الموضعية) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(انسخ_نص_سطر_أوامر(&الحالة.الموضعية[الموضع]));
}

عام مرادف cli_program = برنامج_سطر_أوامر;
عام مرادف cli_option_count = عدد_خيارات_سطر_أوامر;
عام مرادف cli_positional_count = عدد_موضعيات_سطر_أوامر;
عام مرادف cli_positional_at = موضعية_سطر_أوامر;
