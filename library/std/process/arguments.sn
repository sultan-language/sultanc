استورد عمليات.عدد_الوسائط;
استورد عمليات.وسيطة;

عام عرف الوسائط(): متجه نص {
    ليكن العدد: طبيعي = عدد_الوسائط();
    ليكن القيم: متغير متجه نص = [];
    ليكن الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        طابق وسيطة(الفهرس) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القيمة) -> { ألحق(القيم, القيمة); };
        الفهرس := الفهرس + 1;
    }
    أرجع القيم;
}

عام مرادف arguments = الوسائط;
