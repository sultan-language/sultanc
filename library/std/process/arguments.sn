استورد process.argument_count;
استورد process.argument;

عام عرف الوسائط(): متجه نص {
    دع العدد: غير_موقع = عدد_الوسائط();
    دع القيم: متغير متجه نص = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        طابق وسيطة(الفهرس) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(القيمة) -> { ألحق(القيم, القيمة); };
        الفهرس := الفهرس + 1;
    }
    أرجع القيم;
}

عام مرادف arguments = الوسائط;
