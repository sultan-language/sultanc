استورد process.child;
استورد fs.error;
استورد fs.attributes;
استورد fs.handle;
استورد fs.mutation;
استورد fs.temporary;
استورد env.variables;
استورد env.table;
استورد text.from_bytes;
استورد text.compare;
استورد os.error;
استورد os.process;
استورد os.child_stdio;

// A command to run as a child process: its program and arguments, its
// environment, its working directory and what its standard streams are
// connected to (Rust std::process::Command, Go os/exec.Cmd).
//
// A stream is inherited from this process, connected to the null device,
// or captured (piped). ابدأ_الأمر starts the child and hands back the
// pipes (Rust Command::spawn, below); شغل_الأمر and اجمع_خرج_الأمر run it to
// completion, collecting a captured output in memory. A captured input is
// fed from bytes set on the command, or is a pipe the caller writes. Set
// bytes are staged in an already-removed temporary file, as shells do for
// here-documents, so feeding them can neither deadlock against the child's
// output nor raise SIGPIPE. Collected outputs are read as they arrive (poll
// on Unix, a PeekNamedPipe loop on Windows), so a child filling one pipe
// never blocks.
// WASI has no processes: running a command reports غير_مدعوم.

عام نوع مصدر_تيار =
    | وراثة
    | فارغ
    | التقاط
;

عام نوع أمر = {
    البرنامج: نص,
    الوسائط: متجه نص,
    البيئة: متجه مدخل_بيئة,
    بيئة_مخصصة: منطقي,
    الدليل: نص,
    الدخل: مصدر_تيار,
    الخرج: مصدر_تيار,
    الخطأ: مصدر_تيار,
    بيانات_الدخل: متجه ط8
};

عام نوع ناتج_أمر = {
    الحالة: حالة_إنهاء,
    الخرج: متجه ط8,
    الخطأ: متجه ط8
};

// Where running a command failed: starting the child, preparing or
// reading its streams, or waiting for it.
عام نوع خطأ_أمر =
    | تشغيل بنوع فئة_خطأ_نظام
    | دخل_خرج بنوع فئة_خطأ_نظام
    | انتظار بنوع فئة_خطأ_نظام
;

// A command for البرنامج with no arguments, this process's environment and
// working directory, and inherited streams. A program name without a path
// separator is searched in PATH.
عام عرف أنشئ_أمرا(البرنامج: &نص): أمر {
    دع الوسائط: متجه نص = [];
    دع البيئة: متجه مدخل_بيئة = [];
    دع البيانات: متجه ط8 = [];
    دع الأمر: أمر = {
        البرنامج: انسخ_نص(البرنامج), الوسائط: الوسائط, البيئة: البيئة, بيئة_مخصصة: خطأ,
        الدليل: «», الدخل: مصدر_تيار.وراثة(), الخرج: مصدر_تيار.وراثة(),
        الخطأ: مصدر_تيار.وراثة(), بيانات_الدخل: البيانات
    };
    أرجع الأمر;
}

عام عرف أضف_وسيطة_للأمر(الأمر: &متغير أمر, الوسيطة: &نص): فراغ {
    ألحق((*الأمر).الوسائط, انسخ_نص(الوسيطة));
}

عام عرف أضف_وسائط_للأمر(الأمر: &متغير أمر, الوسائط: &متجه نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق((*الأمر).الوسائط, انسخ_نص(&(*الوسائط)[ف]));
        ف := ف + 1;
    }
}

// The first change to the environment copies this process's environment
// into the command; later changes edit that copy.
عرف خذ_بيئة_للأمر(الأمر: &متغير أمر): نتيجة عدد, فئة_خطأ_نظام {
    لو ((*الأمر).بيئة_مخصصة) { أرجع نتيجة.نجح(0); };
    طابق متغيرات_البيئة() مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(المتغيرات) -> {
        (*الأمر).البيئة := المتغيرات;
        (*الأمر).بيئة_مخصصة := صواب;
        أرجع نتيجة.نجح(0);
    };
}

عرف اسم_بيئة_صالح(الاسم: &نص): منطقي {
    لو (الطول(*الاسم) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        لو ((*الاسم)[ف] == 0x3D || (*الاسم)[ف] == 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أزل_من_بيئة_الأمر(الأمر: &متغير أمر, الاسم: &نص): فراغ {
    دع الباقية: متغير متجه مدخل_بيئة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الأمر).البيئة) مثل طبيعي)) {
        لو (!نصان_متساويان(&(*الأمر).البيئة[ف].الاسم, الاسم)) {
            دع المدخل: مدخل_بيئة = {
                الاسم: انسخ_نص(&(*الأمر).البيئة[ف].الاسم),
                القيمة: انسخ_نص(&(*الأمر).البيئة[ف].القيمة)
            };
            ألحق(الباقية, المدخل);
        };
        ف := ف + 1;
    }
    (*الأمر).البيئة := الباقية;
}

// Sets one variable for the child (Rust Command::env).
عام عرف اضبط_بيئة_للأمر(الأمر: &متغير أمر, الاسم: &نص, القيمة: &نص): نتيجة عدد, فئة_خطأ_نظام {
    لو (!اسم_بيئة_صالح(الاسم)) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    طابق خذ_بيئة_للأمر(الأمر) مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(_) -> {};
    أزل_من_بيئة_الأمر(الأمر, الاسم);
    دع المدخل: مدخل_بيئة = { الاسم: انسخ_نص(الاسم), القيمة: انسخ_نص(القيمة) };
    ألحق((*الأمر).البيئة, المدخل);
    أرجع نتيجة.نجح(0);
}

// Removes one variable from the child's environment (Rust env_remove).
عام عرف أزل_بيئة_من_الأمر(الأمر: &متغير أمر, الاسم: &نص): نتيجة عدد, فئة_خطأ_نظام {
    طابق خذ_بيئة_للأمر(الأمر) مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(_) -> {};
    أزل_من_بيئة_الأمر(الأمر, الاسم);
    أرجع نتيجة.نجح(0);
}

// The child starts with an empty environment (Rust env_clear).
عام عرف امسح_بيئة_الأمر(الأمر: &متغير أمر): فراغ {
    دع فارغة: متجه مدخل_بيئة = [];
    (*الأمر).البيئة := فارغة;
    (*الأمر).بيئة_مخصصة := صواب;
}

// The child's working directory (Rust current_dir). Empty keeps this
// process's. A relative program path is resolved by the platform.
عام عرف اضبط_دليل_الأمر(الأمر: &متغير أمر, الدليل: &نص): فراغ {
    (*الأمر).الدليل := انسخ_نص(الدليل);
}

عام عرف اضبط_دخل_الأمر(الأمر: &متغير أمر, المصدر: مصدر_تيار): فراغ { (*الأمر).الدخل := المصدر; }
عام عرف اضبط_خرج_الأمر(الأمر: &متغير أمر, المصدر: مصدر_تيار): فراغ { (*الأمر).الخرج := المصدر; }
عام عرف اضبط_خطأ_الأمر(الأمر: &متغير أمر, المصدر: مصدر_تيار): فراغ { (*الأمر).الخطأ := المصدر; }

// The child's standard input is exactly these bytes, then end of file.
عام عرف اضبط_بيانات_دخل_الأمر(الأمر: &متغير أمر, البيانات: &متجه ط8): فراغ {
    (*الأمر).الدخل := مصدر_تيار.التقاط();
    (*الأمر).بيانات_الدخل := انسخ_بايتات(البيانات);
}

عرف فئة_من_حد(الخطأ: خطأ_حد_نظام): فئة_خطأ_نظام { أرجع فئة_خطأ_حد_نظام(الخطأ); }

عرف أغلق_مقابض_الأمر(المقابض: &متجه ط64): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المقابض) مثل طبيعي)) {
        دع الإغلاق: نتيجة عدد, خطأ_حد_نظام = أغلق_مقبض_قناة_نظام((*المقابض)[ف]);
        ف := ف + 1;
    }
}

// The bytes as an already-removed temporary file positioned at its start.
عرف ملف_دخل_مؤقت(البيانات: &متجه ط8): نتيجة مقبض_ملف, فئة_خطأ_نظام {
    دع البادئة: نص = «sultanc-stdin-»;
    طابق أنشئ_ملفا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح({ المسار: المسار, المقبض: المقبض }) -> {
        دع المكتوب: متغير عدد = 0;
        دع الكلي: عدد = الطول(*البيانات) مثل عدد;
        دع الفشل: متغير اختياري فئة_خطأ_نظام = اختياري.لا_شيء();
        طالما (المكتوب < الكلي) {
            طابق اكتب_إلى_مقبض_ملف(&المقبض, البيانات, المكتوب, الكلي - المكتوب) مع
            | نتيجة.خطأ(الرمز) -> { الفشل := اختياري.موجود(صنف_خطأ_نظام(الرمز)); المكتوب := الكلي; }
            | نتيجة.نجح(العدد) -> {
                لو (العدد <= 0) { الفشل := اختياري.موجود(فئة_خطأ_نظام.آخر()); المكتوب := الكلي; }
                وإلا { المكتوب := المكتوب + العدد; };
            };
        }
        طابق الفشل مع
        | اختياري.لا_شيء -> {
            طابق حرك_مقبض_ملف(&المقبض, 0, أصل_موضع_ملف.البداية()) مع
            | نتيجة.خطأ(الرمز) -> { الفشل := اختياري.موجود(صنف_خطأ_نظام(الرمز)); }
            | نتيجة.نجح(_) -> {};
        }
        | اختياري.موجود(_) -> {};
        دع الإزالة: نتيجة عدد, عدد = أزل_ملفا(&المسار);
        طابق الفشل مع
        | اختياري.موجود(الفئة) -> {
            دع الإغلاق: نتيجة عدد, عدد = أغلق_مقبض_ملف(المقبض);
            أرجع نتيجة.خطأ(الفئة);
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(المقبض); };
    };
}

// A child started by ابدأ_الأمر (Rust std::process::Child): its process and
// this process's ends of the streams that were piped. A piped input is a
// pipe the parent writes (ChildStdin); piped outputs are pipes the parent
// reads (ChildStdout, ChildStderr). Each handle is لا_شيء once taken or
// closed. الحالة keeps an exit status already collected (by try_wait, or by
// kill on a child that had exited), so a later wait still reports it.
// رقم_العملية is the process ID, kept after the child is reaped.
عام نوع طفل_أمر = {
    العملية: عملية_نظام,
    رقم_العملية: عدد,
    الدخل: اختياري ط64,
    الخرج: اختياري ط64,
    الأخطاء: اختياري ط64,
    الحالة: اختياري حالة_إنهاء
};

// A child's standard input, output and error once taken from the child.
// SultanC has no destructors, so a stream is closed explicitly; closing the
// input is the end of file the child reads.
عام نوع دخل_طفل = صندوق ط64;
عام نوع خرج_طفل = صندوق ط64;

عرف أغلق_مقبض_اختياري(المقبض: اختياري ط64): فراغ {
    طابق المقبض مع
    | اختياري.موجود(القيمة) -> { دع الإغلاق: نتيجة عدد, خطأ_حد_نظام = أغلق_مقبض_قناة_نظام(القيمة); }
    | اختياري.لا_شيء -> {};
}

// Starts الأمر with these stream choices. A captured input with bytes set
// (اضبط_بيانات_دخل_الأمر) is fed from those bytes; a captured input without
// bytes is a pipe the caller writes. Handles meant for the child are closed
// here once it started, so the parent keeps only its own pipe ends (all
// close-on-exec on Unix, not inheritable on Windows).
عرف ابدأ_بتيارات(
    الأمر: &أمر, الدخل: مصدر_تيار, الخرج: مصدر_تيار, الخطأ: مصدر_تيار
): نتيجة طفل_أمر, خطأ_أمر {
    دع القياسية: متغير متجه ط64 = [~(0 مثل ط64), ~(0 مثل ط64), ~(0 مثل ط64)];
    // Handles the child receives, closed in this process once it started.
    دع للطفل: متغير متجه ط64 = [];
    // This process's ends: the input's writer, the outputs' readers.
    دع للأب: متغير متجه ط64 = [];
    دع كاتب_الدخل: متغير اختياري ط64 = اختياري.لا_شيء();
    دع قارئ_الخرج: متغير اختياري ط64 = اختياري.لا_شيء();
    دع قارئ_الأخطاء: متغير اختياري ط64 = اختياري.لا_شيء();
    دع ملف_الدخل: متغير اختياري مقبض_ملف = اختياري.لا_شيء();
    دع الفشل: متغير اختياري خطأ_أمر = اختياري.لا_شيء();
    طابق الدخل مع
    | مصدر_تيار.وراثة -> {}
    | مصدر_تيار.فارغ -> {
        طابق افتح_الجهاز_الفارغ_نظام() مع
        | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
        | نتيجة.نجح(المقبض) -> { القياسية[0] := المقبض; ألحق(للطفل, المقبض); };
    }
    | مصدر_تيار.التقاط -> {
        لو ((الطول((*الأمر).بيانات_الدخل) مثل طبيعي) > 0) {
            طابق ملف_دخل_مؤقت(&(*الأمر).بيانات_الدخل) مع
            | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(الفئة)); }
            | نتيجة.نجح(المقبض) -> {
                القياسية[0] := (*المقبض) مثل ط64;
                ملف_الدخل := اختياري.موجود(المقبض);
            };
        } وإلا {
            طابق أنشئ_قناة_نظام() مع
            | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
            | نتيجة.نجح(القناة) -> {
                القياسية[0] := القناة.القارئ;
                ألحق(للطفل, القناة.القارئ);
                ألحق(للأب, القناة.الكاتب);
                كاتب_الدخل := اختياري.موجود(القناة.الكاتب);
            };
        };
    };
    دع المصادر: متجه مصدر_تيار = [الخرج, الخطأ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        طابق المصادر[ف] مع
        | مصدر_تيار.وراثة -> {}
        | مصدر_تيار.فارغ -> {
            طابق افتح_الجهاز_الفارغ_نظام() مع
            | نتيجة.خطأ(الخ) -> { الفشل := اختياري.موجود(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
            | نتيجة.نجح(المقبض) -> { القياسية[ف + 1] := المقبض; ألحق(للطفل, المقبض); };
        }
        | مصدر_تيار.التقاط -> {
            طابق أنشئ_قناة_نظام() مع
            | نتيجة.خطأ(الخ) -> { الفشل := اختياري.موجود(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
            | نتيجة.نجح(القناة) -> {
                القياسية[ف + 1] := القناة.الكاتب;
                ألحق(للطفل, القناة.الكاتب);
                ألحق(للأب, القناة.القارئ);
                لو (ف == 0) { قارئ_الخرج := اختياري.موجود(القناة.القارئ); }
                وإلا { قارئ_الأخطاء := اختياري.موجود(القناة.القارئ); };
            };
        };
        ف := ف + 1;
    }
    دع البيئة: متغير متجه نص = [];
    دع بيئة_مخصصة: متغير منطقي = (*الأمر).بيئة_مخصصة;
    ف := 0;
    لو (!بيئة_مخصصة && هل_جدول_البيئة_مهيأ()) {
        // A child started without an explicit environment inherits this
        // process's, which is std's table once a variable was set or removed
        // (Go's os/exec passes os.Environ() the same way).
        دع المداخل: متجه متجه ط8 = مداخل_جدول_البيئة();
        طالما (ف < (الطول(المداخل) مثل طبيعي)) { ألحق(البيئة, من_بايتات(&المداخل[ف])); ف := ف + 1; }
        بيئة_مخصصة := صواب;
    };
    طالما (ف < (الطول((*الأمر).البيئة) مثل طبيعي)) {
        دع المدخل: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(&(*الأمر).البيئة[ف].الاسم));
        ألحق(المدخل, 0x3D);
        ألحق_بايتات_نص(&متغير المدخل, انسخ_نص(&(*الأمر).البيئة[ف].القيمة));
        ألحق(البيئة, من_بايتات(&المدخل));
        ف := ف + 1;
    }
    دع العملية: متغير عملية_نظام = { المعرف: 0, قيد_الانتظار: خطأ };
    طابق الفشل مع
    | اختياري.موجود(_) -> {}
    | اختياري.لا_شيء -> {
        طابق شغل_عملية_نظام_بإعداد(
            &(*الأمر).البرنامج, &(*الأمر).الوسائط, &البيئة, بيئة_مخصصة,
            &القياسية, &(*الأمر).الدليل
        ) مع
        | نتيجة.خطأ(الخ) -> { الفشل := اختياري.موجود(خطأ_أمر.تشغيل(فئة_من_حد(الخ))); }
        | نتيجة.نجح(المشغلة) -> { العملية := المشغلة; };
    };
    أغلق_مقابض_الأمر(&للطفل);
    طابق ملف_الدخل مع
    | اختياري.موجود(المقبض) -> { دع الإغلاق: نتيجة عدد, عدد = أغلق_مقبض_ملف(المقبض); }
    | اختياري.لا_شيء -> {};
    طابق الفشل مع
    | اختياري.موجود(الخطأ_الأول) -> {
        أغلق_مقابض_الأمر(&للأب);
        أرجع نتيجة.خطأ(الخطأ_الأول);
    }
    | اختياري.لا_شيء -> {};
    دع الطفل: طفل_أمر = {
        العملية: العملية, رقم_العملية: معرف_عملية_نظام(&العملية), الدخل: كاتب_الدخل, الخرج: قارئ_الخرج,
        الأخطاء: قارئ_الأخطاء, الحالة: اختياري.لا_شيء()
    };
    أرجع نتيجة.نجح(الطفل);
}

// Starts the command with its streams as configured and returns the
// running child (Rust Command::spawn). A piped stream is a pipe between the
// two processes, read or written through the child.
عام عرف ابدأ_الأمر(الأمر: &أمر): نتيجة طفل_أمر, خطأ_أمر {
    أرجع ابدأ_بتيارات(الأمر, (*الأمر).الدخل, (*الأمر).الخرج, (*الأمر).الخطأ);
}

// The child's process ID (Rust Child::id).
عام عرف معرف_عملية_الطفل(الطفل: &طفل_أمر): عدد {
    أرجع (*الطفل).رقم_العملية;
}

// Takes the child's standard input, output or error out of the child
// (Rust's child.stdin.take()): لا_شيء if it was not piped or was taken.
عام عرف خذ_دخل_الطفل(الطفل: &متغير طفل_أمر): اختياري دخل_طفل {
    طابق (*الطفل).الدخل مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقبض) -> {
        (*الطفل).الدخل := اختياري.لا_شيء();
        دع الصندوق: دخل_طفل = صندوق المقبض;
        أرجع اختياري.موجود(الصندوق);
    };
}
عام عرف خذ_خرج_الطفل(الطفل: &متغير طفل_أمر): اختياري خرج_طفل {
    طابق (*الطفل).الخرج مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقبض) -> {
        (*الطفل).الخرج := اختياري.لا_شيء();
        دع الصندوق: خرج_طفل = صندوق المقبض;
        أرجع اختياري.موجود(الصندوق);
    };
}
عام عرف خذ_أخطاء_الطفل(الطفل: &متغير طفل_أمر): اختياري خرج_طفل {
    طابق (*الطفل).الأخطاء مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقبض) -> {
        (*الطفل).الأخطاء := اختياري.لا_شيء();
        دع الصندوق: خرج_طفل = صندوق المقبض;
        أرجع اختياري.موجود(الصندوق);
    };
}

// The writer and reader shapes of std.io (كاتب, قارئ): a taken input is
// written, a taken output or error read; 0 bytes read is the end of the
// stream. Errors are negative codes, as for files and sockets.
عام عرف اكتب_دخل_طفل(
    الدخل: &دخل_طفل, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    طابق اكتب_قناة_نظام(**الدخل, المحتوى, الإزاحة, العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(المكتوب); };
}
عام عرف اقرأ_خرج_طفل(
    الخرج: &خرج_طفل, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    طابق اقرأ_قناة_نظام(**الخرج, المخزن, الإزاحة, العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المقروء) -> { أرجع نتيجة.نجح(المقروء); };
}
// Closing a taken input is the end of file the child reads.
عام عرف أغلق_دخل_طفل(الدخل: دخل_طفل): نتيجة عدد, عدد {
    دع المقبض: ط64 = *الدخل;
    حرر(الدخل);
    طابق أغلق_مقبض_قناة_نظام(المقبض) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
}
عام عرف أغلق_خرج_طفل(الخرج: خرج_طفل): نتيجة عدد, عدد {
    دع المقبض: ط64 = *الخرج;
    حرر(الخرج);
    طابق أغلق_مقبض_قناة_نظام(المقبض) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
}

// Writes all of البيانات to the child's piped input (Rust's
// child.stdin.as_mut().unwrap().write_all). An input that was not piped, or
// was taken or closed, is إدخال_غير_صالح; a child that closed its input
// gives the broken-pipe error.
عام عرف اكتب_إلى_الطفل(الطفل: &متغير طفل_أمر, البيانات: &متجه ط8): نتيجة عدد, خطأ_أمر {
    دع المقبض: متغير ط64 = 0;
    طابق (*الطفل).الدخل مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_خطأ_نظام.إدخال_غير_صالح())); }
    | اختياري.موجود(القيمة) -> { المقبض := القيمة; };
    دع الكلي: عدد = الطول(*البيانات) مثل عدد;
    دع المكتوب: متغير عدد = 0;
    طالما (المكتوب < الكلي) {
        طابق اكتب_قناة_نظام(المقبض, البيانات, المكتوب, الكلي - المكتوب) مع
        | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
        | نتيجة.نجح(العدد) -> {
            لو (العدد <= 0) { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_خطأ_نظام.آخر())); };
            المكتوب := المكتوب + العدد;
        };
    }
    أرجع نتيجة.نجح(الكلي);
}

// Closes the child's piped input: the child reads end of file (Rust's
// drop(child.stdin.take())). Nothing happens if there is none.
عام عرف أغلق_دخل_الطفل(الطفل: &متغير طفل_أمر): فراغ {
    أغلق_مقبض_اختياري((*الطفل).الدخل);
    (*الطفل).الدخل := اختياري.لا_شيء();
}

// Closes the pipes the child still holds: its input, output and error
// (Rust drops them with the Child). SultanC has no destructors: a child
// waited for with انتظر_الطفل keeps its output pipes open until this or
// until they are taken and closed. انتظر_خرج_الطفل closes them itself.
عام عرف أغلق_تيارات_الطفل(الطفل: &متغير طفل_أمر): فراغ {
    أغلق_مقبض_اختياري((*الطفل).الدخل);
    أغلق_مقبض_اختياري((*الطفل).الخرج);
    أغلق_مقبض_اختياري((*الطفل).الأخطاء);
    (*الطفل).الدخل := اختياري.لا_شيء();
    (*الطفل).الخرج := اختياري.لا_شيء();
    (*الطفل).الأخطاء := اختياري.لا_شيء();
}

عرف اقرأ_مقبض_الطفل(
    المقبض: اختياري ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, خطأ_أمر {
    طابق المقبض مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_خطأ_نظام.إدخال_غير_صالح())); }
    | اختياري.موجود(القيمة) -> {
        طابق اقرأ_قناة_نظام(القيمة, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(فئة_من_حد(الخ))); }
        | نتيجة.نجح(المقروء) -> { أرجع نتيجة.نجح(المقروء); };
    };
}

// Reads what the child wrote to its piped output or error so far, waiting
// for at least one byte; 0 is the end of the stream (the child closed it,
// usually by exiting).
عام عرف اقرأ_خرج_الطفل(
    الطفل: &متغير طفل_أمر, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, خطأ_أمر {
    أرجع اقرأ_مقبض_الطفل((*الطفل).الخرج, المخزن, الإزاحة, العدد);
}
عام عرف اقرأ_أخطاء_الطفل(
    الطفل: &متغير طفل_أمر, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, خطأ_أمر {
    أرجع اقرأ_مقبض_الطفل((*الطفل).الأخطاء, المخزن, الإزاحة, العدد);
}

// Waits for the child to exit (Rust Child::wait). Its input is closed first,
// as Rust does, so a child reading to the end of its input can finish. The
// outputs stay open for reading.
عام عرف انتظر_الطفل(الطفل: &متغير طفل_أمر): نتيجة حالة_إنهاء, خطأ_أمر {
    أغلق_دخل_الطفل(الطفل);
    طابق (*الطفل).الحالة مع
    | اختياري.موجود(الحالة) -> { أرجع نتيجة.نجح(الحالة); }
    | اختياري.لا_شيء -> {};
    طابق انتظر_عملية_نظام(&متغير (*الطفل).العملية) مع
    | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.انتظار(فئة_من_حد(الخ))); }
    | نتيجة.نجح(الرمز) -> {
        دع الحالة: حالة_إنهاء = حالة_إنهاء_عملية_طفلة(الرمز);
        (*الطفل).الحالة := اختياري.موجود(الحالة);
        أرجع نتيجة.نجح(الحالة);
    };
}

// The child's exit status if it has exited, without waiting (Rust
// Child::try_wait): لا_شيء while it runs.
عام عرف تفقد_الطفل(الطفل: &متغير طفل_أمر): نتيجة اختياري حالة_إنهاء, خطأ_أمر {
    طابق (*الطفل).الحالة مع
    | اختياري.موجود(الحالة) -> { أرجع نتيجة.نجح(اختياري.موجود(الحالة)); }
    | اختياري.لا_شيء -> {};
    طابق تفقد_عملية_نظام(&متغير (*الطفل).العملية) مع
    | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.انتظار(فئة_من_حد(الخ))); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | نتيجة.نجح(اختياري.موجود(الرمز)) -> {
        دع الحالة: حالة_إنهاء = حالة_إنهاء_عملية_طفلة(الرمز);
        (*الطفل).الحالة := اختياري.موجود(الحالة);
        أرجع نتيجة.نجح(اختياري.موجود(الحالة));
    };
}

// Kills the child (Rust Child::kill: SIGKILL on Unix, TerminateProcess on
// Windows). A child that already exited is not an error. Wait for it
// afterwards to collect its status.
عام عرف اقتل_الطفل(الطفل: &متغير طفل_أمر): نتيجة عدد, خطأ_أمر {
    طابق (*الطفل).الحالة مع
    | اختياري.موجود(_) -> { أرجع نتيجة.نجح(0); }
    | اختياري.لا_شيء -> {};
    طابق اقتل_عملية_نظام(&متغير (*الطفل).العملية) مع
    | نتيجة.خطأ(الخ) -> { أرجع نتيجة.خطأ(خطأ_أمر.انتظار(فئة_من_حد(الخ))); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع نتيجة.نجح(0); }
    | نتيجة.نجح(اختياري.موجود(الرمز)) -> {
        (*الطفل).الحالة := اختياري.موجود(حالة_إنهاء_عملية_طفلة(الرمز));
        أرجع نتيجة.نجح(0);
    };
}

// Closes the input, reads the piped output and error to their ends as they
// arrive (poll on Unix, a PeekNamedPipe loop on Windows, so a child filling
// one pipe never blocks), and waits (Rust Child::wait_with_output). An
// output that was not piped, or was taken, is empty.
عام عرف انتظر_خرج_الطفل(الطفل_المملوك: طفل_أمر): نتيجة ناتج_أمر, خطأ_أمر {
    دع الطفل: متغير طفل_أمر = الطفل_المملوك;
    أغلق_دخل_الطفل(&متغير الطفل);
    دع النشطة: متغير متجه ط64 = [];
    دع تيارات_النشطة: متغير متجه طبيعي = [];
    طابق الطفل.الخرج مع
    | اختياري.موجود(المقبض) -> { ألحق(النشطة, المقبض); ألحق(تيارات_النشطة, 1); }
    | اختياري.لا_شيء -> {};
    طابق الطفل.الأخطاء مع
    | اختياري.موجود(المقبض) -> { ألحق(النشطة, المقبض); ألحق(تيارات_النشطة, 2); }
    | اختياري.لا_شيء -> {};
    الطفل.الخرج := اختياري.لا_شيء();
    الطفل.الأخطاء := اختياري.لا_شيء();
    // Read every captured output until each reaches its end.
    دع الخرج_المجموع: متغير متجه ط8 = [];
    دع الخطأ_المجموع: متغير متجه ط8 = [];
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 65536) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
    دع خطأ_القراءة: متغير اختياري فئة_خطأ_نظام = اختياري.لا_شيء();
    طالما ((الطول(النشطة) مثل طبيعي) > 0) {
        طابق انتظر_قنوات_نظام(&النشطة) مع
        | نتيجة.خطأ(الخ) -> {
            خطأ_القراءة := اختياري.موجود(فئة_من_حد(الخ));
            أغلق_مقابض_الأمر(&النشطة);
            دع لا_شيء_نشط: متجه ط64 = [];
            النشطة := لا_شيء_نشط;
        }
        | نتيجة.نجح(الجاهزة) -> {
            دع الباقية: متغير متجه ط64 = [];
            دع تيارات_الباقية: متغير متجه طبيعي = [];
            ف := 0;
            طالما (ف < (الطول(النشطة) مثل طبيعي)) {
                دع منته: متغير منطقي = خطأ;
                لو (الجاهزة[ف]) {
                    طابق اقرأ_قناة_نظام(النشطة[ف], &متغير المخزن, 0, 65536) مع
                    | نتيجة.خطأ(الخ) -> { خطأ_القراءة := اختياري.موجود(فئة_من_حد(الخ)); منته := صواب; }
                    | نتيجة.نجح(العدد) -> {
                        لو (العدد == 0) { منته := صواب; }
                        وإلا {
                            دع ح: متغير طبيعي = 0;
                            طالما (ح < (العدد مثل طبيعي)) {
                                لو (تيارات_النشطة[ف] == 1) { ألحق(الخرج_المجموع, المخزن[ح]); }
                                وإلا { ألحق(الخطأ_المجموع, المخزن[ح]); };
                                ح := ح + 1;
                            }
                        };
                    };
                };
                لو (منته) {
                    دع الإغلاق: نتيجة عدد, خطأ_حد_نظام = أغلق_مقبض_قناة_نظام(النشطة[ف]);
                } وإلا {
                    ألحق(الباقية, النشطة[ف]);
                    ألحق(تيارات_الباقية, تيارات_النشطة[ف]);
                };
                ف := ف + 1;
            }
            النشطة := الباقية;
            تيارات_النشطة := تيارات_الباقية;
        };
    }
    طابق انتظر_الطفل(&متغير الطفل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الحالة) -> {
        طابق خطأ_القراءة مع
        | اختياري.موجود(الفئة) -> { أرجع نتيجة.خطأ(خطأ_أمر.دخل_خرج(الفئة)); }
        | اختياري.لا_شيء -> {};
        دع الناتج: ناتج_أمر = {
            الحالة: الحالة, الخرج: الخرج_المجموع, الخطأ: الخطأ_المجموع
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

// Runs الأمر with these stream choices to completion.
عرف نفذ_بتيارات(
    الأمر: &أمر, الدخل: مصدر_تيار, الخرج: مصدر_تيار, الخطأ: مصدر_تيار
): نتيجة ناتج_أمر, خطأ_أمر {
    طابق ابدأ_بتيارات(الأمر, الدخل, الخرج, الخطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الطفل) -> { أرجع انتظر_خرج_الطفل(الطفل); };
}

// Runs the command with its streams as configured and returns how it ended
// (Rust Command::status). Captured outputs are read and dropped.
عام عرف شغل_الأمر(الأمر: &أمر): نتيجة حالة_إنهاء, خطأ_أمر {
    طابق نفذ_بتيارات(الأمر, (*الأمر).الدخل, (*الأمر).الخرج, (*الأمر).الخطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الناتج) -> { أرجع نتيجة.نجح(الناتج.الحالة); };
}

// Runs the command and collects its standard output and error (Rust
// Command::output): both are captured, and an inherited input becomes the
// null device; a null or captured input is kept.
عام عرف اجمع_خرج_الأمر(الأمر: &أمر): نتيجة ناتج_أمر, خطأ_أمر {
    دع الدخل: متغير مصدر_تيار = (*الأمر).الدخل;
    طابق الدخل مع
    | مصدر_تيار.وراثة -> { الدخل := مصدر_تيار.فارغ(); }
    | _ -> {};
    أرجع نفذ_بتيارات(الأمر, الدخل, مصدر_تيار.التقاط(), مصدر_تيار.التقاط());
}

// Whether the command exited with status 0.
عام عرف هل_نجح_الأمر(الحالة: &حالة_إنهاء): منطقي {
    طابق *الحالة مع
    | حالة_إنهاء.خرج(0) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام مرادف stdio = مصدر_تيار;
عام مرادف stdio.inherit = مصدر_تيار.وراثة;
عام مرادف stdio.null = مصدر_تيار.فارغ;
