استورد process.argument_count;
خارجي عرف تشغيل_الوصول_إلى_وسيط(الحجة_0: عدد): نص;
عرف اقرأ_وسيطة_من_التشغيل(الحجة_0: عدد): نص { أرجع تشغيل_الوصول_إلى_وسيط(الحجة_0); }

عام عرف وسيطة(الفهرس: غير_موقع): اختيار نص {
    لو (الفهرس >= عدد_الوسائط()) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(اقرأ_وسيطة_من_التشغيل(الفهرس مثل عدد));
}

عام مرادف argument = وسيطة;
