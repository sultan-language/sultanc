استورد process.argument_count;
استورد os.arguments;

عام عرف وسيطة(الفهرس: طبيعي): اختياري نص {
    إذا (الفهرس >= عدد_الوسائط()) { أرجع اختياري.لا_شيء(); };
    طابق وسيطة_النظام(الفهرس مثل عدد) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(النص) -> { أرجع اختياري.موجود(النص); };
}

عام مرادف argument = وسيطة;
