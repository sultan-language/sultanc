استورد process.argument_count;
استورد os.arguments;

عام عرف وسيطة(الفهرس: غير_موقع): اختيار نص {
    لو (الفهرس >= عدد_الوسائط()) { أرجع اختيار.لا_شيء(); };
    طابق وسيطة_النظام(الفهرس مثل عدد) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(النص) -> { أرجع اختيار.بعض(النص); };
}

عام مرادف argument = وسيطة;
