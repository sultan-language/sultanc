استورد os.process;
استورد os.error;

عرف شغل_عملية_داخليا(البرنامج: &نص, الوسائط: &متجه نص): عدد {
    طابق شغل_عملية_نظام(البرنامج, الوسائط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العملية) -> { أرجع العملية.المعرف; };
}
عرف انتظر_عملية_داخليا(المعرف: عدد): عدد {
    دع العملية: متغير عملية_نظام = { المعرف: المعرف, قيد_الانتظار: صواب };
    طابق انتظر_عملية_نظام(&متغير العملية) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
}

عام نوع عملية_طفلة = { المعرف: عدد };
عام نوع حالة_إنهاء =
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

عام عرف شغل_عملية(البرنامج: &نص, الوسائط: &متجه نص): نتيجة عملية_طفلة, عدد {
    دع القيم: متجه نص = *الوسائط;
    دع المعرف: عدد = شغل_عملية_داخليا(البرنامج, &القيم);
    لو (المعرف < 0) { أرجع نتيجة.خطأ(المعرف); };
    دع الطفل: عملية_طفلة = { المعرف: المعرف };
    أرجع نتيجة.نجح(الطفل);
}

// Linux and Darwin providers both encode signal terminations as 256 + signal.
لو (الهدف.المنصة == «linux» || الهدف.المنصة == «macos») {
    عام عرف حالة_إنهاء_عملية_طفلة(الحالة: عدد): حالة_إنهاء {
        لو (الحالة >= 256) { أرجع حالة_إنهاء.إشارة(الحالة - 256); };
        أرجع حالة_إنهاء.خرج(الحالة);
    }
} وإلا {
    عام عرف حالة_إنهاء_عملية_طفلة(الحالة: عدد): حالة_إنهاء {
        أرجع حالة_إنهاء.خرج(الحالة);
    }
}

عام عرف انتظر_عملية(الطفل: &عملية_طفلة): نتيجة حالة_إنهاء, عدد {
    دع القيمة: عملية_طفلة = *الطفل;
    دع الحالة: عدد = انتظر_عملية_داخليا(القيمة.المعرف);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(حالة_إنهاء_عملية_طفلة(الحالة));
}

عام عرف شغل_وانتظر(البرنامج: &نص, الوسائط: &متجه نص): نتيجة حالة_إنهاء, عدد {
    طابق شغل_عملية(البرنامج, الوسائط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الطفل) -> { أرجع انتظر_عملية(&الطفل); };
}

// Darwin's nonblocking and bounded interfaces take mutable ownership of a
// child. A successful reap sets its PID to zero, preventing another wait or
// termination through the same child object. Never substitute a shell poll.
لو (الهدف.المنصة == «macos») {
    استورد time.time;
    استورد time.duration;

    // Stateful blocking counterpart to the legacy immutable wait: one
    // successful wait releases this child's PID so it cannot be reused.
    عام عرف انتظر_عملية_مملوكة(
        الطفل: &متغير عملية_طفلة
    ): نتيجة حالة_إنهاء, عدد {
        لو ((*الطفل).المعرف <= 0) { أرجع نتيجة.خطأ(-9); };
        دع الحالة: عدد = انتظر_عملية_داخليا((*الطفل).المعرف);
        لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        (*الطفل).المعرف := 0;
        أرجع نتيجة.نجح(حالة_إنهاء_عملية_طفلة(الحالة));
    }

    عام عرف تفقد_عملية(
        الطفل: &متغير عملية_طفلة
    ): نتيجة اختيار حالة_إنهاء, عدد {
        دع العملية: متغير عملية_نظام = {
            المعرف: (*الطفل).المعرف, قيد_الانتظار: (*الطفل).المعرف > 0
        };
        طابق تفقد_عملية_نظام(&متغير العملية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
            | اختيار.بعض(الرمز) -> {
                (*الطفل).المعرف := 0;
                أرجع نتيجة.نجح(اختيار.بعض(حالة_إنهاء_عملية_طفلة(الرمز)));
            };
        };
    }

    // Some means already exited and reaped. None means SIGTERM/SIGKILL was
    // sent; the caller still owns the child and must wait for its final status.
    عرف أكمل_إنهاء_عملية(
        الطفل: &متغير عملية_طفلة, النتيجة: نتيجة اختيار عدد, خطأ_حد_نظام
    ): نتيجة اختيار حالة_إنهاء, عدد {
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
            | اختيار.بعض(الرمز) -> {
                (*الطفل).المعرف := 0;
                أرجع نتيجة.نجح(اختيار.بعض(حالة_إنهاء_عملية_طفلة(الرمز)));
            };
        };
    }

    عام عرف انه_عملية(
        الطفل: &متغير عملية_طفلة
    ): نتيجة اختيار حالة_إنهاء, عدد {
        دع العملية: متغير عملية_نظام = {
            المعرف: (*الطفل).المعرف, قيد_الانتظار: (*الطفل).المعرف > 0
        };
        أرجع أكمل_إنهاء_عملية(الطفل, انه_عملية_نظام(&متغير العملية));
    }

    عام عرف اقتل_عملية(
        الطفل: &متغير عملية_طفلة
    ): نتيجة اختيار حالة_إنهاء, عدد {
        دع العملية: متغير عملية_نظام = {
            المعرف: (*الطفل).المعرف, قيد_الانتظار: (*الطفل).المعرف > 0
        };
        أرجع أكمل_إنهاء_عملية(الطفل, اقتل_عملية_نظام(&متغير العملية));
    }

    // A timeout never consumes a live child. Terminate it explicitly and
    // reap it afterwards; clock/sleep errors are reported, not treated as
    // timeout or as a successful exit.
    عام عرف انتظر_عملية_بمهلة(
        الطفل: &متغير عملية_طفلة, المهلة: &مدة
    ): نتيجة اختيار حالة_إنهاء, عدد {
        دع الحد: عدد = نانوثواني_المدة(المهلة);
        لو (الحد < 0) { أرجع نتيجة.خطأ(-22); };
        دع البداية: عدد;
        طابق وقت_رتيب_نانو() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النانو) -> { البداية := النانو; };
        بينما (صواب) {
            طابق تفقد_عملية(الطفل) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الحالة) -> {
                طابق الحالة مع
                | اختيار.بعض(النهاية) -> { أرجع نتيجة.نجح(اختيار.بعض(النهاية)); }
                | اختيار.لا_شيء -> {};
            };
            دع الآن: عدد;
            طابق وقت_رتيب_نانو() مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(النانو) -> { الآن := النانو; };
            لو (الآن < البداية) { أرجع نتيجة.خطأ(-75); };
            دع المنقضي: عدد = الآن - البداية;
            لو (المنقضي >= الحد) { أرجع نتيجة.نجح(اختيار.لا_شيء()); };
            دع الباقي: عدد = الحد - المنقضي;
            دع النوم: متغير عدد = 10000000;
            لو (الباقي < النوم) { النوم := الباقي; };
            طابق نم_نانو(النوم) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> {};
        }
        أرجع نتيجة.نجح(اختيار.لا_شيء());
    }

    عام مرادف wait_owned = انتظر_عملية_مملوكة;
    عام مرادف try_wait = تفقد_عملية;
    عام مرادف terminate = انه_عملية;
    عام مرادف kill_child = اقتل_عملية;
    عام مرادف wait_timeout = انتظر_عملية_بمهلة;
}

عام مرادف child_process = عملية_طفلة;
عام مرادف exit_status = حالة_إنهاء;
عام مرادف exit_status.exited = حالة_إنهاء.خرج;
عام مرادف exit_status.signaled = حالة_إنهاء.إشارة;
عام مرادف spawn = شغل_عملية;
عام مرادف wait = انتظر_عملية;
عام مرادف run_and_wait = شغل_وانتظر;
