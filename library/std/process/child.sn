مرادف شغل_عملية_داخليا = بدائي_تشغيل_عملية;
مرادف انتظر_عملية_داخليا = بدائي_انتظار_عملية;

عام نوع عملية_طفلة = { المعرف: عدد };
عام نوع حالة_إنهاء =
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

عام عرف شغل_عملية(البرنامج: &نص, الوسائط: &متجه نص): نتيجة عملية_طفلة, عدد {
    دع القيم: متجه نص = *الوسائط;
    دع المعرف: عدد = شغل_عملية_داخليا(*البرنامج, القيم);
    لو (المعرف < 0) { أرجع نتيجة.خطأ(المعرف); };
    دع الطفل: عملية_طفلة = { المعرف: المعرف };
    أرجع نتيجة.نجح(الطفل);
}

عام عرف انتظر_عملية(الطفل: &عملية_طفلة): نتيجة حالة_إنهاء, عدد {
    دع القيمة: عملية_طفلة = *الطفل;
    دع الحالة: عدد = انتظر_عملية_داخليا(القيمة.المعرف);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    لو (الحالة >= 256) { أرجع نتيجة.نجح(حالة_إنهاء.إشارة(الحالة - 256)); };
    أرجع نتيجة.نجح(حالة_إنهاء.خرج(الحالة));
}

عام عرف شغل_وانتظر(البرنامج: &نص, الوسائط: &متجه نص): نتيجة حالة_إنهاء, عدد {
    طابق شغل_عملية(البرنامج, الوسائط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الطفل) -> { أرجع انتظر_عملية(&الطفل); };
}

عام مرادف child_process = عملية_طفلة;
عام مرادف exit_status = حالة_إنهاء;
عام مرادف exit_status.exited = حالة_إنهاء.خرج;
عام مرادف exit_status.signaled = حالة_إنهاء.إشارة;
عام مرادف spawn = شغل_عملية;
عام مرادف wait = انتظر_عملية;
عام مرادف run_and_wait = شغل_وانتظر;
