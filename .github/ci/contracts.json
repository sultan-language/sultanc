{
  "schema_version": 6,
  "updated": "2026-11-04",
  "ci_check_catalog": {
    "llvm-sdk": {
      "requires": [],
      "description": "Restore or provision the pinned, checksum-verified LLVM development SDK and verify its contract."
    },
    "c-stage0": {
      "requires": [
        "llvm-sdk"
      ],
      "description": "./build.sh stage0: build the C Stage0 (bootstrap/) with the host C toolchain and the pinned LLVM SDK."
    },
    "c-stage2": {
      "requires": [
        "llvm-sdk"
      ],
      "description": "./build.sh: C Stage0 -> Stage1 -> Stage2 (build/sultanc)."
    },
    "compiler-format": {
      "requires": [
        "c-stage2"
      ],
      "description": "Verify build/sultanc is a native executable of the registered host format."
    },
    "seed": {
      "requires": [],
      "description": "Zig-style wasm-seed bootstrap with every declared C toolchain driver; --verify --check-seed where Stage2 runs on the host, otherwise Stage1 plus exact seed reproduction by Stage1."
    },
    "self-check": {
      "requires": [
        "seed"
      ],
      "description": "Stage1 from the seed runs `check compiler/main.sn` (check-only self-compile, no native backend needed)."
    },
    "fixpoint": {
      "requires": [
        "c-stage2"
      ],
      "description": "./build.sh verify: Stage3 == Stage4 (plus the cross-backend LLVM check the build defines)."
    },
    "tests": {
      "requires": [
        "c-stage2"
      ],
      "description": "tools/tests/ci_run.sh with build/sultanc (tests/runner + iSpeak), result contract build/tests-result.json."
    },
    "tests-portable": {
      "requires": [
        "seed"
      ],
      "description": "iSpeak suite with Stage1 from the seed for a non-host target: check + object emission, no native backend for the host needed."
    },
    "examples": {
      "requires": [
        "c-stage2"
      ],
      "description": "Examples harness (gated by the examples contract state)."
    },
    "backend-smoke": {
      "requires": [
        "c-stage2"
      ],
      "description": "Explicit native/LLVM backend smoke (gated by the backend_smoke contract state)."
    }
  },
